body.title-menu .optionsCard>#menuBack{display:none!important}
@media(orientation:landscape) and (max-height:500px){#optionsMenu #quickMenuLinks{grid-template-columns:repeat(3,1fr);gap:6px}#optionsMenu #quickMenuLinks button{min-height:55px;font-size:16px;padding:8px}#menuCategories{grid-template-columns:repeat(3,1fr);gap:6px}#optionsMenu #menuCategories button{font-size:12px;min-height:48px;padding:8px}#optionsMenu #menuCategories .menuHint{display:none}#optionsMenu .optionsTitle{font-size:21px}#optionsMenu .menuPauseNote{margin:5px 0 8px}}
