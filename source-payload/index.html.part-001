.slayerView .screenPanel{width:min(680px,96vw);border-color:#b99a59;background:radial-gradient(ellipse at 30% 0,#403b28,#19251e 65%)}
.slayerView #adventureText{white-space:normal!important}.slayerCopy{font-size:13px;line-height:1.7;color:#e5deca}.slayerHeader{display:flex;align-items:center;gap:15px;padding:8px 2px}.slayerCrest{width:70px;height:78px;flex-shrink:0}.slayerEyebrow{font-size:9px;letter-spacing:2px;color:#cdbb8f}.slayerHeader h3{font:26px Georgia,serif;color:#f3dfae;margin:6px 0}.slayerHeader p{font-size:12px;margin:0;color:#c5c9b5}.slayerRankTrack,.slayerContractMeter{height:5px;border-radius:10px;background:#080f0c;overflow:hidden}.slayerRankTrack i,.slayerContractMeter i{display:block;height:100%;background:linear-gradient(90deg,#927541,#dcc17f)}.slayerRankHint{font-size:11px;color:#cdbb8f;margin:7px 0 16px}
.slayerBoard{display:grid;gap:10px;margin-bottom:14px}.slayerContract{padding:13px;border:1px solid #8d7645;border-left:3px solid #bba066;background:linear-gradient(115deg,#3b3625aa,#1b2a21cc);border-radius:5px;margin-bottom:12px}.slayerBoard .slayerContract{margin:0}.slayerContractTop{display:flex;justify-content:space-between;gap:12px;font-size:9px;letter-spacing:1px;color:#c9b888}.slayerContract h3{font:18px Georgia,serif;color:#f0d9a7;margin:8px 0 5px}.slayerContract p{margin:5px 0;font-size:12px;color:#d7d4c2}.slayerContractGoal{font-size:11px!important}.slayerContractReward{color:#dfc789!important}.slayerContractMeter{margin-top:10px;height:3px}.slayerReady{border-color:#90b285}.slayerReady .slayerContractTop{color:#aad49d}.slayerRanks{display:grid;gap:10px;margin-bottom:15px}.slayerRanks>div{display:flex;justify-content:space-between;gap:12px;padding:10px;border-bottom:1px solid #bba06644}.slayerRanks b{font:15px Georgia,serif;color:#efd9a4}.slayerRanks span{font-size:11px;color:#d3c4a2}
.slayerView .adventureChoices{display:grid;grid-template-columns:1fr 1fr;gap:9px}.slayerView .adventureChoices button{min-height:44px;white-space:normal;line-height:1.4;background:linear-gradient(#55492f,#322e21);border-color:#b29553;color:#f0dfb6}.slayerView .adventureChoices button:last-child{grid-column:1/-1;background:#25382c}.slayerView .adventureChoices button:disabled{opacity:.45}.slayerView .screenFoot{font-size:10px;color:#b7b7a0}
@media(max-height:560px){.slayerCrest{width:48px;height:54px}.slayerHeader h3{font-size:21px}.slayerView .adventureChoices button{min-height:34px;font-size:11px}.slayerContract{padding:9px}.slayerContract h3{font-size:16px}.slayerCopy{font-size:12px}}
@media(max-width:430px){.slayerRanks>div{display:grid;gap:4px}.slayerContractTop{font-size:8px}}
</style>
<style id="character-setup-scroll-fix">
/* Keep the complete creation form reachable inside the fixed-height game shell. */
.shell #characterSetup.setup {
  grid-column: 1 / -1;
  grid-row: 2;
  align-self: stretch;
  min-height: 0;
  max-height: 100%;
  margin: 0 auto;
  overflow-x: hidden;
  overflow-y: auto;
  grid-auto-rows: max-content;
  touch-action: pan-y;
  overscroll-behavior-y: contain;
  -webkit-overflow-scrolling: touch;
}
</style>
<style>
#adventureScreen.narrativeView .screenPanel{height:min(88dvh,720px)}
#adventureScreen.narrativeView #adventureText{flex:1;min-height:0;overflow-y:auto;touch-action:pan-y;font:15px/1.65 Georgia,serif}
#adventureScreen.narrativeView .adventureChoices{flex:0 1 auto;max-height:35dvh;min-height:0;overflow-y:auto;touch-action:pan-y}
#adventureScreen.narrativeView .adventureChoices button{min-height:44px}
</style>
<style>.earnedTitleSection{padding:8px 12px;max-height:28dvh;overflow-y:auto;flex-shrink:0;font:12px system-ui;color:#ddceaa}.earnedTitleSection summary{cursor:pointer;padding:7px}#earnedTitleList{display:grid;gap:5px}#earnedTitleList button{padding:9px;min-height:44px;border:1px solid #82926c;background:#26382a;color:#f1e4bb;text-align:left}#earnedTitleList button:disabled{opacity:.6}</style><style>.questState{float:none;display:block;margin-bottom:6px}.questEntry h3{overflow-wrap:anywhere}.questTitleRow{flex-wrap:wrap}.hud .quest p{line-height:1.25}</style>
<style id="mobile-header-102">
/* Keep the landscape world visible; menu taps activate on release. */
.shell .optionsMenu{position:fixed;inset:0;overflow:auto;align-items:center;padding:8px;}
.shell .optionsCard{max-height:calc(100dvh - 16px);overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;}

@media (orientation:landscape) {
 .shell .hud{align-items:start;gap:6px;padding:4px;}
 .shell .hudSide{flex:0 0 285px;display:grid;grid-template-columns:minmax(0,1fr) 112px;gap:5px;align-items:start;}
 .shell .hudSide .stats{padding:4px 6px;font:10px/1.25 system-ui;max-width:none;}
 .shell .hudSide .stats .bar{display:none;}
 .shell .hudSide .petStatusButton{margin-top:3px;min-height:28px;padding:2px 5px;font-size:9px;}
 .shell .hudSide .petStatusButton img{width:22px!important;height:22px!important;}
 .shell .hudSide .zoomControls{align-self:start;}
 .shell .hudSide .zoomControls button{min-height:36px;}
 .shell .questTitleRow{align-items:center;}
 .shell .quest .journalButton{min-height:36px;}
 .shell .quest p{display:none;}
}
</style>
<style>
#adventureScreen.settlementView .screenPanel{width:min(760px,100%);max-height:calc(100dvh - 24px);overflow-y:auto;display:block;background:linear-gradient(155deg,#172d29,#111b1c);border-color:#ac915d}
#adventureScreen.settlementView .screenHead{position:sticky;top:0;z-index:2;background:#192b28}
#adventureScreen.settlementView #adventureText{overflow:visible;white-space:normal!important;padding:14px!important}
.settlementCopy{white-space:pre-line;font-size:14px;line-height:1.65;margin:14px 0 0;color:#dfdec9}
.settlementVista{padding:16px;border:1px solid #748567;border-radius:12px;background:radial-gradient(ellipse at 50% 0,#64745566,transparent 70%),linear-gradient(#263f3a,#192c29)}
.settlementSky{font-size:10px;letter-spacing:3px;text-align:center;color:#dbc68f}.settlementVista h3{text-align:center;font-family:Georgia,serif;font-size:25px;font-weight:normal;color:#f4dfad;margin:9px 0 20px}
.settlementPlots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.settlementPlot{min-width:0;text-align:center;padding:12px 5px;background:#10211d;border-radius:8px;border:1px dashed #607260;display:flex;align-items:center;flex-direction:column;gap:6px}.settlementPlot span{font-size:32px;line-height:1.1;color:#d4bb7b}.settlementPlot b{font-size:11px;color:#b7bda9}.settlementPlot small{font-size:10px;color:#939e90}.settlementPlot.built{border:1px solid #c2a567;background:linear-gradient(#40533b,#243529);box-shadow:inset 0 1px #d9c28455}.settlementPlot.built b{color:#f1e4bd}.settlementPlot.ruined span{opacity:.4}
.settlementWallet{display:flex;gap:8px;justify-content:space-between;margin-top:12px;flex-wrap:wrap}.settlementWallet span{font-size:12px;color:#d2d6bd}.settlementWallet b{font-size:20px;color:#eed49a}.settlementWallet small{color:#8d9e93}.settlementBuildingIcon{text-align:center;font-size:64px;color:#ebcd84}
#adventureScreen.settlementView .adventureChoices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:0 14px 14px;overflow:visible;max-height:none}
#adventureScreen.settlementView .adventureChoices button{min-height:46px;white-space:normal;font-size:13px;background:linear-gradient(#43513a,#293c2f);border:1px solid #8d8156;color:#efe1b9;padding:10px;line-height:1.4}
#adventureScreen.settlementView .adventureChoices button:disabled{opacity:.5}#adventureScreen.settlementView .adventureChoices button:last-child{grid-column:1/-1;background:#172b28}
@media(max-width:360px){.settlementPlots{grid-template-columns:repeat(2,minmax(0,1fr))}.settlementVista h3{font-size:21px}}
</style>
<style>@media(max-height:560px){#premiumScreen .premiumPanel{overflow-y:auto;touch-action:pan-y}#premiumScreen .premiumPanel>*{flex-shrink:0}#premiumScreen .premiumList{flex:none;overflow:visible}#premiumScreen .screenHead{position:sticky;top:0;z-index:2;background:#151d1b}#premiumScreen .screenFoot{position:sticky;bottom:0;background:#151d1b;z-index:2}.premiumList{grid-template-columns:repeat(3,minmax(0,1fr))}.premiumSwatch{height:60px}.premiumCard p{min-height:0}}</style><style id="thornhaven-action-hud">/* Thornhaven: edge-mounted action RPG interface. */
body:has(#gameView:not([hidden])){overflow:hidden;background:#161813}
body:has(#gameView:not([hidden])) .shell{position:fixed;inset:0;width:100vw;height:100dvh;max-width:none;padding:0;display:block}
body:has(#gameView:not([hidden])) .shell .top{position:absolute;z-index:12;top:0;left:0;right:0;height:34px;flex-wrap:nowrap;align-items:center;padding:2px 9px;margin:0;background:linear-gradient(#151813ec,#15181399);border-bottom:1px solid #89704470}
body:has(#gameView:not([hidden])) .brand{font-size:14px;letter-spacing:.14em}.brand small{font-size:8px}
body:has(#gameView:not([hidden])) .brand small,body:has(#gameView:not([hidden])) .autosavePill{display:none}
body:has(#gameView:not([hidden])) .top .pill{border-image:none;border:0;background:none;padding:2px;font:10px system-ui}
body:has(#gameView:not([hidden])) .top .status{gap:8px;flex-wrap:nowrap} body:has(#gameView:not([hidden])) .top .status .pill:first-child{display:none}
body:has(#gameView:not([hidden])) .shell .game{position:absolute;inset:34px 0 0;display:block;height:auto;min-height:0;max-height:none;border:0;border-radius:0;overflow:hidden}
body:has(#gameView:not([hidden])) #world{position:absolute;inset:0;width:100%;height:100%;max-height:none;aspect-ratio:auto;image-rendering:auto;filter:saturate(.8) contrast(1.05)}
body:has(#gameView:not([hidden])) .shell .hud{position:absolute;inset:10px 10px auto;display:block;width:auto;padding:0;z-index:3;pointer-events:none}
body:has(#gameView:not([hidden])) .shell .hudSide{position:absolute;left:0;top:0;width:190px;display:block}
body:has(#gameView:not([hidden])) .shell .hudSide .stats{position:relative;width:100%;min-width:0;padding:8px 9px 8px 58px;border-image:none;border:1px solid #ae8c52;border-radius:3px;background:linear-gradient(110deg,#252a21e8,#151a17b8);font:10px/1.5 system-ui;color:#e7d9b9;box-shadow:0 3px 10px #0008}
#heroHudPortrait{position:absolute;left:3px;top:4px;width:50px;height:67px;aspect-ratio:auto;border:1px solid #967641;background:radial-gradient(#526052,#1b211b);image-rendering:auto}
body:has(#gameView:not([hidden])) .shell .hudSide .stats .bar{display:block;height:7px;margin:2px 0 4px;border-radius:1px;background:#301a16;border:1px solid #77654c}
body:has(#gameView:not([hidden])) .shell .hudSide .stats .fill{background:linear-gradient(#e97b58,#a42720)}
body:has(#gameView:not([hidden])) .shell .hudSide .stats .xpbar{height:100%;margin:0;background:linear-gradient(#dec778,#8c6c35)}
body:has(#gameView:not([hidden])) .shell .petStatusButton{margin:5px 0 0 -49px;min-height:34px;width:calc(100% + 49px);border:1px solid #8c794f;background:#282e20de;border-radius:2px;font:10px system-ui}
body:has(#gameView:not([hidden])) .shell .hudSide .zoomControls{display:flex;gap:3px;margin-top:6px;justify-content:start}
body:has(#gameView:not([hidden])) .shell .zoomControls button{min-width:38px;min-height:36px;padding:2px;border:1px solid #8b754e;background:#24291ec9;color:#f4dfaf;border-radius:2px;font:11px system-ui}
body:has(#gameView:not([hidden])) .shell .hud .quest{position:absolute;right:0;top:0;width:180px;max-width:calc(100vw - 220px);border-image:none;border:0;border-left:2px solid #b79860;padding:6px 8px;background:linear-gradient(90deg,#171d17d9,#171d1755);pointer-events:auto}
body:has(#gameView:not([hidden])) .shell .questTitleRow{display:flex;flex-direction:column;align-items:stretch;gap:5px}
body:has(#gameView:not([hidden])) .shell .quest h2{font:10px/1.4 Georgia;margin:0;color:#e9d5a5}
body:has(#gameView:not([hidden])) .shell .quest p{display:none}
body:has(#gameView:not([hidden])) .shell .questButtons{display:flex;gap:4px}
body:has(#gameView:not([hidden])) .shell .quest .journalButton{min-height:36px;padding:5px;border:1px solid #958159;background:#282c21cc;color:#e8d9b3;border-radius:2px;font:9px system-ui}
body:has(#gameView:not([hidden])) .shell .bottom{position:absolute;inset:auto 12px max(32px,env(safe-area-inset-bottom));height:148px;width:auto!important;margin:0;padding:0;display:block;background:none;border:0;pointer-events:none;z-index:8}
body:has(#gameView:not([hidden])) .bottom .hint{display:none}
body:has(#gameView:not([hidden])) .shell .touchBar{display:flex;flex-direction:row;justify-content:space-between;align-items:flex-end;height:100%;width:100%;gap:8px;padding:0;flex-wrap:nowrap}
body:has(#gameView:not([hidden])) .shell .controls{position:relative;display:grid;grid-template-columns:repeat(3,44px);grid-template-rows:repeat(3,44px);gap:0;width:144px;height:144px;padding:4px;border:2px solid #ae8d53;border-radius:50%;background:radial-gradient(circle,#443d28 0 18%,#1c221e 19% 34%,#796440b0 35% 62%,#292b20d9 63%);box-shadow:0 3px 14px #0007,inset 0 0 0 4px #332c1d;pointer-events:auto}
body:has(#gameView:not([hidden])) .shell .controls:after{content:'';position:absolute;inset:53px;border-radius:50%;background:radial-gradient(at 30% 25%,#c4a66d,#5b4628);border:1px solid #b29661;pointer-events:none}
body:has(#gameView:not([hidden])) .shell .controls button{width:44px;height:44px;min-height:44px;padding:0;border:0;border-image:none;border-radius:50%;background:none;color:#e1c98e;font:18px Georgia;touch-action:none;box-shadow:none}
body:has(#gameView:not([hidden])) .shell .controls button:active{background:#d1b47b55}
.shell .controls .northwest{grid-column:1;grid-row:1}.shell .controls .up{grid-column:2;grid-row:1}.shell .controls .northeast{grid-column:3;grid-row:1}.shell .controls .left{grid-column:1;grid-row:2}.shell .controls .right{grid-column:3;grid-row:2}.shell .controls .southwest{grid-column:1;grid-row:3}.shell .controls .down{grid-column:2;grid-row:3}.shell .controls .southeast{grid-column:3;grid-row:3}
body:has(#gameView:not([hidden])) .shell .actions{display:flex;flex-direction:column;align-items:flex-end;gap:7px;width:158px;margin:0;pointer-events:auto}
body:has(#gameView:not([hidden])) .shell .combatActions{display:flex;align-items:flex-end;gap:8px}
body:has(#gameView:not([hidden])) .shell .utilityActions{display:flex;gap:5px;flex-wrap:nowrap}
body:has(#gameView:not([hidden])) .shell .actions button{border-image:none;border:1px solid #b29258;border-radius:3px;background:linear-gradient(135deg,#685637e8,#2c3024ee);color:#f7e4b7;box-shadow:inset 0 0 0 2px #262a22,0 3px 8px #0008;min-height:44px;font:bold 10px system-ui;touch-action:none}
body:has(#gameView:not([hidden])) .shell #attack{width:84px;height:84px;border-radius:50%;background:radial-gradient(#84704a,#453925 65%,#252a21 68%);font:bold 11px system-ui}
body:has(#gameView:not([hidden])) .shell #skillButton{width:62px;height:62px;min-height:62px}
body:has(#gameView:not([hidden])) .shell .utilityActions button{width:49px;height:44px;padding:2px}
body:has(#gameView:not([hidden])) .shell .toast{bottom:195px;max-width:min(90%,460px);border-image:none;border:1px solid #aa8a54;background:#1c2119ef}
body[data-control-side="left"]:has(#gameView:not([hidden])) .shell .touchBar{flex-direction:row-reverse;justify-content:space-between}
@media(orientation:landscape){body:has(#gameView:not([hidden])) .shell .hud .quest{width:230px;max-width:230px}body:has(#gameView:not([hidden])) .shell .hudSide{width:215px}body:has(#gameView:not([hidden])) .shell .bottom{bottom:25px}}
@media(max-width:360px){body:has(#gameView:not([hidden])) .shell .hudSide{width:165px}body:has(#gameView:not([hidden])) .shell .hud .quest{max-width:calc(100vw - 192px)}body:has(#gameView:not([hidden])) .shell .bottom{left:5px;right:5px}}
</style><style id="playthrough-fixes">
#travelDestinations>.atlasHint:first-child button{min-height:44px;padding:9px 12px;margin:4px 4px 4px 0;border:1px solid #b29662;border-radius:5px;background:linear-gradient(#4a5035,#263325);color:#f2dfb5;font:600 12px system-ui;touch-action:manipulation}
