#travelScreen #atlasSelection{position:absolute;right:10px;bottom:66px;z-index:8;width:280px;max-width:calc(100% - 20px);max-height:26dvh;overflow:auto;box-sizing:border-box;padding:10px;background:#20343ceF;color:#f6e5bd;border:1px solid #c5b689;border-radius:4px;font:13px/1.4 Georgia;margin:0}
#travelScreen .screenFoot{display:block!important;position:absolute;right:10px;bottom:10px;z-index:8;padding:0;background:none;border:0}
#travelScreen .screenFoot span{display:none}#travelScreen .screenFoot button{min-height:48px;min-width:180px;font:19px Georgia;padding:8px 20px;color:#fff4d9;background:linear-gradient(#748e9c,#425d6b);border:2px solid #b6c2bf;border-radius:3px}
@media(orientation:portrait){#travelScreen .atlasToolbar{top:82px;bottom:auto;max-width:calc(100% - 16px)}#travelScreen .atlasRoutes{top:auto;bottom:10px;right:auto;left:8px;max-width:calc(100% - 210px)}#travelScreen .atlasRoutes summary{font-size:10px}#travelScreen .screenMeta{font-size:10px}#travelScreen #atlasSelection{max-height:22dvh}}
</style><style id="simpleOptionsMenu">
#optionsMenu{width:min(520px,100vw)!important;max-width:100vw!important;top:0!important;bottom:0!important;right:0!important;max-height:100dvh!important;border-radius:0!important;padding:12px!important;overflow-y:auto}
