<style id="fullscreenWorldMap">
#travelScreen{padding:0!important;background:#b6b48d}
#travelScreen .worldPanel{position:relative;width:100%!important;max-width:none!important;height:100dvh!important;max-height:100dvh!important;border:0;border-radius:0;box-shadow:none;overflow:hidden}
#travelScreen .travelDestinations{position:absolute;inset:0;padding:0!important;gap:0;display:block;overflow:hidden}
#travelScreen .atlasScroller{position:absolute;inset:0;border:0;border-radius:0;box-shadow:none;overflow:auto;touch-action:pan-x pan-y;scrollbar-width:thin}
#travelScreen .atlasView{margin:0 auto;max-height:none!important}
#travelScreen .screenHead{position:absolute;top:8px;left:8px;right:8px;z-index:8;padding:0;background:none;border:0;pointer-events:none;align-items:flex-start}
#travelScreen .screenHead>div{padding:7px 12px;background:#172a26e8;border:1px solid #c8b57b;border-radius:4px}
