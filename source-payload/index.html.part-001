#travelScreen .atlasOverview .atlasTown .mapName,#travelScreen .atlasOverview [data-travel-to=frontier_outpost] .mapName,#travelScreen .atlasOverview [aria-current=location] .mapName{font:700 10px Georgia,serif;background:#f1e1b9eF;color:#402f20;border:1px solid #9e8358;border-radius:3px;box-shadow:0 1px 3px #4b392b44;padding:3px}
#travelScreen .atlasOverview [aria-current=location]{background:#238c9b;outline:2px solid #f6f2d4}
#travelScreen #atlasSelection{color:#ded2b2;font:10px/1.4 system-ui;padding:3px 5px}
#travelScreen .screenFoot{background:#1c2b22;color:#cbbf9f}
@media(orientation:landscape) and (max-height:560px){#optionsMenu{padding:10px 14px}.atlasToolbar button{min-height:44px}#optionsMenu .optionsTitle{font-size:22px}}
