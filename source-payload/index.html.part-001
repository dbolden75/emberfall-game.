body:has(#characterSetup:not([hidden])){background:radial-gradient(ellipse at top,#2e3527,transparent 70%),#111710}
#characterSetup.setup{border:2px solid #796742!important;border-radius:5px;box-shadow:0 0 0 3px #11170f,0 0 0 4px #504932,0 20px 70px #000b}
.openingHero{background:linear-gradient(#0b160fcc,#0c1b1133 48%,#0b170dcf),url('assets/ashvale-opening.webp') center 58%/cover;border-right:2px solid #796742}
.openingHero svg{display:none}
.openingHeroText{text-shadow:0 2px 5px #000}
.openingTitle{font-size:64px;letter-spacing:.06em;color:#ddc58c;text-shadow:2px 3px #1a2515,0 0 20px #000;margin-top:32px}
.openingCreate{background:repeating-linear-gradient(90deg,#d5c08b03 0 1px,transparent 1px 7px),repeating-linear-gradient(0deg,#00000008 0 2px,transparent 2px 5px),linear-gradient(130deg,#2a3322,#192318)}
#characterSetup h1{color:#dbc795}
#characterSetup .classCard{border:1px solid #706948!important;border-radius:3px!important;grid-template-columns:54px minmax(0,1fr);background:linear-gradient(135deg,#303a25,#1e291c);box-shadow:inset 0 0 0 2px #131d1444;min-height:138px}
#characterSetup .classPortrait{transform:none;justify-self:center}
#characterSetup .classPick input:checked+.classCard{border-color:#c6ae70!important;background:linear-gradient(135deg,#4b5030,#303d25)!important;box-shadow:inset 0 0 0 2px #c6ae7033,0 0 12px #d9b9740d}
#characterSetup .genderPick span{border-radius:3px;background:#26311f;border-color:#6b6b48}
#characterSetup input[type=text]{background:#131e12;border-color:#646443;border-radius:3px}
#characterSetup .startButton{background:linear-gradient(#8d7946,#655b32)!important;color:#fff1c4;border-color:#bba568!important;border-radius:3px;box-shadow:inset 0 0 0 2px #231f1033,0 3px 12px #0005;text-shadow:0 1px #000}
.openingFooter{color:#c9b788;text-shadow:0 2px 4px #000}
@media(max-width:720px){.openingHero{border-right:0;border-bottom:2px solid #796742;background-position:center 60%;min-height:250px}.openingTitle{font-size:clamp(30px,9vw,43px);margin:16px 0 8px}#characterSetup .classCard{grid-template-columns:42px minmax(0,1fr);min-height:142px}#characterSetup .classPortrait{transform:none}.openingCreate{padding:22px 16px}}
