<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<link rel="icon" href="data:,">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#151d1b">
<!-- Battle art: Tiny Questers by bobddadoo, free commercial use; Pixel Magic Effects by Foozle/lordfitoi, CC0. Embedded for offline play. -->
<title>Thornhaven: Ashvale Reach</title>
<style>
:root{color-scheme:dark;--ink:#f3ecd9;--muted:#b8b39e;--gold:#edc874;--panel:#151d1be8;--edge:#63735a}
*{box-sizing:border-box}*{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
input,textarea,[contenteditable="true"]{-webkit-user-select:text;user-select:text}button,.touchBar,.touchBar *{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}body{margin:0;background:#101613;color:var(--ink);font:15px/1.4 Georgia,serif;min-height:100dvh;display:grid;place-items:center}
.shell{width:min(1100px,100vw);padding:14px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 10px}.brand{font-size:clamp(18px,3vw,27px);letter-spacing:.08em;color:#f5dda5}.brand small{display:block;font:11px/1.3 system-ui,sans-serif;color:var(--muted);letter-spacing:.18em;text-transform:uppercase}
.status{display:flex;gap:12px;align-items:center;font:12px system-ui,sans-serif;color:var(--muted)}.pill{border:1px solid #52624d;background:#1b261f;padding:6px 10px;border-radius:999px}.game{position:relative;border:1px solid #596a51;background:#1a251d;box-shadow:0 18px 55px #0008;overflow:hidden;border-radius:12px;touch-action:none}
canvas{display:block;width:100%;height:auto;aspect-ratio:16/10;image-rendering:pixelated}
.hud{position:absolute;inset:12px 12px auto 12px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px;pointer-events:none}.hud button{pointer-events:auto;touch-action:manipulation}.card{align-self:flex-start;background:var(--panel);border:1px solid #647458;border-radius:9px;padding:9px 11px;backdrop-filter:blur(4px);max-width:250px}.quest h2{font-size:13px;color:var(--gold);margin:0 0 4px;letter-spacing:.08em;text-transform:uppercase}.quest p{font:12px/1.4 system-ui,sans-serif;color:#ded9c7;margin:0}.stats{min-width:145px;font:12px system-ui,sans-serif}.bar{height:8px;background:#503a32;border-radius:8px;overflow:hidden;margin-top:6px}.fill{height:100%;width:100%;background:linear-gradient(90deg,#b9403d,#e47754);transition:width .15s}.xpbar{height:4px;background:#9f7c36;width:0%;margin-top:5px}.toast{position:absolute;left:50%;top:auto;bottom:30px;transform:translateX(-50%);background:#111b18eF;border:1px solid var(--gold);border-radius:10px;padding:8px 12px;text-align:center;color:#f7e3ae;max-width:min(80%,320px);opacity:0;transition:opacity .25s;pointer-events:none;font-size:13px}.toast.show{opacity:1}
.bottom{display:flex;flex-direction:column;align-items:stretch;margin-top:8px;gap:7px}.hint{color:var(--muted);font:12px/1.4 system-ui,sans-serif}.touchBar{display:flex;justify-content:space-between;align-items:center;gap:8px}.controls{display:grid;grid-template-columns:repeat(3,44px);grid-template-rows:repeat(2,40px);gap:3px;user-select:none;flex:0 0 auto}.controls button{border:1px solid #627456;border-radius:10px;background:#233128eF;color:var(--ink);font-size:19px;touch-action:none}.controls .up{grid-column:2}.controls .left{grid-column:1;grid-row:2}.controls .down{grid-column:2;grid-row:2}.controls .right{grid-column:3;grid-row:2}.actions{display:flex;align-items:center;gap:6px}.attack,.interact{display:block;border:1px solid #bd744a;border-radius:50%;width:62px;height:62px;padding:2px;background:#693c32eF;color:#fff0da;font:bold 10px/1.1 system-ui,sans-serif;touch-action:none;flex:0 0 auto}.interact{border-color:#93a776;background:#334936eF;color:#f1f5d9}
@media (pointer:coarse){.shell{padding:7px}.hud{inset:7px}.card{padding:7px 8px}.quest{max-width:195px}.stats{min-width:112px}}
@media(max-width:520px){.status .pill:last-child{display:none}.card{padding:6px 7px}.quest p{font-size:10px}.stats{font-size:10px}.hud{gap:5px}.controls{grid-template-columns:repeat(3,42px);grid-template-rows:repeat(2,38px)}.attack,.interact{width:58px;height:58px;font-size:9px}.toast{bottom:27px;padding:7px 10px;font-size:12px}}
.setup{width:min(760px,100%);margin:20px auto;padding:22px;background:#151d1beF;border:1px solid #63735a;border-radius:14px;box-shadow:0 18px 55px #0008}.setup h1{margin:0 0 5px;color:#f5dda5;font-size:clamp(22px,5vw,32px)}.setup p{margin:0 0 16px;color:var(--muted);font:14px/1.5 system-ui,sans-serif}.setup label.nameLabel{display:block;margin:10px 0 5px;font:13px system-ui,sans-serif;color:var(--gold)}.setup input[type=text]{width:100%;padding:12px;border-radius:8px;border:1px solid #647458;background:#101613;color:var(--ink);font:16px system-ui,sans-serif}.classGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.classPick{display:block;position:relative;cursor:pointer}.classPick input{position:absolute;opacity:0}.classCard{height:100%;padding:12px;border:1px solid #52624d;border-radius:10px;background:#1b261f}.classPick input:checked+.classCard{border-color:var(--gold);box-shadow:inset 0 0 0 1px var(--gold);background:#302c20}.classCard b{display:block;color:#f5dda5;font-size:16px}.classCard span{display:block;margin-top:4px;color:#ded9c7;font:12px/1.4 system-ui,sans-serif}.startButton{width:100%;margin-top:16px;padding:13px;border:1px solid #d8b460;border-radius:9px;background:#76522e;color:#fff0da;font:bold 15px system-ui,sans-serif}.startButton:active{transform:translateY(1px)}

/* Kenney CC0 pixel interface */
.card,.setup,.classCard,.pill,.toast,.controls button,.attack,.interact,.startButton{border:6px solid transparent;border-image-source:url('data:image/png;base64,');border-image-slice:16;border-image-width:6px;border-image-repeat:stretch;border-radius:0;background-color:transparent;backdrop-filter:none}
.pill{border-width:5px;border-image-width:5px;padding:4px 8px}
.card{padding:7px 9px;background-color:#151d1bee}
.setup{padding:20px;background-color:#151d1bee}
.classCard{padding:8px;background-color:#1b261fee}
.classPick input:checked+.classCard{border-image-source:url('data:image/png;base64,');background-color:#302c20;box-shadow:none}
.controls button,.interact{background-color:#293a2d;border-image-source:url('data:image/png;base64,');color:#fff5d7}
.attack{background-color:#633c31;border-image-source:url('data:image/png;base64,');color:#fff5d7}
.startButton{border-image-source:url('data:image/png;base64,');color:#fff5d7;padding:8px}
.toast{background-color:#151d1bee;border-image-source:url('data:image/png;base64,');background-color:#151d1b;color:#fff0b2}


/* v1.4: keep the map clear; HUD sits in its own row. */
.game{display:flex;flex-direction:column}
.game[hidden],.setup[hidden],.bottom[hidden]{display:none!important}
.hud{position:static;inset:auto;order:-1;width:100%;display:flex;align-items:stretch;justify-content:space-between;gap:6px;padding:5px;pointer-events:none}
.hud .card{max-width:none;margin:0}
.hud .quest{flex:1;min-width:0}
.hud .stats{flex:0 0 35%;min-width:132px}
@media (orientation:landscape) and (max-height:560px) and (pointer:coarse){
 body{display:block;min-height:100dvh}
 .shell{width:100vw;height:100dvh;min-height:0;padding:4px;display:grid;grid-template-columns:minmax(0,1fr) 142px;grid-template-rows:38px minmax(0,1fr);gap:4px}
 .top{grid-column:1/-1;grid-row:1;min-width:0;margin:0;gap:5px}
 .brand{font-size:16px;white-space:nowrap}
 .brand small{font-size:7px;letter-spacing:.1em}
 .status{gap:3px;font-size:9px;white-space:nowrap}
 .status .pill{padding:3px 5px}
 .status .pill:last-child{display:none}
 .setup{grid-column:1/-1;grid-row:2;width:min(640px,100%);max-height:100%;overflow:auto;align-self:center;margin:auto;padding:8px}
 .setup h1{font-size:18px;margin-bottom:2px}
 .setup p{font-size:10px;line-height:1.25;margin:0 0 4px}
 .setup label.nameLabel{font-size:10px;margin:4px 0 2px}
 .setup input[type=text]{padding:6px;font-size:13px}
 .classGrid{gap:4px}
 .classCard{padding:5px}
 .classCard b{font-size:12px}
 .classCard span{font-size:9px;line-height:1.2;margin-top:2px}
 .startButton{margin-top:6px;padding:6px}
 .game{grid-column:1;grid-row:2;height:100%;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);align-self:stretch}
 .hud{grid-row:1;order:initial;position:static;inset:auto;width:100%;gap:4px;padding:0 0 3px}
 .hud .card{padding:3px 5px;border-width:4px;border-image-width:4px}
 .hud .quest{flex:1;min-width:0}
 .quest h2{font-size:9px;margin:0 0 1px}
 .quest p{font-size:8px;line-height:1.15}
 .hud .stats{flex:0 0 132px;width:132px;min-width:0;font-size:8px}
 .bar{height:5px;margin-top:1px}
 .xpbar{height:3px;margin-top:1px}
 canvas{grid-column:1;grid-row:2;display:block;width:100%;height:auto;max-height:100%;min-height:0;aspect-ratio:16/10;align-self:center;justify-self:center}
 .toast{bottom:5px;padding:4px 6px;font-size:9px}
 .bottom{grid-column:2;grid-row:2;min-height:0;margin:0;justify-content:center;gap:3px}
 .hint{display:none}
 .touchBar{height:100%;flex-direction:column;justify-content:center;gap:7px}
 .controls{grid-template-columns:repeat(3,34px);grid-template-rows:repeat(2,32px);gap:2px}
 .controls button{font-size:14px}
 .actions{flex-direction:column;gap:4px}
 .attack,.interact{width:62px;height:52px;font-size:9px}
}


/* v1.4 control-side options */
.optionsToggle,.sideChoices button,.optionsDone{border:1px solid #87976a;border-radius:8px;background:#26362b;color:#f5dda5;font:bold 11px system-ui,sans-serif;padding:7px 9px;touch-action:manipulation}
.optionsToggle{flex:0 0 auto;white-space:nowrap}
.optionsToggle[aria-expanded="true"],.sideChoices button[aria-pressed="true"]{background:#594b2c;border-color:#edc874;color:#fff0b2}
.optionsMenu{position:fixed;z-index:40;top:72px;right:12px;width:min(240px,calc(100vw - 24px));}
.optionsMenu[hidden]{display:none!important}
.optionsCard{padding:13px;background:#151d1b;border:2px solid #8a9a74;box-shadow:0 12px 32px #000b}
.optionsTitle{color:#edc874;font:bold 14px Georgia,serif;letter-spacing:.08em}
.optionsLabel{margin:9px 0 5px;font:12px system-ui,sans-serif;color:#ded9c7}
.sideChoices{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.sideChoices button{padding:10px}
.optionsCard>button:not(.optionsDone){display:block;width:100%;margin-top:8px;border:1px solid #87976a;border-radius:8px;background:#26362b;color:#f5dda5;font:bold 11px system-ui,sans-serif;padding:9px;touch-action:manipulation}.optionsDone{width:100%;margin-top:9px}
@media(max-width:520px){.status .autosavePill{display:none}.optionsToggle{padding:5px 6px;font-size:9px}.optionsMenu{top:58px;right:8px}}
@media (orientation:landscape) and (max-height:560px) and (pointer:coarse){
 .status .autosavePill{display:none}
 .optionsToggle{padding:4px 6px;font-size:9px}
 .optionsMenu{top:44px;right:8px;width:min(205px,calc(100vw - 16px))}
 .touchBar{justify-content:flex-end}
 body[data-control-side="left"] .shell{grid-template-columns:142px minmax(0,1fr)}
 body[data-control-side="left"] .game{grid-column:2}
 body[data-control-side="left"] .bottom{grid-column:1}
 body[data-control-side="left"] .touchBar{justify-content:center}
}
body[data-control-side="left"] .touchBar{justify-content:flex-start}
body[data-control-side="right"] .touchBar{justify-content:flex-end}


.inventoryButton,.screenTabs button,.screenFoot button,.screenClose,.itemAction{border:1px solid #8a9a74;border-radius:8px;background:#26362b;color:#f3ecd9;font:bold 11px system-ui,sans-serif;padding:7px;touch-action:manipulation}
.inventoryButton{width:58px;height:58px;flex:0 0 auto}
.screenShade{position:fixed;inset:0;z-index:1000;background:#080e0ddd;display:grid;place-items:center;padding:8px}
.screenShade[hidden]{display:none!important}
.screenPanel{width:min(590px,100%);max-height:calc(100dvh - 16px);display:flex;flex-direction:column;overflow:hidden;background:#151d1b;border:2px solid #8a9a74;box-shadow:0 18px 48px #000b}
.screenHead{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;border-bottom:1px solid #52624d}
.screenHead h2{margin:0;color:#f5dda5;font: bold 20px Georgia,serif}.screenHead p{margin:2px 0 0;color:#b8b39e;font:11px system-ui,sans-serif}
.screenClose{width:36px;height:36px;font-size:22px;padding:0}.screenPanel button{touch-action:manipulation;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
.screenMeta{display:flex;justify-content:space-between;gap:8px;padding:7px 12px;color:#edc874;font:11px system-ui,sans-serif;border-bottom:1px solid #303c31}
.screenTabs{display:flex;gap:5px;padding:7px 10px 3px}.screenTabs button{flex:1;min-height:36px}.screenTabs button[aria-pressed="true"]{background:#594b2c;border-color:#edc874;color:#fff0b2}
.screenNotice{min-height:20px;padding:2px 12px;color:#f2d78e;font:11px system-ui,sans-serif}
.itemList{overflow:auto;overscroll-behavior:contain;padding:0 9px 8px;min-height:54px}
.itemRow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;padding:8px 7px;border-top:1px solid #344234}
.itemInfo{min-width:0}.itemName{color:#f3ecd9;font:bold 13px system-ui,sans-serif}.itemCount{color:#edc874;font-weight:normal}.itemDescription{margin-top:3px;color:#bbb8a7;font:10px/1.25 system-ui,sans-serif}
.itemActions{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end}.itemAction{min-height:34px;min-width:54px;padding:5px 7px}.itemAction.buy{border-color:#9cb979;color:#f0f6d8}.itemAction.sell{border-color:#c47b58}.itemAction.unavailable{opacity:.52;border-style:dashed}
.emptyInventory{padding:18px 8px;text-align:center;color:#b8b39e;font:12px system-ui,sans-serif}
.screenFoot{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 10px;border-top:1px solid #52624d;color:#a9aa96;font:10px system-ui,sans-serif}
.screenFoot button{min-height:34px;white-space:nowrap}
.characterSummary{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid #303c31;color:#edc874;font:11px system-ui,sans-serif}.characterSummary strong{display:block;color:#f5dda5;font:bold 16px Georgia,serif}.gearLayout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:8px;min-height:0;flex:1;padding:8px;overflow:hidden}.gearSlots{display:grid;align-content:start;gap:7px;overflow:auto}.gearSlot{display:grid;grid-template-columns:36px minmax(0,1fr) auto;align-items:center;gap:7px;padding:7px;border:1px solid #52624d;background:#1b261f;color:#c8c5b5;font:10px system-ui,sans-serif}.gearSlotIcon{display:grid;place-items:center;width:34px;height:34px;background:#26332a;border:1px solid #667453;color:#f5dda5;font-size:20px}.gearSlot b{display:block;color:#f3ecd9;font-size:11px}.gearSlot button{border:1px solid #8a9a74;border-radius:7px;background:#26362b;color:#f3ecd9;padding:6px;font:bold 10px system-ui,sans-serif}.characterGear{display:flex;flex-direction:column;min-height:0;border:1px solid #344234;background:#111a16}.characterGear h3{margin:0;padding:7px;color:#f5dda5;font:bold 12px system-ui,sans-serif}.characterGear .itemList{flex:1}.characterButton{width:58px;height:58px;flex:0 0 auto}
body.panel-open #controlRow{pointer-events:none;opacity:.35}
@media(max-width:520px){.screenShade{padding:5px}.screenPanel{max-height:calc(100dvh - 10px)}.screenHead{padding:6px 8px}.screenHead h2{font-size:17px}.screenMeta{padding:5px 8px;font-size:9px}.screenTabs{padding:5px 7px 2px}.screenTabs button{min-height:32px;padding:5px;font-size:10px}.screenNotice{min-height:16px}.itemList{padding:0 6px 5px}.itemRow{padding:6px 4px;gap:4px}.itemName{font-size:11px}.itemDescription{font-size:9px}.itemAction{min-width:46px;padding:4px;font-size:9px}.screenFoot{padding:5px 7px}.inventoryButton,.characterButton{width:54px;height:58px}.characterSummary{padding:5px 8px}.gearLayout{gap:5px;padding:5px}.gearSlot{grid-template-columns:30px minmax(0,1fr) auto;gap:4px;padding:5px}.gearSlotIcon{width:28px;height:28px;font-size:17px}.gearSlot button{padding:5px;font-size:9px}.characterGear h3{padding:5px;font-size:11px}}
@media (orientation:landscape) and (max-height:560px) and (pointer:coarse){.screenShade{padding:4px}.screenPanel{width:min(620px,100%);max-height:calc(100dvh - 8px)}.screenHead{padding:5px 9px}.screenHead h2{font-size:16px}.screenMeta{padding:4px 9px;font-size:9px}.screenTabs{padding:4px 8px 1px}.screenTabs button{min-height:28px;padding:3px}.screenNotice{min-height:15px}.itemRow{padding:4px 5px}.itemName{font-size:10px}.itemDescription{font-size:8px}.itemAction{min-height:28px;padding:3px 5px;font-size:9px}.screenFoot{padding:4px 8px}.inventoryButton{width:62px;height:52px}}


.questTitleRow{display:flex;align-items:center;justify-content:space-between;gap:8px}.questTitleRow h2{margin:0}.journalButton{flex:none;border:1px solid #bba66e;border-radius:8px;background:#24352c;color:#f4e7bb;padding:7px 9px;font-size:11px;font-weight:800;letter-spacing:.04em}.questList{display:grid;gap:10px;padding:12px;flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;-webkit-overflow-scrolling:touch}#questScreen .screenHead,#questScreen .screenNotice,#questScreen .screenFoot{flex-shrink:0}.questEntry{border:1px solid #756b4e;border-radius:10px;background:#17221e;padding:12px}.questEntry h3{margin:0 0 6px;color:#e8ca79;font:700 17px Georgia,serif}.questEntry p{margin:4px 0;color:#ded9c6;font-size:13px}.questEntry .questReward{color:#c8b77e;font-size:12px}.questEntry.active{border-color:#d2b566}.questEntry.complete{opacity:.76}.questState{float:right;color:#c6d9a0;font-size:11px;text-transform:uppercase;letter-spacing:.06em}

.setupSaveButton{display:block;margin:12px auto 0;border:1px solid #8a9a74;border-radius:9px;background:#26362b;color:#f3ecd9;padding:10px 14px;font-weight:800}.saveSlotList{display:grid;gap:9px;overflow:auto;padding:10px}.saveSlot{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px;border:1px solid #596a51;border-radius:10px;background:#18221e;padding:11px}.saveSlot.current{border-color:#edc874}.saveSlotName{font:bold 15px Georgia,serif;color:#f3ecd9}.saveSlotMeta{font:11px system-ui,sans-serif;color:#b8b39e;margin-top:3px}.saveSlotActions{display:flex;gap:6px}.saveSlotActions button{min-height:36px;padding:6px 9px;border:1px solid #8a9a74;border-radius:8px;background:#26362b;color:#f3ecd9;font-weight:800}.saveSlotActions .deleteSlot{border-color:#a75d4a;color:#f0c2ad}.saveEmpty{color:#b8b39e;font:12px system-ui,sans-serif}

/* Companion party and equipment panel */
.partyPanel{width:min(880px,100%);height:min(88dvh,620px)}.partyLayout{display:grid;grid-template-columns:minmax(190px,.72fr) minmax(0,1.28fr);gap:9px;flex:1;min-height:0;padding:9px}.partyRoster,.partyGear{display:flex;flex-direction:column;min-height:0;overflow:auto;border:1px solid #52624d;background:#111a16}.partyRoster h3,.partyGear h3{margin:0;padding:8px;color:#f5dda5;font:bold 11px system-ui,sans-serif;border-bottom:1px solid #344234}.partyMember{padding:8px;border-bottom:1px solid #344234;color:#d8d4c2;font:11px system-ui,sans-serif}.partyMember.selected{background:#29291f;border-left:3px solid #edc874}.partyMemberHead{display:flex;justify-content:space-between;gap:4px;align-items:center}.partyMemberHead strong{color:#f3ecd9;font-size:12px}.partyMemberActions{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px}.partyMember button,.partyEquipSlot button{border:1px solid #7b895f;border-radius:6px;background:#26362b;color:#f3ecd9;padding:5px 7px;font:bold 9px system-ui,sans-serif}.partyEquipSlot{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:5px;padding:6px 8px;border-bottom:1px solid #344234;color:#e7dfc5;font:10px system-ui,sans-serif}.partyEquipSlot strong{color:#f5dda5}.partyGear .itemList{flex:1}.partyEmpty{padding:12px;color:#b8b39e;font:11px/1.45 system-ui,sans-serif}@media(max-width:620px){.partyPanel{height:min(94dvh,760px)}.partyLayout{grid-template-columns:1fr;grid-template-rows:minmax(110px,.7fr) minmax(0,1.3fr);gap:5px;padding:5px}.partyRoster h3,.partyGear h3{padding:5px;font-size:10px}.partyMember{padding:5px}.partyMemberActions{margin-top:3px}}

/* Home storage chest panel */
.storagePanel{width:min(760px,100%);height:min(84dvh,560px)}.storageLayout{display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:1;min-height:0;padding:10px}.storageColumn{display:flex;flex-direction:column;min-height:0;border:1px solid #52624d;background:#111a16}.storageColumn h3{margin:0;padding:8px;color:#f5dda5;font:bold 12px system-ui,sans-serif;border-bottom:1px solid #344234}.storageColumn .itemList{flex:1}.storageColumn .itemRow{grid-template-columns:minmax(0,1fr) auto}.storageColumn .itemAction{font-size:10px;min-width:60px}@media(max-width:620px){.storageLayout{gap:5px;padding:5px}.storageColumn h3{padding:5px;font-size:10px}.storageColumn .itemRow{grid-template-columns:1fr;gap:3px}.storageColumn .itemActions{justify-content:flex-start}.storageColumn .itemAction{min-width:52px;padding:4px;font-size:9px}}

/* v1.4 inventory: equipment slots, item grid, and tap-to-inspect detail card. */
#inventoryScreen .inventoryPanel{width:min(920px,100%);height:min(92dvh,640px);max-height:calc(100dvh - 16px);background:#111914;border-color:#7b8058}
.inventoryTabs button{font-size:12px;letter-spacing:.02em}
.inventoryMeta{display:flex;justify-content:space-between;gap:8px;padding:6px 12px;color:#edc874;font:bold 11px system-ui,sans-serif;border-bottom:1px solid #303c31}
.inventoryLayout{display:grid;grid-template-columns:minmax(200px,.74fr) minmax(0,1.26fr);gap:8px;flex:1;min-height:0;padding:8px}
.inventoryHero,.inventoryPack{min-width:0;min-height:0;background:#18211b;border:1px solid #566247}
.inventoryHero{display:flex;flex-direction:column;gap:6px;padding:7px;overflow:auto}
.inventoryHeroTitle,.inventoryPackHead{display:flex;justify-content:space-between;align-items:center;color:#edc874;font:bold 11px system-ui,sans-serif;letter-spacing:.08em}
.inventoryVitals{min-width:0;overflow-wrap:anywhere;padding:7px;background:#101712;border:1px solid #3f4b39;font:10px system-ui,sans-serif;color:#c8c5b5}
.inventoryVitals strong{display:block;color:#f5dda5;font:bold 15px Georgia,serif}
.inventoryVitals>span{white-space:normal;display:block;margin:1px 0 7px;color:#b8b39e}
.inventoryVital,.inventoryAttack{display:flex;justify-content:space-between;gap:6px;margin-top:3px}
.inventoryVital b,.inventoryAttack b{color:#f2e7c9}
.inventoryVitalBar{height:7px;margin-top:4px;background:#49342c;border:1px solid #665347}
.inventoryVitalBar i{display:block;width:100%;height:100%;background:linear-gradient(90deg,#9b3633,#dc6d4b)}
.inventoryGearSlots{display:grid;grid-template-columns:1fr;gap:5px}
.inventoryGearSlot{display:grid;grid-template-columns:36px minmax(0,1fr);gap:6px;align-items:center;min-height:44px;padding:4px;background:#202b22;border:1px solid #58634b;color:#a9aa96;text-align:left}
.inventoryGearSlot .slotIcon{display:grid;place-items:center;width:34px;height:34px;background:#121a15;border:1px solid #6e7553;color:#f4dda5;font-size:21px}
.inventoryGearSlot b{display:block;color:#f3ecd9;font:bold 10px system-ui,sans-serif}
.inventoryGearSlot span:last-child{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:9px system-ui,sans-serif}
.inventoryGearSlot.equipped{border-color:#b69a50}
.inventoryPack{display:flex;flex-direction:column}
.inventoryPackHead{padding:7px 8px;border-bottom:1px solid #3f4b39}
.inventoryPackHead span{color:#a9aa96;font:9px system-ui,sans-serif;letter-spacing:normal}
.itemGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-content:start;gap:4px;overflow:auto;overscroll-behavior:contain;padding:6px}
.itemTile,.emptyItemTile{position:relative;display:flex;min-width:0;min-height:58px;flex-direction:column;justify-content:center;align-items:center;gap:2px;padding:4px;background:#222c23;border:1px solid #57634a;color:#f1e7cb;text-align:center}
.itemTile{touch-action:manipulation}
.itemTile:active{background:#3c3a27;border-color:#edc874}
.itemTile.equipped{border:2px solid #e3bb5e;background:#363324}
.itemTileIcon{font-size:25px;line-height:1}
.itemTileName{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:9px system-ui,sans-serif}
.itemTileCount{position:absolute;right:3px;top:2px;padding:1px 4px;background:#111914ef;color:#f7e3ae;font:bold 9px system-ui,sans-serif}
.emptyItemTile{min-height:58px;background:#111813;border:1px solid #29342b;box-shadow:inset 0 0 0 1px #1a231b}
.itemDetailShade{position:fixed;inset:0;z-index:1010;display:grid;place-items:center;padding:12px;background:#080e1dcc}
.itemDetailShade[hidden]{display:none!important}
.itemDetailCard{width:min(440px,100%);background:#24291e;border:3px solid #897b4f;box-shadow:0 16px 48px #000d;color:#f3ecd9}
.itemDetailHead{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;border-bottom:1px solid #5f6045}
.itemDetailHead h3{margin:0;color:#fff0bf;font:bold 20px Georgia,serif}
.itemDetailBody{display:grid;grid-template-columns:100px minmax(0,1fr);gap:12px;padding:12px}
.itemDetailIcon{display:grid;place-items:center;min-height:100px;background:#141a14;border:2px solid #776b44;font-size:54px}
.itemDetailType{margin-bottom:5px;color:#edc874;font:bold 11px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.itemDetailStats{display:flex;flex-wrap:wrap;gap:5px}
.itemDetailStats span{padding:4px 6px;background:#121913;border:1px solid #526046;color:#eee2bf;font:10px system-ui,sans-serif}
.itemDetailInfo p{margin:8px 0 0;color:#c9c4af;font:12px/1.4 system-ui,sans-serif}
.itemDetailActions{display:flex;gap:7px;justify-content:flex-end;padding:0 12px 12px}
.itemDetailActions .itemAction{min-height:38px;min-width:72px}
@media(max-width:620px){#inventoryScreen .inventoryPanel{height:min(94dvh,760px)}.inventoryLayout{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);gap:5px;padding:5px}.inventoryHero{display:grid;grid-template-columns:minmax(95px,.8fr) minmax(0,1.5fr);grid-template-rows:auto 1fr;gap:4px;padding:5px}.inventoryHeroTitle{grid-column:1/-1}.inventoryVitals{grid-row:2}.inventoryGearSlots{grid-column:2;grid-row:2;grid-template-columns:repeat(3,minmax(0,1fr));align-content:start}.inventoryGearSlot{display:flex;min-height:0;flex-direction:column;gap:2px;padding:3px}.inventoryGearSlot .slotIcon{width:28px;height:26px;font-size:17px}.inventoryGearSlot b{font-size:8px}.inventoryGearSlot span:last-child{max-width:100%;font-size:8px}.itemGrid{grid-template-columns:repeat(5,minmax(0,1fr));gap:3px;padding:4px}.itemTile,.emptyItemTile{min-height:48px;padding:3px}.itemTileIcon{font-size:21px}.itemTileName{font-size:8px}.inventoryMeta{padding:4px 8px;font-size:9px}.inventoryTabs button{font-size:10px}.itemDetailBody{grid-template-columns:82px minmax(0,1fr);gap:8px;padding:9px}.itemDetailIcon{min-height:82px;font-size:44px}}
@media (orientation:landscape) and (max-height:560px) and (pointer:coarse){#inventoryScreen .inventoryPanel{height:calc(100dvh - 8px);max-height:calc(100dvh - 8px)}.inventoryLayout{grid-template-columns:minmax(180px,.68fr) minmax(0,1.32fr);gap:5px;padding:5px}.inventoryHero{gap:4px;padding:5px}.inventoryVitals{padding:5px}.inventoryGearSlots{gap:3px}.inventoryGearSlot{min-height:38px;padding:3px}.inventoryGearSlot .slotIcon{width:29px;height:29px}.itemGrid{grid-template-columns:repeat(5,minmax(0,1fr));gap:3px;padding:4px}.itemTile,.emptyItemTile{min-height:43px}.itemTileIcon{font-size:19px}.itemTileName{font-size:8px}.inventoryPackHead{padding:5px}.inventoryMeta{padding:4px 8px;font-size:9px}}


.questButtons{display:flex;align-items:center;gap:4px}
.worldPanel{width:min(760px,100%);height:min(82dvh,640px);max-height:calc(100dvh - 16px);min-height:0}
.travelDestinations{flex:1;overflow:auto;overscroll-behavior:contain;padding:8px 10px;min-height:0}
.worldMapView{position:relative;width:100%;height:100%;min-height:450px;max-height:620px;overflow:hidden;border:5px solid #87734b;box-shadow:inset 0 0 0 2px #dfc88f;background:#28575a}
.worldMapView:before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(ellipse at center,transparent 55%,#101a1980 100%)}
.worldMapRoads{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.worldMapRoads path{fill:none;stroke:#b49662;stroke-width:9;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 2px 2px #0009)}
.worldMapRoads path.secondary{stroke:#6c8055;stroke-width:6;stroke-dasharray:8 8}
.worldMapRoads .land{fill:url(#mapgrass);stroke:#d4bd83;stroke-width:16}.worldMapRoads .landInner{fill:url(#mapgrass);stroke:#566a43;stroke-width:4}
.worldMapRoads .river{fill:none;stroke:#4e9ca3;stroke-width:26;stroke-linecap:round;stroke-linejoin:round}.worldMapRoads .riverHighlight{fill:none;stroke:#8cc4b6;stroke-width:4;stroke-linecap:round;opacity:.7}
.worldMapRoads .road{fill:none;stroke:#b78c50;stroke-width:17;stroke-linecap:round;stroke-linejoin:round}.worldMapRoads .roadEdge{fill:none;stroke:#e0c17b;stroke-width:2;stroke-dasharray:5 8;stroke-linecap:round}
.worldMapRoads .mountain{fill:#8d8974;stroke:#d0c298;stroke-width:3}.worldMapRoads .mountainShade{fill:#5c6657}.worldMapRoads .tree{fill:#31563d;stroke:#819159;stroke-width:3}.worldMapRoads .marsh{fill:#48736a;stroke:#88a077;stroke-width:3}.worldMapRoads .water{fill:#35777b;opacity:.65}
.compass{position:absolute;right:10px;top:10px;width:76px;height:76px;border:1px solid #a9945f;border-radius:50%;background:#111a16d9;display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:1fr 1fr 1fr;place-items:center;color:#f2dea1;font:bold 12px system-ui,sans-serif;z-index:2}
.compass .north{grid-column:2;grid-row:1}.compass .west{grid-column:1;grid-row:2}.compass .rose{grid-column:2;grid-row:2;color:#d4aa53;font-size:18px}.compass .east{grid-column:3;grid-row:2}.compass .south{grid-column:2;grid-row:3}
.mapNode{position:absolute;z-index:2;transform:translate(-50%,-50%);width:17.5%;min-width:0;max-width:130px;min-height:58px;padding:4px 3px;border:2px solid #b89a5b;background:#263328ed;color:#f3ecd9;text-align:center;box-shadow:0 3px 8px #0009;font:9px/1.1 system-ui,sans-serif;touch-action:manipulation}
.mapNode .mapIcon{display:block;font-size:16px;line-height:1.1;color:#efd27d}.mapNode .mapName{display:block;font-weight:700;overflow-wrap:anywhere}.mapNode .mapKind{display:block;color:#c4beaa;font-size:8px;margin-top:2px}
.mapNode[aria-current="location"]{border-color:#f5d776;background:#524626;color:#fff4cb;box-shadow:0 0 0 2px #edc87466,0 4px 9px #0008}
.mapNode:disabled{opacity:.58;filter:saturate(.65)}.mapNode:active:not(:disabled){background:#705c30}
.mapLabel{position:absolute;z-index:2;color:#f2dea1;font:700 9px system-ui,sans-serif;letter-spacing:.12em;text-shadow:0 2px 3px #000;pointer-events:none}
.mapLabel.north{left:50%;top:3px;transform:translateX(-50%)}.mapLabel.south{left:50%;bottom:3px;transform:translateX(-50%)}.mapLabel.west{left:4px;top:50%;writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg)}.mapLabel.east{right:4px;top:50%;writing-mode:vertical-rl;transform:translateY(-50%)}
.travelGroup+.travelGroup{margin-top:10px}
.travelGroup h3{margin:0 0 5px;color:#edc874;font:bold 11px system-ui,sans-serif;letter-spacing:.1em}
.travelGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.travelChoice{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;align-items:center;min-height:54px;padding:7px 9px;background:#202a21;border:1px solid #566247;color:#f3ecd9;text-align:left}
.travelChoice strong{display:block;color:#f5dda5;font:bold 12px Georgia,serif}
.travelChoice small{display:block;margin-top:2px;color:#b8b39e;font:10px/1.3 system-ui,sans-serif}
.travelChoice .travelIcon{font-size:20px}
.travelChoice:active:not(:disabled){background:#393728;border-color:#edc874}
.travelChoice[aria-current="location"]{border-color:#e3bb5e;background:#343123}
.travelChoice:disabled{opacity:.55;filter:saturate(.65)}
@media(max-width:760px){body{display:block;overflow-x:hidden}.shell{width:100%;padding:7px}.top{align-items:flex-start;flex-wrap:wrap}.status{max-width:100%;flex-wrap:wrap;gap:5px}.game,.bottom{width:100%;min-width:0}.hud{min-width:0}.hud .stats{flex:0 0 34%;min-width:112px}.questButtons{flex-wrap:wrap}.touchBar{flex-wrap:wrap;justify-content:center}.actions{flex-wrap:wrap;justify-content:center;max-width:100%}}
 @media(max-width:520px){.worldPanel{height:min(92dvh,760px)}.travelDestinations{padding:5px}.travelGrid{grid-template-columns:1fr}.travelChoice{min-height:46px;padding:5px 7px}.worldPanel .screenMeta{font-size:9px}.questButtons{gap:2px}}


/* Mobile controls: a true four-way cross on the left, action cluster on the right. */
.controls{grid-template-columns:repeat(3,42px);grid-template-rows:repeat(3,42px);gap:2px}
.controls .up{grid-column:2;grid-row:1}
.controls .left{grid-column:1;grid-row:2}
.controls .down{grid-column:2;grid-row:3}
.controls .right{grid-column:3;grid-row:2}
.actions{display:grid;grid-template-columns:repeat(5,auto);align-items:center;gap:6px}
@media(max-width:520px){
 .touchBar{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:8px}
 .controls{grid-template-columns:repeat(3,40px);grid-template-rows:repeat(3,40px);gap:2px}
 .actions{grid-template-columns:repeat(2,minmax(42px,58px));justify-content:end;gap:5px}
 .inventoryButton{width:48px;height:48px}
 .attack,.interact{width:56px;height:56px}
}
@media (orientation:landscape) and (max-height:560px) and (pointer:coarse){
 .touchBar{height:100%;flex-direction:column;justify-content:center;gap:6px}
 .controls{grid-template-columns:repeat(3,32px);grid-template-rows:repeat(3,32px);gap:2px}
 .actions{grid-template-columns:repeat(2,48px);justify-content:center;gap:3px}
 .attack,.interact{width:46px;height:42px;font-size:8px}
 .actions .inventoryButton{width:44px;height:40px;font-size:9px}
}

/* Portrait phones: keep the map and the full control cluster in view. */
@media (max-width:520px) and (orientation:portrait){
 body{display:block;min-height:100dvh}
 .shell{padding:4px}
 .top{align-items:center;gap:4px;margin-bottom:4px}
 .brand{font-size:16px;letter-spacing:.04em;white-space:nowrap}
 .brand small{display:none}
 .status{gap:3px;flex-wrap:wrap;justify-content:flex-end}
 .status .pill{padding:3px 5px;font-size:9px}
 .optionsToggle{padding:4px 5px;font-size:9px}
 .hud{gap:3px;padding:3px}
 .hud .card{padding:4px 5px;border-width:4px;border-image-width:4px}
 .hud .stats{flex-basis:33%;min-width:0;font-size:9px}
 .quest h2{font-size:10px;margin-bottom:2px}
 .quest p{font-size:9px;line-height:1.2}
 .bar{height:5px;margin-top:3px}
 .bottom{margin-top:4px;gap:3px}
 .hint{display:none}
 .touchBar{gap:5px}
 .controls{grid-template-columns:repeat(3,36px);grid-template-rows:repeat(3,36px)}
 .actions{gap:3px}
 .attack,.interact{width:50px;height:50px;font-size:8px}
 .actions .inventoryButton{width:44px;height:44px;font-size:9px}
}

/* Fullscreen uses the available phone display for the game. */
.shell:fullscreen,.shell.appFullscreen{width:100vw;height:100dvh;max-width:none;padding:4px;display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:4px;background:#101613}
.shell:fullscreen .top,.shell.appFullscreen .top{margin:0;min-width:0;flex-wrap:nowrap}
.shell:fullscreen .game,.shell.appFullscreen .game{width:100%;min-height:0;align-self:center}
.shell:fullscreen .bottom,.shell.appFullscreen .bottom{margin:0;min-width:0}
.shell:fullscreen .hint,.shell.appFullscreen .hint{display:none}
.shell:fullscreen .touchBar,.shell.appFullscreen .touchBar{justify-content:space-between}
.shell:fullscreen canvas,.shell.appFullscreen canvas{max-height:calc(100dvh - 180px);width:100%;height:auto}
.shell:fullscreen .toast,.shell.appFullscreen .toast{bottom:8px}
@media (orientation:landscape) and (max-height:560px) and (pointer:coarse){
 .shell:fullscreen,.shell.appFullscreen{grid-template-columns:minmax(0,1fr) 142px;grid-template-rows:38px minmax(0,1fr)}
 .shell:fullscreen .top,.shell.appFullscreen .top{grid-column:1/-1;grid-row:1}
 .shell:fullscreen .game,.shell.appFullscreen .game{grid-column:1;grid-row:2}
 .shell:fullscreen .bottom,.shell.appFullscreen .bottom{grid-column:2;grid-row:2}
 .shell:fullscreen .touchBar,.shell.appFullscreen .touchBar{height:100%;flex-direction:column;justify-content:center}
 .shell:fullscreen canvas,.shell.appFullscreen canvas{max-height:100%}
}
.skillsPanel{width:min(660px,100%);max-height:calc(100dvh - 16px)}.gatheringSkillList{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;padding:12px;overflow:auto}.gatheringSkillCard{border:1px solid #596b50;border-radius:9px;background:#1b261f;padding:12px}.gatheringSkillCard h3{margin:0 0 8px;color:#f5dda5;font: bold 15px system-ui}.gatheringSkillCard p{margin:4px 0;color:#ded9c7;font:12px/1.4 system-ui}.skillTrack{height:8px;background:#393a2d;border-radius:8px;overflow:hidden;margin:8px 0}.skillTrack i{display:block;height:100%;background:linear-gradient(90deg,#688c54,#c4b45f)}@media(max-width:520px){.gatheringSkillList{grid-template-columns:1fr;gap:6px;padding:7px}.gatheringSkillCard{padding:8px}.gatheringSkillCard h3{font-size:13px}}
.combatButton{min-width:48px;min-height:44px;padding:5px;border:2px solid #bda572;border-radius:9px;background:#35444f;color:#fff0c4;font:bold 10px system-ui;touch-action:manipulation}.combatButton:disabled{opacity:.55} .actions{grid-template-columns:repeat(4,auto)}@media(max-width:760px){.actions{grid-template-columns:repeat(3,minmax(42px,58px));gap:3px}.combatButton{min-width:0}}
.adventureChoices{display:grid;gap:10px;padding:14px;overflow:auto}.adventureChoices button,.buildChoices button{padding:10px;border:1px solid #c4af74;border-radius:8px;background:#26362b;color:#f3ecd9;font:bold 12px system-ui}.buildChoices{display:flex;flex-wrap:wrap;gap:5px;align-items:center;padding:7px;color:#edc874;font:bold 10px system-ui}.buildChoices button{padding:7px;font-size:10px}.buildChoices button[aria-pressed=true]{background:#65522e;border-color:#ffe08a}
/* v1.81: fill the display with a responsive, undistorted world camera. */
body{display:block}
.shell,.shell:fullscreen,.shell.appFullscreen{width:100%;max-width:1400px;height:100dvh;margin:0 auto;padding:4px;display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto;gap:4px}
.shell .top{grid-column:1;grid-row:1;margin:0;min-width:0;gap:4px}
.shell .brand{font-size:16px;white-space:nowrap}.shell .brand small{display:none}
.shell .status{gap:3px;flex-wrap:wrap;justify-content:flex-end;font-size:10px}
.shell .status .pill{padding:3px 5px}.shell .autosavePill{display:none}
.shell .game,.shell:fullscreen .game,.shell.appFullscreen .game{grid-column:1;grid-row:2;align-self:stretch;display:grid;grid-template-rows:auto minmax(0,1fr);min-height:0;width:100%}
.shell canvas,.shell:fullscreen canvas,.shell.appFullscreen canvas{grid-column:1;grid-row:2;width:100%;height:100%;max-height:none;min-height:0;aspect-ratio:auto;align-self:stretch}
.shell .hud{grid-row:1;gap:3px;padding:3px;min-width:0}
.shell .hud .card{padding:3px 5px;border-width:3px;border-image-width:3px}
.shell .hud .stats{flex:0 0 112px;min-width:0;font-size:9px}
.shell .questTitleRow{gap:3px;flex-wrap:wrap}.shell .quest h2{font-size:10px;letter-spacing:.02em}
.shell .quest p{font-size:9px;line-height:1.15;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.shell .questButtons{display:flex;gap:3px}.shell .journalButton{padding:5px;font-size:9px}
.shell .bottom,.shell:fullscreen .bottom,.shell.appFullscreen .bottom{grid-column:1;grid-row:3;margin:0;min-height:0}
.shell .hint{display:none}.shell .touchBar{height:auto;display:flex;flex-direction:row;justify-content:space-between;align-items:center;gap:5px}
.shell .controls{grid-template-columns:repeat(3,40px);grid-template-rows:repeat(3,40px);gap:3px}
.shell .actions{display:grid;grid-template-columns:repeat(3,48px);gap:3px;justify-content:end}
.shell .actions button{width:48px;height:44px;min-height:44px;min-width:0;font-size:9px}
.shell .setup{grid-column:1;grid-row:2;width:min(760px,100%);max-height:100%;overflow:auto;align-self:center;margin:0 auto}
@media(orientation:landscape) and (max-height:600px){
 .shell,.shell:fullscreen,.shell.appFullscreen{grid-template-columns:minmax(0,1fr) 120px;grid-template-rows:30px minmax(0,1fr)}
 .shell .top{grid-column:1/-1}.shell .bottom,.shell:fullscreen .bottom,.shell.appFullscreen .bottom{grid-column:2;grid-row:2}
 .shell .touchBar{height:100%;flex-direction:column;justify-content:center;gap:4px}
 .shell .controls{grid-template-columns:repeat(3,34px);grid-template-rows:repeat(3,34px);gap:2px}
 .shell .actions{grid-template-columns:repeat(2,50px);gap:2px}.shell .actions button{width:50px;height:36px;min-height:36px;font-size:8px}
 .shell .quest p{display:none}.shell .hud .stats{flex-basis:145px}.shell .questTitleRow{flex-wrap:nowrap}
 body[data-control-side="left"] .shell{grid-template-columns:120px minmax(0,1fr)}
 body[data-control-side="left"] .shell .game{grid-column:2}body[data-control-side="left"] .shell .bottom{grid-column:1}
 .shell .setup{grid-column:1/-1}
}

/* v1.81: separate combat, interaction, and menus into stable thumb groups. */
.shell .touchBar{padding:4px 2px max(4px,env(safe-area-inset-bottom));gap:10px;align-items:center}
.shell .controls{grid-template-columns:repeat(3,42px);grid-template-rows:repeat(3,42px);gap:3px}
.shell .controls button{border-width:3px;border-image-width:3px;font-size:20px}
.shell .actions{width:174px;display:flex;flex-direction:column;gap:6px;align-items:stretch;flex:0 0 auto}
.shell .combatActions,.shell .utilityActions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}
.shell .actions button{width:100%;height:54px;min-width:0;min-height:44px;padding:3px;font:bold 10px/1.15 system-ui;touch-action:manipulation;white-space:normal;overflow-wrap:anywhere}
.shell .actions .interact{height:44px;border:1px solid #9fba7e;border-image:none;border-radius:8px;background:#304a35;color:#eff9de;letter-spacing:.06em}
.shell .actions .attack{border:2px solid #e28e5a;border-image:none;border-radius:9px;background:#70432e}
.shell .combatActions .combatButton{border-color:#c5ae7a;background:#35444f}
.shell .utilityActions{border-top:1px solid #53614c;padding-top:6px}
.shell .utilityActions button{height:44px;min-height:44px;border:1px solid #748460;border-image:none;border-radius:7px;background:#202e24;color:#dce4ca;font-size:10px}
.shell .actions button:active,.shell .controls button:active{filter:brightness(1.4);transform:translateY(1px)}
@media(max-width:350px) and (orientation:portrait){
 .shell .controls{grid-template-columns:repeat(3,38px);grid-template-rows:repeat(3,38px)}
 .shell .actions{width:156px}.shell .touchBar{gap:5px}.shell .actions button{font-size:9px}
}
@media(orientation:landscape) and (max-height:600px){
 .shell .touchBar{padding:2px;height:100%;gap:6px}
 .shell .controls{grid-template-columns:repeat(3,33px);grid-template-rows:repeat(3,33px);gap:2px}
 .shell .actions{width:112px;gap:4px}.shell .combatActions,.shell .utilityActions{gap:2px}
 .shell .actions button{font-size:8px;height:44px;min-height:44px}.shell .actions .interact{height:36px;min-height:36px}
 .shell .utilityActions{padding-top:4px}.shell .utilityActions button{height:36px;min-height:36px;font-size:8px}
}

/* v1.81: keep the button arrangement and anchor it at the right edge. */
.shell .actions{margin-left:auto;align-self:flex-end}
@media(orientation:landscape) and (max-height:600px){
 .shell .actions{margin-left:0;align-self:flex-end}
}

/* v1.81: one touch-scroll surface for the companion screen on phones. */
#partyScreen .screenHead,#partyScreen .screenNotice,#partyScreen .screenFoot{flex-shrink:0}
#partyScreen .partyRoster,#partyScreen .partyGear{min-width:0}
#partyScreen .partyRoster h3,#partyScreen .partyGear h3,#partyEquipmentSlots{flex-shrink:0}
#partyScreen .partyGear{overflow:hidden}
#partyGearList{min-height:0;overflow-y:auto;touch-action:pan-y;-webkit-overflow-scrolling:touch}
#partyMembers{flex-shrink:0}
#partyScreen .partyMemberHead{flex-wrap:wrap}
#partyScreen .partyEquipSlot span{min-width:0;overflow-wrap:anywhere}
#partyScreen .partyMember button,#partyScreen .partyEquipSlot button{min-height:36px}
@media(max-width:620px){
 #partyScreen .partyPanel{height:calc(100dvh - 10px)}
 #partyScreen .partyLayout{display:block;overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;-webkit-overflow-scrolling:touch}
 #partyScreen .partyRoster,#partyScreen .partyGear{display:block;overflow:visible;min-height:0}
 #partyScreen .partyGear{margin-top:8px}
 #partyGearList{overflow:visible;min-height:0}
 #partyScreen .partyMember{padding:8px}
 #partyScreen .partyMemberActions{margin-top:6px}
 #partyScreen .partyMemberHead strong{font-size:13px}
 #partyScreen .itemRow{padding:8px 4px}
 #partyScreen .itemAction{min-height:40px;max-width:100px;white-space:normal}
}

/* Pet sanctuary: one scrollable collection, roomy touch targets, no equipment columns. */
#partyScreen .petPanel{width:min(900px,calc(100vw - 20px));max-height:calc(100dvh - 24px);overflow:hidden;display:flex;flex-direction:column}
#partyScreen .petCollection{overflow-y:auto;min-height:0;flex:1;padding:14px;touch-action:pan-y;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#partyScreen .petGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.petWallet{font:12px/1.5 system-ui;color:#d3c59d;margin-bottom:12px}.petCard{border:1px solid #778369;border-radius:12px;padding:14px;background:linear-gradient(145deg,#26372f,#17241f);min-width:0}.petFollowing{box-shadow:inset 0 0 0 2px #c7bc80}.petTier2{border-color:#6b9dbc}.petTier3{border-color:#ae8bc9}.petTier4{border-color:#deb55d;background:linear-gradient(145deg,#49352a,#201f1a)}.petCardTop{display:flex;align-items:center;gap:12px}.petPortrait{width:112px;height:112px;object-fit:contain;flex:none;image-rendering:auto;filter:drop-shadow(0 5px 4px #0008)}.petTierLabel{font:700 10px system-ui;letter-spacing:.12em;text-transform:uppercase;color:#ead099}.petCard h3{margin:5px 0!important;font:700 20px Georgia;color:#f3dfa7}.petCard h3 small{display:block;font:12px system-ui;color:#dedfcd;margin-top:4px}.petCard p{font:12px/1.55 system-ui;color:#d5ddce;margin:7px 0}.petStats{color:#efce90!important}.petCardActions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.petCardActions button{min-height:44px;padding:8px 12px;border:1px solid #a6aa78;border-radius:8px;background:#324a37;color:#f7edce;font:700 12px system-ui;touch-action:manipulation}.petCardActions button:disabled{opacity:.6;background:#26312b}.petStatusButton{margin-top:6px;padding:5px 7px;max-width:100%;border:1px solid #aaad78;background:#233b2c;border-radius:6px;color:#f1dfae;font:10px system-ui;pointer-events:auto;min-height:30px}
@media(max-width:580px){#partyScreen .petGrid{grid-template-columns:1fr}#partyScreen .petCollection{padding:10px}.petCard{padding:12px}.petPortrait{width:88px;height:88px}.petStatusButton{font-size:9px;padding:4px;min-height:28px}}
/* A compact parchment journal, readable without relying on color. */
#questScreen .screenPanel{background:#e8dab9;color:#302c22;border:2px solid #a8894c;max-width:700px}
#questScreen .screenHead,#questScreen .screenFoot{background:#352f25;color:#f1dfaf}
#questScreen .screenHead h2{color:#f3dfb0;font-family:Georgia,serif}
#questScreen .screenHead p{color:#e5d7bc;font-size:13px}
#questScreen .screenNotice{color:#544735;background:#ded0b0;font-size:13px;line-height:1.45;padding:10px 14px}
#questScreen .questList{gap:10px;padding:12px;background:linear-gradient(100deg,#ddd0ad,#f1e6cd 15%,#e7d7b4)}
#questScreen .questEntry{background:#f7eed9;border:1px solid #b9a378;border-radius:5px;box-shadow:0 2px 3px #46321413;padding:13px}
#questScreen .questEntry.tracked{border-left:5px solid #a27620}
#questScreen .questEntry p{color:#463b2c;font-size:14px;line-height:1.45;margin:8px 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#questScreen .journalDetails p{display:block;overflow:visible}
#questScreen .journalBadge{font-size:11px;letter-spacing:.06em;font-weight:800;color:#705225}
#questScreen .journalTitle{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:44px;background:none;border:0;text-align:left;padding:4px 0;color:#32291c;font:700 19px Georgia,serif}
#questScreen .journalTitle span{font:20px system-ui;padding-left:12px}
#questScreen .journalProgress{color:#625237;font-size:12px;font-weight:700}
#questScreen .journalTabs{display:flex;gap:6px;flex-shrink:0}
#questScreen .journalTabs button,#questScreen .questTrackActions button{min-height:44px;padding:8px 12px;border:1px solid #95815a;background:#efe2c2;color:#3b3020;border-radius:5px;font-weight:700}
#questScreen .journalTabs button{flex:1}
#questScreen .journalTabs button[aria-pressed=true]{background:#524332;color:#fff1d0}
#questScreen .journalEmpty{opacity:.8}
#questScreen .journalLegacy summary{padding:14px;min-height:44px;color:#453925;cursor:pointer}
#questScreen .journalDetails{border-top:1px solid #cbb68c;margin-top:10px;padding-top:5px}

#npcChatForm{position:sticky;bottom:0;background:#1b2922;padding:10px 0 0;border-top:1px solid #776c50;white-space:normal}
#npcChatForm label{display:block;font:12px/1.4 system-ui;color:#d9c9a3;margin-bottom:7px}
#npcChatForm>div{display:flex;gap:6px}
#npcQuestionInput{min-width:0;flex:1;min-height:44px;padding:10px;border-radius:5px;border:1px solid #ab9563;background:#f4ead2;color:#2d291f;font:16px system-ui}
#npcChatForm button{min-height:44px;min-width:52px;padding:8px;background:#dcc493;color:#29261d;border:1px solid #a68e56;border-radius:5px;font-weight:bold}
.npcMood{font:11px system-ui;color:#b8c8ac;text-transform:uppercase;letter-spacing:.08em}
.npcChatTurn{padding:8px 0;border-top:1px solid #54614c;white-space:normal}
.npcChatTurn p{margin:5px 0}.npcQuestion{font:13px/1.4 system-ui;color:#d9be83}
#npcChatForm input:focus{outline:2px solid #efdb9a;outline-offset:2px}
#npcQuestionInput::placeholder{color:#6b6252}
#npcChatForm{margin-top:12px}
#moodNote{color:#caba97}
@media(max-height:500px){#adventureScreen.npcTalkView .screenPanel{height:96dvh}#adventureScreen.npcTalkView .adventureChoices{max-height:26dvh}#adventureScreen.npcTalkView #adventureText{font-size:14px}}


/* Cohesive town ledger and touch-friendly management. */
.crewBanner{padding:18px 20px;margin:0 0 18px;border:1px solid #a58c56;border-radius:12px;background:radial-gradient(ellipse at top right,#35574a,transparent 70%),linear-gradient(135deg,#142c28,#17201e);box-shadow:inset 0 1px #e9d6a526,0 7px 20px #0003;color:#f3e2b7;display:grid;gap:6px}.crewBanner span{font-size:10px;letter-spacing:2.2px;color:#c7b378}.crewBanner b{font:600 25px Georgia,serif}.crewBanner small{color:#bdcabe}.settlementView #adventureChoices button{min-height:46px;border-radius:9px;box-shadow:inset 0 1px #fff1}.settlementView #adventureChoices button:focus-visible{outline:2px solid #f5d682;outline-offset:2px}.settlementView .settlementCopy{line-height:1.65}.settlementPlot{border-radius:8px}.settlementWallet{border-radius:10px}.npcMood{letter-spacing:1px;text-transform:uppercase;font-size:10px}.npcTalkView #npcQuestionInput{min-height:44px}
</style>
<style>
/* v1.81: readable quest text on the portrait display. */
@media(orientation:portrait){.shell .quest p{display:block;-webkit-line-clamp:unset;overflow:visible;line-height:1.3;margin-top:3px}.shell .hud .quest{min-width:0;max-width:none;flex:1}.shell .quest h2{overflow-wrap:anywhere}}
</style><style>.shell .toast,.shell:fullscreen .toast,.shell.appFullscreen .toast{bottom:38px;max-width:min(80%,320px);font:12px/1.3 system-ui;padding:7px 10px;border-image-width:3px}</style><style>
/* Compact contextual action cluster. */
.shell .utilityActions{grid-template-columns:repeat(2,minmax(0,1fr))}
.shell .actions .contextInteract{background:#304a35;border-color:#9fba7e;color:#eff9de}
</style>
<style>
/* Keep the contextual action and skill together, with whole-word labels. */
.shell .combatActions{grid-template-columns:repeat(2,minmax(0,1fr))}
.shell .utilityActions{grid-template-columns:repeat(3,minmax(0,1fr))}
.shell .actions button{overflow-wrap:normal;word-break:normal}
.shell .actions .attack{font-size:9px;white-space:nowrap}
@media(orientation:landscape) and (max-height:600px){.shell .actions .attack{font-size:7px}.shell .utilityActions button{font-size:7px}}
</style>

<style>
:root{--gold:#d9bb7b;--panel:#17231e}
.shell .top{padding:5px 4px;align-items:center}.shell .brand{font:700 18px Georgia;letter-spacing:.08em}
.shell .pill{border-image:none!important;border:1px solid #657258!important;border-radius:7px;background:#1b2821;color:#e7e9d8}
.shell .game{border:1px solid #566c55;border-radius:12px;overflow:hidden;background:#142019}
.shell .hud{padding:6px;gap:6px;background:#111d18}.shell .hud .card{border-image:none!important;border:1px solid #64775b!important;border-radius:9px;background:#1b2922;padding:7px}
.shell .hud .stats{flex-basis:115px;font:10px/1.45 system-ui}.shell .quest h2{font:700 11px/1.3 system-ui;color:#f0d797;letter-spacing:.03em}
.shell .quest p{font:10px/1.4 system-ui;margin:5px 0 0}.shell .quest #progress{display:block;color:#c6dfb0;margin-top:3px}
.shell .questTitleRow{align-items:flex-start}.shell .journalButton{border:1px solid #697a59;border-radius:6px;background:#26362b;font:700 9px system-ui;min-height:30px;padding:5px}
.shell .controls button{border-image:none!important;border:2px solid #86aa6d;border-radius:7px;background:#24362a;box-shadow:inset 0 1px #accb8c33}
.shell .actions .attack{background:#78492f;color:#fff0db}.shell .actions .contextInteract{background:#304a35}
.shell .actions button{box-shadow:inset 0 1px #ffffff20}.shell .combatActions button{position:relative;overflow:hidden}.shell .combatActions button::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:#eed194;transform-origin:left;transform:scaleX(var(--cooldown,0));pointer-events:none}.shell .combatButton:disabled{opacity:.75;background:#1e2930}
.shell .toast{border-image:none!important;border:1px solid #ad9966;border-radius:9px;background:#15221ef5;box-shadow:0 4px 20px #0007;pointer-events:none}
.setup{border-image:none!important;border:1px solid #6b7c58!important;border-radius:15px;background:linear-gradient(145deg,#26392c,#121d19)!important;padding:20px!important}
.setup h1{color:#f1d596}.classCard{border-image:none!important;border:1px solid #5e7353!important;border-radius:10px!important;background:#1b2a21;display:grid;grid-template-columns:48px minmax(0,1fr);column-gap:6px}.classCard b,.classCard>span:not(.classPortrait){grid-column:2}.classPortrait{grid-column:1;grid-row:1/span 2;align-self:center;display:block!important;height:62px;background-repeat:no-repeat;filter:drop-shadow(0 3px 2px #0007)}.classPick input:checked+.classCard{border-color:#e3c27e!important;background:#344632!important}.classPick:focus-within .classCard{outline:2px solid #e3c27e;outline-offset:2px}.setup p{line-height:1.5}
.startButton{border-image:none!important;border:1px solid #d9bb7b!important;border-radius:9px;background:#485d34!important;min-height:48px}
@media(orientation:landscape) and (max-height:600px){.shell .hud{padding:3px}.shell .hud .card{padding:4px}.shell .quest h2{font-size:10px}}
</style>
<style>.genderChoices{margin:14px 0;padding:0;border:0;min-width:0}.genderChoices legend{padding:0;margin-bottom:7px;color:#ead5a6;font:700 12px system-ui}.genderGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.genderPick{position:relative;cursor:pointer}.genderPick input{position:absolute;opacity:0;width:1px;height:1px}.genderPick span{display:flex;align-items:center;justify-content:center;min-height:44px;border:1px solid #617657;border-radius:8px;background:#17251e;color:#e9ebda;font:700 13px system-ui}.genderPick input:checked+span{border-color:#e5c27d;background:#3a5031;box-shadow:inset 0 0 0 1px #e5c27d}.genderPick input:focus-visible+span{outline:2px solid #f1d48c;outline-offset:3px}.setup .genderNote{font:11px/1.4 system-ui;color:#c0cbb5;margin:7px 0 0}</style><style>.controls .northwest{grid-column:1;grid-row:1}.controls .northeast{grid-column:3;grid-row:1}.controls .southwest{grid-column:1;grid-row:3}.controls .southeast{grid-column:3;grid-row:3}</style><style>.shell .controls button.directionHeld{background:#47613a;border-color:#ead39b;filter:brightness(1.2)}</style><style>.zoomControls{position:absolute;right:8px;bottom:30px;z-index:6;display:flex;gap:3px;padding:3px;background:#142019ed;border:1px solid #8a9a74;border-radius:8px}.zoomControls button{min-width:40px;min-height:40px;border:1px solid #8a9a74;border-radius:5px;background:#26362b;color:#f5dda5;font:bold 16px system-ui;touch-action:none}.zoomControls #zoomReset{font-size:11px;min-width:48px}.zoomControls button:disabled{opacity:.45}</style><style>
/* v1.81: zoom below stats, with the world canvas fully unobstructed. */
.shell .hudSide{flex:0 0 115px;min-width:0;display:flex;flex-direction:column;gap:6px;justify-content:space-between}
.shell .hudSide .stats{flex:0 0 auto;width:100%;min-width:0;box-sizing:border-box}
.shell .hudSide .zoomControls{position:static;inset:auto;z-index:auto;width:100%;box-sizing:border-box;pointer-events:auto}
.shell .hudSide .zoomControls button{flex:1;min-width:0;min-height:36px;padding:3px;font-size:16px}
.shell .hudSide .zoomControls #zoomReset{flex:1.2;min-width:0;font-size:11px}
@media(orientation:landscape) and (max-height:600px){.shell .hudSide{flex-basis:145px;gap:3px}.shell .hudSide .zoomControls button{min-height:30px}}
</style><style>
.questEntry.tracked{border:2px solid #efd28d;background:#263b2b}.questLiveProgress{color:#c6dfb0!important;font-weight:700}.questTrackActions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}.questTrackActions button{min-height:42px;padding:8px 12px;border:1px solid #b7a36d;border-radius:7px;background:#334b31;color:#f7e7bd;font-weight:700;touch-action:manipulation}.questTrackActions button[aria-pressed=true]{background:#655633}.questDestination{outline:3px solid #ffe08a!important;outline-offset:3px;filter:drop-shadow(0 0 5px #ffdb79)}
</style><style>
.setBonusSummary,.setForgeHelp{font:11px/1.45 system-ui;color:#dbc78e;margin:8px 0;overflow-wrap:anywhere}.setCraftTabs{display:flex;gap:6px;flex-wrap:wrap}.setCraftTabs button{min-height:40px;border:1px solid #71845e;border-radius:6px;background:#26382a;color:#e9dcae;padding:6px 10px}.setCraftTabs button[aria-pressed=true]{border-color:#ecd295;background:#496138}.inventoryHero{overflow-y:auto;min-height:0;touch-action:pan-y}.inventoryGearSlots{grid-template-columns:repeat(2,minmax(0,1fr))}.inventoryGearSlot{min-width:0}.inventoryGearSlot span{overflow-wrap:anywhere}.partyGear h3{overflow-wrap:anywhere}.gearSlots{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:620px){.inventoryLayout{grid-template-rows:minmax(0,.95fr) minmax(0,1fr)}.inventoryGearSlots{grid-template-columns:repeat(3,minmax(0,1fr))}.setBonusSummary{grid-column:1/-1}.inventoryGearSlot{min-height:58px;padding:5px;gap:4px}.inventoryGearSlot .slotIcon{width:26px;height:26px;flex-basis:26px}.inventoryGearSlot span span{font-size:9px}.gearSlots{grid-template-columns:1fr}}
</style><style>
/* v1.81: an atlas that stays legible on portrait phones. */
