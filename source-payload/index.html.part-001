#travelScreen .screenMeta{color:#d6cfb8;background:#1d2c24;border:0}
#travelScreen .atlasScroller{background:radial-gradient(ellipse,#ddd0aa,#bca77a);border:1px solid #89734a;border-radius:4px;box-shadow:inset 0 0 24px #5d472f44}
.atlasToolbar{gap:5px}.atlasToolbar button{min-height:44px;font:600 11px system-ui;padding:5px 10px;background:linear-gradient(#514f38,#303c2c);border-color:#968052;color:#f3e4bc}
