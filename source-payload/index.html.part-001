#optionsMenu .optionsLabel{font:700 10px system-ui;letter-spacing:.1em;text-transform:uppercase;color:#beccbd;margin:14px 0 6px}
#optionsMenu button{border:1px solid #857049;border-radius:5px;background:linear-gradient(#414634,#28382c);color:#f0e3c1;min-height:44px;box-shadow:inset 0 1px #d7c59420;font:600 12px system-ui}
#optionsMenu button[aria-pressed=true]{background:linear-gradient(#977d49,#69572f);border-color:#ecd08d;color:#fff1ca;box-shadow:inset 0 0 0 1px #c7a963}
#optionsMenu button:focus-visible,.atlasToolbar button:focus-visible{outline:2px solid #f9dfa0;outline-offset:2px}
#quickMenuLinks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin:12px 0}#quickMenuLinks button:nth-child(n){grid-column:auto;min-width:0;padding:9px 6px;text-transform:none}
#quickMenuLinks .menuCore{min-height:53px;font:700 17px Georgia,serif;background:linear-gradient(#665b3c,#403e2b);border-color:#b49c64}
.menuSectionHeading{grid-column:1/-1;font:700 10px system-ui;text-transform:uppercase;letter-spacing:.14em;color:#b7c7b3;margin:8px 0 1px}
#optionsMenu .optionsDone{position:sticky;bottom:0;z-index:4;width:100%;min-height:46px;background:linear-gradient(#947443,#614c2a);border-color:#d9b974;margin-top:10px;box-shadow:0 -6px 12px #152019;font:700 15px Georgia}
#travelScreen .worldPanel{border:1px solid #bfa16c;border-radius:9px;background:#252d24;box-shadow:inset 0 0 0 3px #78674350}
