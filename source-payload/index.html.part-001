</style><style>#danTestControls{border:1px solid #756640;padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}#danTestControls[hidden]{display:none}#danTestControls legend{color:#d9c18a;font:12px Georgia}#danTestControls label{font:11px system-ui;align-self:center}#danTestControls select{min-height:40px;background:#192719;color:#eadab4;border:1px solid #6f7350;border-radius:4px;width:100%;padding:6px}</style><style>.tavernView .screenPanel{width:min(640px,100%);border-color:#b19156;background:radial-gradient(ellipse at top,#4b3821 0,#1e271e 56%,#141d18 100%)}.tavernView .screenHead{background:#30281dc9;border-color:#816a42}.tavernView #adventureText{white-space:normal!important;padding:18px!important;flex-shrink:1;min-height:0}.tavernWelcome{text-align:center}.tavernEyebrow{font:10px system-ui;letter-spacing:3px;color:#d5b57b}.tavernWallet{font:28px Georgia;color:#f3d78f;margin:10px 0}.tavernWallet small{display:block;font:11px system-ui;color:#cabb98;margin-top:4px}.tavernTable{display:flex;align-items:center;justify-content:center;gap:20px;padding:18px;margin:12px 0;border:1px solid #8a6a3c;border-radius:50%;background:radial-gradient(ellipse,#6e4a27,#382917);box-shadow:inset 0 0 20px #120f0b80}.tavernTable>div{display:grid;gap:8px;text-align:center;font:11px Georgia;color:#dac79f}.tavernDie{display:inline-grid;grid-template-columns:repeat(3,1fr);gap:5px;padding:9px;width:57px;height:57px;background:#f0dfb7;border-radius:9px;border:2px solid #a48348;box-shadow:3px 4px 0 #21160b}.tavernDie i{border-radius:50%;background:transparent}.tavernDie i.lit{background:#433024}.tavernCoin{display:grid;place-items:center;width:58px;height:58px;border-radius:50%;border:3px double #ffe1a0;background:radial-gradient(circle at 35% 25%,#e7bc62,#8f612b);color:#fff1be;font:32px Georgia;box-shadow:3px 4px 0 #21160b}.tavernCopy{font:13px/1.65 system-ui;color:#ecdfc3}.tavernRecord{text-align:center;font:11px system-ui;color:#c9b484;margin-bottom:14px}.tavernVersus{color:#c9b484;font:italic 16px Georgia}.tavernView .adventureChoices{grid-template-columns:1fr 1fr;padding-top:0;flex-shrink:0}.tavernView .adventureChoices button{min-height:44px;border-color:#ad8d51;background:linear-gradient(#4f412b,#302b20);color:#ffe7b5}.tavernView .adventureChoices button:last-child{grid-column:1/-1;background:#263326;color:#cfccb4}.tavernView button:disabled{opacity:.4;cursor:not-allowed}.tavernRolled .tavernDie,.tavernRolled .tavernCoin{animation:tavernReveal .35s ease-out}@keyframes tavernReveal{from{transform:rotate(-12deg) scale(.8);opacity:.3}to{transform:rotate(0) scale(1);opacity:1}}@media(max-height:560px){.tavernView .screenPanel{width:min(760px,100%)}.tavernView #adventureText{padding:8px 14px!important}.tavernWallet{font-size:20px;margin:5px 0}.tavernTable{padding:8px;margin:6px 0}.tavernCopy{font-size:11px;line-height:1.4}.tavernView .adventureChoices{gap:5px;padding:7px}.tavernView .adventureChoices button{min-height:36px;padding:7px}.tavernRecord{margin-bottom:5px}}@media(prefers-reduced-motion:reduce){.tavernRolled .tavernDie,.tavernRolled .tavernCoin{animation:none}}</style><style>
.tavernSlots{display:flex;gap:12px;justify-content:center;padding:20px 12px;margin:14px 0;background:linear-gradient(135deg,#39271c,#130f0c);border:3px double #b58a40;border-radius:16px;box-shadow:inset 0 0 22px #0008}
.tavernReel{display:grid;place-items:center;width:110px;min-height:116px;border:2px solid #b58a40;border-radius:8px;background:linear-gradient(#d9c79d,#fff0c9 50%,#bfa36a);color:#6b351e;box-shadow:inset 0 8px 12px #0003,inset 0 -8px 12px #0003}
.tavernReel b{font-size:48px;line-height:1.3}.tavernReel small{font:11px Georgia,serif;letter-spacing:1px;color:#513819}
.tavernCard{display:inline-flex;flex-direction:column;justify-content:space-between;align-items:center;width:48px;height:68px;padding:5px;box-sizing:border-box;color:#29221e;background:#f0e2ba;border:1px solid #c0a66c;border-radius:5px;box-shadow:2px 3px 5px #0008;font-family:Georgia,serif}.tavernCard small{align-self:flex-start;font-size:16px;line-height:18px}.tavernCard b{font-size:28px;line-height:30px}.tavernCard.cardRed{color:#a23b30}.tavernCard.cardBack{background:repeating-linear-gradient(45deg,#61352b,#61352b 4px,#804737 4px,#804737 8px);color:#e8c97c;justify-content:center;font-size:28px;border:3px double #c0a66c}
.blackjackTable{display:grid;gap:16px;padding:16px;margin:12px 0;border:2px solid #9c773f;border-radius:20px;background:radial-gradient(ellipse,#29402d,#17291d);box-shadow:inset 0 0 20px #0007}.blackjackRow{display:grid;gap:7px;text-align:center}.blackjackRow>span{font-size:11px;letter-spacing:1px;color:#e0c58c}.blackjackRow>div{display:flex;justify-content:center;gap:7px;flex-wrap:wrap}
.tavernRolled .tavernReel{animation:tavernReveal .35s ease-out}
@media(max-height:560px){.blackjackTable{gap:9px;padding:10px}.tavernCard{height:54px;width:39px}.tavernCard b{font-size:22px;line-height:23px}.tavernSlots{padding:10px}.tavernReel{min-height:76px}.tavernReel b{font-size:34px}}
@media(prefers-reduced-motion:reduce){.tavernRolled .tavernReel{animation:none}}
