#characterSetup .classGrid{gap:10px}#characterSetup .classCard{position:relative;min-height:132px;padding:13px 9px;grid-template-columns:45px minmax(0,1fr);gap:4px 8px;border-radius:8px!important;border:1px solid #74836266!important;background:linear-gradient(145deg,#293a2f,#18251e)}#characterSetup .classCard b{font:700 18px Georgia;color:#eedab0;align-self:end}#characterSetup .classCard>span:not(.classPortrait){font:11px/1.4 system-ui;color:#b9c6b2;margin:0}#characterSetup .classCard i{display:block;font:10px/1.3 system-ui;color:#9eae98;margin-top:6px}#characterSetup .classPortrait{transform:scale(1.2);filter:drop-shadow(0 5px 4px #0009)}#characterSetup .classPick input:checked+.classCard{border-color:#dfbd75!important;background:linear-gradient(145deg,#4b4930,#28392b)!important}#characterSetup .classPick input:checked+.classCard:after{content:'✦';position:absolute;right:6px;top:5px;color:#e3c17b;font-size:11px}#characterSetup .startButton{border-image:none!important;border:1px solid #dfbd75!important;background:linear-gradient(#dfbd77,#af8c49)!important;border-radius:7px;color:#1e261b;min-height:50px;font:700 14px system-ui;letter-spacing:.05em;margin-top:22px;box-shadow:0 4px 20px #d7ac4e22}#characterSetup .setupSaveButton{display:block;width:100%;margin:5px 0 0;padding:14px;border:0!important;background:none!important;min-height:44px;font:12px system-ui;color:#d2bc88;text-decoration:underline;text-underline-offset:4px}#characterSetup .openingSaveNote{margin:4px 0 0;text-align:center;font:10px system-ui;color:#899b85}
