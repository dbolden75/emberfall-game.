#travelScreen .screenMeta>span:nth-child(2){display:none}
#travelScreen .atlasToolbar{position:absolute;left:8px;bottom:10px;z-index:8;justify-content:flex-start;max-width:calc(100% - 310px);gap:5px;flex-wrap:wrap;padding:5px;background:#172a26df;border:1px solid #a8966c;border-radius:4px}
#travelScreen .atlasToolbar button{min-height:44px;padding:7px 11px;background:linear-gradient(#6b8795,#3d5865);color:#fff1d1;font-size:12px;border-color:#bec6b9}
