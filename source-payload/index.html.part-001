#characterSetup.setup{width:min(980px,100%);padding:0!important;overflow:hidden;border:1px solid #a38a5555!important;background:#15211b!important;border-radius:16px;display:grid;grid-template-columns:.8fr 1fr;box-shadow:0 25px 90px #0008}#characterSetup[hidden]{display:none!important}
.openingHero{position:relative;min-height:690px;overflow:hidden;background:linear-gradient(#152c29cc,#20382c88,#0d211de8),radial-gradient(circle at 70% 55%,#e9c682 0,#4d6a53 25%,#21372c 65%);border-right:1px solid #c6a96255;text-align:center;padding:45px 25px}.openingHero svg{position:absolute;inset:0;width:100%;height:100%;opacity:.6}.openingHeroText{position:relative}.openingEyebrow{font:600 9px system-ui;letter-spacing:.22em;color:#c3ae7e}.openingTitle{font:700 76px/.98 Georgia;letter-spacing:.035em;color:#f2d398;text-shadow:0 5px 24px #0009;margin:30px 0 20px}.openingDivider{color:#d9b46c;font-size:22px;margin:12px auto}#characterSetup .openingTagline{font:italic 24px/1.4 Georgia;color:#f4e2bb}#characterSetup .openingStory{font:13px/1.65 system-ui;color:#d0d8c5;max-width:240px;margin:18px auto}.openingFooter{position:absolute;bottom:24px;left:10px;right:10px;color:#bba977;font:9px system-ui;letter-spacing:.13em}
