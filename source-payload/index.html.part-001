#optionsMenu{background:linear-gradient(145deg,#27271fec,#101b17f7)!important;border:1px solid #b69a62;border-radius:10px 0 0 10px;box-shadow:0 12px 50px #000a,inset 0 0 0 3px #584c333d;color:#e9ddbc;width:min(370px,calc(100vw - 12px))!important;padding:14px!important;box-sizing:border-box;scrollbar-color:#aa8c57 #1c2620}
#optionsMenu .optionsCard{padding:0;background:transparent;border:0;box-shadow:none;width:100%;box-sizing:border-box}
