body:has(#gameView:not([hidden])) .shell .hudSide .stats{padding-left:48px}
</style><style id="edge-menu-ui">
#optionsMenu{position:fixed!important;inset:34px 0 0 auto!important;width:min(210px,44vw)!important;height:auto!important;padding:0!important;background:#142019!important;z-index:20;overflow-y:auto;touch-action:pan-y;overscroll-behavior-y:contain;backdrop-filter:none!important}
#optionsMenu .optionsCard{width:100%!important;max-height:none!important;min-width:0;margin:0;padding:9px;border:0;border-radius:0;box-shadow:none;overflow:visible;overscroll-behavior:auto}
#quickMenuLinks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}
#quickMenuLinks button{min-width:0;padding:4px!important;overflow-wrap:normal;background:#263b2b;color:#f4dfb0;border:1px solid #778768;border-radius:6px;width:100%!important;min-height:44px!important;margin:0;font-size:11px}
body:has(#optionsMenu:not([hidden])):has(#gameView:not([hidden])) .shell .game{right:min(210px,44vw);width:auto!important}
body:has(#optionsMenu:not([hidden])) #controlRow{visibility:hidden}
body:has(#gameView:not([hidden])) .shell .hud .quest{display:none}
body:has(#gameView:not([hidden])) .shell .utilityActions:empty{display:none}
</style><style id="final-touch-targets">
body:has(#gameView:not([hidden])) .shell .top{height:46px}
body:has(#gameView:not([hidden])) .shell .game{top:46px}
#optionsToggle{min-height:44px;min-width:66px;padding:4px 8px;touch-action:manipulation}
#optionsMenu{top:46px!important}
#quickMenuLinks button:nth-child(n+7){grid-column:1/-1}#quickMenuLinks button:focus-visible,#optionsToggle:focus-visible{outline:2px solid #f2d78e;outline-offset:2px}
#tutorialHint{position:absolute;right:10px;top:10px;z-index:5;max-width:145px;min-height:44px;padding:7px;background:#263b2b;color:#f4dfb0;border:1px solid #b79860;border-radius:6px;font:11px system-ui;touch-action:manipulation}
</style><style>
#optionsMenu details{margin-top:12px;border-top:1px solid #778768;padding-top:8px}
#optionsMenu summary{cursor:pointer;color:#f4dfb0;font:12px system-ui;min-height:44px;display:flex;align-items:center}
#optionsMenu details button{min-height:44px;width:100%;margin:4px 0;background:#263b2b;color:#f4dfb0;border:1px solid #778768;border-radius:6px}
#optionsMenu .sideChoices button{width:50%}#soundVolume{width:100%;min-height:44px;accent-color:#edc874}
#optionsMenu .optionsDone{position:sticky;bottom:0;min-height:44px;background:#344c36}
.menuPauseNote{font:11px system-ui;color:#c5cdb8}#optionsMenu .optionsLabel{display:block}
</style><style id="map-usability-update">
#travelScreen{padding:4px}#travelScreen .worldPanel{width:100%;height:calc(100dvh - 8px);max-height:calc(100dvh - 8px)}
#travelScreen .screenHead{padding:5px 10px}#travelScreen .screenHead h2{font-size:20px;margin:0}#travelScreen .screenHead p{display:none}
#travelScreen .screenMeta{padding:3px 10px;font-size:10px}
#travelScreen .screenFoot{padding:3px 10px;font-size:10px}#travelScreen .screenFoot button{min-height:36px;padding:5px 10px}
#travelScreen .travelDestinations{flex:1;min-height:0;gap:3px;padding:4px}
#travelScreen .settlementAtlasSummary{display:none}
#travelScreen .atlasLegend{display:none}
.atlasToolbar{display:flex;justify-content:center;gap:6px;flex-wrap:wrap;flex-shrink:0}.atlasToolbar button{min-height:44px;padding:4px 12px;border:1px solid #a99664;border-radius:6px;background:#25392a;color:#f6e2b5;font:600 12px system-ui}.atlasToolbar button[aria-pressed=true]{background:#57683c}
#travelScreen .atlasScroller{min-height:0;flex:1;position:relative}
#travelScreen .atlasView{margin:0 auto;flex-shrink:0}
#travelScreen .atlasOverview .atlasNode{min-height:0;width:6%;height:6%;padding:0;border:1px solid #cdb67d;border-radius:50%;background:#213b28;max-width:none}
#travelScreen .atlasOverview .atlasStamp,#travelScreen .atlasOverview .mapKind,#travelScreen .atlasOverview .mapName,#travelScreen .atlasOverview .mapLabel{display:none}
