.settlementAtlasSummary{margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:6px}.settlementAtlasSummary p{margin:0;width:100%}.settlementAtlasSummary button{min-height:44px}.atlasScroller{min-height:140px}
@media(orientation:landscape) and (max-height:560px){.settlementAtlasSummary p{display:none}.settlementAtlasSummary b{margin-right:auto}.settlementAtlasSummary button{padding:5px 9px;font-size:10px}.travelDestinations>.atlasLegend{display:none}#travelScreen .screenHead{padding:6px 12px}#travelScreen .screenHead p{display:none}#travelScreen .screenMeta{padding:4px 12px}#travelScreen .screenFoot{padding:4px 12px}.travelDestinations{gap:4px}#atlasSelection{display:none}}
</style><style id="touch-proximity-ui">
body:not([data-movement-mode="arrows"]):has(#gameView:not([hidden])) .shell .controls{display:none!important}
