 quest:{x:260,y:87,w:124,h:105,label:'QUEST HOUSE',kind:'home'},
 shop:{x:742,y:87,w:142,h:110,label:'SHOP',kind:'shop'},
 companion:{x:76,y:390,w:145,h:100,label:'PET SANCTUARY',kind:'inn'},
 provisions:{x:260,y:390,w:124,h:100,label:'PROVISIONS',kind:'shop'},
 healer:{x:560,y:390,w:124,h:100,label:'HEALER',kind:'home'},
 forge:{x:739,y:390,w:145,h:100,label:'FORGE',kind:'shop'},
 weapons:{x:-420,y:575,w:122,h:94,label:'WEAPONS',kind:'shop'},
 armorShop:{x:-115,y:575,w:122,h:94,label:'ARMOR',kind:'shop'},
 jewelry:{x:760,y:575,w:122,h:94,label:'JEWELER',kind:'shop'},
 tavern:{x:-420,y:390,w:170,h:120,label:'TAVERN',kind:'inn'},
 slayers:{x:-115,y:390,w:170,h:120,label:'SLAYERS HALL',kind:'inn'},
 classHome:{x:545,y:-210,w:124,h:105,label:'CLASS HOUSE',kind:'home'}
};
function townDoor(front){return {x:Math.round(front.x+front.w*.54)+Math.max(20,Math.round(front.w*.16))/2,y:front.y+front.h+3}}
for(const id of ['ashvale','brackenford','stonewatch','sunmere']){
 const town=maps[id];let shops=0;
 for(const n of town.npcs){
  const key=n.role==='leader'?'elder':n.role==='house_broker'?'classHome':n.role==='companion'?'companion':n.role==='healer'?'healer':n.shopId?.endsWith('_forge')?'forge':n.shopId?(shops++===0?'shop':'provisions'):'quest';
  const front=townFrontages[key],door=townDoor(front);
  n.frontage=key;n.x=door.x+(key==='classHome'?56:0);n.y=door.y+32;
 }
}
const tavernNames={ashvale:'The Ember & Oak',brackenford:'The Fox & Lantern',stonewatch:'The Copper Tankard',sunmere:'The Tideglass Inn'};
for(const [id,name] of Object.entries(tavernNames)){const door=townDoor(townFrontages.tavern);maps[id].npcs.push({name:name+' · Innkeeper',role:'innkeeper',frontage:'tavern',x:door.x,y:door.y+32,tx:0,ty:9});}
for(const id of Object.keys(tavernNames)){const door=townDoor(townFrontages.slayers);maps[id].npcs.push({name:'Warden Rook · Huntmaster',role:'huntmaster',frontage:'slayers',x:door.x,y:door.y+32,tx:1,ty:9});}
let tavernRollReadyAt=0;
function tavernStats(){return townQuestState._tavern||(townQuestState._tavern={played:0,wins:0,losses:0,pushes:0,net:0})}
// Tavern prizes use existing, level-appropriate equipment and never wager purchased currency.
function tavernGearPrize(game,stake,result){
 if(result!=='win')return '';
 const chance=Math.min(.22,.035+stake*.004+(game==='slots'?.025:0));
 if(Math.random()>=chance)return '';
 const eligible=Object.entries(itemDefs).filter(([id,d])=>d.category==='gear'&&GEAR_SLOTS.includes(d.slot)&&(!d.minLevel||d.minLevel<=player.level)&&(!itemClassRules[id]||itemClassRules[id].includes(player.class))&&!d.set&&d.sell>0);
 if(!eligible.length||bagUnits()>=bagLimit())return '';
 const pick=eligible[Math.floor(Math.random()*eligible.length)];
 if(!addItem(pick[0],1))return '';
 const st=tavernStats();st.gearWins=(st.gearWins||0)+1;st.lastPrize=pick[0];
 return 'Bonus equipment prize: '+pick[1].name+'! Check your inventory.';
}
function tavernDie(value){const dots={1:[4],2:[0,8],3:[0,4,8],4:[0,2,6,8],5:[0,2,4,6,8],6:[0,2,3,5,6,8]}[value];return '<span class="tavernDie" role="img" aria-label="Die showing '+value+'">'+Array.from({length:9},(_,i)=>'<i class="'+(dots.includes(i)?'lit':'')+'"></i>').join('')+'</span>'}
function tavernPanel(text,choices,art=''){if(!hasStarted||!activeMap.town||!tavernNames[mapId])return;openAdventureDialog(tavernNames[mapId],text,choices);const panel=document.getElementById('adventureScreen');panel.classList.add('tavernView');panel.querySelector('.screenClose').setAttribute('aria-label','Close tavern');document.getElementById('adventureText').innerHTML='<div class="tavernWelcome"><span class="tavernEyebrow">THE INNKEEPER’S TABLE</span><div class="tavernWallet">◈ '+player.coins+' <small>crowns in your purse</small></div></div>'+art+'<div class="tavernCopy">'+text.replace(/\n/g,'<br>')+'</div>';panel.querySelector('.screenFoot').textContent='Wagers use the crowns in your purse. Every result saves immediately.';}
const tavernSymbols=[{name:'Crown',glyph:'♛'},{name:'Ruby',glyph:'◆'},{name:'Clover',glyph:'♧'},{name:'Leaf',glyph:'❧'},{name:'Moon',glyph:'☾'}];
const tavernGameNames={coin:'Coin Toss',dice:'Dice Duel',slots:'Ember Reels',highcard:'High Card',blackjack:'Blackjack'};
function tavernHandActive(){return tavernStats().hand?.status==='active'}
function openTavern(){if(tavernHandActive()){showBlackjack();return}const st=tavernStats();tavernPanel('Warm lanterns, worn oak, and a seat by the fire.\nChoose a game. Wager 1, 5, 10, or 25 crowns. Winning rounds can award bonus equipment!',[{label:'Ember Reels · Slot machine',action:()=>chooseTavernWager('slots')},{label:'Blackjack · Hit or stand',action:()=>chooseTavernWager('blackjack')},{label:'High Card · Draw against the dealer',action:()=>chooseTavernWager('highcard')},{label:'Coin Toss · Heads or tails',action:()=>chooseTavernWager('coin')},{label:'Dice Duel · Highest roll wins',action:()=>chooseTavernWager('dice')},{label:'Leave the tavern',action:()=>{}}],'<div class="tavernTable"><span class="tavernCoin" aria-hidden="true">♛</span>'+tavernCard({rank:1,suit:'♠'})+tavernCard({rank:13,suit:'♥'})+'</div><div class="tavernRecord">'+st.played+' rounds · '+(st.gearWins||0)+' gear prizes · '+st.wins+' win'+(st.wins===1?'':'s')+' · Net '+(st.net>=0?'+':'')+st.net+' crowns</div>');}
function chooseTavernWager(game){if(!tavernGameNames[game])return;if(tavernHandActive()){showBlackjack();return}const rules={coin:'Call heads or tails. Wins pay your stake in profit.',dice:'Beat the innkeeper’s die. Wins pay your stake in profit; ties refund it.',slots:'Three crowns return 20× your wager. Three matching other symbols return 10×. Any pair returns your wager. No match loses it. Returns include your original stake; all five symbols have equal odds.',highcard:'Draw from one shuffled deck. Aces are high; suits do not break ties. A higher card wins your stake in profit; equal ranks refund it.',blackjack:'Reach 21 without going over. Aces count as 1 or 11. The dealer stands on all 17s. All wins, including blackjack, pay 1:1 profit; ties refund your stake. No splitting, doubling, or insurance.'};tavernPanel(tavernGameNames[game].toUpperCase()+'\n'+rules[game]+'\nChoose your wager.'+(player.coins<1?'\nYour purse is empty. Earn some crowns on your adventures first.':''),[...[1,5,10,25].map(stake=>({label:'Wager '+stake+' crown'+(stake===1?'':'s'),disabled:player.coins<stake,action:()=>game==='coin'?tavernPanel('Wager: '+stake+' crowns.\nCall the coin before the innkeeper flips it.',[{label:'Heads · Wager '+stake,action:()=>playTavernRound('coin',stake,'heads')},{label:'Tails · Wager '+stake,action:()=>playTavernRound('coin',stake,'tails')},{label:'Change wager',action:()=>chooseTavernWager('coin')}],'<div class="tavernTable"><span class="tavernCoin" aria-hidden="true">✦</span></div>'):game==='blackjack'?startBlackjack(stake):playTavernRound(game,stake)})),{label:'Back to the tavern',action:openTavern}]);}
function playTavernRound(game,stake,call){if(tavernHandActive()){showBlackjack();return false}if(game==='slots'||game==='highcard')return playTavernExtra(game,stake);return playTavernClassic(game,stake,call)}
function playTavernClassic(game,stake,call){if(!hasStarted||!activeMap.town||!tavernNames[mapId]||!['coin','dice'].includes(game)||![1,5,10,25].includes(stake)||(game==='coin'&&!['heads','tails'].includes(call)))return false;if(Date.now()<tavernRollReadyAt){chooseTavernWager(game);return false}if(player.coins<stake){chooseTavernWager(game);return false}const before=player.coins,a=game==='coin'?(Math.random()<.5?'heads':'tails'):1+Math.floor(Math.random()*6),b=game==='dice'?1+Math.floor(Math.random()*6):call,result=a===b?(game==='dice'?'push':'win'):game==='dice'&&a>b?'win':'loss',net=result==='win'?stake:result==='loss'?-stake:0;player.coins+=net;tavernRollReadyAt=Date.now()+600;const st=tavernStats();st.played++;st[result==='win'?'wins':result==='loss'?'losses':'pushes']++;st.net+=net;st.lastRound={game,stake,call:call||null,a,b,result,net,before,after:player.coins,town:mapId,time:Date.now()};const gearPrize=tavernGearPrize(game,stake,result);saveGame();ui();const title=result==='win'?'You win! +'+stake+' crowns':result==='push'?'A tie. Your wager is returned.':'The innkeeper wins. −'+stake+' crowns';const detail=(game==='coin'?'The coin lands '+a.toUpperCase()+'. You called '+call.toUpperCase()+'.':'Your die: '+a+' · Innkeeper’s die: '+b+'.')+(gearPrize?'\n'+gearPrize:'');const art=game==='dice'?'<div class="tavernTable tavernRolled"><div>You'+tavernDie(a)+'</div><span class="tavernVersus">vs</span><div>Innkeeper'+tavernDie(b)+'</div></div>':'<div class="tavernTable tavernRolled"><span class="tavernCoin">'+(a==='heads'?'✦':'◈')+'</span></div>';tavernPanel(title+'\n'+detail+(gearPrize?'\n'+gearPrize:'')+'\nWager: '+stake+' · Purse: '+before+' → '+player.coins+' crowns.',[{label:'Play again · Choose wager',action:()=>chooseTavernWager(game)},{label:'Choose another game',action:openTavern},{label:'Leave the tavern',action:()=>{}}],art);return true;}
function tavernCanWager(stake){return hasStarted&&activeMap.town&&!!tavernNames[mapId]&&[1,5,10,25].includes(stake)&&player.coins>=stake&&Date.now()>=tavernRollReadyAt&&!tavernHandActive()}
function recordTavernRound(game,stake,before,result,extra={}){const st=tavernStats(),net=player.coins-before;st.played++;st[result==='win'?'wins':result==='loss'?'losses':'pushes']++;st.net+=net;const gearPrize=tavernGearPrize(game,stake,result);st.lastRound={game,stake,before,after:player.coins,result,net,town:mapId,time:Date.now(),gearPrize,...extra};tavernRollReadyAt=Date.now()+600;saveGame();ui();}
function tavernResult(game,stake,before,result,detail,art){const net=player.coins-before,gearPrize=tavernStats().lastRound?.gearPrize||'',title=result==='win'?'You win! +'+net+' crown'+(net===1?'':'s'):result==='push'?'Your wager is returned.':'You lose your wager. −'+stake+' crown'+(stake===1?'':'s');tavernPanel(title+'\n'+detail+'\nWager: '+stake+' · Purse: '+before+' → '+player.coins+' crowns.',[{label:'Play again · Choose wager',action:()=>chooseTavernWager(game)},{label:'Choose another game',action:openTavern},{label:'Leave the tavern',action:()=>{}}],art);}
function tavernDeck(){const deck=[];for(const suit of ['♠','♥','♦','♣'])for(let rank=1;rank<=13;rank++)deck.push({rank,suit});for(let i=deck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]]}return deck}
function tavernCard(card,hidden=false){if(hidden)return '<span class="tavernCard cardBack" role="img" aria-label="Face-down card">✦</span>';const rank=({1:'A',11:'J',12:'Q',13:'K'})[card.rank]||card.rank;return '<span class="tavernCard '+(['♥','♦'].includes(card.suit)?'cardRed':'')+'" role="img" aria-label="'+rank+' '+card.suit+'"><small>'+rank+'</small><b>'+card.suit+'</b></span>'}
function playTavernExtra(game,stake){if(!['slots','highcard'].includes(game)||!tavernCanWager(stake))return false;const before=player.coins;let result,detail,art,extra;if(game==='slots'){const reels=Array.from({length:3},()=>Math.floor(Math.random()*5)),same=new Set(reels).size,mult=same===1?(reels[0]===0?20:10):same===2?1:0;player.coins+=stake*(mult-1);result=mult>1?'win':mult===1?'push':'loss';detail=reels.map(i=>tavernSymbols[i].name).join(' · ')+'\nTotal return: '+stake*mult+' crowns (includes your stake).';art='<div class="tavernSlots tavernRolled">'+reels.map(i=>'<div class="tavernReel" role="img" aria-label="'+tavernSymbols[i].name+'"><b>'+tavernSymbols[i].glyph+'</b><small>'+tavernSymbols[i].name+'</small></div>').join('')+'</div>';extra={reels,mult};}else{const deck=tavernDeck(),a=deck.pop(),b=deck.pop(),value=c=>c.rank===1?14:c.rank;result=value(a)>value(b)?'win':value(a)===value(b)?'push':'loss';player.coins+=result==='win'?stake:result==='loss'?-stake:0;detail='Aces are high. '+(result==='push'?'Equal ranks tie.':'Higher rank wins.');art='<div class="tavernTable"><div>You'+tavernCard(a)+'</div><span>vs</span><div>Innkeeper'+tavernCard(b)+'</div></div>';extra={a,b};}recordTavernRound(game,stake,before,result,extra);tavernResult(game,stake,before,result,detail,art);return true;}
function blackjackValue(cards){let total=0,aces=0;for(const c of cards){total+=c.rank===1?11:Math.min(c.rank,10);if(c.rank===1)aces++}while(total>21&&aces-- >0)total-=10;return total}
function startBlackjack(stake){if(!tavernCanWager(stake))return false;const deck=tavernDeck(),hand={status:'active',town:mapId,stake,before:player.coins,deck,playerCards:[deck.pop(),deck.pop()],dealerCards:[deck.pop(),deck.pop()]};tavernStats().hand=hand;player.coins-=stake;saveGame();ui();if(blackjackValue(hand.playerCards)===21||blackjackValue(hand.dealerCards)===21)settleBlackjack(true);else showBlackjack();return true;}
function blackjackAction(action){const hand=tavernStats().hand;if(!hasStarted||!activeMap.town||!tavernNames[mapId]||!hand||hand.status!=='active'||!['hit','stand'].includes(action))return false;if(action==='hit'){hand.playerCards.push(hand.deck.pop());saveGame();if(blackjackValue(hand.playerCards)>=21)settleBlackjack();else showBlackjack();}else settleBlackjack();return true;}
function settleBlackjack(natural=false){const h=tavernStats().hand;if(!h||h.status!=='active')return false;const p=blackjackValue(h.playerCards);if(!natural&&p<=21)while(blackjackValue(h.dealerCards)<17)h.dealerCards.push(h.deck.pop());const d=blackjackValue(h.dealerCards),pn=h.playerCards.length===2&&p===21,dn=h.dealerCards.length===2&&d===21,result=p>21?'loss':pn||dn?(pn&&dn?'push':pn?'win':'loss'):d>21||p>d?'win':p===d?'push':'loss';h.status='settled';h.result=result;player.coins+=result==='win'?h.stake*2:result==='push'?h.stake:0;recordTavernRound('blackjack',h.stake,h.before,result,{playerCards:h.playerCards,dealerCards:h.dealerCards});showBlackjack();return true;}
function showBlackjack(){const h=tavernStats().hand;if(!h)return;const active=h.status==='active',p=blackjackValue(h.playerCards),d=blackjackValue(h.dealerCards),art='<div class="blackjackTable"><div class="blackjackRow"><span>Innkeeper · '+(active?'?':d)+'</span><div>'+h.dealerCards.map((c,i)=>tavernCard(c,active&&i>0)).join('')+'</div></div><div class="blackjackRow"><span>You · '+p+'</span><div>'+h.playerCards.map(c=>tavernCard(c)).join('')+'</div></div></div>';if(!active){tavernResult('blackjack',h.stake,h.before,h.result,(p>21?'You bust.':d>21?'The innkeeper busts.':p===21&&h.playerCards.length===2?'Blackjack!':'Hand complete.')+' Your total: '+p+' · Innkeeper: '+d+'.',art);return}tavernPanel('BLACKJACK · Wager: '+h.stake+' crown'+(h.stake===1?'':'s')+' (already placed).\nHit to draw a card. Stand to let the innkeeper play.\nYour hand saves after every draw. You can leave and resume later.',[{label:'Hit · Draw a card',action:()=>blackjackAction('hit')},{label:'Stand · Finish hand',action:()=>blackjackAction('stand')},{label:'Leave table · Resume later',action:()=>{saveGame()}}],art);}

// Repeatable hunting contracts use each character's existing persistent quest state.
const slayerContracts={
 ash_slimes:{title:'Ash Slime Patrol',monster:'Ash Slimes',area:'whisperwood',kind:'slime',level:1,target:8,coins:30,xp:25,marks:1,hint:'Search along the forest road and the old stones. Slimes return after 18 seconds.'},
 fen_stalkers:{title:'Fangs in the Fen',monster:'Fen Stalkers',area:'redfen',kind:'spider',level:2,target:6,coins:45,xp:35,marks:2,hint:'Search the northern marsh clearings. Keep moving to evade venom spit.'},
 briar_spiders:{title:'The Briar Web',monster:'Briar Spiders',area:'greenhollow',kind:'spider',level:2,target:6,coins:45,xp:35,marks:2,hint:'Search the woodland clearings and eastern trail. Watch for venom attacks.'},
 moor_wardens:{title:'Silence the Old Guard',monster:'Moor Wardens',area:'highmoor',kind:'skeleton',level:4,target:10,coins:70,xp:55,marks:3,hint:'Search around the ruined keep. Dodge the wardens’ heavy cleaves.'},
 willow_stalkers:{title:'Willowfang Hunt',monster:'Willow Stalkers',area:'willowfen',kind:'spider',level:4,target:8,coins:70,xp:55,marks:3,hint:'Search the marsh clearings on both sides of the trail. Bring healing supplies.'},
 frost_weavers:{title:'Webs of Winter',monster:'Ice Cave Weavers',area:'frostmarch',kind:'spider',level:6,target:10,coins:100,xp:75,marks:4,hint:'Search near the pass and eastern snowfields. Weavers return after 50 seconds.'},
 glass_sentinels:{title:'Shattered Watch',monster:'Glass Ridge Sentinels',area:'glassridge',kind:'skeleton',level:7,target:10,coins:120,xp:90,marks:5,hint:'Search the ridge clearings. Sentinels hit hard; bring upgraded armor.'}
};
const slayerRanks=[{name:'Novice',marks:0,bonus:0},{name:'Tracker',marks:5,bonus:40},{name:'Hunter',marks:15,bonus:80},{name:'Warden',marks:35,bonus:160},{name:'Master Slayer',marks:70,bonus:300}];
function slayerState(){return townQuestState._slayers||(townQuestState._slayers={joined:false,marks:0,completed:0,hunts:{},rankRewards:[]})}
function slayerHunt(id){return slayerState().hunts[id]||null}
function slayerRank(){const marks=slayerState().marks;if(marks>=120){const tier=Math.floor((marks-70)/50);return {name:'Legend '+tier,marks:70+tier*50,bonus:150}}return slayerRanks.filter(r=>marks>=r.marks).at(-1)}
function nextSlayerRank(){const marks=slayerState().marks;return slayerRanks.find(r=>r.marks>marks)||{name:'Legend '+(Math.floor(Math.max(0,marks-70)/50)+1),marks:70+(Math.floor(Math.max(0,marks-70)/50)+1)*50,bonus:150}}
function openMultiplayerPreview(){openAdventureDialog('Multiplayer & Clans','Single player is available now. Online play is not connected yet.\n\nThe next online milestone is a shared town and four-player cooperative dungeon. Clans will have a leader, officers and members, with invitations and shared goals. Founders must complete every quest on the current release checklist first; repeatable quests count once. Joining a clan does not require this.\n\nYour solo character stays separate from future online characters. TheDanCode remains a solo testing feature.',[{label:'Co-op parties · Coming later',disabled:true,action:()=>{}},{label:'Create or join a clan · Coming later',disabled:true,action:()=>{}},{label:'Continue single player',action:()=>{}}])}
function openContinuingAdventure(){const st=slayerState();openAdventureDialog('The Reach Lives On','Every chapter can end. Your life in the Reach continues.\n\n'+st.completed+' contracts cleared · '+slayerRank().name+'\nNext hall milestone: '+nextSlayerRank().name+' at '+nextSlayerRank().marks+' marks.\n\nHunts remain repeatable. Alternating hunting grounds earns a 20% crown bonus. Legend ranks continue every 50 marks beyond Master. Cleared sanctums offer challenge replays and Ancient Alloy for your gear. Your settlement still needs builders, workers and decisions.',[{label:atSlayersHall()?'Visit the hunting board':'Find a town Slayers Hall',action:()=>{if(atSlayersHall())openSlayerBoard(0);else openTravelScreen()}},{label:'Develop your settlement',action:openSettlement},{label:'Review quests',action:openQuestJournal},{label:'Explore the world',action:openTravelScreen},{label:'Return to adventure',action:()=>{}}])}

function slayerTerms(id){const d=slayerContracts[id],tier=Math.min(5,slayerHunt(id)?.completed||0);return {target:d.target+tier*2,coins:Math.round(d.coins*(1+tier*.1)*(slayerState().lastCompleted&&slayerState().lastCompleted!==id?1.2:1)),xp:Math.round(d.xp*(1+tier*.1)),marks:d.marks,tier}}
function slayerActive(){return Object.entries(slayerState().hunts).filter(([id,h])=>slayerContracts[id]&&h.accepted)}
function atSlayersHall(){return hasStarted&&activeMap.town&&!!tavernNames[mapId]}
function slayerRewardText(t){return t.coins+' crowns · '+t.xp+' XP · '+t.marks+' Slayer Mark'+(t.marks===1?'':'s')}
function slayerPanel(text,choices,art=''){if(!atSlayersHall())return;openAdventureDialog('Monster Slayers Hall',text,choices);const panel=document.getElementById('adventureScreen');panel.classList.add('slayerView');panel.querySelector('.screenClose').setAttribute('aria-label','Close Slayers Hall');document.getElementById('adventureText').innerHTML=art+'<div class="slayerCopy">'+questEscape(text).replace(/\n/g,'<br>')+'</div>';panel.querySelector('.screenFoot').textContent='Accepted hunts save with this character. Turn in rewards at any Slayers Hall.';}
function slayerCrest(){return '<svg class="slayerCrest" viewBox="0 0 80 80" aria-hidden="true"><path d="M40 5 68 16v24c0 17-15 28-28 35C27 68 12 57 12 40V16Z" fill="#25332b" stroke="#cba65d" stroke-width="2"/><path d="m24 22 31 35m0-35L24 57m-5-8 13 12m16 0 13-12" stroke="#e6d1a0" stroke-width="4"/><circle cx="40" cy="35" r="8" fill="#cba65d"/><path d="M36 33h2m4 0h2m-8 7h8" stroke="#25332b" stroke-width="3"/></svg>'}
function slayerHeader(){const st=slayerState(),rank=slayerRank(),next=nextSlayerRank(),pct=next?Math.round((st.marks-rank.marks)/(next.marks-rank.marks)*100):100;return '<div class="slayerHeader">'+slayerCrest()+'<div><span class="slayerEyebrow">THE HUNTERS’ LEDGER</span><h3>'+rank.name+'</h3><p>'+st.marks+' Slayer Marks · '+st.completed+' contracts cleared</p></div></div><div class="slayerRankTrack" role="progressbar" aria-label="Hall rank progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="'+pct+'"><i style="width:'+pct+'%"></i></div><p class="slayerRankHint">'+(next?(next.marks-st.marks)+' marks to '+next.name+' · Rank reward: '+next.bonus+' crowns':'Master rank earned · The hall remembers your deeds')+'</p>'}
function openSlayersHall(){if(!atSlayersHall())return;const st=slayerState();if(!st.joined){st.joined=true;saveGame()}const active=slayerActive(),ready=active.filter(([id,h])=>h.kills>=h.target).length;slayerPanel('“Find the beast. Finish the hunt. Bring the road home safe.” — Warden Rook\n\nOne optional contract at a time. Finish or pause it before taking another. Only kills after acceptance count; your pet can help. Completed hunts earn crowns, XP, and permanent Slayer Marks.\n\n'+(active.length?active.length+' hunts accepted'+(ready?' · '+ready+' ready for reward.':'.'):'Your ledger is empty. Take a contract from the board.'),[{label:'Browse hunting contracts',action:()=>openSlayerBoard(0)},{label:'Active hunts · '+active.length+' accepted',disabled:!active.length,action:openSlayerActive},{label:'Hall ranks & rewards',action:openSlayerRanks},{label:'Leave the hall',action:()=>{}}],slayerHeader());}
function slayerContractCard(id){const d=slayerContracts[id],h=slayerHunt(id),active=!!h?.accepted,t=active?h:slayerTerms(id),ready=active&&h.kills>=h.target,pct=active?Math.round(Math.min(h.kills,t.target)/t.target*100):0;return '<article class="slayerContract '+(ready?'slayerReady':'')+'"><div class="slayerContractTop"><span>'+ (ready?'READY TO TURN IN':active?'ACTIVE HUNT':'LEVEL '+d.level+'+')+'</span><span>'+ (h?.completed?'Cleared '+h.completed+'×':'First contract')+'</span></div><h3>'+d.title+'</h3><p>'+d.monster+' · '+maps[d.area].name+'</p><div class="slayerContractMeter"><i style="width:'+pct+'%"></i></div><p class="slayerContractGoal">'+(active?h.kills+' / '+t.target+' defeated':'Hunt '+t.target+' monsters')+'</p><p class="slayerContractReward">'+slayerRewardText(t)+'</p></article>'}
function openSlayerBoard(page=0){const ids=Object.keys(slayerContracts),pages=Math.ceil(ids.length/3);page=clamp(Math.floor(Number(page)||0),0,pages-1);const shown=ids.slice(page*3,page*3+3);slayerPanel('CONTRACT BOARD · Page '+(page+1)+' of '+pages+'\nInspect a contract for its hunting grounds, rules, and rewards.',[...shown.map(id=>({label:slayerContracts[id].title+' · Inspect',action:()=>openSlayerContract(id)})),...(page>0?[{label:'Previous contracts',action:()=>openSlayerBoard(page-1)}]:[]),...(page<pages-1?[{label:'More contracts',action:()=>openSlayerBoard(page+1)}]:[]),{label:'Back to the hall',action:openSlayersHall}],'<div class="slayerBoard">'+shown.map(slayerContractCard).join('')+'</div>');}
function openSlayerActive(){const active=slayerActive();if(!active.length){openSlayersHall();return}slayerPanel('YOUR ACTIVE HUNTS\nReturn here when the ledger says ready. You may turn in at any town’s hall.',[...active.map(([id,h])=>({label:slayerContracts[id].title+(h.kills>=h.target?' · Claim reward':' · View hunt'),action:()=>openSlayerContract(id)})),{label:'Back to the hall',action:openSlayersHall}],'<div class="slayerBoard">'+active.map(([id])=>slayerContractCard(id)).join('')+'</div>');}
function openSlayerContract(id){const d=slayerContracts[id];if(!d||!atSlayersHall())return;const h=slayerHunt(id),active=!!h?.accepted,ready=active&&h.kills>=h.target,t=active?h:slayerTerms(id),full=journalActiveRows().some(q=>journalKind(q.id)==='optional'),locked=player.level<d.level;const choices=active?[...(ready?[{label:'Claim · '+slayerRewardText(t),action:()=>claimSlayerContract(id)}]:[{label:'Track this hunt',action:()=>{townQuestState._tracking={id:'slayer_'+id};saveGame();ui();say('Tracking '+d.title+'.');}},{label:'Show hunting grounds on map',action:()=>{openTravelScreen();markQuestDestination('slayer_'+id)}}]),{label:'Abandon hunt',action:()=>confirmAbandonSlayer(id)}]:[{label:locked?'Unlocks at level '+d.level:full?'Optional quest slot occupied':'Accept hunt · '+t.target+' monsters',disabled:locked||full,action:()=>acceptSlayerContract(id)}];slayerPanel(d.title.toUpperCase()+'\nHunting grounds: '+maps[d.area].name+' · Level '+d.level+'+\n'+d.hint+'\n\n'+(active?(ready?'The contract is complete. Claim your reward below.':'Defeat '+Math.max(0,h.target-h.kills)+' more '+d.monster+'. Kills by your active party count.'):'Defeat '+t.target+' '+d.monster+' in this region after accepting. Previous kills do not count. Accepting will track this hunt.')+'\n\nRepeat contracts ask for two more monsters per clear, up to five increases, with higher crown and XP rewards. Marks build permanent hall rank. After Master, Legend ranks continue every 50 marks. Choosing a different contract after a clear adds 20% crowns; the displayed reward includes it.',[...choices,{label:'Back to the hall',action:openSlayersHall}],slayerContractCard(id));}
function acceptSlayerContract(id){if(!journalCanAccept('slayer_'+id))return false;const d=slayerContracts[id];if(!d||!atSlayersHall()||player.level<d.level||slayerHunt(id)?.accepted||slayerActive().length>=3)return false;const st=slayerState(),old=slayerHunt(id),t=slayerTerms(id);st.joined=true;st.hunts[id]={...t,accepted:true,kills:0,completed:old?.completed||0,acceptedAt:Date.now()};townQuestState._tracking={id:'slayer_'+id};saveGame();ui();openSlayerContract(id);return true;}
function claimSlayerContract(id){const d=slayerContracts[id],h=slayerHunt(id);if(!d||!atSlayersHall()||!h?.accepted||h.kills<h.target)return false;const st=slayerState(),oldLegend=Math.floor(Math.max(0,st.marks-70)/50);h.accepted=false;h.completed=(h.completed||0)+1;st.completed++;st.marks+=h.marks;st.lastCompleted=id;player.coins+=h.coins;grantXp(h.xp);let bonus=0;for(const r of slayerRanks)if(r.bonus&&st.marks>=r.marks&&!st.rankRewards.includes(r.name)){st.rankRewards.push(r.name);bonus+=r.bonus}bonus+=Math.max(0,Math.floor(Math.max(0,st.marks-70)/50)-oldLegend)*150;player.coins+=bonus;if(trackedQuestId()==='slayer_'+id)delete townQuestState._tracking;saveGame();ui();playSfx('quest');slayerPanel('CONTRACT CLEARED · '+d.title+'\n'+slayerRewardText(h)+(bonus?'\nRank reward: +'+bonus+' crowns · '+slayerRank().name+'!':'')+'\n\nYour reward is saved. A harder version of this contract is now on the board.',[{label:'Browse more contracts',action:()=>openSlayerBoard(0)},{label:'Back to the hall',action:openSlayersHall}],slayerHeader());return true;}
function confirmAbandonSlayer(id){const h=slayerHunt(id);if(!slayerContracts[id]||!h?.accepted)return;slayerPanel('Abandon '+slayerContracts[id].title+'?\nYour '+h.kills+' recorded kills will be lost. No fee is charged; you may accept it again and start fresh.',[{label:'Keep hunting',action:()=>openSlayerContract(id)},{label:'Abandon · Lose progress',action:()=>abandonSlayerContract(id)}]);}
function abandonSlayerContract(id){const h=slayerHunt(id);if(!slayerContracts[id]||!atSlayersHall()||!h?.accepted)return false;h.accepted=false;h.kills=0;if(trackedQuestId()==='slayer_'+id)delete townQuestState._tracking;saveGame();ui();openSlayersHall();return true;}
function slayerTarget(area,e){return !!townQuestState._slayers&&slayerActive().some(([id,h])=>h.kills<h.target&&slayerContracts[id].area===area&&slayerContracts[id].kind===e.kind)}
function recordSlayerKill(area,e){if(!townQuestState._slayers||!e||e.alive||maps[area]?.town)return;let changed=false;for(const [id,h] of slayerActive()){const d=slayerContracts[id];if(h.kills>=h.target||d.area!==area||d.kind!==e.kind)continue;h.kills=Math.min(h.target,h.kills+1);changed=true;}if(changed)saveGame();}
function openSlayerRanks(){slayerPanel('HALL RANKS\nSlayer Marks are permanent reputation, not a spendable currency. Each new rank pays its crown reward once when you turn in a hunt. Beyond Master, each 50 marks earns another Legend rank and 150 crowns, with no final rank.',[{label:'Back to the hall',action:openSlayersHall}],slayerHeader()+'<div class="slayerRanks">'+slayerRanks.map(r=>'<div><b>'+r.name+'</b><span>'+r.marks+' marks · '+(r.bonus?r.bonus+' crown reward':'Starting rank')+(slayerState().marks>=r.marks?' · Earned':'')+'</span></div>').join('')+'</div>');}
function slayerQuestEntries(){const st=townQuestState._slayers,rows=[{id:'slayer_intro',title:'The Monster Slayers Hall',desc:'Find Warden Rook at the signed hall beside the tavern in any town. Take hunting contracts and return for rewards.',reward:'Repeatable hunts · crowns · XP · Slayer Marks and hall ranks',done:!!st?.joined,active:false}];if(st)for(const [id,h] of slayerActive()){const d=slayerContracts[id];rows.push({id:'slayer_'+id,title:'Slayers · '+d.title,desc:'Defeat '+h.target+' '+d.monster+' in '+maps[d.area].name+'. '+d.hint+' Return to any town’s hall for your reward.',reward:'Reward: '+slayerRewardText(h),done:false,active:true})}return rows;}

let gearUpgradeLevels={};let gatheringSkills={mining:{xp:0,level:1},woodcutting:{xp:0,level:1},fishing:{xp:0,level:1}};function normalizeGatheringSkills(saved){const out={};for(const id of ['mining','woodcutting','fishing']){const row=saved&&saved[id]||{},xp=Math.max(0,Math.floor(Number(row.xp)||0));out[id]={xp,level:Math.max(1,Math.min(10,1+Math.floor(xp/50)))}}return out}
