function resizeWorldView(){const rect=c.getBoundingClientRect();if(rect.width<1||rect.height<1)return;const nextW=rect.height>rect.width?480:960,nextH=Math.round(nextW*rect.height/rect.width);if(c.width!==nextW||c.height!==nextH){c.width=viewW=nextW;c.height=viewH=nextH;ctx.imageSmoothingEnabled=false;updateCamera()}}
new ResizeObserver(resizeWorldView).observe(c);
