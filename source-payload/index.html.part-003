 mosslight:{entries:{default:[55,520],from_whisperwood:[55,520],from_rootmaze:[850,520]},exits:[{trigger:'edge',side:'north',to:'sunmere'},{trigger:'edge',side:'west',to:'greenhollow'},{trigger:'edge',side:'east',to:'brackenford'},{trigger:'edge',side:'south',to:'redfen'},{trigger:'interact',x:850,y:550,radius:68,to:'shrine_rootmaze',entry:'from_mosslight',requires:'shrine_floor1',lockedMessage:'Solve the lantern order and claim the Ember Rune to open the lower stair.'}]},
 brackenford:{entries:{default:[480,340],from_home:[490,190]},exits:[{trigger:'edge',side:'north',to:'frostmarch'},{trigger:'edge',side:'west',to:'mosslight',requires:'fourfold_key',lockedMessage:'Complete all four personal stories to open the shrine road.'},{trigger:'edge',side:'south',to:'willowfen'},{trigger:'interact',x:490,y:130,radius:58,to:'brackenford_home',entry:'front_door',requires:'home_owned'}]},
