const homeDefs={ashvale:{map:'ashvale_home',name:'Ashvale Watch House',class:'warrior',wall:'#8a603a',roof:'#633b31'},brackenford:{map:'brackenford_home',name:'Brackenford Outrider House',class:'rogue',wall:'#8a7350',roof:'#49372d'},stonewatch:{map:'stonewatch_home',name:'Stonewatch Cloister House',class:'cleric',wall:'#aaa78d',roof:'#4b5158'},sunmere:{map:'sunmere_home',name:'Sunmere Arcanum House',class:'mage',wall:'#6f9aa0',roof:'#38586e'}};
function blankHouseStorage(){return Object.fromEntries(Object.keys(homeDefs).map(id=>[id,{front_chest:[],side_chest:[]}]))}
function normalizeHouseStorage(saved){const out=blankHouseStorage();if(!saved||typeof saved!=='object')return out;for(const id of Object.keys(homeDefs)){const box=saved[id];if(box&&typeof box==='object')for(const chest of ['front_chest','side_chest'])if(Array.isArray(box[chest]))out[id][chest]=box[chest]}if(Array.isArray(saved.front_chest))out.brackenford.front_chest=saved.front_chest;if(Array.isArray(saved.side_chest))out.brackenford.side_chest=saved.side_chest;return out}
function ownsHome(id){return !!ownedHomes[id]||(id==='brackenford'&&houseBought)}

