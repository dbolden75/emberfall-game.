maps.ashvale.npcs.push({x:500,y:405,name:'Dalen the Guard',role:'companion',companionId:'dalen',lines:['I shut Ashvale’s gate while my patrol was still outside. I will not leave anyone behind again. Help me recover their signal in Whisperwood.'],talk:0});maps.brackenford.npcs.push({x:480,y:405,name:'Sylvi the Outrider',role:'companion',companionId:'sylvi',lines:['I hid a warning map because I feared what the council would do. Scouts are stranded in Redfen because of my silence. I need to make this right.'],talk:0});maps.stonewatch.npcs.push({x:470,y:405,name:'Corin the Acolyte',role:'companion',companionId:'corin',lines:['When Stonewatch’s vigil bell rang, I froze. The dead rose while I stayed silent. I will return to Highmoor and finish the rites.'],talk:0});maps.sunmere.npcs.push({x:500,y:405,name:'Eryn the Arcanist',role:'companion',companionId:'eryn',lines:['My experiment cracked Sunmere’s beacon ward. I have hidden it long enough. Help me mend the beacon before another storm reaches the harbor.'],talk:0});
maps.sunmere.npcs.push({x:820,y:235,name:'Ilan the Arcanist Smith',lines:['I shape tools and armor for the Sunmere Arcanum. Bring ore and timber if you want your mage gear reforged.'],talk:0,shopId:'sunmere_forge'});maps.ashvale.npcs.push({x:650,y:218,name:'Steward Hal',role:'house_broker',homeId:'ashvale',lines:['The Watch house is ready for a new keeper.'],talk:0});maps.stonewatch.npcs.push({x:700,y:220,name:'Keeper Ysra',role:'house_broker',homeId:'stonewatch',lines:['A quiet cloister house is available to a faithful owner.'],talk:0});maps.sunmere.npcs.push({x:700,y:220,name:'Quartermaster Noll',role:'house_broker',homeId:'sunmere',lines:['The Arcanum house has a clear view of the harbor.'],talk:0});
// One frontage layout drives houses, signs, paths, and NPC feet in every town.
