,160],[370,430],[610,160],[775,430]],enemies:[{x:300,y:215,hp:3,alive:true,seed:9,kind:'skeleton'},{x:490,y:390,hp:3,alive:true,seed:10,kind:'spider'},{x:760,y:300,hp:6,alive:true,seed:11,kind:'warden',boss:true}],npcs:[],traps:[{x:230,y:300,armed:true},{x:635,y:300,armed:true}],treasure:{x:865,y:300,opened:false}}};

