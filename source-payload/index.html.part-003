const briarClues={
 briar_bell:'The bell lies in the weeds. Its rope was severed before the attack. A message scratched beneath the platform reads: “They waited until we could not warn the road.” This bell fell before the strange silence that spread through the Reach.',
 briar_clinic:'The infirmary ledger names six residents treated for paired wounds and terrible weakness. The last line is hurried: “They returned for the living. We hid the children beneath the mill.” A supply note lists the same blue-cord medicine cases carried along the road.',
 briar_gate:'The watch log records covered wagons arriving after sunset. “We offered shelter. At midnight their passengers opened the gates from within.” Beneath it: “The pale man in the black cloak fought them. I saw him carry a child out.”'
};
function briarState(){return townQuestState.briar_hollow||(townQuestState.briar_hollow={accepted:false,clues:[],rescued:false,claimed:false});}
function briarGuide(){const s=townQuestState.briar_hollow||{},n=(s.clues||[]).length;return {destination:'briarhollow',detail:s.claimed?'Briar Hollow’s dead are remembered. Ada escaped; the missing residents were taken alive.':!s.accepted?'Read the fallen town sign in Briar Hollow, one region north of Ashvale.':n<3?'Inspect the broken bell, infirmary ledger, and gate watch log.':!s.plan?'Speak through the cellar door beside the ruined mill.':!s.rescued?'Light the road signal to guide Ada out through the drainage channel.':'Record the names at the remembrance stone in the square.',progress:s.claimed?'Complete':n+'/3 clues · '+(s.rescued?'Survivor safe':s.plan?'Escape prepared':'Search for survivors'),ready:!!s.rescued&&!s.claimed};}
function briarQuestEntry(){const s=townQuestState.briar_hollow||{};return {id:'briar_hollow',title:'The Town That Did Not Wake',desc:briarGuide().detail,reward:'35 crowns · 40 XP · Ada’s testimony and the missing residents’ names',done:!!s.claimed,active:!!s.accepted&&!s.claimed};}
function briarCommit(){saveGame();ui();}
function briarDialog(title,text,choices=[{label:'Continue',action:()=>{}}]){openAdventureDialog(title,text,choices);}
function briarInteract(obj){
 if(!obj.id.startsWith('briar_'))return false;
 if(!journalCanAccept('briar_hollow'))return true;
 const s=briarState();s.clues=s.clues||[];
 if(obj.id==='briar_sign'){
  if(s.claimed){briarDialog('Briar Hollow','The village remains empty. At the stone in the square, every recovered name has been recorded. Ada reached the road safely.');return true;}
  if(s.accepted){briarDialog('The Town That Did Not Wake',briarGuide().detail);return true;}
  briarDialog('Briar Hollow','A dinner table stands beneath a roof open to the sky. The houses were searched, not looted. Beyond the square, the bell lies in the weeds.\n\nA fallen sign reads: BRIAR HOLLOW — A BED FOR EVERY TRAVELER.',[{label:'Investigate the abandoned town',action:()=>{s.accepted=true;briarCommit();briarDialog('The Town That Did Not Wake',briarGuide().detail);}},{label:'Leave for now',action:()=>{}}]);return true;
 }
 if(!s.accepted){say('Read the fallen town sign in the square first.');return true;}
 if(briarClues[obj.id]){if(!s.clues.includes(obj.id))s.clues.push(obj.id);briarCommit();briarDialog(obj.label,briarClues[obj.id]+(s.clues.length===3?'\n\nFrom beneath the ruined mill: three faint knocks.':''));return true;}
 if(obj.id==='briar_cellar'){
  if(s.rescued){briarDialog('An empty cellar','Ada is safe. Her blanket is folded beside an empty water jug.');return true;}
  if(s.clues.length<3){briarDialog('The cellar door','Someone holds the door shut from below. “Tell me what happened at the gate. I won’t open it for another stranger.”\n\nFinish searching the bell, infirmary, and watch log.');return true;}
  if(s.plan){briarDialog('Ada beneath the mill','“The drainage channel reaches the roadside. Light the signal. I’ll come out when I can see it.”');return true;}
  briarDialog('Ada, the mill keeper','“Vampires. There, I said it. They took my neighbors away breathing.”\n\nYou mention the black cloak.\n\n“He fought them. They called him a traitor. I don’t know what that makes him. I know whose hands opened this cellar for us.”\n\n“The others escaped yesterday. I stayed to find my brother’s name in the ledger. Help me reach the road.”',[
   {label:'Keep watch while Ada prepares (no supplies needed)',action:()=>{if(s.plan)return;s.plan='watch';briarCommit();briarDialog('A little courage','You keep watch while Ada binds her ankle with cloth from the mill.\n\n“I thought nobody was coming. Light the road signal. I can manage the channel.”');}},
   {label:'Give Ada a Field Ration (uses 1)',disabled:bagCount('field_ration')<1,action:()=>{if(s.plan)return;if(bagCount('field_ration')<1){say('You need one Field Ration, or you can keep watch for free.');return;}removeItem('field_ration',1);s.plan='ration';briarCommit();briarDialog('A meal shared','Ada eats slowly, then wraps the remaining bread. “For when I find him.”\n\nLight the road signal to guide her out.');}},
   {label:'I’ll return',action:()=>{}}
  ]);return true;
 }
 if(obj.id==='briar_signal'){
  if(!s.plan){say('Search the town and speak to the survivor first.');return true;}
  if(s.rescued){briarDialog('A light on the road','The signal burns beside the empty channel. Ada is already beyond the ruined town.');return true;}
  s.rescued=true;briarCommit();briarDialog('Someone made it out','You kindle the sheltered road lamp. Ada emerges from the drainage channel and takes the path toward Ashvale.\n\n“Write their names down,” she says. “People will call this place empty. It wasn’t always.”\n\nReturn to the remembrance stone in the square.');return true;
 }
 if(obj.id==='briar_memorial'){
  if(s.claimed){briarDialog('The names remain','Ada — escaped. Tomas, Elset, Brenna — missing, taken alive. The others are remembered here.\n\nThe abandoned town has become a place of remembrance.');return true;}
  if(!s.rescued){say('Help the survivor reach the road before recording the town’s fate.');return true;}
  s.claimed=true;s.names=['Tomas','Elset','Brenna'];player.coins+=35;grantXp(40);briarCommit();playSfx('quest');briarDialog('The Town That Did Not Wake','You carve the recovered names into the stone. Beside three, you write MISSING.\n\nThe raiders were vampires. The stranger in the black cloak opposed them. Beyond that, Ada could give you no certainty.\n\nQuest complete · 35 crowns · 40 XP.\n\nThe names and Ada’s testimony remain in your journal.');return true;
 }
 return true;
}
function drawBriarHollow(){
 if(mapId!=='briarhollow')return;
 ctx.save();
 for(const [x,y,w,h] of briarRuins){
  // Keep the existing collision footprint, with textured stone ruins inside it.
  ctx.save();ctx.fillStyle='#141b1855';ctx.beginPath();ctx.ellipse(x+w/2,y+h-5,w*.48,12,0,0,Math.PI*2);ctx.fill();
  const f=detailedFrames.environment.ruin,scale=Math.min(w/f[2],h/f[3]);
  paintArt('ruin',x+(w-f[2]*scale)/2,y+h-f[3]*scale,f[2]*scale,f[3]*scale);
  ctx.restore();
 }
 for(const o of activeMap.worldObjects||[]){if(!o.id.startsWith('briar_'))continue;
  const s=townQuestState.briar_hollow||{},lit=o.id==='briar_signal'&&s.rescued;
  const art=o.id==='briar_signal'?'campfire':o.id==='briar_cellar'?'trap':o.id==='briar_memorial'?'runestone':o.id==='briar_sign'?'notice':o.id==='briar_clinic'?'scroll':'tablet';
  const group=['trap','notice','scroll','tablet'].includes(art)?'extras':'environment';
  if(!standArt(art,o.x,o.y,38,group)){ctx.fillStyle=lit?'#eab36a':'#85745c';ctx.fillRect(o.x-12,o.y-22,24,25);}
  if(lit){ctx.fillStyle='#ffd883';ctx.beginPath();ctx.arc(o.x,o.y-28,7,0,Math.PI*2);ctx.fill();}
  if(o.id==='briar_bell'){ctx.fillStyle='#887953';ctx.beginPath();ctx.ellipse(o.x,o.y-8,23,12,.4,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#211e19';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(o.x-6,o.y-18);ctx.lineTo(o.x+6,o.y-2);ctx.stroke();}
  drawLocationLabel(o.x,o.y-52,o.label);
 }
 ctx.restore();
}

// Veilhaven is a separate island town beyond Worldsend, not a fifth mainland origin.
const veilhavenBuildings=[[95,85,185,135,'hall','HOUSE OF ACCORDS'],[650,85,185,135,'shop','NIGHT CLINIC'],[390,55,180,150,'house','GUEST HOUSE']];
maps.veilhaven={name:'Veilhaven',vampireTown:true,landmark:'vampire_town',level:1,combatLevel:1,trees:[[55,90],[900,85],[80,440],[875,435]],stones:[],enemies:[],npcs:[],arrival:[480,480],hint:'Vampire sanctuary beyond the eastern sea · ferry from Worldsend, east of Hearthstead · humans welcome under the town charter.',worldObjects:[{id:'veil_charter',x:380,y:340,label:'SANCTUARY CHARTER'},{id:'veil_clinic',x:805,y:280,label:'NIGHT CLINIC'},{id:'veil_ferry',x:480,y:540,label:'FERRY TO WORLDSEND'}]};
maps.worldsend.worldObjects=(maps.worldsend.worldObjects||[]).concat({id:'veil_departure',x:750,y:315,label:'FERRY TO VEILHAVEN'});
function veilhavenInteract(o){
 if(!o.id.startsWith('veil_'))return false;
 if(o.id==='veil_charter'){openAdventureDialog('Veilhaven · The sanctuary charter','Beyond the eastern sea, Veilhaven shelters vampires who reject the raider houses. The towns of the Reach lie far across the water.\n\nNo feeding without freely given consent. No forced turning. No person is property. Human guests keep the same right to leave as every resident.\n\nVaelis keeps the accords, Mirelle runs the Night Clinic, and Orven stands watch while answering for his past. The covered streets protect residents during daylight.',[{label:'Explore Veilhaven',action:()=>{}}]);return true;}
 if(o.id==='veil_clinic'){openAdventureDialog('The Night Clinic','Mirelle keeps clean bandages and ordinary medicines for human guests as well as her own people. A screened room protects patients from daylight.\n\nRest here to recover your health. No feeding, payment, or transformation is involved.',[{label:'Rest and recover (free)',action:()=>{player.hp=player.max;saveGame();ui();say('You rest safely at the Night Clinic.');}},{label:'Leave',action:()=>{}}]);return true;}
 const leaving=o.id==='veil_ferry',destination=leaving?'worldsend':'veilhaven';
 openAdventureDialog(leaving?'Return across the eastern sea':'A town beyond the Reach',leaving?'The ferry returns to Worldsend, on the coast east of Hearthstead. The crossing is free.':'A covered ferry waits at Worldsend. Beyond the eastern sea stands Veilhaven, a vampire town far from the four towns of the Reach.\n\nHumans may visit. Passage is free, and the return ferry is always available.',[{label:leaving?'Sail to Worldsend':'Sail to Veilhaven',action:()=>takeMapExit(mapConnections[mapId].exits.find(e=>e.to===destination))},{label:'Stay here',action:()=>{}}]);return true;
}
function drawVeilhaven(){
 if(mapId==='worldsend'){standArt('notice',750,315,44,'extras');drawLocationLabel(750,255,'FERRY · VEILHAVEN');return;}
 if(mapId!=='veilhaven')return;
 ctx.save();ctx.fillStyle='#172b32';ctx.fillRect(20,30,920,540);ctx.fillStyle='#53556b';ctx.fillRect(65,245,830,170);ctx.fillRect(430,205,100,355);
 ctx.strokeStyle='#8a8598';ctx.lineWidth=2;for(let x=75;x<890;x+=35){ctx.beginPath();ctx.moveTo(x,245);ctx.lineTo(x,415);ctx.stroke();}for(let y=250;y<415;y+=35){ctx.beginPath();ctx.moveTo(65,y);ctx.lineTo(895,y);ctx.stroke();}
 for(const [x,y,w,h,art,label] of veilhavenBuildings){if(!paintArt(art,x,y,w,h)){ctx.fillStyle='#665d73';ctx.fillRect(x,y,w,h);ctx.fillStyle='#31263e';ctx.beginPath();ctx.moveTo(x-8,y);ctx.lineTo(x+w/2,y-35);ctx.lineTo(x+w+8,y);ctx.fill();}ctx.fillStyle='#292337';ctx.fillRect(x-5,y+h-8,w+10,20);ctx.fillStyle='#b889b8';ctx.fillRect(x+20,y+h+12,5,18);ctx.fillRect(x+w-25,y+h+12,5,18);drawLocationLabel(x+w/2,y-16,label);}
 for(const [x,y]of [[95,320],[855,320],[430,460],[530,460]]){standArt('lamp',x,y,45);ctx.globalAlpha=.14+.025*Math.sin(animationClock*2+x);ctx.fillStyle='#c4a6df';ctx.beginPath();ctx.arc(x,y-20,25,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;}
 for(const o of activeMap.worldObjects){standArt(o.id==='veil_charter'?'tablet':o.id==='veil_clinic'?'notice':'crate',o.x,o.y,35,'extras');drawLocationLabel(o.x,o.y-45,o.label);}
 ctx.restore();
}

// Original vampire visitors: no automatic attacks, feeding or transformation.
const vampireNpcDefs={
 vaelis:{row:0,name:'Vaelis the Witness',job:'vampire wayfarer',voice:'cautious',x:230,y:290,routineRole:'guard',past:'I was turned on a winter road sixty years ago. I remember every door that stayed closed. I came here after the wagons had gone.',hope:'I want to leave a road safer than I found it.',raid:'I arrived after the raid. The wagons left deep tracks; whoever they carried was heavy enough to slow them. The watch log is better evidence than my guesses.',cloak:'I found a strip of black cloth caught on the gate. I did not see its owner. Ask the people he helped before you decide who he was.'},
 mirelle:{row:1,name:'Mirelle of the Night Clinic',job:'vampire field healer',voice:'warm',x:715,y:290,routineRole:'healer',past:'I worked in a fever ward before I was turned. I still carry bandages. I do not take blood from the people who come to me for help.',hope:'A clinic where a patient can say no and still be cared for.',raid:'The infirmary recorded paired wounds and terrible weakness. That is not the work of the slimes outside. Read the ledger; remember that some people survived long enough to be taken.',cloak:'Cold hands can bind a wound or make one. A cloak will not tell you which. The gate watch log records what someone actually saw.'},
 orven:{row:2,name:'Orven the Deserter',job:'vampire deserter',voice:'blunt',x:555,y:375,routineRole:'guard',past:'I guarded wagons for the raiders. I told myself cargo was none of my business. Then someone inside called for her daughter. I left, but leaving did not undo it.',hope:'To give useful testimony, even when it names me.',raid:'They cut warning ropes before opening the gates. I saw that done on another road. I was not here for this attack, and I will not pretend I know which of your missing people is still alive.',cloak:'Anyone who interferes with their wagons gets called a traitor. That word tells you whose side the speaker is on, not what happened.'}
};
for(const [id,d] of Object.entries(vampireNpcDefs))maps.veilhaven.npcs.push({id:'vampire_'+id,vampireId:id,dialogueId:'vampire_'+id,name:d.name,x:d.x,y:d.y,routineRole:d.routineRole,lines:[d.past],talk:0});
const vampireNpcArt=new Image();vampireNpcArt.src='art/vampire-npcs-v1.png';
// Measured alpha bounds; use individual rectangles rather than assuming generated gutters.
const vampireNpcFrames=[
 [[121,33,198,335],[445,39,223,331],[776,40,228,332],[1145,38,228,330]],
 [[134,388,158,334],[458,387,208,340],[798,387,193,340],[1166,388,199,335]],
 [[122,732,199,329],[444,735,221,325],[769,735,234,325],[1168,734,207,325]]
];
const vampireNpcAnchors=[[215,571,909,1252],[214,569,909,1250],[213,570,907,1251]];
function vampireNpcProfile(n){const d=vampireNpcDefs[n.vampireId],s=townQuestState.briar_hollow||{};return {name:d.name,job:d.job,voice:d.voice,past:d.past,mood:s.claimed?'quietly hopeful':s.rescued?'relieved':'watchful'};}
function vampireNpcGreeting(n){const s=townQuestState.briar_hollow||{},d=vampireNpcDefs[n.vampireId];return s.claimed?'You wrote their names down. Thank you. An empty house is not the same as a forgotten person.':s.rescued?'You say Ada reached the road. That is welcome news here.':n.vampireId==='mirelle'?'Welcome to the Night Clinic. Tell me what you found at Briar Hollow.':n.vampireId==='orven'?'Yes, I am a vampire. No, that does not make me innocent. Ask plainly.':'Welcome to Veilhaven. Humans are guests here, not prey. Read our charter and judge us by it.';}
function vampireNpcReply(n,text){
 const d=vampireNpcDefs[n.vampireId],s=townQuestState.briar_hollow||{},mem=npcAgentMemory(n),t=String(text).toLowerCase();let topic='the ruins',reply;
 if(/ada|survivor|rescue/.test(t)){topic='Ada';reply=s.rescued?'Ada made it to the road. She asked that the missing people be remembered.':(s.clues||[]).length>=3?'You heard knocking beneath the mill. Speak through the cellar door; give whoever is hiding a reason to trust you.':'A traveler reported movement near Briar Hollow’s mill. Search the town before frightening anyone out of hiding.';}
 else if(/cloak|stranger|traitor/.test(t)){topic='the stranger';reply=d.cloak;}
 else if(/raid|attack|wagon|victim|missing/.test(t)){topic='the attack';reply=d.raid;}
 else if(/blood|feed|hunger|bite|turn me|vampire/.test(t)){topic='vampires';reply=n.vampireId==='mirelle'?'Hunger is real. So is restraint. I bring my own supplies. I will not feed on you or offer to turn you.':n.vampireId==='orven'?'I am responsible for what I choose, hungry or not. Being turned did not force me to guard those wagons.':'Some of us prey on people. Others oppose them. You should judge what we do, and keep asking questions.';}
 else if(/who|yourself|past|family|story/.test(t)){topic='their past';reply=d.past;}
 else if(/hope|wish|want|keeps you/.test(t)){topic='hopes';reply=d.hope;}
 else if(/trust|think of me|relationship/.test(t)){topic='trust';reply=s.claimed?'You helped Ada and recorded the missing. Those are reasons to trust you.':s.rescued?'You came back for someone who needed help. I noticed.':'We have just met. Neither of us owes the other blind trust.';}
 else if(/help|work|quest|where|direction/.test(t)){topic='the investigation';reply='You are in Veilhaven, across the eastern sea. The ferry at the south dock returns to Worldsend, east of Hearthstead. For the investigation: '+briarGuide().detail;}
 else if(/heal|medicine|bandage/.test(t)){topic='care';reply=n.vampireId==='mirelle'?'The Night Clinic is open to human guests. Interact with its sign to rest and recover. I will never feed on a patient.':'Mirelle runs the clinic in this square. You can rest there safely.';}
 else if(/stupid|idiot|hate/.test(t)){topic='boundaries';reply='You can question me without insulting me. Ask what you need to know.';}
 else if(/hello|hi\b|how are|news|changed|here/.test(t)){topic='the ruins';reply=vampireNpcGreeting(n);}
 else {topic='unknown';reply='I can talk about the raid, Ada, the stranger in the black cloak, or my own past. I will not invent answers about people I have not met.';}
 mem.lastTopic=topic;mem.turns=Math.min(10000,(mem.turns||0)+1);mem.history=Array.isArray(mem.history)?mem.history:[];mem.history.push({ask:String(text).slice(0,180),reply,topic});mem.history=mem.history.slice(-3);saveGame();return reply;
}
function vampireNpcPose(n,time=animationClock,talking=false){const r=npcRoutines.get(n),clock=Number.isFinite(time)?time:0,walk=!!r?.walking&&!talking;return {frame:talking?(Math.floor(clock*2)%3===0?0:3):walk?[0,1,0,2][Math.floor(clock*7)%4]:0,face:talking?1:r?.face<0?-1:1,bob:walk?Math.abs(Math.sin(clock*7*Math.PI/2))*1.2:Math.sin(clock*1.8)*.35,breath:walk?1:1+Math.sin(clock*1.8)*.009};}
function paintVampireNpc(g,n,x,y,height,time=animationClock,talking=false){
 const d=vampireNpcDefs[n.vampireId];if(!d||!vampireNpcArt.complete||!vampireNpcArt.naturalWidth)return false;
 const pose=vampireNpcPose(n,time,talking),f=vampireNpcFrames[d.row][pose.frame],scale=height/340;
 g.save();g.translate(x,y-pose.bob);g.scale(pose.face,pose.breath);g.imageSmoothingEnabled=true;
 g.drawImage(vampireNpcArt,...f,(f[0]-vampireNpcAnchors[d.row][pose.frame])*scale,-f[3]*scale,f[2]*scale,f[3]*scale);g.restore();return true;
}
function drawVampireNpc(n){return paintVampireNpc(ctx,n,n.x,n.y+6,61);}
function drawVampirePortrait(time=animationClock){
 const c=npcConversation;if(!c?.npc.vampireId||c.map!==mapId||document.getElementById('adventureScreen').hidden)return;
 const canvas=document.getElementById('vampireNpcPortrait');if(!canvas)return;const g=canvas.getContext('2d');if(!g)return;g.clearRect(0,0,160,180);paintVampireNpc(g,c.npc,70,174,161,time,true);
}

// Hostile raiders are separate entities from Veilhaven's neutral residents.
const vampireMonsterDefs={
 bloodbound_scout:{name:'Bloodbound Scout',level:3,hp:8,portrait:'orven',area:'briarhollow',x:1060,y:690,description:'A raider searching the outer ruins. Its marked lunge can be dodged.',pattern:{label:'BLOOD LUNGE',speed:40,range:62,radius:34,windup:.95,cool:1.8}},
 veil_stalker:{name:'Veil Stalker',level:5,hp:12,portrait:'vaelis',area:'worldsend',x:1250,y:650,description:'A fast coastal ambusher. Watch the long windup before its strike.',pattern:{label:'VEIL STRIKE',speed:48,range:72,radius:32,windup:1.1,cool:1.65}},
 crimson_elder:{name:'Crimson Elder',level:12,hp:26,portrait:'vaelis',area:'ashenpass',x:1070,y:660,boss:true,description:'A vampire-house commander. Stronger than ordinary raiders, with a broad telegraphed attack.',pattern:{label:'CRIMSON SWEEP',speed:30,range:105,radius:62,windup:1.35,cool:2.2}}
};
// Outer wilderness encounters; no town, camp or sanctuary spawns.
for(const [area,type,x,y] of [['whisperwood','bloodbound_scout',600,430],['redfen','veil_stalker',720,460],['highmoor','bloodbound_scout',640,420],['frostmarch','veil_stalker',710,460],['greenhollow','bloodbound_scout',570,430]]){const d=vampireMonsterDefs[type];if(maps[area]&&!maps[area].town)maps[area].enemies.push({kind:'vampire',vampireType:type,name:d.name,combatLevel:d.level,combatBaseHp:d.hp,x,y,hp:d.hp,alive:true,seed:940+(area==='redfen'?1:0),boss:false});}
const vampireEnemyActors=new WeakMap();
function drawVampireMonster(e,dead=false){
 const d=vampireMonsterDefs[e.vampireType];if(!d)return false;
 let n=vampireEnemyActors.get(e);if(!n){n={vampireId:d.portrait,x:e.x,y:e.y};vampireEnemyActors.set(e,n);}
 const moved=Math.hypot(e.x-n.x,e.y-n.y)>.02;n.x=e.x;n.y=e.y;
 npcRoutines.set(n,{walking:moved&&!dead&&!(e.windup>0),face:player.x<e.x?-1:1});
 ctx.save();if(dead){ctx.globalAlpha*=Math.max(0,e.deathAnim/.6);ctx.translate(e.x,e.y);ctx.scale(1,Math.max(.1,e.deathAnim/.6));ctx.translate(-e.x,-e.y);}else if(e.hitTime>0)ctx.globalAlpha=.65;
 const lunge=e.swing?Math.sin(Math.PI*(1-Math.max(0,e.windup)/(e.windupLength||1)))*5*(player.x<e.x?-1:1):0;
 const ok=paintVampireNpc(ctx,n,e.x+lunge,e.y+6,e.boss?76:60,animationClock,e.windup>0);
 if(!dead){ctx.strokeStyle='#bd4356';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(e.x,e.y+6,e.boss?24:18,7,0,0,Math.PI*2);ctx.stroke();}ctx.restore();return ok;
}
function vampireBestiaryText(){return '\n\nVAMPIRE RAIDERS\n'+Object.values(vampireMonsterDefs).map(d=>d.name+' · minimum level '+Math.max(d.level,regionCombatLevel(d.area))+' · '+maps[d.area].name+'\n'+d.description).join('\n\n')+'\n\nAll hostile vampires scale with your level. Bosses stay at least two levels above you. Health, damage, XP and crowns follow the actual encounter level. Veilhaven residents are neutral NPCs, not monster targets.';}

// Optional discoveries use the existing quest save state.
const worldQuestDefs={world_watchtower:{title:'The Silent Watchtower',area:'northridge',item:'watchkeeper_shield',coins:45,xp:40},world_rescue:{title:'A Prisoner on the Southern Road',area:'meadowroad',item:'wayfarer_coat',coins:60,xp:50}};
Object.assign(itemDefs,{watchkeeper_shield:{name:'Watchkeeper Shield',icon:'🛡️',category:'gear',slot:'shield',guard:4,sell:30,description:'A unique shield from the northern watchtower. Reduces each hit by 4.'},wayfarer_coat:{name:'Wayfarer Coat',icon:'🧥',category:'gear',slot:'armor',guard:4,sell:30,description:'A unique reward for rescuing the southern-road traveler. Reduces each hit by 4.'}});
maps.northridge.landmark='watchtower';maps.northridge.hint='Silent Watchtower · read the tablet, light the three beacons, then open the cache.';
maps.northridge.worldObjects=[{id:'tower_tablet',x:480,y:405,label:'READ TABLET'},{id:'beacon_west',x:310,y:185,label:'WEST BEACON'},{id:'beacon_north',x:480,y:60,label:'NORTH BEACON'},{id:'beacon_east',x:650,y:185,label:'EAST BEACON'},{id:'tower_cache',x:480,y:260,label:'WATCHTOWER CACHE'}];
maps.meadowroad.landmark='bandit_camp';maps.meadowroad.hint='Southern Bandit Camp · read the notice, defeat four camp guards, and free the traveler.';
maps.meadowroad.worldObjects=[{id:'rescue_notice',x:480,y:405,label:'MISSING TRAVELER'},{id:'prisoner_cage',x:750,y:235,label:'FREE TRAVELER'}];
for(const [i,[x,y]] of [[340,230],[580,240],[650,270],[810,225]].entries())maps.meadowroad.enemies.push({x,y,hp:i===3?9:6,alive:true,seed:160+i,kind:'bandit',name:i===3?'Bandit Captain':'Camp Guard',boss:true,worldBandit:true});
function worldQuestState(id){return townQuestState[id]||(townQuestState[id]={accepted:false,claimed:false,progress:0})}
function completeWorldQuest(id){const q=worldQuestDefs[id],st=worldQuestState(id);if(st.claimed){say('You already received this reward.');return true}if(!addItem(q.item)){say('Your pack is full. Make room, then collect '+itemDefs[q.item].name+'.');return true}st.claimed=true;player.coins+=q.coins;grantXp(q.xp);playSfx('quest');say(q.title+' complete · '+itemDefs[q.item].name+' · +'+q.coins+' crowns · +'+q.xp+' XP');ui();saveGame();return true}
function worldObjectInteract(obj){
 if(campInteract(obj))return true;
 if(veilhavenInteract(obj))return true;
 if(briarInteract(obj))return true;
 if(obj.id==='town_council'){openTownCouncil();return true;}
 if(npcStoryInteract(obj))return true;
 const journalObjectQuest=obj.id==='tower_tablet'||obj.id.startsWith('beacon_')||obj.id==='tower_cache'?'world_watchtower':['rescue_notice','prisoner_cage'].includes(obj.id)?'world_rescue':null;if(journalObjectQuest&&!journalCanAccept(journalObjectQuest))return true;
 if(memoryInteract(obj))return true;
 if(frontierInteract(obj))return true;
 if(obj.id.startsWith("wayfarer_"))return interactWayfarer(obj);
 if(obj.id.startsWith("regional_"))return regionalInteract(obj);
 if(interactAdventureObject(obj))return true;
 if(obj.id.startsWith('armory_'))return interactClassArmory(obj.hero);
 if(obj.id.startsWith('gear_waystone_'))return interactGearWaystone(obj);
 if(obj.id==='tower_tablet'){const st=worldQuestState('world_watchtower');st.accepted=true;say(st.claimed?'The watchtower beacons shine again.':'Tablet: At dawn face EAST, at dusk turn WEST, then look NORTH. Light the beacons in that order; the cache will open.');saveGame();return true}
 if(obj.id.startsWith('beacon_')){const st=worldQuestState('world_watchtower');if(st.claimed||st.progress>=3){say('All three beacons are lit. The cache is unlocked.');return true}if(!st.accepted){say('Read the tablet beside the road first.');return true}const order=['beacon_east','beacon_west','beacon_north'];if(obj.id===order[st.progress]){st.progress++;say(st.progress===3?'The three beacons blaze. Open the watchtower cache.':'Beacon lit · '+st.progress+'/3.')}else{st.progress=0;say('Wrong order. The beacons go dark. Read the tablet and try again.')}saveGame();return true}
 if(obj.id==='tower_cache'){const st=worldQuestState('world_watchtower');if(st.progress<3&&!st.claimed){say('The cache is sealed. Read the tablet and light the three beacons.');return true}return completeWorldQuest('world_watchtower')}
 if(obj.id==='rescue_notice'){const st=worldQuestState('world_rescue');st.accepted=true;say(st.claimed?'The traveler made it home safely.':'A traveler is held in this camp. Defeat its four guards, then INTERACT at the cage to free them.');saveGame();return true}
 if(obj.id==='prisoner_cage'){const st=worldQuestState('world_rescue');st.accepted=true;if(st.claimed){say('The cage is empty. The traveler is safe.');return true}const left=maps.meadowroad.enemies.filter(e=>e.worldBandit&&e.alive).length;if(left){say('The traveler: '+left+' camp guard'+(left===1?'':'s')+' still hold the key. Defeat them first.');saveGame();return true}st.rescued=true;return completeWorldQuest('world_rescue')}
 return false;
}
function nearestWorldObject(x=player.x,y=player.y,radius=64){let nearest=null,best=radius;for(const obj of activeMap.worldObjects||[]){const d=Math.hypot(x-obj.x,y-obj.y);if(d<best){best=d;nearest=obj}}return nearest}
// Three separate equipment quests per class: weapon, armor, and shield.
const classGearProfiles={
 warrior:{town:'ashvale',items:['emberguard_blade','emberguard_plate','emberguard_aegis'],names:['Emberguard Blade','Emberguard Plate','Emberguard Aegis'],hunt:['whisperwood','slime',5],gather:['westwood','mining',3],stones:['glassridge','highmoor','westwood']},
 rogue:{town:'brackenford',items:['shadowthorn_dagger','shadowthorn_leathers','shadowthorn_buckler'],names:['Shadowthorn Dagger','Shadowthorn Leathers','Shadowthorn Buckler'],hunt:['redfen','spider',4],gather:['willowfen','woodcutting',3],stones:['greenhollow','fenroad','southwood']},
 mage:{town:'sunmere',items:['tideglass_staff','tideglass_robes','tideglass_ward'],names:['Tideglass Staff','Tideglass Robes','Tideglass Ward'],hunt:['frostmarch','spider',4],gather:['sunharbor','fishing',3],stones:['frostwood','northridge','icecoast']},
 cleric:{town:'stonewatch',items:['dawnwarden_mace','dawnwarden_vestments','dawnwarden_shield'],names:['Dawnwarden Mace','Dawnwarden Vestments','Dawnwarden Shield'],hunt:['highmoor','skeleton',5],gather:['stonewatchroad','mining',3],stones:['crowfield','meadowroad','cinderfields']}
};
const classGearQuests={};
for(const [hero,profile] of Object.entries(classGearProfiles)){
 const slots=['weapon','armor','shield'];
 profile.items.forEach((item,i)=>{const id='gear_'+hero+'_'+slots[i];itemDefs[item]={name:profile.names[i],icon:i===0?(hero==='mage'?'🪄':'⚔️'):'🛡️',category:'gear',slot:slots[i],sell:40,description:'Unique '+classDefs[hero].title+' '+slots[i]+'. Earned through the '+maps[profile.town].name+' armory. '+(i===0?'Adds 5 damage.':'Reduces each hit by 5.'),...(i===0?{bonus:5}:{guard:5})};itemClassRules[item]=[hero];
  classGearQuests[id]={hero,town:profile.town,item,slot:slots[i],title:profile.names[i]+' · '+(i===0?'The Hunt':i===1?'Supply the Armory':'The Three Waystones'),type:i===0?'hunt':i===1?'gather':'waystones',target:i===0?profile.hunt[2]:i===1?profile.gather[2]:3,area:i===0?profile.hunt[0]:i===1?profile.gather[0]:null,kind:i===0?profile.hunt[1]:null,skill:i===1?profile.gather[1]:null,regions:i===2?profile.stones:[],coins:25+i*10,xp:30+i*10};
 });
 const m=maps[profile.town];m.worldObjects=(m.worldObjects||[]).concat({id:'armory_'+hero,x:1020,y:430,label:classDefs[hero].title.toUpperCase()+' ARMORY',hero});
 for(const [i,area] of profile.stones.entries()){const m=maps[area];m.worldObjects=(m.worldObjects||[]).concat({id:'gear_waystone_'+hero+'_'+i,x:480,y:490,label:classDefs[hero].title.toUpperCase()+' WAYSTONE',hero,index:i})}
}

// Class sets use the existing rare quest pieces and four new accessories/armor pieces.
for(const hero of Object.keys(GEAR_SET_NAMES))for(let tier=1;tier<=5;tier++)for(const slot of GEAR_SLOTS){
 const id=setGearId(hero,tier,slot),legacy=tier===3&&['weapon','armor','shield'].includes(slot),setName=GEAR_SET_NAMES[hero];
 if(legacy){Object.assign(itemDefs[id],{tier,set:hero,minLevel:1});itemDefs[id].description+=' Part of the '+setName+' set. 3/5/7 pieces unlock set bonuses.';continue;}
 const stat=slot==='weapon'||slot==='necklace'?'bonus':'guard',power=slot==='weapon'?tier+1:slot==='armor'||slot==='shield'||slot==='legs'?Math.ceil(tier*.7):Math.ceil(tier*.4),price=(tier===1?18:tier===2?65:150*tier)+(slot==='weapon'?12:0);
 itemDefs[id]={name:setName+' '+GEAR_LABELS[slot]+' · T'+tier,icon:GEAR_ICONS[slot],category:'gear',slot,tier,set:hero,minLevel:GEAR_TIERS[tier].level,price,sell:Math.floor(price/2),[stat]:power,description:GEAR_TIERS[tier].name+' '+setName+' set · requires level '+GEAR_TIERS[tier].level+'. '+(stat==='bonus'?'Attack':'Guard')+' +'+power+'. Set bonuses: 3 pieces +tier attack; 5 pieces +tier guard; 7 pieces +2×tier attack and guard. Mixed tiers use the lowest equipped tier.'};
 itemClassRules[id]=[hero];
}
for(const shop of Object.values(shopDefs))if(shop.forgeClass)for(const tier of [1,2])for(const slot of GEAR_SLOTS)shop.stock.push(setGearId(shop.forgeClass,tier,slot));

// v1.81: gear merchants occupy separate houses; the forge stays a workshop.
const gearShopDistrict={weapons:{label:'Weapons',slots:['weapon','shield'],frontage:'weapons',seller:'Weaponsmith'},armor:{label:'Armor',slots:['armor','legs','boots'],frontage:'armorShop',seller:'Armorer'},jewelry:{label:'Jeweler',slots:['earrings','necklace'],frontage:'jewelry',seller:'Jeweler'}};
for(const [town,hero] of Object.entries({ashvale:'warrior',brackenford:'rogue',stonewatch:'cleric',sunmere:'mage'})){
 const forge=shopDefs[town+'_forge'],early=forge.stock.filter(id=>itemDefs[id]?.category==='gear');
 for(const [kind,d] of Object.entries(gearShopDistrict)){
  const id=town+'_'+kind,front=townFrontages[d.frontage],door=townDoor(front);
  shopDefs[id]={name:maps[town].name+' '+d.label,seller:GEAR_SET_NAMES[hero]+' '+d.seller,stock:[...new Set(early.filter(id=>d.slots.includes(itemDefs[id].slot)))],gearMerchant:true};
  maps[town].npcs.push({name:GEAR_SET_NAMES[hero]+' '+d.seller,x:door.x,y:door.y+32,frontage:d.frontage,shopId:id,lines:['Browse our '+d.label.toLowerCase()+' collection.'],talk:0});
 }
 forge.stock=[];forge.workshopOnly=true;
}
for(const shop of Object.values(shopDefs))if(!shop.gearMerchant&&!shop.forgeClass)shop.stock=shop.stock.filter(id=>itemDefs[id]?.category!=='gear');
// Route any gear formerly stocked at general merchants to the appropriate new shop.
const legacyGearByTown={ashvale:['trail_vest'],brackenford:['trail_vest','short_sword'],stonewatch:[],sunmere:['sabre','ashwood_staff','trail_vest']};
for(const [town,ids] of Object.entries(legacyGearByTown))for(const id of ids){const entry=Object.entries(gearShopDistrict).find(([,d])=>d.slots.includes(itemDefs[id]?.slot));if(entry){const stock=shopDefs[town+'_'+entry[0]].stock;if(!stock.includes(id))stock.push(id);}}
const shopSellQuantities=Object.create(null);
function shopSellAvailable(id){const item=itemDefs[id];if(!item?.sell)return 0;return Math.max(0,bagCount(id)-(GEAR_SLOTS.some(slot=>player[slot]===id)?1:0));}
function shopSellQuantity(id){const available=shopSellAvailable(id);return Math.min(available,Math.max(1,Math.floor(Number(shopSellQuantities[id])||1)));}
function renderBulkSell(){const host=document.getElementById('bulkSellBar');host.hidden=shopMode!=='sell';host.textContent='Choose an amount for each item, or sell all of that item. Equipped copies are protected.';}
function shopSellControls(id){const available=shopSellAvailable(id),quantity=shopSellQuantity(id),item=itemDefs[id];if(!available)return '<span>Equipped copy protected</span>';return '<div class="sellQuantity"><label>Quantity <output>'+quantity+' / '+available+'</output><input type="range" min="1" max="'+available+'" step="1" value="'+quantity+'" data-sell-quantity="'+id+'" aria-label="Quantity to sell" '+(available===1?'disabled':'')+'></label><div><button type="button" class="itemAction sell" data-shop-action="sell" data-id="'+id+'">Sell '+quantity+' · '+quantity*item.sell+' crowns</button><button type="button" class="itemAction sell" data-shop-action="sell-item-all" data-id="'+id+'">Sell all ('+available+') · '+available*item.sell+' crowns</button></div></div>';}
function sellShopQuantity(id,all=false){const item=itemDefs[id],count=all?shopSellAvailable(id):shopSellQuantity(id);if(!item||count<1)return;removeItem(id,count);player.coins+=count*item.sell;delete shopSellQuantities[id];saveGame();ui();renderShop();document.getElementById('shopNotice').textContent='Sold '+count+' × '+item.name+' for '+count*item.sell+' crowns.';}
let craftTier=3;
const setCraftCosts={3:{coins:140,materials:{iron_ore:4,silver_ore:2,hardwood_log:3}},4:{coins:300,materials:{silver_ore:5,ancient_alloy:3,hardwood_log:4}},5:{coins:650,materials:{silver_ore:8,ancient_alloy:7,hardwood_log:6}}};
function craftSetGear(id){const shop=shopDefs[activeShopId],d=itemDefs[id],cost=d&&setCraftCosts[d.tier];if(!shop?.forgeClass||!d||d.set!==shop.forgeClass||d.tier<3||Object.values(classGearQuests).some(q=>q.item===id))return;if(player.level<GEAR_TIERS[d.tier].level){document.getElementById('shopNotice').textContent='Requires level '+GEAR_TIERS[d.tier].level+'.';return;}if(bagUnits()>=bagLimit()){document.getElementById('shopNotice').textContent='Make room in your bag before crafting.';return;}if(player.coins<cost.coins||Object.entries(cost.materials).some(([mat,n])=>bagCount(mat)<n)){document.getElementById('shopNotice').textContent='Gather the listed materials and crowns first.';return;}if(!addItem(id))return;for(const [mat,n] of Object.entries(cost.materials))removeItem(mat,n);player.coins-=cost.coins;saveGame();ui();renderShop();document.getElementById('shopNotice').textContent='Crafted '+d.name+'.';}
function renderSetForge(){const shop=shopDefs[activeShopId],cost=setCraftCosts[craftTier],ids=GEAR_SLOTS.map(slot=>setGearId(shop.forgeClass,craftTier,slot)).filter(id=>!Object.values(classGearQuests).some(q=>q.item===id));document.getElementById('shopList').innerHTML='<div class="setCraftTabs">'+[3,4,5].map(t=>'<button type="button" data-craft-tier="'+t+'" aria-pressed="'+(craftTier===t)+'">T'+t+' '+GEAR_TIERS[t].name+'</button>').join('')+'</div><p class="setForgeHelp">'+GEAR_SET_NAMES[shop.forgeClass]+' set · requires level '+GEAR_TIERS[craftTier].level+'. Rare weapons, body armor, and shields come from armory quests. Equip 3, 5, or 7 pieces; mixed tiers use the lowest tier.</p>'+ids.map(id=>{const d=itemDefs[id],ready=player.level>=GEAR_TIERS[craftTier].level&&player.coins>=cost.coins&&bagUnits()<bagLimit()&&Object.entries(cost.materials).every(([mat,n])=>bagCount(mat)>=n);return '<article class="itemRow"><div class="itemInfo"><div class="itemName" style="color:'+GEAR_TIERS[craftTier].color+'">'+d.icon+' '+d.name+'</div>'+shopGearRequirementsHTML(id)+'<div class="itemDescription">'+d.description+'<br>'+Object.entries(cost.materials).map(([mat,n])=>itemDefs[mat].name+' '+bagCount(mat)+'/'+n).join(' · ')+'</div></div><div class="itemActions"><button type="button" data-shop-action="craft" data-id="'+id+'" class="itemAction buy" '+(ready?'':'disabled')+'>Craft · '+cost.coins+' crowns</button></div></article>'}).join('');}
function classGatherRequiredLevel(q){const level=maps[q.area]?.level||1;return q.skill==='mining'?(level>=6?5:level>=4?3:1):q.skill==='woodcutting'&&level>=4?3:q.skill==='fishing'&&['frostmarch','glassridge'].includes(q.area)?3:1}
function classGearQuestDetail(q){return q.type==='hunt'?'Defeat '+q.target+' '+(q.kind==='slime'?'slimes':q.kind==='spider'?'spiders':'skeletons')+' in '+maps[q.area].name+'.':q.type==='gather'?'Gather successfully '+q.target+' times using '+q.skill+' in '+maps[q.area].name+'. Buy the matching tool at a town shop. Requires '+gatheringSkillDefs[q.skill].name+' level '+classGatherRequiredLevel(q)+'. Train on basic nodes near Ashvale first if needed.':'Activate the '+classDefs[q.hero].title+' waystones in '+q.regions.map(id=>maps[id].name).join(', ')+'.'}
function recordClassGearProgress(type,area,kind){let changed=false;for(const [id,q] of Object.entries(classGearQuests)){const st=townQuestState[id];if(!st?.accepted||st.claimed||q.type!==type||q.area!==area||(type==='hunt'?q.kind!==kind:q.skill!==kind))continue;st.progress=Math.min(q.target,(st.progress||0)+1);changed=true;}if(changed)saveGame()}
function interactClassArmory(hero){
 const quests=Object.entries(classGearQuests).filter(([,q])=>q.hero===hero),next=quests.find(([id])=>!townQuestState[id]?.claimed);
 if(!next){say(classDefs[hero].title+' armory: You have earned all three unique items.');return true}
 const [id,q]=next,st=worldQuestState(id);if(!journalCanAccept(id))return true;
 if(!st.accepted){st.accepted=true;st.progress=0;st.waystones=[];say(q.title+' accepted. '+classGearQuestDetail(q));saveGame();return true}
 const progress=q.type==='waystones'?(st.waystones||[]).length:st.progress||0;
 if(progress<q.target){say(q.title+' · '+progress+'/'+q.target+'. '+classGearQuestDetail(q));return true}
 if(!addItem(q.item)){say('Your pack is full. Make room, then return for '+itemDefs[q.item].name+'.');return true}
 st.claimed=true;player.coins+=q.coins;grantXp(q.xp);playSfx('quest');say(itemDefs[q.item].name+' earned · +'+q.coins+' crowns · +'+q.xp+' XP. '+(q.slot==='shield'?'Your class set is complete.':'INTERACT again for the next equipment quest.'));ui();saveGame();if(hero===player.class)openClassMystery();return true;
}
function interactGearWaystone(obj){const id='gear_'+obj.hero+'_shield',q=classGearQuests[id],st=townQuestState[id];if(!st?.accepted){say('Accept the '+classDefs[obj.hero].title+' shield quest at the '+maps[q.town].name+' armory first.');return true}if(st.claimed){say('This waystone has already granted its blessing.');return true}st.waystones=Array.isArray(st.waystones)?st.waystones:[];if(!st.waystones.includes(mapId))st.waystones.push(mapId);say(classDefs[obj.hero].title+' waystones · '+st.waystones.length+'/3.'+(st.waystones.length===3?' Return to the armory for '+itemDefs[q.item].name+'.':''));saveGame();return true}
// Five story chapters culminate in four new optional-to-enter dungeon floors.
const storyDungeons={
 embercrypt:{name:'Ember Crypt',parent:'westwood',level:7,boss:'Cinderbound Herald',style:'fire',relic:'ember_heart',hint:'Disable both ward stones to break the Herald’s armor. Dodge the orange fire ring.',coins:90,xp:65,color:'#695346'},
 tidevault:{name:'Tide Vault',parent:'icecoast',level:8,boss:'The Tidekeeper',style:'tide',relic:'tide_heart',hint:'Disable the healing pylons. Move out of the marked tidal pools.',coins:110,xp:75,color:'#3c626b'},
 stormspire:{name:'Storm Spire',parent:'northridge',level:9,boss:'Stormwing Sentinel',style:'storm',relic:'storm_heart',hint:'Ground both rods to slow the lightning. Step out of the orange lanes.',coins:130,xp:85,color:'#565d78'},
 hollowcrown:{name:'Hollow Crown Keep',parent:'cinderfields',level:10,boss:'The Hollow Regent',style:'crown',relic:'crown_heart',hint:'Break the Regent’s wards, then face fire rings, tidal pools, and lightning lanes.',coins:180,xp:120,color:'#655061'}
};
Object.assign(itemDefs,{ancient_alloy:{name:'Ancient Alloy',icon:'🔩',category:'material',sell:15,description:'Dungeon alloy used for forge ranks 4 and 5.'}});
for(const [i,[id,d]] of Object.entries(storyDungeons).entries()){
 itemDefs[d.relic]={name:d.name+' Heart',icon:'✦',category:'quest',description:'A story relic recovered from '+d.name+'.'};
 maps[id]={name:d.name,dungeon:true,level:d.level,trees:[],stones:[[130,180],[830,180]],npcs:[],arrival:[480,450],hint:d.hint,enemies:[{x:260,y:300,hp:8+i*2,kind:'skeleton',name:'Sanctum Guard',seed:210+i*4,alive:true},{x:700,y:300,hp:8+i*2,kind:'spider',name:'Vault Weaver',seed:211+i*4,alive:true},{x:480,y:355,hp:8+i*2,kind:'skeleton',name:'Sanctum Guard',seed:212+i*4,alive:true},{x:480,y:240,hp:20+i*5,kind:'warden',name:d.boss,seed:213+i*4,alive:true,boss:true,storyBoss:id}],worldObjects:[{id:'story_ward_'+id+'_0',dungeon:id,index:0,x:250,y:170,label:d.style==='tide'?'HEALING PYLON':d.style==='storm'?'GROUNDING ROD':'WARD STONE'},{id:'story_ward_'+id+'_1',dungeon:id,index:1,x:710,y:170,label:d.style==='tide'?'HEALING PYLON':d.style==='storm'?'GROUNDING ROD':'WARD STONE'},{id:'story_cache_'+id,dungeon:id,x:480,y:105,label:'SANCTUM CACHE'},{id:'story_replay_'+id,dungeon:id,x:790,y:455,label:'CHALLENGE AGAIN'}]};
 const parent=maps[d.parent];parent.worldObjects=(parent.worldObjects||[]).concat({id:'story_portal_'+id,dungeon:id,x:1040,y:180,label:d.name.toUpperCase()});
}
// Personal epilogues become available after each companion's existing two chapters.
const companionEpilogues={dalen:{town:'ashvale',quests:['ashvale_watch','ashvale_scout'],title:'Dalen · The Open Gate',text:'Dalen can return to the watch or escort the families his old order put at risk.'},sylvi:{town:'brackenford',quests:['bracken_patrol','bracken_herbs'],title:'Sylvi · An Honest Map',text:'Sylvi is ready to reveal the warning she hid. Will she lead the next scouting patrol or stay to protect the stranded scouts?'},corin:{town:'stonewatch',quests:['stonewatch_sweep','stonewatch_silk'],title:'Corin · The Last Bell',text:'Corin has finished the rites. The Order asks whether he will take the road against the dead or guard the living at home.'},eryn:{town:'sunmere',quests:['sunmere_hunt','sunmere_weavers'],title:'Eryn · A Steady Beacon',text:'Eryn admits she cracked the beacon. She can study the storm’s power or strengthen the harbor’s wards.'}};
for(const [id,q] of Object.entries(companionEpilogues)){const m=maps[q.town];m.worldObjects.push({id:'epilogue_'+id,companion:id,x:1160,y:450,label:companionDefs[id].name.split(' ')[0].toUpperCase()+' · EPILOGUE'})}
maps.ashvale.worldObjects.push({id:'campaign_chronicle',x:1300,y:420,label:'STORY CHRONICLE'});
maps.coastroad.worldObjects=(maps.coastroad.worldObjects||[]).concat({id:'crossroads_medicine',x:480,y:430,label:'WOUNDED TRAVELER'});
const hiddenTrailCaches=[{id:'secret_westwood',area:'westwood',x:-250,y:540},{id:'secret_coastroad',area:'coastroad',x:1250,y:100},{id:'secret_southwood',area:'southwood',x:-260,y:-140}];
for(const cache of hiddenTrailCaches)maps[cache.area].worldObjects.push({...cache,label:'HIDDEN TRAIL CACHE'});
function storyState(id){return worldQuestState('story_'+id)}
function storyCleared(id){return !!townQuestState['story_'+id]?.claimed}
function storySanctumCount(){return ['embercrypt','tidevault','stormspire'].filter(storyCleared).length}
function storyPortalLock(id){if(id==='embercrypt'&&!deepQuestDone)return 'Clear the Ashvault and claim its coffer first.';if(id==='tidevault'&&!storyCleared('embercrypt'))return 'Recover the Ember Crypt heart first.';if(id==='stormspire'&&!storyCleared('tidevault'))return 'Recover the Tide Vault heart first.';if(id==='hollowcrown'&&storySanctumCount()<3)return 'Recover all three sanctum hearts first.';return ''}
function storyWards(id){return (townQuestState['story_'+id]?.wards||[]).length}
function playerBuild(){return townQuestState['build_'+player.class]?.path||'balanced'}
function buildAttack(){return playerBuild()==='power'?2:0}
function buildGuard(){return playerBuild()==='guard'?2:0}
function companionStoryAttack(c){return townQuestState['epilogue_'+c.id]?.choice==='road'?1:0}
function companionStoryGuard(c){return townQuestState['epilogue_'+c.id]?.choice==='home'?2:0}
function chooseBuild(path){if(!['power','guard','recovery'].includes(path))return;townQuestState['build_'+player.class]={path};say('Build selected: '+path+'.');saveGame();renderCharacter()}
function renderBuildChoices(){const el=document.getElementById('buildChoices');if(!el)return;const chosen=playerBuild();el.innerHTML='<span>BUILD</span>'+[['power','Power · +2 attack'],['guard','Guard · +2 defense'],['recovery','Recovery · skills heal 8%']].map(([id,label])=>'<button type="button" data-build-choice="'+id+'" aria-pressed="'+(chosen===id)+'">'+label+'</button>').join('')}
// Frontier settlement v1: additive, character-scoped progression.
const settlementBuildings={
 palisade:{name:'Palisade',icon:'▥',detail:'Adds 80 town defense per level during a siege.',cost:[14,4,0]},
 gate:{name:'Reinforced Gate',icon:'▣',detail:'Adds 60 town defense per level during a siege.',cost:[10,12,0]},
 tower:{name:'Watchtower',icon:'♜',detail:'Archers inflict 2 damage per level every 3 active seconds during a siege.',cost:[16,10,4]},
 barracks:{name:'Town Barracks',icon:'⚑',detail:'Militia inflict 1 damage per level every 3 active seconds and reduce incoming siege pressure by 15% per level.',cost:[12,14,8]},
 hall:{name:'Hearth Hall',icon:'⌂',detail:'A roof for the first families. Each level raises every supply cap by 80.',cost:[8,4,0]},
 mill:{name:'Timber Mill',icon:'♧',detail:'Produces 6 timber per hour per level.',cost:[6,4,0]},
 quarry:{name:'Stone Quarry',icon:'◇',detail:'Produces 6 stone per hour per level.',cost:[8,2,0]},
 garden:{name:'Kitchen Garden',icon:'❧',detail:'Produces 6 food per hour per level.',cost:[4,2,0]},
 forge:{name:'Wayfarer Forge',icon:'⚒',detail:'Turn stone and 2 food into 1 iron ore. Stone cost falls from 4 to 3 to 2 as the forge improves.',cost:[14,12,6]},
 lodge:{name:'Ranger Lodge',icon:'⚑',detail:'Prepare a healing tonic. Food cost falls from 6 to 5 to 4 as the lodge improves.',cost:[12,8,8]}
};
function settlementState(){
 let s=townQuestState._settlement;
 if(!s||typeof s!=='object'||Array.isArray(s))s=townQuestState._settlement={};
 s.version=1;s.founded=!!s.founded;
 for(const key of ['stock','pending','levels','claimed','gathers'])if(!s[key]||typeof s[key]!=='object'||Array.isArray(s[key]))s[key]={};
 for(const k of Object.keys(settlementBuildings))s.levels[k]=Math.max(0,Math.min(3,Math.floor(Number(s.levels[k])||0)));
 const cap=80+s.levels.hall*80;
 for(const k of ['wood','stone','food']){s.stock[k]=Math.max(0,Math.min(cap,Number(s.stock[k])||0));s.pending[k]=Math.max(0,Math.min(cap,Number(s.pending[k])||0));s.gathers[k]=Math.max(0,Math.floor(Number(s.gathers[k])||0));}
 s.kills=Math.max(0,Math.floor(Number(s.kills)||0));
 if(!Number.isFinite(s.lastTick)||s.lastTick<0)s.lastTick=Date.now();return s;
}
function settlementTick(now=Date.now()){
 const s=settlementState();if(!s.founded)return s;
 // Clock rollback gives no income and resets the baseline; one absence is capped at eight hours.
 const hours=Math.min(8,Math.max(0,now-s.lastTick)/3600000);s.lastTick=now;
 const cap=80+s.levels.hall*80;
 for(const [k,b] of [['wood','mill'],['stone','quarry'],['food','garden']])s.pending[k]=Math.min(cap,s.pending[k]+hours*6*s.levels[b]*(k==='food'&&townQuestState.npc_sera?.choice==='divert'&&!townQuestState.npc_sera.repaired ? 0.5 : 1));return s;
}
function settlementSupplies(values){const s=settlementState(),cap=80+s.levels.hall*80;['wood','stone','food'].forEach((k,i)=>s.stock[k]=Math.min(cap,s.stock[k]+values[i]));}
function settlementGather(skill){const s=settlementState();if(!s.founded)return;const k={woodcutting:'wood',mining:'stone',fishing:'food'}[skill];if(k){s.gathers[k]++;s.stock[k]=Math.min(80+s.levels.hall*80,s.stock[k]+2);}}
function settlementKill(area){const s=settlementState();if(s.founded&&!maps[area]?.town)s.kills++;}
function settlementAtTown(){if(activeMap.town||mapId==='frontier_outpost')return true;say('Return to a town to manage settlement supplies.');return false;}
function foundSettlement(){if(!settlementAtTown())return;const s=settlementState();if(s.founded)return;s.founded=true;s.lastTick=Date.now();settlementSupplies([18,12,6]);saveGame();openSettlement();}
function settlementCost(id){const d=settlementBuildings[id],s=settlementState();return d.cost.map(n=>n*(s.levels[id]+1));}
function settlementGate(id){if(workforceState().build?.id===id)return 'Bram is constructing this upgrade';if(politicsState().phase==='siege')return 'Finish the siege before construction';const s=settlementState();if(!s.founded)return 'Found the settlement first';if(id==='hall'&&!s.levels.hall&&!frontierState().home)return 'Rescue Edda from the old quarry first';if(id!=='hall'&&!s.levels.hall)return 'Build Hearth Hall first';if(s.levels[id]>=3)return 'Fully restored';if(id!=='hall'&&s.levels[id]>=s.levels.hall)return 'Upgrade Hearth Hall first';if(id==='forge'&&s.gathers.stone<3)return 'Mine 3 nodes after founding';if(id==='lodge'&&s.kills<8)return 'Defeat 8 wilderness enemies after founding';if(id==='hall'&&s.levels.hall===1&&s.kills<8)return 'Defeat 8 wilderness enemies';if(id==='hall'&&s.levels.hall===2&&!Object.keys(townQuestDefs).some(k=>townQuestState[k]?.claimed))return 'Complete one existing town quest';return '';}
function settlementCanPay(cost){const s=settlementState();return ['wood','stone','food'].every((k,i)=>s.stock[k]>=cost[i]);}
function settlementPay(cost){const s=settlementState();['wood','stone','food'].forEach((k,i)=>s.stock[k]-=cost[i]);}
function upgradeSettlement(id){if(!settlementBuildings[id]||!settlementAtTown())return;const s=settlementTick(),cost=settlementCost(id);if(settlementGate(id)||!settlementCanPay(cost))return;settlementPay(cost);s.levels[id]++;saveGame();openSettlementBuilding(id);}
function collectSettlement(){if(!settlementAtTown())return;const s=settlementTick(),cap=80+s.levels.hall*80;for(const k of ['wood','stone','food']){const n=Math.min(Math.floor(s.pending[k]),cap-s.stock[k]);s.stock[k]+=n;s.pending[k]-=n;}saveGame();openSettlement();}
function settlementTasks(){const s=settlementState();return [
 {id:'hearth',title:'A place to belong',text:'Build Hearth Hall.',done:s.levels.hall>=1,reward:[8,6,4]},
 {id:'lumber',title:'Timber for tomorrow',text:'Gather wood from 3 nodes after founding. Buy a hatchet in a town shop.',done:s.gathers.wood>=3,reward:[8,4,4]},
 {id:'stone',title:'Foundations of stone',text:'Mine 3 nodes after founding. Buy a pick in a town shop. Unlocks the forge.',done:s.gathers.stone>=3,reward:[6,10,4]},
 {id:'roads',title:'Safe roads home',text:'Defeat 8 wilderness enemies after founding. Pet kills count. Unlocks the lodge and Hall II.',done:s.kills>=8,reward:[10,8,8]},
 {id:'promise',title:'A promise kept',text:'Complete any existing town quest. Earlier completions count. Unlocks Hall III.',done:Object.keys(townQuestDefs).some(k=>townQuestState[k]?.claimed),reward:[12,12,12]},
 {id:'home',title:'From camp to community',text:'Restore all six buildings to at least level 1.',done:['hall','mill','quarry','garden','forge','lodge'].every(k=>s.levels[k]>0),reward:[20,20,20]}
 ];}
function claimSettlementTask(id){if(!settlementAtTown())return;const s=settlementState(),t=settlementTasks().find(x=>x.id===id);if(!s.founded||!t?.done||s.claimed[id])return;const cap=80+s.levels.hall*80;if(['wood','stone','food'].some((k,i)=>s.stock[k]+t.reward[i]>cap)){openSettlementTasks('Spend supplies or upgrade the Hall first so none of this reward is lost.');return;}s.claimed[id]=true;settlementSupplies(t.reward);saveGame();openSettlementTasks();}
function settlementCraft(id){if(!settlementAtTown())return;const s=settlementState(),ore=id==='forge',cost=ore?[0,5-s.levels.forge,2]:[0,0,7-s.levels.lodge],item=ore?'iron_ore':'health_tonic';if(!['forge','lodge'].includes(id)||!s.levels[id]||!settlementCanPay(cost))return;if(!addItem(item,1)){openSettlementBuilding(id,'Your bag is full. Make room before collecting supplies.');return;}settlementPay(cost);saveGame();ui();openSettlementBuilding(id,'Supplied: '+itemDefs[item].name);}
function settlementCostText(c){return c.map((n,i)=>n?n+' '+['timber','stone','food'][i]:'').filter(Boolean).join(' · ');}
function settlementPanel(title,text,choices,html=''){
 openAdventureDialog(title,text,choices);const screen=document.getElementById('adventureScreen');screen.classList.add('settlementView');screen.querySelector('.screenPanel').scrollTop=0;document.getElementById('adventureText').innerHTML=html+'<p class="settlementCopy">'+questEscape(text.replaceAll('Hearthstead',()=>settlementName()))+'</p>';screen.querySelector('.screenFoot').textContent='Supplies belong to this character · Offline production capped at 8 hours';
}
function settlementArt(){const s=settlementState(),total=Object.values(s.levels).reduce((a,b)=>a+b,0);return '<div class="settlementVista"><div class="settlementSky">FRONTIER RESTORATION</div><h3>'+(!total?'The first embers':total<6?'A home taking shape':'A light on the frontier')+'</h3><div class="settlementPlots">'+Object.entries(settlementBuildings).map(([id,d])=>'<div class="settlementPlot '+(s.levels[id]?'built':'ruined')+'"><span aria-hidden="true">'+d.icon+'</span><b>'+d.name+'</b><small>'+(s.levels[id]?'Level '+s.levels[id]:'Unbuilt')+'</small></div>').join('')+'</div></div>';}


function settlementName(){const name=settlementState().name;return typeof name==='string'&&name.trim()?Array.from(name.trim()).slice(0,28).join(''):'Hearthstead';}
function syncSettlementName(){maps.frontier_outpost.name=settlementName()+' Settlement';if(mapId==='frontier_outpost')document.getElementById('mapName').textContent=maps.frontier_outpost.name;}
function renameSettlement(value){
 const name=String(value||'').replace(/[\u0000-\u001f\u007f-\u009f\u202a-\u202e\u2066-\u2069]/g,'').replace(/\s+/g,' ').trim();
 if(!name||Array.from(name).length>28){openSettlementNaming('Use between 1 and 28 characters.');return false;}
 settlementState().name=name;syncSettlementName();saveGame();openSettlementMap();say('Your settlement is now called '+name+'.');return true;
}
function openSettlementNaming(error=''){
 settlementPanel('Name your settlement',error||'Choose a name for this character’s settlement. You can change it later without losing buildings, workers or quests.',[
 {label:'Save settlement name',action:()=>renameSettlement(document.getElementById('settlementNameInput').value)},
 {label:'Cancel',action:openSettlementMap}
 ],'<label for="settlementNameInput" style="display:block;margin:12px 0">Settlement name · 1–28 characters</label><input id="settlementNameInput" type="text" maxlength="56" autocomplete="off" style="box-sizing:border-box;width:100%;min-height:48px;font-size:18px;padding:10px;background:#192b25;color:#fff0c6;border:1px solid #c8ae70;border-radius:8px"/>');
 const input=document.getElementById('settlementNameInput');input.value=settlementName();input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();renameSettlement(input.value);}});input.focus();input.select();
}

// Settlement uses its own scene and saved state; the atlas exposes it separately.
function settlementMapPoints(){
 const m=maps.frontier_outpost;
 const ids=['frontier_board','frontier_exit','frontier_mine','town_council','frontier_well'];
 const points=ids.map(id=>m.worldObjects.find(o=>o.id===id)).filter(Boolean).map(o=>({...o,name:o.label}));
 for(const [id,d] of Object.entries(settlementBuildings)){
  const o=m.worldObjects.find(o=>o.id==='frontier_plot_'+id);
  if(o)points.push({...o,name:d.name+' · '+(settlementState().levels[id]?'Level '+settlementState().levels[id]:'Unbuilt')});
 }
 for(const n of m.npcs.filter(n=>n.workerId))points.push({id:'worker_'+n.workerId,x:n.x,y:n.y+35,name:n.name});
 const valley=m.worldObjects.find(o=>o.id==='memory_trail');
 if(valley)points.push({...valley,name:'Remembering Vale'});
 return points;
}
function settlementMapArt(points){
 const b={minX:0,maxX:1240,minY:-280,maxY:900},w=b.maxX-b.minX,h=b.maxY-b.minY;
 const roads=frontierRoads().map(([x,y,x1,y1])=>'<rect x="'+x+'" y="'+y+'" width="'+(x1-x)+'" height="'+(y1-y)+'" fill="#816a45"/>').join('');
 const plots=Object.entries(frontierPlots).map(([id,[x,y,w,h]])=>'<rect x="'+x+'" y="'+y+'" width="'+w+'" height="'+h+'" rx="9" fill="'+(settlementState().levels[id]?'#b89860':'#465346')+'" stroke="#d2bb89" stroke-width="4"/>').join('');
 const marks=points.map((point,i)=>{const plot=point.id.startsWith('frontier_plot_')&&frontierPlots[point.id.slice(14)];const o=plot?{x:plot[0]+plot[2]/2,y:plot[1]+plot[3]/2}:point;return '<g><circle cx="'+o.x+'" cy="'+o.y+'" r="24" fill="#192b25" stroke="#f1d699" stroke-width="3"/><text x="'+o.x+'" y="'+(o.y+8)+'" text-anchor="middle" font-size="24" fill="#fff0c6">'+(i+1)+'</text></g>';}).join('');
 const hero=mapId==='frontier_outpost'?'<circle cx="'+player.x+'" cy="'+player.y+'" r="17" fill="#7be5ed" stroke="#fff" stroke-width="4"/>':'';
 return '<svg role="img" aria-label="Hearthstead settlement map. Numbered locations match the walking destinations below. Blue dot marks your position." viewBox="'+b.minX+' '+b.minY+' '+w+' '+h+'" style="display:block;width:100%;max-height:380px;background:#283b2c;border:1px solid #b49a64;border-radius:12px"><rect x="'+b.minX+'" y="'+b.minY+'" width="'+w+'" height="'+h+'" fill="#283b2c"/>'+roads+plots+'<ellipse cx="1070" cy="552" rx="55" ry="32" fill="#477b86"/>'+marks+hero+'</svg>';
}
function walkSettlementPoint(id){
 if(mapId!=='frontier_outpost')return;
 const point=settlementMapPoints().find(o=>o.id===id);if(!point)return;
 closePanel('adventureScreen');tapTarget={x:point.x,y:point.y};
 say('Walking to '+point.name+'. Use INTERACT when you arrive.');
}
function openSettlementMap(){
 const here=mapId==='frontier_outpost',points=settlementMapPoints();
 settlementPanel('Hearthstead · Settlement Map',here?'Your settlement is a separate map. Blue dot: you. Choose a numbered destination to walk there, then use INTERACT. Buildings and workers reflect your current progress.':'Your settlement has its own map, in the southeast corner of the world, reached across any point of its north or west border. Visit on foot first; the Wayfarer’s Compass can return you here once discovered.',[
 {label:'Name your settlement',action:openSettlementNaming},
 {label:'Buildings, supplies and workers',action:openSettlement},
 ...(here?points.map((o,i)=>({label:(i+1)+'. '+o.name,action:()=>walkSettlementPoint(o.id)})):[{label:'Show world map and settlement route',action:()=>{openTravelScreen();requestAnimationFrame(()=>sizeAtlas(false,'frontier_outpost'));document.getElementById('atlasSelection').textContent='Settlement: southeast corner. Enter from Scorched Strand to the north or Obsidian Reach to the west.';}}]),
 {label:here?'Return to settlement':'Return to adventure',action:()=>{}}
 ],settlementMapArt(points));
 document.querySelector('#adventureScreen .screenFoot').textContent=settlementName()+' · Separate settlement map · Your buildings, residents and defenses';
}

function openSettlement(){const s=settlementTick();saveGame();if(!s.founded){settlementPanel('A Hearth Beyond the Walls','Along the roads between the four towns, families shelter in the remains of an old outpost. Help them rebuild a home. Your adventures, gathering skills, and victories will supply the settlement.\n\nFounding provides 18 timber, 12 stone, and 6 food. Visit any town to build, collect, and provision. Review progress from anywhere.',[{label:'Open settlement map',action:openSettlementMap},{label:'A Hearth Worth Keeping · story',action:openFrontierChapter},{label:(activeMap.town||mapId==='frontier_outpost')?'Found the settlement':'Return to a town to found',disabled:!(activeMap.town||mapId==='frontier_outpost'),action:foundSettlement},{label:'Return to adventure',action:()=>{}}],settlementArt());return;}
 const cap=80+s.levels.hall*80,ready=settlementTasks().filter(t=>t.done&&!s.claimed[t.id]).length;
 settlementPanel('Your Frontier Settlement','Build from any town. Gather in the world for +2 matching settlement supplies per successful node, alongside your normal loot. Producers work at 6 supplies per hour per level.\n\n'+(!(activeMap.town||mapId==='frontier_outpost')?'You are away from town; management is read-only.':'Choose a building to inspect its costs and restoration requirements.'),[
 {label:'Open settlement map',action:openSettlementMap},
 {label:'A Hearth Worth Keeping · story',action:openFrontierChapter},
 {label:'Collect production · '+['wood','stone','food'].map(k=>Math.floor(s.pending[k])).join(' / '),disabled:!(activeMap.town||mapId==='frontier_outpost'),action:collectSettlement},
 {label:'Hire and manage town workers',action:()=>openWorkforce()},
 {label:'Town council · relations and defense',action:openTownCouncil},
 {label:'Settlement objectives'+(ready?' · '+ready+' ready':''),action:()=>openSettlementTasks()},
 ...Object.entries(settlementBuildings).map(([id,d])=>({label:d.name+' · '+s.levels[id]+'/3',action:()=>openSettlementBuilding(id)})),{label:'Return to adventure',action:()=>{}}],settlementArt()+'<div class="settlementWallet">'+['wood','stone','food'].map((k,i)=>'<span><b>'+Math.floor(s.stock[k])+'</b> '+['Timber','Stone','Food'][i]+' <small>/ '+cap+'</small></span>').join('')+'</div>');}
function openSettlementBuilding(id,note=''){const s=settlementTick(),d=settlementBuildings[id];if(!d)return;const cost=settlementCost(id),gate=settlementGate(id),craft=['forge','lodge'].includes(id),craftCost=id==='forge'?[0,5-Math.max(1,s.levels.forge),2]:[0,0,7-Math.max(1,s.levels.lodge)];saveGame();settlementPanel(d.name,d.detail+'\n\nLevel '+s.levels[id]+' / 3\n'+(gate||'Next upgrade: '+settlementCostText(cost))+(note?'\n\n'+note:''),[{label:gate||(!settlementCanPay(cost)?'Need '+settlementCostText(cost):'Restore · '+settlementCostText(cost)),disabled:!(activeMap.town||mapId==='frontier_outpost')||!!gate||!settlementCanPay(cost),action:()=>upgradeSettlement(id)},...(craft?[{label:(id==='forge'?'Make 1 iron ore':'Prepare 1 healing tonic')+' · '+settlementCostText(craftCost),disabled:!(activeMap.town||mapId==='frontier_outpost')||!s.levels[id]||!settlementCanPay(craftCost),action:()=>settlementCraft(id)}]:[]),...(id==='garden'&&frontierState().blueprint?[{label:'Prepare Field Ration · 2 food',disabled:!(activeMap.town||mapId==='frontier_outpost')||!s.levels.garden||s.stock.food<2,action:craftFrontierRation}]:[]),...(id==='hall'&&mapId==='frontier_outpost'&&frontierState().complete?[{label:'Rest at the hearth · party healing',action:frontierRest}]:[]),{label:'Back to settlement',action:openSettlement}],'<div class="settlementBuildingIcon" aria-hidden="true">'+d.icon+'</div>');}
function openSettlementTasks(note=''){const s=settlementState();settlementPanel('Rebuilding the Frontier',(note?note+'\n\n':'')+'After founding: '+s.gathers.wood+'/3 wood nodes · '+s.gathers.stone+'/3 mining nodes · '+Math.min(8,s.kills)+'/8 enemies.\n\n'+settlementTasks().map(t=>(s.claimed[t.id]?'✓ ':t.done?'READY · ':'')+t.title+'\n'+t.text+'\nReward: '+settlementCostText(t.reward)).join('\n\n'),[...settlementTasks().filter(t=>t.done&&!s.claimed[t.id]).map(t=>({label:'Claim: '+t.title,disabled:!(activeMap.town||mapId==='frontier_outpost'),action:()=>claimSettlementTask(t.id)})),{label:'Back to settlement',action:openSettlement}]);}

// Living towns: transient movement, character-owned hires and active-play jobs.
const workerDefs={
 builder:{name:'Bram',job:'Builder',cost:60,building:'hall',at:[365,240],action:'Fitting timber',detail:'Queue one building upgrade. Supply its normal materials; Bram completes it in 45 seconds of active play.'},
 farmer:{name:'Ada',job:'Farmer',cost:45,building:'garden',at:[285,475],action:'Tending crops',resource:'food',detail:'Grows 1 food every 60 seconds of active play.'},
 fisher:{name:'Finn',job:'Fisher',cost:45,building:'hall',at:[1005,535],action:'Casting a line',resource:'food',detail:'Catches fish for 1 settlement food every 60 seconds of active play.'},
 lumberjack:{name:'Orin',job:'Woodcutter',cost:50,building:'mill',at:[275,235],action:'Splitting timber',resource:'wood',detail:'Cuts 1 timber every 60 seconds of active play.'},
 smith:{name:'Elric',job:'Smith',cost:65,building:'forge',at:[575,495],action:'Forging supplies',item:'iron_ore',inputs:[0,3,2],detail:'Forges 1 iron ore per 90 active seconds. Each batch uses 3 stone and 2 food.'},
 cook:{name:'Rosa',job:'Cook',cost:55,building:'garden',at:[350,485],action:'Preparing rations',item:'field_ration',inputs:[0,0,2],detail:'Prepares 1 Field Ration per 90 active seconds, using 2 food. Requires the Bellkeeper Provisions blueprint.'},
 healer:{name:'Wren',job:'Apothecary',cost:65,building:'lodge',at:[845,500],action:'Mixing remedies',item:'health_tonic',inputs:[0,0,5],detail:'Prepares 1 Health Tonic per 90 active seconds, using 5 food.'},
 guard:{name:'Tor',job:'Town Guard',cost:70,building:'barracks',at:[770,-60],action:'Patrolling the gate',detail:'While on duty, reduces siege pressure by another 10% and adds 1 damage to each defensive volley.'},
 miner:{name:'Kes',job:'Miner',cost:50,building:'quarry',at:[850,235],action:'Sorting stone',resource:'stone',detail:'Quarries 1 stone every 60 seconds of active play.'}
};
function workforceState(){let s=townQuestState._workers;if(!s||typeof s!=='object'||Array.isArray(s))s=townQuestState._workers={};s.version=1;if(!s.hires||typeof s.hires!=='object')s.hires={};for(const id of Object.keys(workerDefs)){const h=s.hires[id];if(!h)continue;h.active=h.active!==false;h.progress=Math.max(0,Math.min(90,Number(h.progress)||0));h.ready=Math.max(0,Math.min(20,Math.floor(Number(h.ready)||0)));}return s;}
function workerGate(id){const d=workerDefs[id];if(!d)return 'Unknown worker';if(!frontierState().complete)return 'Welcome the first Hearthstead families first';if(!settlementState().levels[d.building])return 'Restore '+settlementBuildings[d.building].name+' first';if(id==='cook'&&!frontierState().blueprint)return 'Recover the Bellkeeper Provisions blueprint first';if(politicsState().phase==='siege')return 'Resolve the siege first';return '';}
function hireWorker(id){const d=workerDefs[id],s=workforceState();if(!d||s.hires[id]||!settlementAtTown()||workerGate(id))return false;if(player.coins<d.cost){openWorker(id,'Not enough crowns.');return false;}player.coins-=d.cost;s.hires[id]={active:true,progress:0,ready:0};syncHiredWorkers();saveGame();ui();openWorker(id,'Welcome to Hearthstead, '+d.name+'.');return true;}
function syncHiredWorkers(){const m=maps.frontier_outpost;if(!m)return;const keep=m.npcs.filter(n=>!n.workerId);for(const [id,h] of Object.entries(workforceState().hires)){const d=workerDefs[id];if(!d||!h)continue;const previous=m.npcs.find(n=>n.workerId===id);keep.push(previous||{name:d.name+' the '+d.job,workerId:id,routineRole:id,x:d.at[0],y:d.at[1],lines:['I am '+d.name+', your '+d.job.toLowerCase()+'. '+d.detail]});}m.npcs=keep;if(mapId==='frontier_outpost')npcs=m.npcs;}
function openWorkforce(note=''){const s=workforceState();settlementPanel('People of Hearthstead',(note?note+'\n\n':'')+'Hire skilled residents with a one-time payment. No recurring wages. Gatherers and crafters store up to 20 outputs each; collect them into your settlement stock. Work advances during active play, including when you explore elsewhere. Menus, closed games and sieges pause jobs.\n\nBuilders use your normal upgrade materials. Hires and unfinished work save with this character.',Object.entries(workerDefs).map(([id,d])=>({label:d.name+' · '+d.job+(s.hires[id]?' · '+(s.hires[id].active?'HIRED':'RESTING'):' · '+d.cost+' crowns'),action:()=>openWorker(id)})).concat([{label:'Back to settlement',action:openSettlement}]),'<div class="crewBanner"><span>THE WORKING TOWN</span><b>'+Object.keys(s.hires).filter(id=>workerDefs[id]).length+' / '+Object.keys(workerDefs).length+' residents hired</b><small>'+player.coins+' crowns available</small></div>');document.querySelector('#adventureScreen .screenFoot').textContent='Workers advance during active play · No offline worker income';}
function openWorker(id,note=''){const d=workerDefs[id];if(!d)return;const s=workforceState(),h=s.hires[id],gate=workerGate(id),manage=activeMap.town||mapId==='frontier_outpost',job=s.build;let status=h?(h.active?'On duty':'Resting'):'Available to hire';if(h&&id==='builder'&&builderBoostSeconds()>0)status+=' · +25% speed · '+Math.ceil(builderBoostSeconds())+' work seconds left';if(h&&id==='builder')status+=job?' · '+settlementBuildings[job.id].name+' · '+Math.floor(job.elapsed||0)+'/45 seconds':' · no construction queued';else if(h&&id==='guard')status+=' · protects the whole town';else if(h)status+=' · '+h.ready+'/20 '+(d.item?itemDefs[d.item].name:d.resource)+' ready · '+Math.floor(h.progress)+'/'+(d.item?90:60)+' seconds'+(d.item&&!h.batch?' · waiting for supplies':'');settlementPanel(d.name+' · '+d.job,(note?note+'\n\n':'')+d.detail+'\n\n'+status+(gate?'\n'+gate:''),[
 ...(!h?[{label:gate||'Hire · '+d.cost+' crowns (one time)',disabled:!manage||!!gate||player.coins<d.cost,action:()=>hireWorker(id)}]:[
 {label:h.active?'Let '+d.name+' rest':'Return to work',disabled:!manage,action:()=>{if(!settlementAtTown())return;h.active=!h.active;saveGame();openWorker(id);}},
 ...(id==='builder'?[{label:job?'Construction in progress':'Choose construction project',disabled:!manage||!!gate||!!job,action:openWorkerConstruction}]:id==='guard'?[]:[{label:'Collect '+h.ready+' '+(d.item?itemDefs[d.item].name:d.resource),disabled:!manage||!h.ready,action:()=>collectWorker(id)}]),
 ...(mapId==='frontier_outpost'?[{label:'Find '+d.name,action:()=>{const n=npcs.find(n=>n.workerId===id);if(n){tapTarget={x:n.x,y:n.y+35};say(d.name+' works near '+(id==='fisher'?'the eastern fishing pond':settlementBuildings[d.building].name)+'.');}}}]:[])]),
 {label:'All workers',action:()=>openWorkforce()}],'<div class="crewBanner"><span>'+d.job.toUpperCase()+'</span><b>'+d.name+'</b><small>'+(h?'A resident of your town':'A new pair of hands')+'</small></div>');document.querySelector('#adventureScreen .screenFoot').textContent='Active play only · Full stores stop production without losing supplies';}
function collectWorker(id){const d=workerDefs[id],h=workforceState().hires[id];if(!d||!h||(!d.resource&&!d.item)||!settlementAtTown())return;const s=settlementState();let take=0;if(d.item){take=Math.min(h.ready,Math.max(0,bagLimit()-bagUnits()));if(take&&!addItem(d.item,take))take=0;}else{take=Math.min(h.ready,Math.floor(80+s.levels.hall*80-s.stock[d.resource]));s.stock[d.resource]+=take;}h.ready-=take;saveGame();ui();openWorker(id,take?'Collected '+take+' '+(d.item?itemDefs[d.item].name:d.resource)+'.':'Your '+(d.item?'bag is':'settlement stores are')+' full. Nothing was lost.');}
function openWorkerConstruction(){const s=workforceState();settlementPanel('Bram’s construction ledger','One project at a time. Materials are paid when you commission it. Bram needs 45 seconds of active work (36 with an active Builder’s Contract); resting or a siege pauses construction. Normal story and restoration requirements still apply. You can still restore other buildings yourself.',Object.entries(settlementBuildings).map(([id,d])=>{const gate=settlementGate(id),cost=settlementCost(id);return {label:d.name+' · '+(gate||settlementCostText(cost)),disabled:!!gate||!!s.build||!settlementCanPay(cost)||!s.hires.builder?.active,action:()=>queueWorkerBuild(id)};}).concat([{label:'Back to Bram',action:()=>openWorker('builder')}]));}
function queueWorkerBuild(id){const s=workforceState();if(!settlementBuildings[id]||!settlementAtTown()||!s.hires.builder?.active||s.build||workerGate('builder')||settlementGate(id)||!settlementCanPay(settlementCost(id)))return false;const level=settlementState().levels[id];settlementPay(settlementCost(id));s.build={id,level,elapsed:0};saveGame();openWorker('builder','Materials delivered. Bram has started the project.');return true;}
function builderBoostSeconds(){return Math.max(0,Number(townQuestState._builderBoost?.seconds)||0)}
// Internal gameplay activation only; no unverified purchase can reach this function.
function startBuilderBoost(){if(builderBoostSeconds()>0||!frontierState().complete||!workforceState().hires.builder||workerGate('builder'))return false;townQuestState._builderBoost={seconds:900};saveGame();return true}
function builderWorkTime(dt){const boosted=Math.min(dt,builderBoostSeconds());if(boosted>0)townQuestState._builderBoost.seconds=Math.max(0,builderBoostSeconds()-boosted);return dt+boosted*.25}
function workforceTick(dt){if(document.hidden||!Number.isFinite(dt)||dt<=0)return;const s=workforceState();if(!frontierState().complete||politicsState().phase==='siege')return;dt=Math.min(dt,.25);for(const [id,h] of Object.entries(s.hires)){const d=workerDefs[id];if(!d||!h.active||!settlementState().levels[d.building])continue;if(id==='builder'){const b=s.build;if(!b||!settlementBuildings[b.id])continue;if(mapId==='frontier_outpost'){const builder=npcs.find(n=>n.workerId==='builder');if(!builder||!npcRoutines.get(builder)?.projectReady)continue;}b.elapsed=Math.min(45,(Number(b.elapsed)||0)+builderWorkTime(dt));if(b.elapsed>=45){const town=settlementState();if(town.levels[b.id]===b.level)town.levels[b.id]=Math.min(3,b.level+1);delete s.build;say('Bram finished '+settlementBuildings[b.id].name+'.');saveGame();}continue;}if(id==='guard'||h.ready>=20)continue;if(d.item&&!h.batch){if(workerGate(id)||!settlementCanPay(d.inputs))continue;settlementPay(d.inputs);h.batch=true;}const hungry=d.resource==='food'&&townQuestState.npc_sera?.choice==='divert'&&!townQuestState.npc_sera.repaired;h.progress+=dt*(hungry?.5:1);const duration=d.item?90:60;if(h.progress>=duration){h.progress-=duration;h.ready++;h.batch=false;}}}

const npcRoutines=new WeakMap(),npcHeroActors=new WeakMap();
function drawNpcHero(n){let actor=npcHeroActors.get(n);if(!actor){actor={};npcHeroActors.set(n,actor);}Object.assign(actor,n,{class:companionDefs[n.companionId].class,faceX:npcRoutines.get(n)?.face||0,faceY:1,walking:!!npcRoutines.get(n)?.walking});return drawClassHero(actor,1.55);}
function npcWorkRole(n){if(n.routineRole)return ({smith:'builder',cook:'merchant',healer:'herbalist'})[n.routineRole]||n.routineRole;if(n.shopId?.endsWith('_forge')||/smith|carpenter/i.test(n.name))return 'builder';if(/gardener|farmer/i.test(n.name))return 'farmer';if(/netmaker|sailor/i.test(n.name))return 'fisher';if(n.role==='companion')return 'keeper';if(/guard|captain|scout|outrider|warden/i.test(n.name))return 'guard';if(n.role==='healer'||/herbalist/i.test(n.name))return 'herbalist';if(n.shopId||n.role==='innkeeper')return 'merchant';return 'scribe';}
function npcRoutine(n){let r=npcRoutines.get(n);if(r)return r;const seed=[...n.name].reduce((a,c)=>a+c.charCodeAt(0),0),home={x:n.x,y:n.y},role=npcWorkRole(n);const span=role==='guard'?65:role==='farmer'?38:26;const candidates=[home,{x:home.x+span,y:home.y+8},{x:home.x-span,y:home.y+12},{x:home.x,y:home.y+30}];const stops=candidates.filter(p=>!mapPlacementBlocked(mapId,p.x,p.y,12)&&walkingLine(mapId,home,p,12));r={home,stops:stops.length?stops:[home],index:0,wait:1+seed%5,clock:seed,walking:false,role,face:1};npcRoutines.set(n,r);return r;}
function updateNpcRoutines(dt){if(document.hidden)return;for(const n of npcs){if(/inscription|tablet/i.test(n.name))continue;const r=npcRoutine(n);r.walking=false;const project=n.workerId==='builder'&&workforceState().build;if(project){const key=project.id+':'+project.level;if(r.project!==key){const [x,y,w,h]=frontierPlots[project.id],goal=safeMapPosition(mapId,x+w/2,y+h+35,12);r.project=key;r.projectReady=false;r.route=findWalkingPath(mapId,n,goal,12)||[];}if(r.route?.length){const q=r.route[0],dx=q.x-n.x,dy=q.y-n.y,d=Math.hypot(dx,dy),step=Math.min(d,dt*32);if(politicsState().phase!=='siege'&&workforceState().hires.builder?.active){if(d<1)r.route.shift();else if(!mapPlacementBlocked(mapId,n.x+dx/d*step,n.y+dy/d*step,12)){n.x+=dx/d*step;n.y+=dy/d*step;r.walking=true;r.face=dx<0?-1:1;r.clock+=dt;}r.activity='Carrying tools to the site';}continue;}r.projectReady=true;r.clock+=dt;r.activity=politicsState().phase==='siege'?'Work suspended':workforceState().hires.builder?.active?'Constructing '+settlementBuildings[project.id].name:'Resting';continue;}else if(r.project){npcRoutines.delete(n);continue;}const h=n.workerId&&workforceState().hires[n.workerId];if(Math.hypot(player.x-n.x,player.y-n.y)<88||h&&!h.active||mapId==='frontier_outpost'&&politicsState().phase==='siege'){r.activity=h&&!h.active?'Resting':mapId==='frontier_outpost'&&politicsState().phase==='siege'?(r.role==='guard'?'Defending town':'Work suspended'):'Ready to talk';continue;}if(h&&n.workerId!=='guard'&&(h.ready>=20||workerDefs[n.workerId].item&&!h.batch&&!settlementCanPay(workerDefs[n.workerId].inputs))){r.activity=h.ready>=20?'Stores full':'Waiting for supplies';continue;}r.clock+=dt;if(r.wait>0){r.wait-=dt;r.activity=workerDefs[n.workerId]?.action||({builder:'Working at the bench',farmer:'Tending plants',fisher:'Mending fishing tackle',keeper:'Preparing feed',guard:'Watching the road',herbalist:'Preparing remedies',merchant:'Checking supplies',scribe:'Reading the ledger'})[r.role];continue;}const target=r.stops[(r.index+1)%r.stops.length],dx=target.x-n.x,dy=target.y-n.y,d=Math.hypot(dx,dy);if(d<1){r.index=(r.index+1)%r.stops.length;r.wait=4+(r.index*3)%5;continue;}const step=Math.min(d,dt*23),x=n.x+dx/d*step,y=n.y+dy/d*step;if(mapPlacementBlocked(mapId,x,y,12)||npcs.some(other=>other!==n&&Math.hypot(other.x-x,other.y-y)<23)){r.wait=1;continue;}n.x=x;n.y=y;r.face=dx<0?-1:1;r.walking=true;r.activity=r.role==='guard'?'Patrolling':'Walking to work';}}
function drawNpcWork(n,r){if(!r||r.walking||r.activity==='Ready to talk'||r.activity==='Resting'||r.activity==='Work suspended'||r.activity==='Stores full'||r.activity==='Waiting for supplies')return;const t=r.clock,role=r.role;ctx.save();ctx.translate(n.x+12,n.y-13);ctx.lineCap='round';ctx.lineJoin='round';ctx.lineWidth=2.4;if(['builder','miner','lumberjack','farmer'].includes(role)){const a=Math.sin(t*5)*.45;ctx.rotate(-.4+a);ctx.strokeStyle='#bc8b52';ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(8,-20);ctx.stroke();ctx.fillStyle=role==='farmer'?'#727d72':'#aebbbd';ctx.fillRect(role==='farmer'?4:1,-22,role==='farmer'?13:12,5);if(role==='builder'&&a>.38){ctx.fillStyle='#ffd485';for(let i=0;i<3;i++)ctx.fillRect(9+i*4,-3-i*3,2,2);}}else if(role==='fisher'){ctx.strokeStyle='#a68051';ctx.beginPath();ctx.moveTo(0,0);ctx.quadraticCurveTo(20,-40,38,-33);ctx.stroke();ctx.strokeStyle='#d3ddd288';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(38,-33);ctx.lineTo(47,12+Math.sin(t*2));ctx.stroke();ctx.fillStyle='#df9b64';ctx.fillRect(45,10+Math.sin(t*2),4,3);}else if(role==='guard'){ctx.strokeStyle='#aaa78b';ctx.beginPath();ctx.moveTo(2,12);ctx.lineTo(3,-28);ctx.stroke();ctx.fillStyle='#c8d2cd';ctx.beginPath();ctx.moveTo(3,-36);ctx.lineTo(-1,-26);ctx.lineTo(7,-26);ctx.fill();}else{ctx.rotate(Math.sin(t*1.7)*.07);ctx.fillStyle=role==='herbalist'?'#739c71':'#d7bf8d';ctx.fillRect(-2,-8,15,11);ctx.strokeStyle='#846b49';ctx.lineWidth=1;ctx.strokeRect(-2,-8,15,11);ctx.beginPath();ctx.moveTo(5,-7);ctx.lineTo(5,2);ctx.stroke();}ctx.restore();}
function drawLivingVillager(n){if(n.vampireId&&drawVampireNpc(n))return true;if(/inscription|tablet/i.test(n.name))return standArt('tablet',n.x,n.y,45,'extras');if(!artReady('actors'))return false;const r=npcRoutines.get(n),height=activeMap.town?55:51,key=n.workerId?({builder:'smith',farmer:'farmer',fisher:'traveler',lumberjack:'farmer',miner:'smith',smith:'smith',cook:'merchant',healer:'healer',guard:'guard'})[n.workerId]:villagerKey(n),f=detailedFrames.actors[key],width=height*f[2]/f[3],gait=r?.walking?Math.sin(r.clock*10):0;ctx.save();ctx.translate(n.x,n.y);if(r?.walking&&r.face<0)ctx.scale(-1,1);ctx.imageSmoothingEnabled=true;const split=.72;ctx.drawImage(detailedArt.actors,f[0],f[1],f[2],f[3]*split,-width/2,-height+7-Math.abs(gait)*1.1,width,height*split);for(let i=0;i<2;i++){const stride=gait*(i?1:-1);ctx.drawImage(detailedArt.actors,f[0]+f[2]/2*i,f[1]+f[3]*split,f[2]/2,f[3]*(1-split),-width/2+width/2*i+stride*1.6,-height+7+height*split-Math.max(0,stride)*2,width/2,height*(1-split));}ctx.restore();drawNpcWork(n,r);return true;}
function drawTownBanners(){const colors={ashvale:'#638573',brackenford:'#738754',stonewatch:'#687b99',sunmere:'#4f939f'},color=colors[mapId]||'#648775';ctx.save();for(const key of ['elder','shop','forge']){const f=townFrontages[key];if(!activeMap.npcs.some(n=>n.frontage===key))continue;const x=f.x+f.w-18,y=f.y+31;ctx.strokeStyle='#bda36c';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x,y-4);ctx.lineTo(x,y+38);ctx.stroke();ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(x+1,y);ctx.lineTo(x+19,y+1);ctx.lineTo(x+18,y+30);ctx.lineTo(x+10,y+24);ctx.lineTo(x+1,y+29);ctx.fill();ctx.strokeStyle='#e8d499';ctx.lineWidth=1;ctx.stroke();ctx.fillStyle='#e6d299';ctx.fillRect(x+8,y+9,4,9);}ctx.restore();}
function drawWorkingTown(){if(mapId!=='frontier_outpost')return;const hires=workforceState().hires;textureWater(1070,552,47,27);if(hires.fisher){ctx.save();ctx.fillStyle='#806a45';for(let i=0;i<5;i++)ctx.fillRect(1010+i*8,533,7,18);ctx.restore();standArt('crate',984,555,23);}if(hires.farmer){ctx.save();ctx.fillStyle='#59432c';ctx.fillRect(264,436,71,23);for(let row=0;row<2;row++)for(let col=0;col<7;col++){const x=270+col*9,y=442+row*10;ctx.strokeStyle='#9ebc6b';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x,y+6);ctx.lineTo(x-3,y);ctx.moveTo(x,y+6);ctx.lineTo(x+4,y+1);ctx.stroke();}ctx.restore();}for(const [id,key] of [['builder','logs'],['lumberjack','logs'],['miner','silver']])if(hires[id]){const d=workerDefs[id];standArt(key,d.at[0]+25,d.at[1]-9,25,'items');}const b=workforceState().build;if(b){const [x,y,w,h]=frontierPlots[b.id];ctx.save();ctx.strokeStyle='#b79261';ctx.lineWidth=4;ctx.strokeRect(x-5,y-7,w+10,h+8);for(let row=1;row<4;row++){ctx.beginPath();ctx.moveTo(x-5,y+row*h/4);ctx.lineTo(x+w+5,y+row*h/4);ctx.stroke();}ctx.beginPath();ctx.moveTo(x-5,y+h);ctx.lineTo(x+w+5,y-7);ctx.stroke();if(!b.level&&b.elapsed>12){ctx.save();ctx.beginPath();const reveal=Math.min(1,(b.elapsed-12)/30);ctx.rect(x,y+h-h*reveal,w,h*reveal);ctx.clip();drawPixelHouse(x,y,w,h,b.id==='hall'?1:0,b.id==='forge'?'forge':b.id==='hall'?'elder':'home');ctx.restore();}ctx.fillStyle='#152820';ctx.fillRect(x,y+h+13,w,6);ctx.fillStyle='#e4bf70';ctx.fillRect(x,y+h+13,w*Math.min(1,b.elapsed/45),6);ctx.restore();}}

maps.crowfield.npcs.push({name:'Elsie the Farmer',x:260,y:220,routineRole:'farmer',lines:['The mill needs its gears, but the seedlings still need tending.','A harvest takes patience. I work a different row while the soil drinks.']});

let adventureChoices=[];
function openAdventureDialog(title,text,choices){title=title.replaceAll('Hearthstead',()=>settlementName());text=text.replaceAll('Hearthstead',()=>settlementName());document.getElementById('adventureScreen').querySelector('.screenClose').setAttribute('aria-label','Close story');document.getElementById('adventureScreen').classList.remove('tavernView','slayerView','narrativeView','settlementView','npcTalkView');document.getElementById('adventureScreen').querySelector('.screenFoot').textContent='Choices and progress save with this character.';preparePanel('adventureScreen');keys.clear();document.getElementById('adventureTitle').textContent=title;document.getElementById('adventureText').textContent=text;adventureChoices=choices;document.getElementById('adventureChoices').innerHTML=choices.map((q,i)=>'<button type="button" data-adventure-choice="'+i+'"'+(q.disabled?' disabled':'')+'>'+q.label+'</button>').join('');document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;document.getElementById('adventureScreen').hidden=false;refreshPanelState()}

// Single-player narrative: revelations unlock with existing quest progress.
const campaignScenes={
 opening:{title:'Prologue · The Night the Bells Stopped',text:'At dusk, every bell in the Reach falls silent. By morning, ash drifts from a cloudless sky. On the road outside your home town, you find a broken cart, an empty medicine chest, and a watch ribbon tied around the axle. Someone stayed behind so the others could run.\n\nYou are not carrying a prophecy. You are carrying the ribbon home.\n\nFour towns have survived by keeping their gates closed. Now the roads between them are dying. Start with the creatures gathering in Whisperwood, then ask Dalen in Ashvale what happened to his patrol. The answer will take you farther than he wants to admit.'},
 seals:{title:'Chapter I · Four Broken Promises',text:'Dalen closed a gate on people he had sworn to protect. Sylvi hid a warning. Corin abandoned a vigil. Eryn broke a beacon and kept silent. None caused this darkness alone; each believed that saving one town meant turning away from another.\n\nTheir founders made the same mistake. The four town seals are pieces of one promise: no gate will close while a neighbor is still outside. Helping these four people repair what they can is how you restore that promise.\n\nFinish both personal quests in each town. The seals will join into the Fourfold Keystone and open Mosslight Shrine.'},
 rune:{title:'Chapter II · The Words Beneath the Words',text:'The four seals fit without a seam. In Mosslight, soot hides a line beneath the founders’ oath: “A ward is a promise kept together.”\n\nThe lanterns are not asking which town was strongest. Their sequence remembers the messengers who carried help between them. Beyond the shrine waits the Ember Rune, the key to the Ashvault.\n\nSomeone scratched a warning beside the lock: “Do not mistake the keeper for the thing he keeps.”'},
 vault:{title:'Chapter III · The Keeper Below',text:'The Ember Rune warms in your hand whenever the ash falls. Beneath Ashvale, the Cinder Warden still guards a vault whose builders are long dead.\n\nThe founders did imprison a hungry force. But their safeguard demanded a living keeper. They chose a watch captain, placed a crown upon his head, and slowly removed his name from every record.\n\nDescend into the Ashvault. Find what the towns chose to forget before you decide what must be destroyed.'},
 sanctums:{title:'Chapter IV · The Cost of Keeping',text:'The Ashvault ledger names the captain: Auren. The towns called him Regent so no one would have to call him a sacrifice. For generations he held the breach alone. Now he gathers the dead, convinced that people who cannot leave can never abandon one another.\n\nThe Ember, Tide, and Storm sanctums hold the three hearts that once let the towns share his burden. Recover them. You are not gathering a stronger crown; you are gathering a way to end its rule.'},
 ember:{title:'Ember Memory · A Name Returned',text:'Inside the Ember heart, a memory survives: Auren kneels beside a burned gate, reading the names of those he could not save. There is no throne in the memory. Only a tired captain and a promise he cannot forgive himself for breaking.\n\nDalen reads the last name aloud. “Remembering them is our duty. Making everyone else prisoners is not.”\n\nThe first heart answers. The Tide Vault is next.'},
 tide:{title:'Tide Memory · Those Who Left',text:'The Tide heart remembers boats leaving through smoke. Auren believes they fled him. The harbor record tells another story: they carried children and medicine, and promised to return. The beacon failed before their answer arrived.\n\nSylvi studies the record. “Silence is not proof that nobody cared.” Eryn takes a copy of the beacon pattern. This time, a warning will leave the harbor.\n\nThe Storm Spire holds the last heart.'},
 storm:{title:'Storm Memory · The Unfinished Oath',text:'The Storm heart preserves the oath without its missing final line: “Until the four return to stand beside the one.” The founders turned a temporary watch into a life sentence.\n\nCorin rings the small vigil bell once for Auren, then once for those Auren has hurt. “We can tell the truth about him without excusing him.”\n\nAll three hearts are yours. Enter Hollow Crown Keep in the Cinder Fields. Break the Regent’s wards and stop the army he is building.'},
 crown:{title:'Chapter V · No One Keeps the Watch Alone',text:'Beyond the keep, the dead march toward the four towns. Auren no longer asks them to trust him. He intends to make leaving impossible.\n\nYou carry proof that his watch was meant to end. He carries centuries of reasons not to believe you. His suffering explains the crown; it does not give him the right to rule the living.\n\nBreak both wards, defeat the Hollow Regent and his remaining guards, and open the final cache. The breach can be closed. What becomes of its hearts will be your last decision.'}
};
function campaignChapter(){return !done?'opening':!hasFourfoldKey?'seals':!hasSigil?'rune':!deepQuestDone?'vault':storySanctumCount()<3?'sanctums':'crown'}
function tutorialState(){return townQuestState._tutorial||(townQuestState._tutorial={active:false,steps:{},distance:0})}
function tutorialMark(key){const t=tutorialState();if(!t.active||t.steps[key])return;t.steps[key]=true;saveGame();refreshTutorialHint()}
function tutorialLessons(){return [
 ['move','Move and steer','Hold the ground to walk. Slide your finger to change direction without lifting; lift to stop. You can choose an arrow pad in MENU. Walk a short distance to finish this lesson.'],
 ['map','Find a safe hunt','Open Map from MENU. The first areas beside towns have monsters every unarmed class can fight. Difficulty rises toward the center. Rare Dread Wanderers appear deeper in the wilderness: their red DANGER marker and level warn you to keep away. They can defeat low-level heroes.'],
 ['kill','Earn your first crowns','Approach an ordinary nearby monster to attack automatically. Move out of attack warnings or use DODGE. Your pet helps. Defeat one monster to earn crowns and XP. Quests in MENU show your next goals; stronger monsters can wait.'],
 ['gear','Earn and equip gear','Every class starts without gear. Save crowns for a usable item from a town merchant, or earn one through a quest. Open MENU → Bag, select it and equip it. Skills and forging improve through normal play. This tutorial gives no free equipment or crowns.']
 ]}
function refreshTutorialHint(){const b=document.getElementById('tutorialHint');if(!b)return;const t=tutorialState(),lessons=tutorialLessons(),next=lessons.find(l=>!t.steps[l[0]]);b.hidden=!t.active;b.textContent=next?'Tutorial · '+next[1]:'Tutorial complete';}
function openTutorial(){const t=tutorialState(),lessons=tutorialLessons(),next=lessons.find(l=>!t.steps[l[0]]);openAdventureDialog(next?'Tutorial · '+next[1]:'Tutorial complete',next?next[2]+'\n\n'+lessons.map(l=>(t.steps[l[0]]?'✓ ':'○ ')+l[1]).join('\n'):'You learned movement, safe routes, combat and equipment. Continue your quests at your own pace.',[{label:next?'Continue tutorial':'Finish tutorial',action:()=>{t.active=!!next;saveGame();refreshTutorialHint()}},{label:'Skip tutorial',action:()=>{t.active=false;saveGame();refreshTutorialHint()}}]);}
function showCampaignScene(id,back=false){const scene=campaignScenes[id];if(!scene)return;openAdventureDialog(scene.title,scene.text,[...(id==='opening'&&!back?[{label:'Start tutorial',action:()=>{tutorialState().active=true;openTutorial()}}]:[]),{label:back?'Back to story chronicle':'Continue the journey',action:()=>{if(back)openCampaignChronicle()}}]);document.getElementById('adventureScreen').classList.add('narrativeView')}
function campaignAftermath(){
 const choice=townQuestState.campaign_ending?.choice;
 const decision=choice==='share'?'You return one heart to each of three towns. Ashvale keeps the oath and coordinates the watch. No town can command the wards alone. Their first council is noisy, imperfect, and open to everyone.':'You place the hearts beneath the repaired keep. Each town sends a keeper, serving one season before returning home. The gate remains open. No one will disappear into its stones again.';
 const lines=['The Hollow Regent is defeated. The breach closes. The dead lose the voice driving them toward the towns. Auren’s last breath is his own name.\n\n'+decision,
 'Dalen reads the lost patrol’s names at the open gate. Sylvi delivers her warning map herself. Corin finishes the vigil. Eryn lights the harbor beacon in full view of the people she failed. Forgiveness is not instant, but the work has begun.'];
 for(const [id,def] of Object.entries(companionDefs)){const end=townQuestState['epilogue_'+id];if(end?.claimed)lines.push(def.name+(end.choice==='road'?' takes the road again, carrying news between the towns.':' stays with the watch, protecting those who travel between the towns.'));}
 const medicine=townQuestState.crossroads_medicine?.choice;if(medicine==='mercy')lines.push('At the crossroads, the traveler you helped is treating the first returning caravan. Your kindness has outlived the danger.');else if(medicine==='profit')lines.push('The courier’s caravan returns to the crossroads. Your bargain is remembered; trust there will take longer to rebuild.');
 lines.push('Weeks later, Eryn brings a salt-stained reply to the beacon’s first signal. The paper bears a bell with five spokes, a mark absent from every surviving town record. Beneath it are eight words: “We kept our light. Did you keep yours?”\n\nBeyond the sea, a fifth bell answers.\n\nThe Reach is safe. The road ahead is still unwritten.');
 return lines.join('\n\n');
}
function finishCampaign(choice){if(!storyCleared('hollowcrown')||!['share','watch'].includes(choice))return;if(!townQuestState.campaign_ending?.choice){townQuestState.campaign_ending={choice,completed:true};saveGame();ui()}showCampaignEnding()}
function showCampaignEnding(){if(!storyCleared('hollowcrown'))return;
 if(townQuestState.campaign_ending?.choice){openAdventureDialog('Epilogue · The Fifth Bell',campaignAftermath()+'\n\nThis chapter closes, but the Reach lives on. Revisit challenge sanctums, earn new hall ranks and shape your settlement.',[{label:'Your next adventure',action:openContinuingAdventure},{label:'Return to the Reach',action:()=>{}},{label:'Read the story chronicle',action:openCampaignChronicle}])}
 else{openAdventureDialog('The Last Watch','The crown breaks. Auren sees the three hearts and, for one moment, remembers what they were meant to do. He releases the breach. The army falls still.\n\nThe towns can hold the restored wards without another sacrifice. You must decide how. Both choices save the Reach; neither changes your combat rewards. This decision will remain in your character’s story.',[{label:'Share the hearts between the towns',action:()=>finishCampaign('share')},{label:'Establish a rotating watch at the keep',action:()=>finishCampaign('watch')}])}
 document.getElementById('adventureScreen').classList.add('narrativeView');
}
function openCampaignChronicle(){
 const current=campaignChapter(),unlocked=['opening'];if(done)unlocked.push('seals');if(hasFourfoldKey)unlocked.push('rune');if(hasSigil)unlocked.push('vault');if(deepQuestDone)unlocked.push('sanctums');for(const [area,scene] of [['embercrypt','ember'],['tidevault','tide'],['stormspire','storm']])if(storyCleared(area))unlocked.push(scene);if(storySanctumCount()===3)unlocked.push('crown');
 const choices=unlocked.map(id=>({label:campaignScenes[id].title,action:()=>showCampaignScene(id,true)}));if(storyCleared('hollowcrown'))choices.push({label:townQuestState.campaign_ending?.choice?'Read your ending':'Choose the Reach’s future',action:showCampaignEnding});choices.push({label:'Return to the adventure',action:()=>{}});
 openAdventureDialog('Story Chronicle',storyCleared('hollowcrown')?'The Regent is defeated. Your completed chapters and the Reach’s future are recorded here.':'Current chapter: '+campaignScenes[current].title+'\n\n'+campaignScenes[current].text,choices);document.getElementById('adventureScreen').classList.add('narrativeView');
}

function collectStoryCache(id){const d=storyDungeons[id],st=storyState(id),firstStoryClaim=!st.claimed&&!st.replayActive;if(maps[id].enemies.some(e=>e.alive)){say('Defeat the guardian and every sanctum guard first.');return true}if(st.claimed&&!st.replayActive){say('This sanctum’s story treasure has already been claimed. Use the challenge altar to revisit its battle.');return true}const alloy=st.replayActive?2:5;if(bagUnits()+alloy>bagLimit()){say('Make room for '+alloy+' Ancient Alloy, then open the cache.');return true}addItem('ancient_alloy',alloy);if(st.replayActive){st.replayActive=false;st.replayReadyAt=Date.now()+300000;player.coins+=35;grantXp(35);say('Challenge complete · 2 Ancient Alloy · +35 crowns · +35 XP.')}else{grantQuestArtifact(d.relic);st.claimed=true;st.replayReadyAt=Date.now()+300000;player.coins+=d.coins;grantXp(d.xp);say(d.name+' cleared · '+itemDefs[d.relic].name+' · 5 Ancient Alloy · +'+d.coins+' crowns.')}playSfx('quest');ui();saveGame();if(firstStoryClaim){if(id==='hollowcrown')showCampaignEnding();else showCampaignScene({embercrypt:'ember',tidevault:'tide',stormspire:'storm'}[id]);}return true}
function resetStoryChallenge(id){const st=storyState(id);if(!st.claimed){say('Claim this sanctum’s story cache first.');return true}if(st.replayActive){say('The current challenge is still active. Clear the floor and open its cache.');return true}if(Date.now()<(st.replayReadyAt||0)){say('Challenge altar recharges in '+Math.ceil((st.replayReadyAt-Date.now())/1000)+' seconds.');return true}openAdventureDialog('Replay '+storyDungeons[id].name,'This restores the floor’s guards and boss. The story relic is awarded once; replay rewards are 2 Ancient Alloy and 35 crowns.',[{label:'Begin challenge',action:()=>{if(st.replayActive)return;st.replayActive=true;st.wards=[];for(const e of maps[id].enemies){e.alive=true;e.hp=e.maxHp;e.x=e.spawnX;e.y=e.spawnY;e.windup=0;e.swing=null;e.stun=0;e.specialClock=5;e.specialPhase=0}dungeonHazards=[];say('The sanctum awakens for a new challenge.');saveGame()}},{label:'Leave it quiet',action:()=>{}}]);return true}
function interactEpilogue(id){if(!journalCanAccept('epilogue_'+id))return true;const q=companionEpilogues[id],c=humanCompanion()?.id===id?humanCompanion():null,st=townQuestState['epilogue_'+id];if(st?.claimed){say(companionDefs[id].name+': '+(st.choice==='road'?'I will keep the road open. (+1 attack)':'I will protect those who travel it. (+2 defense)'));return true}if(!c){say('Bring '+companionDefs[id].name+' from Wayfarer’s Camp before choosing this chapter.');return true}if(!q.quests.every(key=>townQuestState[key]?.claimed)){say('Finish both of '+companionDefs[id].name.split(' ')[0]+'’s town story chapters first.');return true}const choose=choice=>{if(townQuestState['epilogue_'+id]?.claimed)return;townQuestState['epilogue_'+id]={claimed:true,choice};grantXp(35);say(companionDefs[id].name+' chooses '+(choice==='road'?'the road · permanent +1 attack.':'the watch · permanent +2 defense.'));ui();saveGame()};openAdventureDialog(q.title,q.text+' This choice is permanent for this character save.',[{label:'Take the road · companion +1 attack',action:()=>choose('road')},{label:'Protect travelers · companion +2 defense',action:()=>choose('home')}]);return true}
function interactMedicine(){if(!journalCanAccept('crossroads_medicine'))return true;const st=townQuestState.crossroads_medicine;if(st?.claimed){if(st.choice==='mercy'){if(Date.now()<(st.healReadyAt||0)){say('The traveler is preparing more medicine. Return in '+Math.ceil((st.healReadyAt-Date.now())/1000)+' seconds.');return true}player.hp=player.max;for(const c of companions)if(c.active)c.hp=c.max;st.healReadyAt=Date.now()+300000;say('The grateful traveler heals your active party for free.');ui();saveGame()}else say('The traveler remembers that you sold the medicine. No healing is offered.');return true}if(bagCount('potion_25')<1){worldQuestState('crossroads_medicine').accepted=true;say('The wounded traveler needs one Small Healing Potion. Buy one in town, then return.');saveGame();return true}const choose=choice=>{if(townQuestState.crossroads_medicine?.claimed)return;if(!removeItem('potion_25',1)){say('Bring one Small Healing Potion first.');return}townQuestState.crossroads_medicine={claimed:true,choice,healReadyAt:0};player.coins+=choice==='mercy'?35:75;grantXp(25);say(choice==='mercy'?'You help the traveler · +35 crowns. Free party healing is now available here every five minutes.':'You sell the medicine · +75 crowns. The traveler will not heal your party.');ui();saveGame()};openAdventureDialog('Medicine at the Crossroads','A wounded traveler and a wealthy courier both need your potion. Helping the traveler earns a lasting ally; selling it pays more immediately. One Small Healing Potion is consumed.',[{label:'Help the traveler · 35 crowns + roadside healer',action:()=>choose('mercy')},{label:'Sell to the courier · 75 crowns',action:()=>choose('profit')}]);return true}
function interactAdventureObject(obj){
 if(obj.id==='campaign_chronicle'){openCampaignChronicle();return true}
 if(obj.id.startsWith('story_portal_')){const id=obj.dungeon,locked=storyPortalLock(id);if(locked){say(locked);return true}return takeMapExit({trigger:'interact',to:id,entry:'default'})}
 if(obj.id.startsWith('story_ward_')){const st=storyState(obj.dungeon);st.wards=Array.isArray(st.wards)?st.wards:[];if(!st.wards.includes(obj.index))st.wards.push(obj.index);say(obj.label+' disabled · '+st.wards.length+'/2.');saveGame();return true}
 if(obj.id.startsWith('story_cache_'))return collectStoryCache(obj.dungeon);
 if(obj.id.startsWith('story_replay_'))return resetStoryChallenge(obj.dungeon);
 if(obj.id.startsWith('epilogue_'))return interactEpilogue(obj.companion);
 if(obj.id==='crossroads_medicine')return interactMedicine();
 if(obj.id.startsWith('secret_')){const st=worldQuestState(obj.id);if(st.claimed){say('This hidden cache is empty.');return true}if(!addItem('ancient_alloy')){say('Make room for the Ancient Alloy in this cache.');return true}st.claimed=true;player.coins+=30;grantXp(20);say('Hidden trail cache · Ancient Alloy · +30 crowns · +20 XP.');ui();saveGame();return true}
 return false;
}
function campaignHud(){if(!deepQuestDone)return;const count=storySanctumCount(),complete=storyCleared('hollowcrown');document.getElementById('questTitle').textContent=complete?'Ashvale Restored':count<3?'The Broken Sanctums':'The Hollow Crown';document.getElementById('progress').textContent=complete?(townQuestState.campaign_ending?.choice?'Story complete':'Choose the Reach’s future'):count<3?'Sanctum hearts '+count+'/3':'Face the Hollow Regent';document.getElementById('questDetails').textContent=complete?'The Regent is defeated. Open Options → Story Chronicle to choose or reread your ending. The Reach remains open for unfinished adventures.':count<3?'Enter the Ember Crypt in Westwood, then the Tide Vault on the Ice Coast, then the Storm Spire at North Ridge. Clear each floor and claim its cache.':'Enter Hollow Crown Keep in the Cinder Fields. Break its wards, defeat the Regent, and claim the final heart.'}
// Solo testing starts at level 100; all other progression is earned normally.
function danTesting(){return String(player.name||'').trim().toLowerCase()==='thedancode'}
function applyDanTestProfile(){
 if(!danTesting())return false;
 const ratio=Math.max(0,Math.min(1,(Number(player.hp)||1)/Math.max(1,Number(player.max)||1)));
 player.level=Math.max(100,Math.floor(Number(player.level)||1));
 player.max=heroMaxHealth();player.speed=classDefs[player.class].speed*(player.class==='rogue'?1+.15*veteranProgress():1);
 player.hp=Math.max(1,Math.round(player.max*ratio));
 scaleEnemiesForRegion();return true;
}

// v1.81: the Compass is earned through a long, guarded pilgrimage.
itemDefs.wayfarer_compass={name:'Wayfarer’s Compass',icon:'🧭',category:'quest',fastTravel:true,description:'Reusable relic. Activate from your bag to travel to a place already visited on foot. Cannot activate in combat or inside a dungeon.'};
let fastTravelArmed=false;
const wayfarerTrials=[{area:'westwood',name:'Roots',order:[0,2,1],clue:'West → East → North',x:-180,y:430},{area:'icecoast',name:'Tides',order:[1,0,2],clue:'North → West → East',x:1100,y:400},{area:'southwood',name:'Ashes',order:[2,1,0],clue:'East → North → West',x:-180,y:430}];
maps.ashvale.worldObjects.push({id:'wayfarer_notice',x:1010,y:640,label:'THE LOST COMPASS'});
for(const [i,t] of wayfarerTrials.entries()){
 const m=maps[t.area];m.worldObjects=(m.worldObjects||[]).concat({id:'wayfarer_altar_'+i,trial:i,x:t.x,y:t.y,label:t.name.toUpperCase()+' TRIAL'},...[[t.x-95,t.y-95],[t.x,t.y-175],[t.x+95,t.y-95]].map(([x,y],rune)=>({id:'wayfarer_rune_'+i+'_'+rune,trial:i,rune,x,y,label:['WEST RUNE','NORTH RUNE','EAST RUNE'][rune]})));
 for(let j=0;j<3;j++)m.enemies.push({x:t.x-70+j*70,y:t.y-60,hp:j===1?65:28,alive:false,seed:900+i*4+j,kind:j===1?'warden':'skeleton',name:j===1?t.name+' Sentinel':'Compass Warder',boss:true,wayfarerTrial:i,lootClaimed:true});
}
maps.northridge.worldObjects.push({id:'wayfarer_vault',x:1080,y:460,label:'COMPASS VAULT'});
for(let j=0;j<3;j++)maps.northridge.enemies.push({x:1000+j*70,y:385,hp:j===1?110:40,alive:false,seed:920+j,kind:j===1?'warden':'skeleton',name:j===1?'The Roadbound Guardian':'Vault Warder',boss:true,wayfarerTrial:3,lootClaimed:true});
function wayfarerState(){return worldQuestState('wayfarer_compass')}
function compassTrialReady(i){const st=wayfarerState(),area=i===3?'northridge':wayfarerTrials[i].area;return !!st.started?.includes(i)&&!maps[area].enemies.some(e=>e.wayfarerTrial===i&&e.alive)}
function awakenCompassTrial(i){const st=wayfarerState();st.started=st.started||[];if(st.started.includes(i))return;st.started.push(i);const area=i===3?'northridge':wayfarerTrials[i].area;for(const e of maps[area].enemies)if(e.wayfarerTrial===i){Object.assign(e,safeMapPosition(area,e.spawnX??e.x,e.spawnY??e.y,16));e.alive=true;e.hp=e.maxHp||e.baseHp||e.hp;e.lootClaimed=true;e.respawnAt=0;e.combatCool=1;e.windup=0;e.swing=null;}scaleEnemiesForRegion();say(i===3?'The Roadbound Guardian awakens. Defeat all three vault guardians.':'The trial awakens. Defeat the sentinel and both warders, then solve the runes.');saveGame();}
function interactWayfarer(obj){if(!journalCanAccept('wayfarer_compass'))return true;
 const st=wayfarerState();st.seals=st.seals||[];st.runes=st.runes||{};
 if(obj.id==='wayfarer_notice'){if(st.claimed){say('The Compass is yours. Activate it from BAG for each journey.');return true;}st.accepted=true;openAdventureDialog('The Lost Wayfarer’s Compass','A roadkeeper hid a relic that folds the roads of Ashvale. Prove yourself at the Roots trial in Westwood, the Tides trial on the Ice Coast, and the Ashes trial in Southwood. Each trial has a sentinel, two warders, and a rune sequence. Carry all three seals to the Compass Vault on the east side of North Ridge. Defeat its final guardians to find the Compass. Recommended: level 12+, upgraded equipment, a pet, and healing supplies.',[{label:'Track the Compass quest',action:()=>{townQuestState._tracking={id:'wayfarer_compass'};ui();saveGame();}}]);saveGame();return true;}
 if(!st.accepted){say('Read THE LOST COMPASS inscription in Ashvale before attempting this trial.');return true;}
 if(obj.id==='wayfarer_vault'){
  if(st.claimed){say('The vault is empty. Activate the Compass from your bag.');return true;}
  if(st.seals.length<3){say('The vault needs all three trial seals · '+st.seals.length+'/3.');return true;}
  if(!st.started?.includes(3)){awakenCompassTrial(3);return true;}
  if(!compassTrialReady(3)){say('Defeat every vault guardian before opening the Compass Vault.');return true;}
  grantQuestArtifact('wayfarer_compass');st.claimed=true;player.coins+=150;grantXp(100);playSfx('quest');say('Wayfarer’s Compass found! BAG → Compass → Activate fast travel.');ui();saveGame();return true;
 }
 const i=obj.trial,t=wayfarerTrials[i];if(!t)return false;
 if(st.seals.includes(i)){say(t.name+' seal is already yours.');return true;}
 if(obj.id.startsWith('wayfarer_altar_')){if(!st.started?.includes(i)){awakenCompassTrial(i);return true;}if(!compassTrialReady(i)){say('Defeat the sentinel and both warders first.');return true;}say(t.name+' inscription: '+t.clue+'. Touch the three runes in that order.');return true;}
 if(!compassTrialReady(i)){say('Awaken the trial at its altar and defeat all three guardians before touching the runes.');return true;}
 const n=st.runes[i]||0;if(obj.rune===t.order[n]){st.runes[i]=n+1;if(n===2){st.seals.push(i);playSfx('quest');say(t.name+' seal earned · '+st.seals.length+'/3. '+(st.seals.length===3?'Find the Compass Vault in North Ridge.':'Continue to the next guarded trial.'));}else say('Rune lit · '+(n+1)+'/3.');}else{st.runes[i]=0;say('Wrong rune. Sequence reset. Read the trial altar for its order.');}ui();saveGame();return true;
}
function compassActivationLock(){if(!bagCount('wayfarer_compass'))return 'Find the Wayfarer’s Compass first. Read THE LOST COMPASS in Ashvale.';if(activeMap.dungeon||activeMap.interior||['mosslight','emberdeep','shrine_rootmaze','shrine_heart'].includes(mapId))return 'Leave the dungeon or building before activating the Compass.';if(enemies.some(e=>e.alive&&(e.windup>0||Math.hypot(e.x-player.x,e.y-player.y)<240)))return 'Move away from enemies before activating the Compass.';return '';}
function activateWayfarerCompass(){const reason=compassActivationLock();if(reason){document.getElementById('inventoryNotice').textContent=reason;say(reason);return;}closeItemDetail();openTravelScreen(true);}
function drawWayfarerObjects(){for(const obj of activeMap.worldObjects||[]){if(!obj.id.startsWith('wayfarer_'))continue;const st=townQuestState.wayfarer_compass||{},lit=obj.trial!==undefined&&st.seals?.includes(obj.trial);if(obj.id==='wayfarer_notice')standArt('notice',obj.x,obj.y,48,'extras');else if(obj.id==='wayfarer_vault')standArt(st.claimed?'openchest':'chest',obj.x,obj.y,48,st.claimed?'extras':'environment');else standArt('runestone',obj.x,obj.y,obj.rune!==undefined?44:62,'environment',lit?.55:1);drawLocationLabel(obj.x,obj.y-75,obj.label);}}
const PREMIUM_PRODUCTS=[{"id":"emberfall_aura_embers","name":"Ember Halo","category":"aura","color":"#ffad62","icon":"🔥","description":"A warm circle of embers follows your hero.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":1.99},{"id":"emberfall_aura_frost","name":"Frost Halo","category":"aura","color":"#8de1f5","icon":"❄️","description":"A crystalline blue aura circles your feet.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":1.99},{"id":"emberfall_aura_arcane","name":"Arcane Halo","category":"aura","color":"#c9a2ff","icon":"✧","description":"Violet runes orbit your hero.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":1.99},{"id":"emberfall_trail_embers","name":"Ember Footsteps","category":"trail","color":"#ffbb77","icon":"🔥","description":"Leave a fading trail of tiny embers as you walk.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":1.99},{"id":"emberfall_trail_stars","name":"Starlight Footsteps","category":"trail","color":"#c5d9ff","icon":"✦","description":"Small stars shimmer along the road behind you.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":1.99},{"id":"emberfall_trail_leaves","name":"Forest Footsteps","category":"trail","color":"#b7d98a","icon":"🍃","description":"Soft green leaves drift behind your steps.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":1.99},{"id":"emberfall_title_emberborn","name":"Emberborn","category":"title","color":"#eec47c","icon":"✦","description":"Display the Emberborn title above your hero.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":0.99},{"id":"emberfall_title_wayfarer","name":"Wayfarer","category":"title","color":"#bad9b0","icon":"🧭","description":"Display the Wayfarer title above your hero. Cosmetic only; does not grant the Compass.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":0.99},{"id":"emberfall_title_champion","name":"Ashvale Champion","category":"title","color":"#d8b4ed","icon":"♜","description":"Display the Ashvale Champion title above your hero.","productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":0.99},{"id":"emberfall_bundle_founder","name":"First Flame Collection","category":"bundle","color":"#ffd088","icon":"🎁","description":"Ember Halo, Ember Footsteps, and the Emberborn title together.","contains":["emberfall_aura_embers","emberfall_trail_embers","emberfall_title_emberborn"],"productType":"non_consumable","gameplayBonus":false,"launchStatus":"draft","suggestedUSD":4.99},{"id":"thornhaven_xp_boost_25_15m","name":"Adventurer’s Focus","category":"xp","color":"#e4bf66","icon":"✦","description":"+25% combat XP for 15 minutes of active play. Menus and offline time pause the timer. No stacking. Combat XP follows the scaled encounter level. Quest, gathering and forging progress are unchanged.","productType":"consumable","gameplayBonus":true,"launchStatus":"draft","suggestedUSD":0.99,"durationSeconds":900,"combatXpMultiplier":1.25},{"id":"thornhaven_builder_contract_25_15m","name":"Builder’s Contract","category":"builder","color":"#b7d98a","icon":"⚒","description":"+25% construction speed for 15 minutes of actual builder work. Requires a hired builder, normal materials and quest unlocks. Pauses without a job, during rest, menus, sieges and offline. No stacking or instant completion.","productType":"consumable","gameplayBonus":true,"launchStatus":"draft","durationSeconds":900,"constructionMultiplier":1.25},{"id":"thornhaven_levels_1","name":"Adventurer Levels · +1","category":"levels","color":"#cfad72","icon":"✦","description":"Adds 1 character level to the selected character. Existing XP is kept. Monsters scale with your new level. Quests, crafting, materials and settlement progress are unchanged.","productType":"consumable","gameplayBonus":true,"launchStatus":"draft","levels":1,"suggestedUSD":0.99},{"id":"thornhaven_levels_5","name":"Adventurer Levels · +5","category":"levels","color":"#cfad72","icon":"✦","description":"Adds 5 character levels to the selected character. Existing XP is kept. Monsters scale with your new level. Quests, crafting, materials and settlement progress are unchanged.","productType":"consumable","gameplayBonus":true,"launchStatus":"draft","levels":5,"suggestedUSD":3.99},{"id":"thornhaven_levels_10","name":"Adventurer Levels · +10","category":"levels","color":"#cfad72","icon":"✦","description":"Adds 10 character levels to the selected character. Existing XP is kept. Monsters scale with your new level. Quests, crafting, materials and settlement progress are unchanged.","productType":"consumable","gameplayBonus":true,"launchStatus":"draft","levels":10,"suggestedUSD":6.99}];

// Prototype preview selections are never payment receipts or purchase entitlements.
const PREMIUM_MODE='preview';let premiumCategory='all',styleTrail=[],styleTrailClock=0,styleTrailMap=null,premiumTrial={},premiumTrialUntil=0;
function premiumProduct(id){return PREMIUM_PRODUCTS.find(p=>p.id===id)||earnedTitle(id)}
const EARNED_TITLES=[{id:'earned_trailblazer',name:'Trailblazer',category:'title',color:'#b9d98a',goal:'Complete your first hunt',unlocked:()=>huntRewarded},{id:'earned_oathkeeper',name:'Oathkeeper',category:'title',color:'#e9c979',goal:'Unite the four town seals',unlocked:()=>hasFourfoldKey},{id:'earned_reachkeeper',name:'Reachkeeper',category:'title',color:'#bddfff',goal:'Defeat the Regent and claim the final cache',unlocked:()=>storyCleared('hollowcrown')}];
function earnedTitle(id){return EARNED_TITLES.find(t=>t.id===id&&t.unlocked())}
function equipEarnedTitle(id){if(!earnedTitle(id))return;townQuestState._earnedTitle=townQuestState._earnedTitle===id?null:id;delete premiumTrial.title;if(townQuestState._equippedPaid)delete townQuestState._equippedPaid.title;saveGame();renderPremiumShop()}
function styleSelection(){const saved=Date.now()<premiumTrialUntil?premiumTrial:{},out={};for(const slot of ['aura','trail','title'])if(premiumProduct(saved[slot])?.category===slot)out[slot]=saved[slot];if(!out.title&&earnedTitle(townQuestState._earnedTitle))out.title=townQuestState._earnedTitle;return out;}
function previewPremiumProduct(id){const p=premiumProduct(id);if(!p)return;if(['xp','builder','levels'].includes(p.category)){document.getElementById('premiumSummary').textContent='Level packs and boosts require a verified purchase. Purchases are not available yet.';return;}const selection=styleSelection();if(p.category==='bundle'){for(const child of p.contains){const d=premiumProduct(child);selection[d.category]=child;}}else{if(selection[p.category]===id)delete selection[p.category];else selection[p.category]=id;}premiumTrial=Object.fromEntries(Object.entries(selection).filter(([slot,id])=>!id.startsWith('earned_')));premiumTrialUntil=Date.now()+60000;styleTrail=[];renderPremiumShop();}
function clearPremiumPreview(){premiumTrial={};premiumTrialUntil=0;delete townQuestState._stylePreview;styleTrail=[];saveGame();renderPremiumShop();}
function renderPremiumShop(){document.getElementById('earnedTitleList').innerHTML=EARNED_TITLES.map(t=>'<button type="button" data-earned-title="'+t.id+'" '+(!t.unlocked()?'disabled':'')+' aria-pressed="'+(townQuestState._earnedTitle===t.id)+'">'+(t.unlocked()?(townQuestState._earnedTitle===t.id?'✓ ':'Equip '):'Locked · ')+t.name+' — '+t.goal+'</button>').join('');const selection=styleSelection(),names=Object.values(selection).map(id=>premiumProduct(id).name);document.getElementById('premiumSummary').textContent=names.length?'Current look: '+names.join(' · '):'Try a paid-style preview for 60 seconds, or equip a title earned through play.';document.querySelectorAll('[data-premium-category]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.premiumCategory===premiumCategory)));document.getElementById('premiumList').innerHTML=PREMIUM_PRODUCTS.filter(p=>premiumCategory==='all'||p.category===premiumCategory).map(p=>{const active=p.category==='bundle'?p.contains.every(id=>selection[premiumProduct(id).category]===id):selection[p.category]===p.id;return '<article class="premiumCard" style="--style-color:'+p.color+'"><div class="premiumSwatch '+p.category+'">'+(gearVectorPaths[p.icon]?'<img src="'+gearVectorIcon(p.icon)+'" width="34" height="34" alt="">':'<span aria-hidden="true">'+p.icon+'</span>')+'</div><div class="premiumCardInfo"><span class="premiumKind">'+p.category.toUpperCase()+(['xp','builder','levels'].includes(p.category)?' · PROGRESSION BOOST':' · COSMETIC')+'</span><h3>'+p.name+'</h3><p>'+p.description+'</p><p class="premiumPrice">'+(p.suggestedUSD!==undefined?'Draft price: $'+p.suggestedUSD.toFixed(2)+' USD':'Price to be confirmed')+' · Purchases unavailable</p><button type="button" data-preview-product="'+p.id+'" '+(['xp','builder','levels'].includes(p.category)?'disabled ':'')+'aria-pressed="'+active+'">'+(['xp','builder','levels'].includes(p.category)?'Purchases unavailable':active?(p.category==='bundle'?'Previewing collection':'Remove preview'):'Preview '+(p.category==='bundle'?'collection':'style'))+'</button></div></article>';}).join('');}
function openPremiumShop(){if(!hasStarted)return;preparePanel('premiumScreen');keys.clear();document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;document.getElementById('premiumScreen').hidden=false;premiumCategory='all';renderPremiumShop();refreshPanelState();}
function drawPremiumGround(){const selection=styleSelection();if(styleTrailMap!==mapId){styleTrail=[];styleTrailMap=mapId;}const trail=premiumProduct(selection.trail);if(trail&&player.walking&&animationClock-styleTrailClock>.09){styleTrailClock=animationClock;styleTrail.push({x:player.x,y:player.y+5,born:animationClock,color:trail.color,id:trail.id});if(styleTrail.length>24)styleTrail.shift();}styleTrail=styleTrail.filter(p=>animationClock-p.born<1.5);ctx.save();for(const p of styleTrail){const age=animationClock-p.born;ctx.globalAlpha=Math.max(0,(1-age/1.5)*.55);ctx.fillStyle=p.color;const r=2+age;if(p.id.includes('stars')){ctx.fillRect(p.x-r,p.y-1,r*2,2);ctx.fillRect(p.x-1,p.y-r,2,r*2);}else{ctx.beginPath();ctx.ellipse(p.x,p.y,r,p.id.includes('leaves')?r*.5:r,age,0,Math.PI*2);ctx.fill();}}ctx.globalAlpha=1;const aura=premiumProduct(selection.aura);if(aura){ctx.strokeStyle=aura.color;ctx.lineWidth=1.5;ctx.globalAlpha=.7;ctx.beginPath();ctx.ellipse(player.x,player.y+5,25+Math.sin(animationClock*2),12,0,0,Math.PI*2);ctx.stroke();for(let i=0;i<5;i++){const a=animationClock*.7+i*Math.PI*2/5;ctx.fillStyle=aura.color;ctx.beginPath();ctx.arc(player.x+Math.cos(a)*25,player.y+5+Math.sin(a)*12,1.8,0,Math.PI*2);ctx.fill();}}ctx.restore();}
function drawPremiumTitle(){const p=premiumProduct(styleSelection().title);if(!p)return;ctx.save();ctx.font='bold 11px Georgia';ctx.textAlign='center';ctx.strokeStyle='#132019';ctx.lineWidth=3;ctx.strokeText(p.name,player.x,player.y-68);ctx.fillStyle=p.color;ctx.fillText(p.name,player.x,player.y-68);ctx.restore();}
window.EmberfallMonetization=Object.freeze({mode:PREMIUM_MODE,getCatalog:()=>JSON.parse(JSON.stringify(PREMIUM_PRODUCTS)),purchase:async()=>({status:'unavailable',message:'Purchases are not enabled in this preview.'}),restorePurchases:async()=>({status:'unavailable',message:'No purchases are processed in this preview.'})});
const outerLandmarks={
 ashvale:[[-390,-170],[-330,80],[-360,520],[-160,760],[120,795],[800,760],[1230,-170],[1340,90],[1290,510],[1100,790]],
 whisperwood:[[-400,-170],[-345,70],[-380,500],[-130,770],[230,790],[760,770],[1240,-170],[1350,90],[1300,520],[1060,790]],
 redfen:[[-390,-170],[-340,100],[-370,560],[-150,780],[180,800],[800,770],[1240,-170],[1350,80],[1300,550],[1080,790]],
 highmoor:[[-390,-170],[-340,100],[-370,560],[-150,780],[180,800],[800,770],[1240,-170],[1350,80],[1300,550],[1080,790]],
 frostmarch:[[-390,-170],[-340,100],[-370,560],[-150,780],[180,800],[800,770],[1240,-170],[1350,80],[1300,550],[1080,790]],
 brackenford:[[-390,-170],[-350,65],[-380,545],[-150,780],[170,800],[800,770],[1240,-170],[1350,75],[1300,545],[1080,790]],
 stonewatch:[[-390,-170],[-350,65],[-380,545],[-150,780],[170,800],[800,770],[1240,-170],[1350,75],[1300,545],[1080,790]],
 sunmere:[[-390,-170],[-350,65],[-380,545],[-150,780],[170,800],[800,770],[1240,-170],[1350,75],[1300,545],[1080,790]]
};
for(const [id,points] of Object.entries(outerLandmarks)){maps[id].trees.push(...points);maps[id].stones.push([-240,690],[1160,-90])}
// Spread hunting encounters through the full explorable bounds while preserving existing save indexes.
const expandedEnemySpawns={
 whisperwood:[[-350,-145,'slime'],[1190,-175,'slime'],[-335,700,'slime'],[1260,720,'slime'],[-155,260,'slime'],[1080,465,'slime'],[425,-210,'slime'],[675,770,'slime']],
 redfen:[[-350,-145,'spider'],[1190,-175,'slime'],[-335,700,'spider'],[1260,720,'slime'],[-155,260,'slime'],[1080,465,'spider'],[425,-210,'spider'],[675,770,'slime']],
 highmoor:[[-350,-145,'skeleton'],[1190,-175,'spider'],[-335,700,'spider'],[1260,720,'skeleton'],[-155,260,'skeleton'],[1080,465,'spider'],[425,-210,'skeleton'],[675,770,'skeleton']],
 frostmarch:[[-350,-145,'skeleton'],[1190,-175,'spider'],[-335,700,'skeleton'],[1260,720,'spider'],[-155,260,'skeleton'],[1080,465,'spider'],[425,-210,'spider'],[675,770,'skeleton']]
};let expandedEnemySeed=24;for(const [id,points] of Object.entries(expandedEnemySpawns)){const map=maps[id],level=map.level||1;for(const [x,y,kind] of points)map.enemies.push({x,y,hp:level<=1?2:level<=3?3:level<=5?4:5,alive:true,seed:expandedEnemySeed++,kind,name:kind==='skeleton'?(id==='frostmarch'?'Frostbound Guard':'Moor Warden'):kind==='spider'?(id==='frostmarch'?'Ice Cave Weaver':id==='redfen'?'Fen Stalker':'Ruin Weaver'):(id==='redfen'?'Bog Slime':'Ash Slime')})}

// Optional regional adventures preserve fixed enemy indexes in older saves.
const regionalAdventures={
 greenhollow:{title:'The Briar Nest',type:'hunt',x:675,y:470,kind:'spider',guards:3,text:'Silk smothers an abandoned camp. Disturb the nest, defeat three briar spiders, then recover the scout’s supplies.',reward:'hardwood_log',amount:3,coins:30,color:'#b9d582',lore:'Silk catches in the green canopy. Something is nesting beyond the road.'},
 sunharbor:{title:'The Drowned Bell',type:'hunt',x:790,y:500,kind:'specter',guards:2,text:'The harbor bell wakes two drowned sentries. Ring it, survive their marked tide strikes, then claim the salvaged cargo.',reward:'coast_fish',amount:3,coins:35,color:'#86d5e4',lore:'An old bell still calls to the sailors who never came home.'},
 crowfield:{title:'The Broken Mill',type:'search',x:180,y:465,points:[[300,160],[640,210],[780,475]],text:'Recover three missing mill gears from the farm, then return here to repair the mill. Look for brass glints off the road.',reward:'iron_ore',amount:3,coins:30,color:'#e3c484',lore:'Harvest wagons wait beside a silent mill.'},
 glassridge:{title:'Frostglass Echo',type:'sequence',x:190,y:470,points:[[225,215],[480,150],[740,215]],order:[1,0,2],text:'Three stones answer the mountain wind. Touch NORTH, then WEST, then EAST. A wrong note resets the song.',reward:'silver_ore',amount:2,coins:40,color:'#b1e3f0',lore:'The ice carries a melody from three ancient stones.'},
 willowfen:{title:'The Lost Lanterns',type:'search',x:170,y:480,points:[[285,155],[660,135],[820,490]],text:'Recover three lanterns left by the fen guides. Return them here so travelers can find the safe road through the marsh.',reward:'marsh_fish',amount:3,coins:30,color:'#abd8b2',lore:'Small lights vanish in the reeds. The guides need their lanterns back.'},
 cinderfields:{title:'The Cinder Breach',type:'hunt',x:760,y:475,kind:'warden',guards:1,elite:true,text:'An ember guardian sleeps under the broken seal. Awaken it, evade its wide strikes, then seal the breach for Ancient Alloy.',reward:'ancient_alloy',amount:2,coins:50,color:'#f3a875',lore:'The ground glows beneath an old seal. A guardian is stirring.'},
 frostwood:{title:'Shelter in the Snow',type:'supply',x:730,y:480,text:'A stranded traveler needs one Field Ration. Bring food from a town shop to earn a reward and a place to rest.',reward:'ice_trout',amount:2,coins:25,color:'#c4dae4',lore:'A lantern flickers beside a traveler’s snowbound shelter.'}
};
for(const [id,d] of Object.entries(regionalAdventures)){
 const m=maps[id];m.worldObjects=(m.worldObjects||[]).concat({id:'regional_'+id,x:d.x,y:d.y,label:d.title.toUpperCase(),region:id});
 for(const [i,p] of (d.points||[]).entries())m.worldObjects.push({id:'regional_piece_'+id+'_'+i,x:p[0],y:p[1],label:d.type==='sequence'?['WEST STONE','NORTH STONE','EAST STONE'][i]:d.type==='search'&&id==='crowfield'?'MILL GEAR':'LOST LANTERN',region:id,piece:i});
 for(let i=0;i<(d.guards||0);i++)m.enemies.push({x:d.x-75+i*65,y:d.y-70,hp:d.elite?15:5,alive:false,seed:500+i,kind:d.kind,name:d.elite?'Breach Guardian':id==='sunharbor'?'Drowned Sentry':'Briar Spider',boss:!!d.elite,eventRegion:id,lootClaimed:true});
}
function regionalState(id){return worldQuestState('regional_'+id)}
function regionalReady(id){const d=regionalAdventures[id],st=regionalState(id);return d.type==='hunt'?st.accepted&&!maps[id].enemies.some(e=>e.eventRegion===id&&e.alive):d.type==='supply'?bagCount('field_ration')>0:d.type==='sequence'?st.progress>=3:(st.found||[]).length>=3}
function regionalInteract(obj){
 const id=obj.region,d=regionalAdventures[id],st=regionalState(id);if(!d)return false;if(!journalCanAccept('regional_'+id))return true;
 if(st.claimed){if(d.type==='supply'){if(Date.now()<(st.restAt||0)){say('The shelter is warm. You can rest again in '+Math.ceil((st.restAt-Date.now())/1000)+' seconds.');return true}player.hp=player.max;st.restAt=Date.now()+180000;say('You rest by the traveler’s fire and recover your vitality.');ui();saveGame()}else say(d.title+' is complete. Your work here is remembered.');return true}
 if(obj.piece!==undefined){
  if(!st.accepted){say('Visit '+d.title+' first to learn what is needed.');return true}
  if(d.type==='sequence'){if(d.order[st.progress||0]===obj.piece){st.progress=(st.progress||0)+1;say(st.progress===3?'The frostglass sings. Return to the echo shrine for your reward.':'A clear note rings · '+st.progress+'/3.')}else{st.progress=0;say('The song fades. Remember: NORTH → WEST → EAST.')}}
  else{st.found=st.found||[];if(st.found.includes(obj.piece)){say('You already recovered this piece.');return true}st.found.push(obj.piece);say((id==='crowfield'?'Mill gear':'Guide’s lantern')+' recovered · '+st.found.length+'/3.');}
  ui();saveGame();return true;
 }
 if(!st.accepted){openAdventureDialog(d.title,d.text,[{label:d.type==='hunt'?'Awaken the encounter':'Begin discovery',action:()=>{if(!journalCanAccept('regional_'+id))return;st.accepted=true;st.progress=0;st.found=[];if(d.type==='hunt')for(const e of maps[id].enemies.filter(e=>e.eventRegion===id)){e.alive=true;e.hp=e.maxHp||e.baseHp;e.x=e.spawnX;e.y=e.spawnY;e.windup=0;e.swing=null;e.combatCool=1}say(d.text);ui();saveGame()}},{label:'Explore first',action:()=>{}}]);return true}
 if(!regionalReady(id)){say(d.type==='hunt'?'Defeat the remaining guardians, then return here.':d.type==='supply'?'Bring one Field Ration from a town shop.':d.type==='sequence'?'Touch NORTH → WEST → EAST, then return.':'Recover all three marked pieces, then return.');return true}
 if(bagUnits()+d.amount-(d.type==='supply'&&bagCount('field_ration')>0?1:0)>bagLimit()){say('Make room for '+d.amount+' '+itemDefs[d.reward].name+' before collecting your reward.');return true}
 if(d.type==='supply'&&!removeItem('field_ration',1))return true;
 addItem(d.reward,d.amount);st.claimed=true;player.coins+=d.coins;grantXp(25);playSfx('quest');say(d.title+' complete · '+d.coins+' crowns · '+itemDefs[d.reward].name+' ×'+d.amount+' · 25 XP.');ui();saveGame();return true;
}
function openFieldGuide(){openAdventureDialog('Your first adventure','Regions have fixed monster difficulty: stronger heroes do not strengthen nearby monsters. Harder regions award more combat XP; overlevelled kills award less. Touch and hold the ground to move immediately. Slide your finger to change direction without lifting; lift to stop. You can enable the arrow pad in MENU → Movement. Press INTERACT near people, resources, objects, or entrances to use them. Attacks happen automatically within weapon range. Use your class skill in battle and DODGE out of orange danger marks. Open MENU then Bag to use a tonic. Your First Hunt is three Ash Slimes in Whisperwood; its reward is automatic.',[{label:'Open map for the First Hunt',action:()=>openTravelScreen()}]);}
function objectiveAction(){if(!done){if(mapId!=='whisperwood'){openTravelScreen();return}say('Approach the marked Ash Slimes to attack automatically. Use your class skill and dodge orange circles.');return}openQuestJournal()}
function refreshOpeningGuide(){
 if(done&&regionalAdventures[mapId]&&regionalState(mapId).accepted&&!regionalState(mapId).claimed){const d=regionalAdventures[mapId],state=regionalState(mapId);document.getElementById('questTitle').textContent=d.title;document.getElementById('questDetails').textContent=regionalReady(mapId)?'Your objective is complete. Return to the discovery marker to claim the reward.':d.text;document.getElementById('progress').textContent=d.type==='hunt'?'Guardians remaining '+maps[mapId].enemies.filter(e=>e.eventRegion===mapId&&e.alive).length:d.type==='supply'?'Field Ration '+Math.min(1,bagCount('field_ration'))+'/1':(d.type==='sequence'?state.progress||0:(state.found||[]).length)+'/3';}
}

function openFrontierDialog(title,text,choices){openAdventureDialog(title,text,choices);document.getElementById('adventureScreen').classList.add('narrativeView');}
// A Hearth Worth Keeping: a walkable side chapter, saved with existing characters.
const frontierPlots={palisade:[180,-210,150,48],gate:[410,-210,140,80],tower:[50,-210,100,100],barracks:[710,-210,140,105],hall:[410,78,140,126],mill:[130,100,120,100],quarry:[710,100,120,100],garden:[130,360,120,92],forge:[410,360,140,105],lodge:[710,360,120,105]};
maps.frontier_outpost={name:'Hearthstead Settlement',frontier:true,level:1,trees:[[60,95],[895,95],[65,460],[890,455]],stones:[],enemies:[],npcs:[],arrival:[480,510],hint:'The workboard is in the old center. Follow the east road beyond OLD QUARRY to the Remembering Vale; the new memory garden is southeast.',worldObjects:[{id:'frontier_board',x:480,y:270,label:'WORKBOARD'},{id:'frontier_carpenter_home',x:345,y:280,label:'CARPENTER'},{id:'frontier_well',x:620,y:180,label:'OLD WELL'},{id:'frontier_mine',x:870,y:290,label:'OLD QUARRY'},{id:'frontier_exit',x:480,y:545,label:'WORLD ROADS · NORTH / WEST / EAST'},...Object.entries(frontierPlots).map(([id,[x,y,w,h]])=>({id:'frontier_plot_'+id,x:x+w/2,y:y+h+32,label:settlementBuildings[id].name.toUpperCase()}))]};
maps.frontier_quarry={name:'Briarstone Quarry',frontier:true,dungeon:true,level:1,trees:[],stones:[[85,120],[880,110],[85,460],[880,455]],npcs:[],arrival:[480,510],hint:'Defeat the three quarry raiders, then speak to Edda beside the northern scaffolding.',enemies:[{x:310,y:310,hp:4,alive:true,seed:701,kind:'bandit',name:'Quarry Raider',boss:true},{x:665,y:280,hp:4,alive:true,seed:702,kind:'bandit',name:'Quarry Raider',boss:true},{x:540,y:150,hp:6,alive:true,seed:703,kind:'bandit',name:'Raider Foreman',boss:true}],worldObjects:[{id:'frontier_carpenter',x:770,y:170,label:'EDDA · CARPENTER'},{id:'frontier_quarry_exit',x:480,y:545,label:'OUTPOST TRAIL'}]};
(maps.worldsend.worldObjects??=[]).push({id:'frontier_entrance',x:480,y:315,label:'SETTLEMENT · WEST EDGE'});
Object.assign(itemDefs,{hearthstead_charter:{name:'Hearthstead Charter',icon:'📜',category:'quest',description:'Edda and the first residents signed this charter. A home raised by your adventures.'},bellkeeper_plans:{name:'Bellkeeper Provisions',icon:'📜',category:'quest',description:'Recovered plans unlock Field Ration preparation at your settlement garden.'}});
function frontierState(){let s=townQuestState._frontier;if(!s||typeof s!=='object'||Array.isArray(s))s=townQuestState._frontier={};s.version=1;return s;}
function frontierStage(){const s=frontierState();return s.complete?'complete':!s.accepted?'discover':!s.rescued?'rescue':!s.home?'return':!settlementState().levels.hall?'rebuild':'welcome';}
function frontierObjective(){const stage=frontierStage(),left=maps.frontier_quarry.enemies.filter(e=>e.alive).length;return ({discover:'Travel to your settlement in the southeast corner of the world, then read Hearthstead’s workboard.',rescue:left?'Enter OLD QUARRY on the east side of Hearthstead. Defeat '+left+' raiders, then speak to Edda in the northeast.':'The quarry is clear. Speak to Edda in its northeast corner to bring her home.',return:'Leave the quarry by the southern trail. Edda will meet you back at Hearthstead.',rebuild:'At Hearthstead, supply the Hearth Hall with 8 timber and 4 stone. Gather in the world if you need more.',welcome:'Speak to Edda beside the workboard to welcome the first families.',complete:'The hall is alive again. Inspect the OLD WELL to uncover what lies beneath Hearthstead.'})[stage];}
function frontierEnter(id){syncSettlementName();const s=frontierState();if(id==='frontier_outpost'&&s.rescued&&!s.home){s.home=true;say('Edda reaches Hearthstead. Meet her beside the workboard.');}syncFrontierResidents();syncMemoryWorld();}
function syncFrontierResidents(){const s=frontierState();const maraMarker=maps.frontier_outpost.worldObjects.find(o=>o.id==='npc_mara');if(maraMarker)maraMarker.label=townQuestState.npc_mara?.choice==='exile'?'MARA’S EMPTY CAMP':'MARA · A SECOND CHANCE';maps.frontier_outpost.npcs=s.complete?[{x:605,y:290,name:'Nell the Gardener',talk:0,lines:['I planted the first seeds this morning. This time we can stay.','Food from our garden belongs on the road as much as on our table.']},{x:270,y:480,name:'Tomas the Wayfarer',talk:0,lines:['Your light brought us here. I thought every safe road had disappeared.','That old well carries sound strangely. I heard a bell before dawn.']}]:[];if(s.memory?.choice&&s.complete){maps.frontier_outpost.npcs[0].lines.unshift(s.memory.choice==='river'?'Iona brought river seeds. Our children will know more than dust.':'Orren’s lamps shine over my dry garden. We have planted a promise instead.');maps.frontier_outpost.npcs[1].lines.unshift(s.memory.choice==='river'?'I heard water beyond the valley bridge. You changed more than a map.':'A light reached the old road last night. I wonder who will follow it home.');}if(s.complete&&townQuestState.npc_mara?.claimed)maps.frontier_outpost.npcs[0].lines.unshift(townQuestState.npc_mara.choice==='shelter'?'Mara has a bed here. I hope we can all live with what we remember.':'Mara’s bed is empty. She hurt us, and she helped us. Both things remain true.');if(s.complete&&townQuestState.npc_sera?.choice==='divert')maps.frontier_outpost.npcs[1].lines.unshift(townQuestState.npc_sera.repaired?'The food came back. Trust takes longer.':'Stone will not feed the families whose food you traded.');syncHiredWorkers();if(mapId==='frontier_outpost')npcs=maps.frontier_outpost.npcs;}
function openFrontierChapter(){const s=frontierState();openFrontierDialog('A Hearth Worth Keeping',frontierObjective()+'\n\n'+(s.complete?'Edda’s forge hammer rings where the wind once blew through broken rafters. Your charter is in your bag.':s.accepted?'A settlement needs more than timber. Edda knows how to turn these ruins into a place worth returning to.':'A faded survey marks a ruined outpost in the southeast corner of the world. Someone has kept its last campfire burning.'),[...(s.complete?[{label:'The River That Remembers',action:openMemoryChronicle}]:[]),{label:s.complete?'Track the old well mystery':'Track this chapter',action:()=>{townQuestState._tracking={id:s.complete?'frontier_bells':'frontier_hearth'};saveGame();ui();say(frontierObjective());}},{label:'Show settlement on world map',action:()=>{openTravelScreen();requestAnimationFrame(()=>{const el=document.querySelector('[data-travel-to=frontier_outpost].atlasNode');el?.scrollIntoView({block:'center',inline:'center'});});}},{label:'Return to adventure',action:()=>{}}]);}
function beginFrontierChapter(){if(mapId!=='frontier_outpost'||!journalCanAccept('frontier_hearth'))return;const s=frontierState();if(!s.accepted){s.accepted=true;townQuestState._tracking={id:'frontier_hearth'};if(!settlementState().founded)foundSettlement();saveGame();}openFrontierChapter();}
function rescueFrontierCarpenter(){const s=frontierState();if(mapId!=='frontier_quarry')return;if(!s.accepted){say('Read the workboard at Hearthstead first.');return;}if(s.rescued){say('Edda is on her way to Hearthstead. Take the southern exit.');return;}const left=maps.frontier_quarry.enemies.filter(e=>e.alive).length;if(left){say('Edda: '+left+' raiders still block the way. Clear them and come back.');return;}s.rescued=true;saveGame();openFrontierDialog('The Carpenter’s Promise','Edda lifts a battered tool roll from the dust. “They wanted the old foundation plans. I told them the stones were worthless.”\n\nShe glances at the mark on the foreman’s coat: a bell split down the middle.\n\n“I can mend your hall. After that, we should talk about what is underneath it.”\n\nReturn through the southern quarry exit. Edda will meet you at the outpost.',[{label:'Bring the carpenter home',action:()=>{townQuestState._tracking={id:'frontier_hearth'};saveGame();ui();}}]);}
function welcomeFrontierResidents(){if(!journalCanAccept('frontier_hearth'))return;const s=frontierState();if(mapId!=='frontier_outpost'||!s.home||!settlementState().levels.hall)return;if(s.complete){openFrontierChapter();return;}s.complete=true;grantQuestArtifact('hearthstead_charter');settlementSupplies([8,6,6]);grantXp(20);syncFrontierResidents();townQuestState._tracking={id:'frontier_bells'};saveGame();ui();openFrontierDialog('The First Night at Hearthstead','The first families arrive before sunset. Nell hangs herbs beside the door; Tomas carries in a table with one short leg. Edda lights the hearth.\n\n“No one sleeps outside tonight.”\n\nFor a moment, this is enough. Then a single bell sounds from the old well.\n\nCHAPTER COMPLETE\nHearthstead Charter · +20 XP · settlement supplies\nThe hall now offers free rest to you and your active pets.',[{label:'Step outside and see your home',action:()=>{say('Two residents have arrived. The OLD WELL holds your next clue.');}},{label:'Read the next clue',action:()=>{say('Walk to the OLD WELL, northeast of the hall, and INTERACT.');}}]);}
function frontierRest(){if(politicsState().phase==='siege'){say('The hearth cannot offer rest during a siege. Defend the town or yield at the council.');return;}if(mapId!=='frontier_outpost'||!frontierState().complete)return;player.hp=player.max;for(const c of activeCompanions())c.hp=c.max;saveGame();ui();say('Rested at your hearth. You and your active pets are ready for the road.');}
function frontierWell(){if(!journalCanAccept('frontier_bells'))return;const s=frontierState();if(!s.complete){say('A cracked bell hangs deep below the well. Edda may know its story once the hall is restored.');return;}if(s.blueprint){say('The bellkeeper’s plans are safe. Your Kitchen Garden can prepare Field Rations.');return;}s.mystery=true;townQuestState._tracking={id:'frontier_bells'};saveGame();if(!townQuestState.world_watchtower?.claimed){openFrontierDialog('The Bell Beneath the Well','Inside the well’s stone rim, you find a maker’s mark: three watchfires over a split bell. Edda recognizes it.\n\n“The Silent Watchtower kept these roads safe before the towns shut their gates. Its cache may explain why the raiders wanted our plans.”\n\nComplete The Silent Watchtower in North Ridge, then return here. Earlier completion counts.',[{label:'Track the watchtower lead',action:()=>{townQuestState._tracking={id:'frontier_bells'};saveGame();ui();}},{label:'Continue exploring',action:()=>{}}]);return;}
 s.blueprint=true;grantQuestArtifact('bellkeeper_plans');grantXp(15);saveGame();ui();openFrontierDialog('A Road Remembered','The watchtower records match the mark beneath the well. Hearthstead was a refuge on the bellkeepers’ road—a place where any traveler could find food and shelter.\n\nEdda unfolds a provisioner’s plan. “Then that is what we will make it again.”\n\nNEW RECIPE: Kitchen Garden · prepare a Field Ration for 2 food.\n+15 XP · Bellkeeper Provisions added to your bag.',[{label:'Return to Hearthstead',action:()=>{}}]);}
function craftFrontierRation(){if(!settlementAtTown()||!frontierState().blueprint||!settlementState().levels.garden)return;const s=settlementState();if(s.stock.food<2){say('You need 2 settlement food.');return;}if(!addItem('field_ration')){say('Make room in your bag first.');return;}s.stock.food-=2;saveGame();ui();openSettlementBuilding('garden','Prepared one Field Ration.');}
function frontierInteract(obj){if(!obj.id.startsWith('frontier_'))return false;const s=frontierState();
 if(obj.id==='frontier_entrance'){say('Your settlement is west. Cross anywhere along the western border.');return true;}
 if(obj.id==='frontier_exit'){say('Cross any point of the north, west, or east border to reach the adjoining region.');return true;}
 if(obj.id==='frontier_mine'){if(!s.accepted){openFrontierDialog('Old Quarry · Rescue quest required','Read the WORKBOARD at the center of your settlement and accept A Hearth Worth Keeping. Then return to this rock entrance and press INTERACT to enter Briarstone Quarry.',[{label:'Show me the workboard',action:()=>walkSettlementPoint('frontier_board')},{label:'Back',action:()=>{}}]);return true;}return takeMapExit(mapConnections.frontier_outpost.exits.find(e=>e.to==='frontier_quarry'));}
 if(obj.id==='frontier_quarry_exit')return takeMapExit(mapConnections.frontier_quarry.exits[0]);
 if(obj.id==='frontier_board'){beginFrontierChapter();return true;}
 if(obj.id==='frontier_carpenter'){rescueFrontierCarpenter();return true;}
 if(obj.id==='frontier_carpenter_home'){if(!s.home){say('The carpenter is missing. Read the workboard.');return true;}if(!settlementState().levels.hall){openSettlementBuilding('hall');return true;}if(!s.complete){welcomeFrontierResidents();return true;}openFrontierDialog('Edda · Carpenter','“Look around. They have started calling this place home.”\n\n'+(!s.blueprint?'The old well may tell us why the raiders came.':'The bellkeepers kept their roads open by feeding the people who walked them.'),[{label:'Manage settlement',action:openSettlement},{label:'Rest at the hearth',action:frontierRest},{label:'Leave',action:()=>{}}]);return true;}
 if(obj.id==='frontier_well'){frontierWell();return true;}
 if(obj.id.startsWith('frontier_plot_')){const id=obj.id.slice(14);openSettlementBuilding(id);return true;}return true;
}
function frontierQuestEntries(){const s=frontierState();return [...(s.complete?[memoryQuestEntry()]:[]),{id:'frontier_hearth',title:'A Hearth Worth Keeping',desc:frontierObjective(),reward:'A living outpost · free party rest · Hearthstead Charter',done:!!s.complete,active:!!s.accepted&&!s.complete},...(s.complete?[{id:'frontier_bells',title:'The Bell Beneath the Well',desc:'Inspect Hearthstead’s old well, investigate the Silent Watchtower, and bring its history home.',reward:'Kitchen Garden recipe: Field Rations · 15 XP',done:!!s.blueprint,active:!s.blueprint}]:[])];}
function frontierQuestGuide(id){if(id==='frontier_memory')return memoryQuestGuide();const s=frontierState();if(id==='frontier_hearth')return {destination:mapId.startsWith('frontier_')?(frontierStage()==='rescue'?'frontier_quarry':'frontier_outpost'):'frontier_outpost',detail:frontierObjective(),progress:({discover:'Find the outpost',rescue:'Rescue Edda',return:'Return home',rebuild:'Raise the hall',welcome:'Welcome residents',complete:'Home restored'})[frontierStage()],ready:frontierStage()==='welcome'};return {destination:s.mystery&&!townQuestState.world_watchtower?.claimed?'northridge':'frontier_outpost',detail:!s.mystery?'Inspect the OLD WELL at Hearthstead. Enter at the southeast corner of the world.':!townQuestState.world_watchtower?.claimed?'Solve the Silent Watchtower in North Ridge, open its cache, then return to Hearthstead’s well.':'Return to Hearthstead’s OLD WELL to recover the provisioner’s plan.',progress:s.blueprint?'Recipe recovered':s.mystery?'Follow the bellkeepers':'A bell below',ready:!!s.mystery&&!!townQuestState.world_watchtower?.claimed};}
function frontierRoads(){return [[70,240,900,325],[455,204,505,240],[175,200,205,240],[755,200,785,240],[310,325,340,505],[635,325,665,505],[100,485,855,525],[175,452,205,485],[455,465,505,485],[755,465,785,485],[455,525,505,565]];}
function drawFrontierScenery(){
 if(mapId==='memory_valley'){drawMemoryScenery();return;}
 const s=frontierState();if(mapId==='ashvale'){standArt('notice',1420,640,52,'extras');drawLocationLabel(1420,565,settlementName().toUpperCase()+' TRAIL');return;}
 if(!activeMap.frontier)return;
 if(mapId==='frontier_outpost'){
 paintSurface('grass',32,42,896,516);for(const [x0,y0,x1,y1] of frontierRoads())paintSurface('dirt',x0,y0,x1-x0,y1-y0);
 for(const [id,[x,y,w,h]] of Object.entries(frontierPlots)){const level=settlementState().levels[id];paintSurface('dirt',x-8,y+h-6,w+16,52);if(level){if(['palisade','gate','tower'].includes(id)){drawTownDefense(id,x,y,w,h,level);}else if(id==='garden'){paintSurface('dirt',x,y,w,h);ctx.save();ctx.strokeStyle='#b29962';ctx.lineWidth=3;ctx.strokeRect(x+2,y+2,w-4,h-4);for(let row=0;row<4;row++){ctx.fillStyle='#473d28';ctx.fillRect(x+8,y+12+row*20,w-16,9);for(let col=0;col<7;col++){const px=x+15+col*15,py=y+17+row*20;ctx.fillStyle=(row+col)%2?'#9cad59':'#6c9958';ctx.beginPath();ctx.ellipse(px-3,py-3,5,2,-.7,0,Math.PI*2);ctx.ellipse(px+3,py-3,5,2,.7,0,Math.PI*2);ctx.fill();ctx.fillStyle=row%2?'#d5b65f':'#bad283';ctx.fillRect(px-1,py-6,2,5);}}ctx.restore();}else drawPixelHouse(x,y,w,h,id==='hall'?1:0,id==='forge'?'forge':id==='hall'?'elder':'home');if(level>1)standArt('lamp',x+12,y+h,38);if(level>2)standArt('bush',x+w-12,y+h,30);}else{paintArt('ruin',x,y,w,h);standArt('logs',x+w/2,y+h-8,30,'items');}drawLocationLabel(x+w/2,y-17,settlementBuildings[id].name.toUpperCase()+(level?' · '+level:' · RUIN'));}
 standArt('notice',480,270,42,'extras');drawLocationLabel(480,224,'WORKBOARD');standArt('well',620,180,60);drawLocationLabel(620,114,s.complete?'THE OLD WELL':'OLD WELL');standArt('rock',870,290,65);drawLocationLabel(870,212,'OLD QUARRY · INTERACT');standArt('lamp',530,510,45);
 if(s.home){drawDetailedVillager({x:345,y:280,name:'Edda the Carpenter'});drawLocationLabel(345,216,'EDDA');}else standArt('crate',345,280,34);
 if(s.complete){standArt('hearth',575,265,45,'extras');standArt('bush',275,390,30);standArt('crate',655,450,34);ctx.save();ctx.fillStyle='#e9c873';ctx.fillRect(562,72,3,92);ctx.fillStyle='#4d8a73';ctx.fillRect(565,73,34,43);ctx.fillStyle='#f5df9d';ctx.font='24px Georgia';ctx.fillText('⌂',572,102);ctx.restore();}
 drawLocationLabel(480,582,'↓ RETURN TO ASHVALE');drawMemoryScenery();
 }else{
 paintSurface('stone',32,42,896,516);ctx.save();ctx.strokeStyle='#403a31';ctx.lineWidth=14;ctx.strokeRect(32,42,896,516);ctx.restore();paintSurface('dirt',445,95,70,450);
 for(const [x,y,w,h] of [[200,200,200,34],[570,365,190,34]]){paintArt('ruin',x,y,w,h);}
 standArt('crate',720,115,44);standArt('lamp',805,125,48);if(!s.rescued){drawDetailedVillager({x:770,y:170,name:'Edda the Carpenter'});drawLocationLabel(760,100,'EDDA');}else standArt('logs',770,170,32,'items');drawLocationLabel(480,582,'↓ RETURN TO HEARTHSTEAD');
 }
}


// Town politics: finite decrees, named grievances, active-play sieges. No wall-clock attacks.
const townPowers={ashvale:'Ashvale',brackenford:'Brackenford',stonewatch:'Stonewatch',sunmere:'Sunmere'};
const townDecrees={seize:{name:'Seize merchant timber',gain:[10,0,0]},levy:{name:'Confiscate a food caravan',gain:[0,0,10]},blockade:{name:'Take a stone shipment by force',gain:[0,10,0]}};
maps.frontier_outpost.worldObjects.push({id:'town_council',x:830,y:720,label:'TOWN COUNCIL'});
for(let i=0;i<6;i++)maps.frontier_outpost.enemies.push({x:850+i*42,y:620+(i%2)*50,hp:12,alive:false,seed:900+i,kind:'bandit',name:'Town Expedition Soldier',boss:true,townSiege:true});
function politicsState(){let p=townQuestState._politics;if(!p||typeof p!=='object'||Array.isArray(p))p=townQuestState._politics={};p.relations=p.relations||{};p.events=p.events||{};p.decrees=p.decrees||{};p.log=Array.isArray(p.log)?p.log:[];for(const id of Object.keys(townPowers))p.relations[id]=clamp(Number(p.relations[id])||0,-100,100);if(!['peace','ultimatum','siege'].includes(p.phase))p.phase='peace';p.seconds=Math.max(0,Number(p.seconds)||0);p.integrity=Math.max(0,Number(p.integrity)||0);p.volley=Math.max(0,Number(p.volley)||0);return p;}
function politicsLog(text){const p=politicsState();p.log.push(text);p.log=p.log.slice(-12);}
function politicsEvent(key,text,deltas){const p=politicsState();if(p.events[key])return;p.events[key]=true;for(const [id,delta]of Object.entries(deltas))p.relations[id]=clamp(p.relations[id]+delta,-100,100);politicsLog(text);}
function syncPolitics(){const p=politicsState();if(!frontierState().complete)return p;
 const m=townQuestState.npc_mara,s=townQuestState.npc_sera,med=townQuestState.crossroads_medicine;
 if(m?.claimed)politicsEvent('mara','Mara: '+(m.choice==='shelter'?'Sunmere welcomes mercy; Stonewatch questions the pardon.':'Stonewatch supports the sentence; Sunmere regrets the exile.'),m.choice==='shelter'?{sunmere:8,stonewatch:-8}:{sunmere:-8,stonewatch:8});
 if(s?.claimed)politicsEvent('convoy','Convoy: '+(s.choice==='divert'?'Food was diverted from families (-15 Ashvale, -20 Brackenford).':'Families received their food (+10 Ashvale and Brackenford).'),s.choice==='divert'?{ashvale:-15,brackenford:-20}:{ashvale:10,brackenford:10});
 if(s?.repaired)politicsEvent('convoy_repaid','Sera’s families repaid (+10 Ashvale, +15 Brackenford).',{ashvale:10,brackenford:15});
 if(med?.claimed)politicsEvent('medicine','Crossroads medicine: '+(med.choice==='mercy'?'The wounded traveler was helped (+8 Sunmere).':'The wounded traveler went without aid (-10 Sunmere).'),{sunmere:med.choice==='mercy'?8:-10});
 if(p.phase==='peace'){const hostile=Object.keys(townPowers).find(id=>p.relations[id]<=-60);if(hostile){p.phase='ultimatum';p.attacker=hostile;p.seconds=60;politicsLog(townPowers[hostile]+' issues an ultimatum. Pay reparations or prepare for a siege.');say(politicsStatus());}}
 if(p.phase==='ultimatum'&&p.relations[p.attacker]>-60){politicsLog(townPowers[p.attacker]+' withdraws its ultimatum.');p.phase='peace';p.seconds=0;}
 return p;
}
function politicsStatus(){const p=politicsState();return p.phase==='siege'?townPowers[p.attacker]+' is attacking! Town defense '+Math.ceil(p.integrity)+' / '+p.maximum+'.':p.phase==='ultimatum'?townPowers[p.attacker]+' ultimatum: '+Math.ceil(p.seconds)+' active seconds at Hearthstead until attack.':'No army is marching on Hearthstead.';}
function councilAvailable(){return mapId==='frontier_outpost'&&frontierState().complete;}
function enactTownDecree(id,key){const p=syncPolitics(),d=townDecrees[key];if(!councilAvailable()||p.phase==='siege'||!townPowers[id]||!d||p.decrees[id+'_'+key])return;p.decrees[id+'_'+key]=true;settlementSupplies(d.gain);politicsEvent('decree_'+id+'_'+key,townPowers[id]+': '+d.name+' (-25 relations).',{[id]:-25});syncPolitics();saveGame();openTownRelations(id);}
function townReparations(id){const p=syncPolitics();if(!councilAvailable()||p.phase==='siege'||!townPowers[id]||p.relations[id]>=0||!settlementCanPay([6,6,6]))return;settlementPay([6,6,6]);p.relations[id]=Math.min(0,p.relations[id]+20);politicsLog(townPowers[id]+': reparations delivered (+20 relations, capped at neutral).');syncPolitics();saveGame();openTownRelations(id);}
function openTownRelations(id){if(!townPowers[id])return;const p=syncPolitics();openFrontierDialog(townPowers[id]+' · diplomacy','Relations: '+p.relations[id]+' / 100\nAt -60, this town sends an ultimatum. A decree costs 25 relations and can be issued only once per shipment. These seizures harm your neighbors.\n\nReparations cost 6 timber, 6 stone and 6 food for +20 relations (up to neutral). Get above -60 before the ultimatum expires to cancel the attack.\n\n'+p.log.filter(t=>t.includes(townPowers[id])).slice(-4).join('\n'),[
 {label:'Send reparations · 6 of each supply',disabled:!councilAvailable()||p.phase==='siege'||p.relations[id]>=0||!settlementCanPay([6,6,6]),action:()=>townReparations(id)},
 ...Object.entries(townDecrees).map(([key,d])=>({label:(p.decrees[id+'_'+key]?'Already issued · ':'')+d.name+' · +10 supplies / −25 relations',disabled:!councilAvailable()||p.phase==='siege'||!!p.decrees[id+'_'+key],action:()=>openFrontierDialog('Confirm coercive decree',d.name+' from '+townPowers[id]+'. Gain '+settlementCostText(d.gain)+'. Lose 25 relations. At -60 they threaten war. This decision cannot be taken back; reparations cost supplies.',[{label:'Issue decree',action:()=>enactTownDecree(id,key)},{label:'Go back',action:()=>openTownRelations(id)}])})),{label:'Back to council',action:openTownCouncil}]);}
function townDefenseMaximum(){const l=settlementState().levels;return Math.round((100+l.palisade*80+l.gate*60)*(politicsState().damaged?.5:1));}
function repairTownDefenses(){const p=politicsState();if(!councilAvailable()||p.phase==='siege'||!p.damaged||!settlementCanPay([10,10,0]))return;settlementPay([10,10,0]);p.damaged=false;politicsLog('Edda repaired the defenses.');saveGame();openTownCouncil();}
function openTownCouncil(){const p=syncPolitics();saveGame();openFrontierDialog('The Hearthstead Council',(!frontierState().complete?'Welcome Hearthstead’s residents to establish the council.\n\n':'')+politicsStatus()+'\n\nYou are Warden. Edda oversees works, Nell provisions, and Tomas diplomacy.\n\nRelations begin at 0. At −60, a town threatens war. Pay reparations or prepare your defenses.\n\n'+(p.damaged?'Edda: Our defenses need repairs.':'Edda: '+townDefenseMaximum()+' town defense ready.'),[
 ...Object.entries(townPowers).map(([id,name])=>({label:name+' · '+p.relations[id],action:()=>openTownRelations(id)})),
 {label:'Defensive works and repairs',action:openTownDefenses},
 {label:'Council record and siege rules',action:openCouncilRecord},
 ...(p.phase==='siege'?[{label:'Yield the town…',action:()=>openFrontierDialog('Yield Hearthstead?','Lose 25% of stored supplies, at most 20 of each. Defense is damaged, but all buildings and story progress remain.',[{label:'Yield and end siege',action:()=>{endTownSiege(false);openTownCouncil();}},{label:'Keep defending',action:()=>{}}])}]:[]),
 {label:'Return to adventure',action:()=>{}}]);}
function openTownDefenses(){const p=politicsState(),l=settlementState().levels;openFrontierDialog('Defensive Works','Edda: '+townDefenseMaximum()+' starting town defense. Palisades and gates absorb siege pressure.\n\nWatchtower and militia: '+(2*l.tower+l.barracks)+' damage every 3 active seconds.\nBarracks: '+Math.round(l.barracks*15)+'% less incoming siege pressure.\n\n'+(p.damaged?'Defenses damaged: starting defense halved until repaired.':'The defenses are in good repair.')+'\n\nConstruction waits until a siege ends. All four structures have three levels, limited by Hearth Hall.',[
 ...['palisade','gate','tower','barracks'].map(id=>({label:settlementBuildings[id].name+' · '+l[id]+'/3',action:()=>openSettlementBuilding(id)})),
 ...(p.damaged?[{label:'Repair · 10 timber + 10 stone',disabled:!councilAvailable()||p.phase==='siege'||!settlementCanPay([10,10,0]),action:repairTownDefenses}]:[]),
 {label:'Back to council',action:openTownCouncil}]);}
function openCouncilRecord(){const p=politicsState();openFrontierDialog('Council Record','Armies advance only during active play in Hearthstead. Menus and offline time pause them. After a 60-second ultimatum, six soldiers attack. Each survivor inflicts 1 town defense damage per second, reduced by Barracks. Defeat them before defense reaches zero.\n\nLeaving town or falling in battle during a siege yields Hearthstead: lose 25% of stored supplies (at most 20 of each). Buildings remain; defense is halved until repaired. Both victory and defeat bring an uneasy truce. Fresh harms can cause another attack.\n\n'+(p.log.join('\n\n')||'No decisions recorded.'),[{label:'Back to council',action:openTownCouncil}]);}
function restoreTownPolitics(){const p=politicsState();for(const [i,e]of maps.frontier_outpost.enemies.filter(e=>e.townSiege).entries()){if(p.phase!=='siege'){e.alive=false;e.hp=0;e.respawnAt=0;}e.name=(townPowers[p.attacker]||'Town Expedition')+' Soldier '+(i+1);}}
function startTownSiege(){const p=politicsState();if(p.phase!=='ultimatum'||mapId!=='frontier_outpost')return;p.phase='siege';p.maximum=townDefenseMaximum();p.integrity=p.maximum;p.volley=0;const troops=maps.frontier_outpost.enemies.filter(e=>e.townSiege);troops.forEach((e,i)=>{e.alive=true;e.x=e.spawnX;e.y=e.spawnY;e.hp=e.maxHp;e.windup=0;e.swing=null;e.stun=0;e.name=townPowers[p.attacker]+' Soldier '+(i+1);});politicsLog(townPowers[p.attacker]+' attacks Hearthstead.');saveGame();openFrontierDialog('Hearthstead is under attack',townPowers[p.attacker]+' has sent six soldiers to the southeast approach. Each surviving soldier inflicts 1 town defense damage per second, reduced by your Barracks. Defeat them before defense reaches zero. Your Watchtower and Barracks fire automatically.\n\nLeaving Hearthstead or falling in battle yields the town. You can also yield at the council. Rest and construction are unavailable during combat.',[{label:'Defend Hearthstead',action:()=>{}}]);}
function endTownSiege(won){const p=politicsState();if(p.phase!=='siege')return;const name=townPowers[p.attacker];p.phase='peace';p.relations[p.attacker]=Math.max(-35,p.relations[p.attacker]);p.seconds=0;p.lastResult=won?'defended':'yielded';for(const e of maps.frontier_outpost.enemies.filter(e=>e.townSiege)){e.alive=false;e.hp=0;e.respawnAt=0;}if(!won){const s=settlementState();for(const key of ['wood','stone','food'])s.stock[key]-=Math.min(20,Math.floor(s.stock[key]*.25));p.damaged=true;}politicsLog(name+': '+(won?'the attack was repelled.':'Hearthstead yielded; supplies lost and defenses damaged.')+' An uneasy truce sets relations to at least -35.');say(won?'Hearthstead defended. The army withdraws.':'Hearthstead yielded. Buildings remain; visit the council to repair defenses.');saveGame();}
function politicsTick(dt){if(mapId!=='frontier_outpost'||!frontierState().complete||document.hidden)return;const p=syncPolitics();if(p.phase==='ultimatum'){p.seconds=Math.max(0,p.seconds-dt);if(!p.seconds)startTownSiege();return;}if(p.phase!=='siege')return;const alive=enemies.filter(e=>e.townSiege&&e.alive);if(!alive.length){endTownSiege(true);return;}const l=settlementState().levels;p.integrity=Math.max(0,p.integrity-alive.length*dt*(1-l.barracks*.15-(workforceState().hires.guard?.active?.1:0)));if(!p.integrity){endTownSiege(false);return;}p.volley+=dt;if(p.volley>=3){p.volley-=3;const damage=l.tower*2+l.barracks+(workforceState().hires.guard?.active?1:0);if(damage)damageEnemy(alive[0],damage,0,null);}}
function drawTownDefense(id,x,y,w,h,level){ctx.save();ctx.fillStyle=level>1?'#727778':'#765239';ctx.strokeStyle='#342d29';ctx.lineWidth=4;if(id==='gate'){ctx.fillRect(x,y,30,h);ctx.fillRect(x+w-30,y,30,h);ctx.fillRect(x,y,w,18);ctx.strokeRect(x,y,w,h);ctx.fillStyle='#201f1c';ctx.fillRect(x+35,y+22,w-70,h-22);}else if(id==='tower'){ctx.fillRect(x+15,y+18,w-30,h-18);ctx.fillRect(x,y,w,26);ctx.fillStyle='#2c3e45';ctx.fillRect(x+35,y+43,30,22);for(let i=0;i<4;i++)ctx.fillRect(x+i*w/4,y-10,14,12);}else{for(let i=0;i<w;i+=15){ctx.fillRect(x+i,y,12,h);ctx.beginPath();ctx.moveTo(x+i,y);ctx.lineTo(x+i+6,y-12);ctx.lineTo(x+i+12,y);ctx.fill();}ctx.fillStyle='#b2986c';ctx.fillRect(x,y+h/2,w,5);}ctx.restore();}
function drawPoliticsScenery(){if(mapId!=='frontier_outpost')return;standArt('notice',830,720,48,'extras');drawLocationLabel(830,660,'TOWN COUNCIL');}
function politicsHudTitle(){const p=politicsState();return p.phase==='siege'?'SIEGE · DEFENSE '+Math.ceil(p.integrity)+' / '+p.maximum:p.phase==='ultimatum'?townPowers[p.attacker].toUpperCase()+' ULTIMATUM · '+Math.ceil(p.seconds)+'s':activeMap.name.toUpperCase();}

// The River That Remembers. Branching history is per character, not global.
const memorySites=[
 {id:'cradle',x:-1040,y:-540,title:'THE EMPTY CRADLE',text:'A stone cradle hums with running water. A mother remembers washing blankets here. Nell remembers the same bank as an orchard. The bell has kept both voices.'},
 {id:'ferry',x:1850,y:-510,title:'THE LAST FERRY',text:'An oar rests in dry earth. A ferryman remembers carrying families through a storm. His daughter Iona still waits for water to return.'},
 {id:'lantern',x:1820,y:1120,title:'THE UNLIT LANTERN',text:'A lantern remembers a road that no longer exists. Orren, its keeper, has spent years listening for the travelers stranded beyond it.'}
];
maps.memory_valley={name:'The Remembering Vale',frontier:true,memory:true,level:2,trees:[[-800,-630],[-750,-480],[1570,-570],[2080,-490],[1510,1050],[2140,1150],[-900,990],[-700,1100]],stones:[[-480,-400],[1540,780],[2030,800],[-1090,680]],enemies:[{x:580,y:20,hp:8,alive:true,seed:711,kind:'skeleton',name:'Hollow Listener',boss:true},{x:800,y:30,hp:8,alive:true,seed:712,kind:'skeleton',name:'Hollow Listener',boss:true},{x:690,y:-120,hp:12,alive:true,seed:713,kind:'skeleton',name:'Keeper of the Last Sound',boss:true}],npcs:[],arrival:[480,510],hint:'Follow the three memory trails. Read the cradle, ferry and lantern, then decide what the buried bell should remember.',worldObjects:[{id:'memory_return',x:480,y:560,label:'HEARTHSTEAD'},{id:'memory_bell',x:690,y:-230,label:'THE BURIED BELL'},...memorySites.map(s=>({id:'memory_echo_'+s.id,x:s.x,y:s.y,label:s.title})),{id:'memory_task_north',x:-850,y:-100,label:'NORTH CHANNEL'},{id:'memory_task_east',x:1650,y:450,label:'EAST CHANNEL'},{id:'memory_task_south',x:-850,y:1020,label:'SOUTH CHANNEL'}]};
maps.frontier_outpost.worldObjects.push({id:'memory_trail',x:1120,y:290,label:'REMEMBERING VALE'},{id:'memory_ledger',x:1020,y:720,label:'TOWN CHRONICLE'},{id:'memory_resident',x:1160,y:800,label:'MEMORY GARDEN'});
Object.assign(itemDefs,{memory_river:{name:'Riverkeeper’s Promise',icon:'💧',category:'quest',description:'You returned the bell’s memory to the river. Iona has made her home in Hearthstead.'},memory_beacon:{name:'Lanternkeeper’s Promise',icon:'🏮',category:'quest',description:'You gave the bell’s memory to the lost road. Orren has made his home in Hearthstead.'},memory_finished:{name:'A Place That Remembers',icon:'📜',category:'quest',description:'Your settlement remembers a choice you made in the valley.'}});
function memoryState(){const f=frontierState();if(!f.memory||typeof f.memory!=='object')f.memory={};const s=f.memory;s.echoes=Array.isArray(s.echoes)?s.echoes:[];s.tasks=Array.isArray(s.tasks)?s.tasks:[];return s;}
function memoryObjective(){const s=memoryState();if(!frontierState().complete)return 'Restore Hearthstead and welcome its first residents.';if(!s.accepted)return 'Follow the east road beyond the quarry sign to REMEMBERING VALE.';if(!s.choice)return s.echoes.length<3?'Listen to the Empty Cradle (northwest), Last Ferry (northeast), and Unlit Lantern (southeast). '+s.echoes.length+'/3 memories.':'Clear the three Hollow Listeners near the center, then approach THE BURIED BELL.';if(!s.home)return 'Return to Hearthstead. Meet '+(s.choice==='river'?'Iona':'Orren')+' in the new garden southeast of the old settlement.';if(!s.finished)return (s.choice==='river'?'Repair three river channels with 2 settlement stone each':'Tune wayposts in order: NORTH → SOUTH → EAST')+' in the vale. '+s.tasks.length+'/3. Then return to your new resident.';return 'Your choice lives in Hearthstead. Visit your new resident for provisions, or read the Town Chronicle.';}
function openMemoryChronicle(){const s=memoryState();openFrontierDialog('A Place That Remembers',memoryObjective()+'\n\n'+(s.choice?(s.choice==='river'?'THE RIVER RETURNED\nIona followed the first current home. A water garden grows where dust once gathered. The lost road remains silent.':'THE ROAD AWAKENED\nOrren followed a thread of light home. Lanterns mark a refuge in the dry garden. The river remains a memory.'):'The valley’s bell holds one last song. It can restore a river or recall a lost road. Listen before deciding. Neither choice erases your earlier adventures.')+(s.finished?'\n\nYour town records: “We made room for a life that might otherwise have been forgotten.”':''),[{label:'Track this story',action:()=>{townQuestState._tracking={id:'frontier_memory'};saveGame();ui();}},{label:'Return to the world',action:()=>{}}]);}
function memoryEcho(id){const s=memoryState(),site=memorySites.find(e=>e.id===id);if(mapId!=='memory_valley'||!site||!s.accepted)return;if(!s.echoes.includes(id))s.echoes.push(id);saveGame();openFrontierDialog(site.title,site.text+'\n\n'+s.echoes.length+'/3 memories heard.'+(activeCompanions().length?'\n'+activeCompanions()[0].name+' pauses beside you, listening.':''),[{label:'Keep exploring',action:()=>{ui();}},{label:'Read the chronicle',action:openMemoryChronicle}]);}
function memoryBell(){const s=memoryState();if(mapId!=='memory_valley')return;if(s.choice){openMemoryChronicle();return;}if(s.echoes.length<3){say('The bell answers in fragments. Listen to all three memory sites first.');return;}if(enemies.some(e=>e.alive)){say('The Hollow Listeners still bind the bell. Defeat all three.');return;}openFrontierDialog('What Should This Place Remember?','One song remains inside the bell. Edda’s inscription warns that releasing it changes this valley for this character.\n\nRETURN THE RIVER: restore the stream and water garden; Iona joins Hearthstead. Her follow-up restores three channels and unlocks food provisions.\n\nRECALL THE ROAD: kindle the lantern refuge; Orren joins Hearthstead. His follow-up lights three wayposts and unlocks stone provisions.\n\nThe other landscape will remain a memory. You may leave and decide later.',[{label:'Hear the river’s promise',action:()=>confirmMemoryChoice('river')},{label:'Hear the road’s promise',action:()=>confirmMemoryChoice('beacon')},{label:'I need more time',action:()=>{}}]);}
function confirmMemoryChoice(choice){openFrontierDialog('Make This History?',choice==='river'?'The river will return. Iona will settle in Hearthstead, and you will help her reopen its channels. The lantern road will stay silent.\n\nThis choice is permanent for this character.':'The lantern road will awaken. Orren will settle in Hearthstead, and you will help him light its wayposts. The riverbed will stay dry.\n\nThis choice is permanent for this character.',[{label:choice==='river'?'Return the river':'Recall the road',action:()=>chooseMemory(choice)},{label:'Consider both promises',action:memoryBell}]);}
function chooseMemory(choice){const s=memoryState();if(mapId!=='memory_valley'||!['river','beacon'].includes(choice)||s.choice||s.echoes.length<3||enemies.some(e=>e.alive))return;s.choice=choice;grantQuestArtifact('memory_'+choice);grantXp(25);syncMemoryWorld();saveGame();ui();openFrontierDialog(choice==='river'?'Water Finds Its Way':'A Light Answers','The bell makes no sound. Instead, the ground remembers.\n\n'+(choice==='river'?'A ribbon of water crosses the valley. Somewhere downstream, a woman drops the oar she has carried for years.':'One lantern lights another across the dry valley. On a road absent from every map, a keeper finally sees the way home.')+'\n\nReturn to Hearthstead’s new southeast garden. Someone is waiting for you.\n+25 XP · a new resident and a changed landscape',[{label:'Carry this story home',action:()=>{townQuestState._tracking={id:'frontier_memory'};saveGame();ui();}}]);}
function syncMemoryWorld(){const s=memoryState();for(const o of maps.memory_valley.worldObjects)if(o.id.startsWith('memory_task_'))o.label=s.choice==='beacon'?o.id.slice(12).toUpperCase()+' WAYPOST':o.id.slice(12).toUpperCase()+' CHANNEL';const home=maps.frontier_outpost.worldObjects.find(o=>o.id==='memory_resident');home.label=s.choice?(s.choice==='river'?'IONA · RIVERKEEPER':'ORREN · LANTERNKEEPER'):'MEMORY GARDEN';}
function memoryResident(){const s=memoryState();if(mapId!=='frontier_outpost')return;if(!s.choice){openMemoryChronicle();return;}s.home=true;saveGame();const river=s.choice==='river';if(!s.finished&&s.tasks.length===3){s.finished=true;grantQuestArtifact('memory_finished');grantXp(35);settlementSupplies(river?[4,2,12]:[4,12,2]);saveGame();ui();}openFrontierDialog(river?'Iona · Riverkeeper':'Orren · Lanternkeeper',!s.finished?(river?'“Water returned, but it has forgotten its banks. Bring 2 settlement stone to each of the three old channels in the vale. I will plant something here that outlives us.”':'“I found my way home. Others are still out there. Tune the wayposts NORTH, then SOUTH, then EAST—the order of my journey—and I will keep this refuge ready.”')+'\n\n'+memoryObjective():(river?'Iona places a seedling into running water. “My daughter will grow up knowing this sound.”':'Orren hangs a lantern for someone who has not arrived yet. “A home is also a promise to the people still coming.”')+'\n\nChapter complete · 35 XP and supplies awarded once.\nResident trade: '+(river?'exchange 2 timber for 3 food.':'exchange 2 food for 3 stone.'),[{label:s.finished?'Trade for provisions':'Track the channels and wayposts',action:()=>{if(s.finished)memoryTrade();else{townQuestState._tracking={id:'frontier_memory'};saveGame();ui();}}},{label:'Read the Town Chronicle',action:openMemoryChronicle},{label:'Leave',action:()=>{}}]);}
function memoryTrade(){const s=memoryState();if(mapId!=='frontier_outpost'||!s.finished)return;const stock=settlementState().stock,from=s.choice==='river'?'wood':'food',to=s.choice==='river'?'food':'stone';if(stock[from]<2){say('You need 2 '+from+' to trade.');return;}if(stock[to]+3>(80+settlementState().levels.hall*80)){say('Make room for 3 '+to+' in settlement storage.');return;}stock[from]-=2;stock[to]+=3;saveGame();ui();say('Resident trade: 2 '+from+' → 3 '+to+'.');}
function memoryTask(id){const s=memoryState();if(mapId!=='memory_valley'||!s.choice||!s.home){say('Meet the new resident in Hearthstead before restoring this site.');return;}if(s.tasks.includes(id)){say('This place already remembers your help.');return;}if(!['north','east','south'].includes(id))return;if(s.choice==='river'){const stock=settlementState().stock;if(stock.stone<2){say('Repair this channel with 2 settlement stone. Mine nearby rocks for supplies.');return;}stock.stone-=2;}else if(id!==['north','south','east'][s.tasks.length]){say('The lantern hums out of tune. Orren’s order: NORTH, SOUTH, EAST. Your lit wayposts remain safe.');return;}s.tasks.push(id);saveGame();ui();say((s.choice==='river'?'Channel opened.':'Waypost lit.')+' '+s.tasks.length+'/3.'+(s.tasks.length===3?' Return to your resident in Hearthstead.':''));}
function memoryInteract(o){if(!o.id.startsWith('memory_'))return false;const s=memoryState();if(s.accepted&&!s.finished&&journalPaused('frontier_memory')&&!['memory_return','memory_ledger'].includes(o.id)){journalCanAccept('frontier_memory');return true;}if(o.id==='memory_trail'){if(!journalCanAccept('frontier_memory'))return true;if(!frontierState().complete){say('Welcome Hearthstead’s first residents before following this trail.');return true;}s.accepted=true;townQuestState._tracking={id:'frontier_memory'};saveGame();return takeMapExit(mapConnections.frontier_outpost.exits.find(e=>e.to==='memory_valley'));}if(o.id==='memory_return')return takeMapExit(mapConnections.memory_valley.exits[0]);if(o.id==='memory_bell')memoryBell();else if(o.id.startsWith('memory_echo_'))memoryEcho(o.id.slice(12));else if(o.id.startsWith('memory_task_'))memoryTask(o.id.slice(12));else if(o.id==='memory_resident')memoryResident();else openMemoryChronicle();return true;}
function memoryQuestEntry(){const s=memoryState();return {id:'frontier_memory',title:'The River That Remembers',desc:memoryObjective(),reward:'A changed valley · a resident · a new provision trade',done:!!s.finished,active:!!frontierState().complete&&!s.finished};}
function memoryQuestGuide(){const s=memoryState();return {destination:!frontierState().complete?'frontier_outpost':s.choice&&(!s.home||s.tasks.length===3)?'frontier_outpost':'memory_valley',detail:memoryObjective(),progress:s.finished?'A place that remembers':s.choice?s.tasks.length+'/3 restored':s.echoes.length+'/3 memories',ready:!!s.choice&&s.tasks.length===3&&!s.finished};}
function drawMemoryLantern(x,y,lit){ctx.save();if(lit){const glow=ctx.createRadialGradient(x,y-34,3,x,y-34,42);glow.addColorStop(0,'#f5d57566');glow.addColorStop(1,'#f5d57500');ctx.fillStyle=glow;ctx.fillRect(x-42,y-76,84,84);}ctx.fillStyle='#322f27';ctx.fillRect(x-3,y-46,6,48);ctx.fillRect(x-12,y-49,24,4);ctx.fillStyle='#98866a';ctx.fillRect(x-10,y-43,20,23);ctx.fillStyle=lit?'#ffe29b':'#343d3b';ctx.fillRect(x-7,y-40,14,17);ctx.strokeStyle='#514634';ctx.lineWidth=2;ctx.strokeRect(x-10,y-43,20,23);ctx.fillStyle='#887557';ctx.fillRect(x-8,y,16,5);ctx.restore();}
function drawMemoryScenery(){const s=memoryState();if(mapId==='frontier_outpost'){
 paintSurface('dirt',875,265,310,55);paintSurface('dirt',980,290,50,560);paintSurface('dirt',950,690,390,185);standArt('notice',1120,290,48,'extras');drawLocationLabel(1120,226,'REMEMBERING VALE →');standArt('notice',1020,720,42,'extras');drawLocationLabel(1020,662,'TOWN CHRONICLE');
 if(s.choice){paintSurface(s.choice==='river'?'water':'stone',1210,705,80,180);for(let i=0;i<4;i++){if(s.choice==='river')standArt('bush',1320,720+i*48,36);else drawMemoryLantern(1320,720+i*48,true);}drawDetailedVillager({x:1160,y:800,name:s.choice==='river'?'Iona':'Orren'});drawLocationLabel(1160,742,s.choice==='river'?'IONA':'ORREN');}else{paintArt('ruin',1200,700,110,110);drawLocationLabel(1190,920,'A PLACE FOR SOMEONE');}return;
 }if(mapId!=='memory_valley')return;
 // Paths connect each authored destination; shallow water is deliberately walkable.
 for(const y of [-540,1020])paintSurface('dirt',-1110,y,3040,55);for(const x of [-1060,1820])paintSurface('dirt',x,-540,50,1690);paintSurface('dirt',455,-540,50,1620);paintSurface('dirt',-1070,425,2940,55);paintSurface('dirt',480,-265,265,50);
 paintSurface(s.choice==='river'?'water':'dirt',-1220,640,3360,65);for(const x of [-1040,480,1840]){paintSurface('stone',x-35,620,100,110);}
 for(const site of memorySites){paintSurface('stone',site.x-70,site.y-60,140,90);standArt(site.id==='cradle'?'well':site.id==='ferry'?'logs':'lamp',site.x,site.y,55,site.id==='ferry'?'items':undefined);drawLocationLabel(site.x,site.y-100,site.title+(s.echoes.includes(site.id)?' · HEARD':''));}
 paintSurface('stone',620,-295,140,90);standArt('well',690,-230,70);drawLocationLabel(690,-335,'THE BURIED BELL');
 for(const o of activeMap.worldObjects.filter(o=>o.id.startsWith('memory_task_'))){const lit=s.tasks.includes(o.id.slice(12));standArt(s.choice==='beacon'?'lamp':'rock',o.x,o.y,48);if(s.choice==='beacon')drawMemoryLantern(o.x,o.y,lit);if(lit){ctx.save();ctx.strokeStyle=s.choice==='river'?'#7ee4dd':'#ffd875';ctx.lineWidth=4;ctx.beginPath();ctx.arc(o.x,o.y-15,32,0,Math.PI*2);ctx.stroke();ctx.restore();}drawLocationLabel(o.x,o.y-75,o.label+(lit?' · RESTORED':''));}
 if(s.choice==='beacon')for(const x of [-600,-200,200,600,1000,1400])drawMemoryLantern(x,735,true);
 standArt('notice',480,560,42,'extras');drawLocationLabel(480,600,'↓ HEARTHSTEAD');
}

// Stories are serialized in the existing per-character quest state.
const npcStoryDefs={npc_mara:{title:'The Name on the Ledger',giver:'Mara',x:-650,y:440},npc_sera:{title:'The Cost of Shelter',giver:'Sera',x:-350,y:440}};
maps.frontier_outpost.worldObjects.push({id:'npc_mara',x:-650,y:440,label:'MARA · A SECOND CHANCE'},{id:'npc_sera',x:-350,y:440,label:'SERA · THE COURIER'},{id:'npc_testimony',x:640,y:300,label:'NELL · TESTIMONY'});
maps.frontier_quarry.worldObjects.push({id:'npc_ledger',x:730,y:440,label:'RAIDERS’ LEDGER'},{id:'npc_convoy',x:150,y:310,label:'STRANDED CONVOY'});
for(let i=0;i<5;i++)maps.frontier_quarry.enemies.push({x:180+i*130,y:i%2?330:280,hp:i===4?12:7,alive:false,seed:750+i,kind:'bandit',name:i===4?'Convoy Breaker':'Road Extortionist',boss:true,npcRaid:true});
function npcStoryState(id){return townQuestState[id]||(townQuestState[id]={accepted:false,claimed:false,evidence:[]});}
function npcStoryObjective(id){const s=npcStoryState(id);if(s.claimed)return npcStoryConsequence(id);if(!s.accepted)return 'Speak to '+npcStoryDefs[id].giver+' at Hearthstead’s western camp.';if(id==='npc_mara'){const e=s.evidence||[];return e.length<2?'Read the Raiders’ Ledger in the quarry’s southeast and ask Nell for testimony beside Hearthstead’s workboard. '+e.length+'/2 accounts.':'Return to Mara at the western camp and decide whether she can stay.';}const left=maps.frontier_quarry.enemies.filter(e=>e.npcRaid&&e.alive).length;return !s.convoy?'Visit the stranded convoy in Briarstone Quarry. Defeat '+left+' road extortionists, then inspect the wagon.':'Return to Sera at Hearthstead’s western camp. Decide where the recovered supplies belong.';}
function npcStoryConsequence(id){const s=npcStoryState(id);if(id==='npc_mara')return s.choice==='shelter'?'You sheltered Mara. Her knowledge reduces Sera’s ambush from five enemies to three. She repairs salvage at the western camp.':'You exiled Mara for a 60-crown bounty. Her bed is empty; Sera must face five enemies without her warning.';return s.choice==='protect'?'You returned the convoy’s food. Sera opened a supply exchange at the western camp.':s.repaired?'You diverted the food, then repaid the families. Garden production recovered and Sera reopened her exchange. The journal keeps both decisions.':'You diverted the food for 18 stone. Hungry residents halve Kitchen Garden food production. Bring Sera 12 food to make reparations.';}
function npcStoryEntries(){return Object.entries(npcStoryDefs).filter(([id])=>townQuestState[id]?.accepted||townQuestState[id]?.claimed).map(([id,d])=>({id,title:d.title,desc:npcStoryObjective(id),reward:id==='npc_mara'?'A lasting resident decision · 20 XP':'Convoy fate · 30 XP · a settlement consequence',active:!!townQuestState[id]?.accepted&&!townQuestState[id]?.claimed,done:!!townQuestState[id]?.claimed}));}
function npcStoryGuide(id){const s=npcStoryState(id);return {destination:!s.accepted||s.claimed||id==='npc_mara'&&s.evidence?.length===2||id==='npc_sera'&&s.convoy?'frontier_outpost':id==='npc_mara'&&!s.evidence?.includes('ledger')||id==='npc_sera'?'frontier_quarry':'frontier_outpost',detail:npcStoryObjective(id),progress:s.claimed?'Your choice is remembered':id==='npc_mara'?(s.evidence||[]).length+'/2 accounts':s.convoy?'Supplies recovered':'Reach the convoy',ready:id==='npc_mara'?s.evidence?.length===2:!!s.convoy};}
function startNpcStory(id){if(mapId!=='frontier_outpost'||!frontierState().complete||!npcStoryDefs[id])return;if(id==='npc_sera'&&!npcStoryState('npc_mara').claimed){say('Finish Mara’s story before starting Sera’s.');return;}const s=npcStoryState(id);if(s.accepted||s.claimed)return;if(!journalCanAccept(id))return;s.accepted=true;s.evidence=[];if(id==='npc_sera'){const count=npcStoryState('npc_mara').choice==='shelter'?3:5;maps.frontier_quarry.enemies.filter(e=>e.npcRaid).forEach((e,i)=>{e.alive=i<count;e.hp=e.maxHp||e.baseHp;e.lootClaimed=false;e.x=e.spawnX;e.y=e.spawnY;});}townQuestState._tracking={id};saveGame();ui();openNpcStory(id);}
function openNpcStory(id){const s=npcStoryState(id),d=npcStoryDefs[id];if(!d||mapId!=='frontier_outpost')return;if(!frontierState().complete){say(d.giver+': Restore the hall and welcome the first families. Then we can talk.');return;}if(id==='npc_sera'&&!npcStoryState('npc_mara').claimed){openFrontierDialog('Sera · A Closed Road','“There is a convoy waiting beyond the quarry. First, settle what will happen to Mara. She knows those roads.”',[{label:'Leave',action:()=>{}}]);return;}if(s.claimed){openFrontierDialog(id==='npc_mara'&&s.choice==='exile'?'Mara’s Empty Camp':d.giver+' · What We Remember',npcStoryConsequence(id),[...(id==='npc_mara'&&s.choice==='shelter'?[{label:'Repair salvage · 3 timber → 2 stone',action:()=>npcResidentTrade('mara')}]:[]),...(id==='npc_sera'?[{label:s.choice==='divert'&&!s.repaired?'Make reparations · 12 food':'Convoy exchange · 3 food → 2 timber',action:()=>s.choice==='divert'&&!s.repaired?repairNpcHarm():npcResidentTrade('sera')}]:[]),{label:'Leave',action:()=>{}}]);return;}if(!s.accepted){openFrontierDialog(d.giver+' · '+d.title,id==='npc_mara'?'“My name is in the raiders’ ledger. I carried their tools. I also opened a gate so Nell’s family could escape. Ask her. Read their record. Then decide whether I belong here.”\n\nAccepting this story uses your personal-story slot.':'“The quarry road has swallowed another convoy.”\n\n'+(npcStoryState('npc_mara').choice==='shelter'?'Mara names a hidden approach. Only three extortionists can reach the wagon.':'Mara is gone. Without her warning, five extortionists surround the wagon.')+'\n\nRecover the supplies. We will decide where they belong afterward.',[{label:'Accept personal story',action:()=>startNpcStory(id)},{label:'Not yet',action:()=>{}}]);return;}if(!journalCanAccept(id))return;const ready=id==='npc_mara'?(s.evidence||[]).length===2:s.convoy;openFrontierDialog(d.giver+' · '+d.title,npcStoryObjective(id)+(ready?(id==='npc_mara'?'\n\nNell confirms that Mara helped her escape. The ledger also confirms Mara supplied the raiders. Both are true.\n\nSHELTER: Mara stays, offers salvage repairs, and can warn Sera about an ambush.\nEXILE: collect the 60-crown bounty. Mara leaves permanently, and her knowledge leaves with her.':'\n\nPROTECT THE FAMILIES: return their food. Sera opens a supply exchange.\nDIVERT TO HEARTHSTEAD: trade their food for 18 settlement stone. Hungry residents halve Garden food production until you repay 12 food.'):''),ready?[{label:id==='npc_mara'?'Shelter Mara':'Protect the families',action:()=>confirmNpcChoice(id,id==='npc_mara'?'shelter':'protect')},{label:id==='npc_mara'?'Exile Mara · 60 crowns':'Divert the supplies · 18 stone',action:()=>confirmNpcChoice(id,id==='npc_mara'?'exile':'divert')},{label:'Decide later',action:()=>{}}]:[{label:'Track this story',action:()=>{townQuestState._tracking={id};saveGame();ui();}},{label:'Leave',action:()=>{}}]);}
function confirmNpcChoice(id,choice){openFrontierDialog('Choose With Your Eyes Open',(id==='npc_mara'?(choice==='shelter'?'Mara will stay. Sera’s ambush will have three enemies, and Mara will repair salvage.':'Mara will leave permanently. Gain 60 crowns, but Sera’s ambush will have five enemies.'):(choice==='protect'?'The food goes back to its families. Sera opens her supply exchange.':'Gain 18 stone. Garden food production is halved until you give Sera 12 food in reparations.'))+'\n\nThis decision will be recorded in your history.',[{label:'Confirm this decision',action:()=>resolveNpcStory(id,choice)},{label:'Go back',action:()=>openNpcStory(id)}]);}
function resolveNpcStory(id,choice){if(mapId!=='frontier_outpost'||!npcStoryDefs[id])return;const s=npcStoryState(id);if(s.claimed||!s.accepted||!journalCanAccept(id))return;if(id==='npc_mara'&&(!(s.evidence||[]).includes('ledger')||!s.evidence.includes('nell')||!['shelter','exile'].includes(choice)))return;if(id==='npc_sera'&&(!s.convoy||!['protect','divert'].includes(choice)))return;if(choice==='divert'&&settlementState().stock.stone+18>80+settlementState().levels.hall*80){say('Make room for 18 stone before choosing this outcome.');return;}settlementTick();s.choice=choice;s.claimed=true;if(choice==='exile')player.coins+=60;if(choice==='divert')settlementSupplies([0,18,0]);grantXp(id==='npc_mara'?20:30);syncFrontierResidents();saveGame();ui();openNpcStory(id);}
function repairNpcHarm(){const s=npcStoryState('npc_sera');if(mapId!=='frontier_outpost'||!s.claimed||s.choice!=='divert'||s.repaired)return;const st=settlementState();if(st.stock.food<12){say('Bring 12 settlement food to repay the families.');return;}settlementTick();st.stock.food-=12;s.repaired=true;syncFrontierResidents();saveGame();ui();openNpcStory('npc_sera');}
function npcResidentTrade(who){if(mapId!=='frontier_outpost')return;const mara=npcStoryState('npc_mara'),sera=npcStoryState('npc_sera');if(who==='mara'?mara.choice!=='shelter':!sera.claimed||(sera.choice!=='protect'&&!sera.repaired))return;const st=settlementState(),from=who==='mara'?'wood':'food',to=who==='mara'?'stone':'wood',cost=3,gain=2;if(st.stock[from]<cost){say('You need '+cost+' '+from+'.');return;}if(st.stock[to]+gain>80+st.levels.hall*80){say('Make room in settlement storage first.');return;}st.stock[from]-=cost;st.stock[to]+=gain;saveGame();ui();say('Trade complete · '+gain+' '+to+'.');}
function npcStoryInteract(o){if(!o.id.startsWith('npc_'))return false;if(npcStoryDefs[o.id]){openNpcStory(o.id);return true;}if(o.id==='npc_ledger'||o.id==='npc_testimony'){const s=npcStoryState('npc_mara');if(!s.accepted){say('Speak to Mara at Hearthstead’s western camp first.');return true;}if(!journalCanAccept('npc_mara'))return true;const key=o.id==='npc_ledger'?'ledger':'nell';s.evidence=s.evidence||[];if(!s.evidence.includes(key))s.evidence.push(key);saveGame();openFrontierDialog(key==='ledger'?'The Raiders’ Record':'Nell’s Account',key==='ledger'?'The ledger lists Mara as a supplier. Beside the last entry: “Gate key missing. Families escaped. Hold the tool carrier for questioning.”':'“She worked for them. She also came back for us. I cannot make that simple for you.”',[{label:'Remember this account',action:()=>{ui();}}]);return true;}if(o.id==='npc_convoy'){const s=npcStoryState('npc_sera');if(!s.accepted){say('Speak to Sera at the western camp first.');return true;}if(!journalCanAccept('npc_sera'))return true;if(maps.frontier_quarry.enemies.some(e=>e.npcRaid&&e.alive)){say('Clear the road extortionists before recovering the convoy supplies.');return true;}s.convoy=true;saveGame();ui();say('Supplies recovered. Return to Sera to decide their destination.');return true;}return true;}
function drawNpcStories(){if(mapId==='frontier_outpost'){paintSurface('dirt',-750,400,520,85);paintArt('tent',-760,175,115,95);paintArt('tent',-390,175,115,95);const m=townQuestState.npc_mara;if(m?.choice!=='exile')drawDetailedVillager({x:-650,y:440,name:'Mara the Smith'});else standArt('crate',-650,440,35);drawLocationLabel(-650,375,m?.choice==='exile'?'MARA’S EMPTY CAMP':'MARA');drawDetailedVillager({x:-350,y:440,name:'Sera the Traveler'});drawLocationLabel(-350,375,'SERA');if(townQuestState.npc_sera?.choice==='divert'&&!townQuestState.npc_sera.repaired)drawLocationLabel(190,345,'FOOD SHORTAGE · HALF PRODUCTION');}if(mapId==='frontier_quarry'){standArt('crate',730,440,45);drawLocationLabel(730,380,'RAIDERS’ LEDGER');standArt('crate',150,310,48);drawLocationLabel(150,250,'STRANDED CONVOY');}}

// Three commitments: one main chapter, one personal story, one optional task.
const journalMainOrder=['camp_caller','briar_hollow','main_hunt','main_seals','main_rune','main_maze','main_heart','main_vault','story_embercrypt','story_tidevault','story_stormspire','story_hollowcrown'];
let journalTab='active';const journalExpanded=new Set();
function journalKind(id){return journalMainOrder.includes(id)?'main':id.startsWith('npc_')||id==='frontier_hearth'||id==='frontier_memory'||!!townQuestDefs[id]||id.startsWith('epilogue_')?'personal':'optional';}
function journalLabel(id){const i=journalMainOrder.indexOf(id);return i>=0?'◆ MAIN STORY · CHAPTER '+(i+1):journalKind(id)==='personal'?'PERSONAL STORY':'OPTIONAL TASK';}
function journalState(){return townQuestState._journal||(townQuestState._journal={paused:{}});}
function journalPaused(id){return !!journalState().paused?.[id];}
function journalAccepted(q){if(q.done)return false;if(journalMainOrder.includes(q.id))return q.id===journalMainOrder.find(id=>{const r=questCatalogRaw().find(x=>x.id===id);return r&&!r.done;});if(q.id==='main_caches'||q.id==='slayer_intro')return false;if(q.id.startsWith('epilogue_'))return !!townQuestState[q.id]?.accepted;if(q.id==='frontier_bells')return !!frontierState().mystery;if(q.id==='frontier_memory')return !!memoryState().accepted;return !!q.active;}
function questCatalog(){return [...campQuestEntries(),briarQuestEntry(),...questCatalogRaw(),...npcStoryEntries(),vampireQuestEntry()];}
function journalActiveRows(){const all=questCatalog(),next=journalMainOrder.find(id=>all.some(q=>q.id===id&&!q.done));return all.filter(q=>!q.done&&!journalPaused(q.id)&&!(q.id==='world_watchtower'&&frontierState().mystery&&!frontierState().blueprint&&!journalPaused('frontier_bells'))&&(journalMainOrder.includes(q.id)?q.id===next:journalAccepted(q)));}
function journalCanAccept(id){const all=questCatalog(),q=all.find(q=>q.id===id);if(q?.done)return true;if(journalPaused(id)){say('This quest is paused. Resume it from Quest Journal → Paused.');return false;}const current=journalActiveRows();if((id==='world_watchtower'&&current.some(q=>q.id==='frontier_bells'))||(id==='frontier_bells'&&current.some(q=>q.id==='world_watchtower')))return true;if(current.some(q=>q.id===id))return true;const kind=journalKind(id),conflict=current.find(q=>journalKind(q.id)===kind);if(current.length>=3||conflict){say(conflict?'Finish or pause '+conflict.title+' before accepting another '+(kind==='personal'?'personal story':'optional task')+'.':'You have three commitments. Finish or pause one before accepting another.');return false;}return true;}
function pauseJournalQuest(id){if(journalKind(id)==='main')return;const s=journalState();s.paused=s.paused||{};s.paused[id]=true;if(id==='frontier_bells'&&townQuestState.world_watchtower?.accepted&&!townQuestState.world_watchtower.claimed)s.paused.world_watchtower=true;if(trackedQuestId()===id)delete townQuestState._tracking;saveGame();ui();renderQuests();}
function resumeJournalQuest(id){const s=journalState();if(!s.paused?.[id])return;const current=journalActiveRows();if(current.length>=3||current.some(q=>journalKind(q.id)===journalKind(id))){say('Finish or pause the current '+(journalKind(id)==='personal'?'personal story':'optional task')+' before resuming this one.');return;}delete s.paused[id];if(id==='frontier_bells')delete s.paused.world_watchtower;saveGame();renderQuests();}
function journalCard(q){const g=questGuide(q),expanded=journalExpanded.has(q.id),tracked=trackedQuestId()===q.id;return '<article class="questEntry '+(tracked?'tracked ':'')+(journalKind(q.id)==='main'?'mainStory':'')+'"><div class="journalBadge">'+journalLabel(q.id)+(tracked?' · TRACKING':'')+'</div><button class="journalTitle" data-journal-detail="'+q.id+'" aria-expanded="'+expanded+'">'+questEscape(q.title)+' <span>'+(expanded?'−':'+')+'</span></button><p>'+questEscape(q.done?q.desc:g.detail)+'</p><div class="journalProgress">'+questEscape(q.done?'Recorded in your history':g.progress)+'</div>'+(expanded?'<div class="journalDetails"><p>'+questEscape(q.desc)+'</p><p>'+questEscape(q.reward)+'</p>'+(!q.done?'<div class="questTrackActions"><button data-track-quest="'+q.id+'">'+(tracked?'Stop tracking':'Track quest')+'</button>'+(g.destination?'<button data-quest-map="'+q.id+'">Show on map</button>':'')+(journalKind(q.id)!=='main'?'<button data-journal-'+(journalPaused(q.id)?'resume':'pause')+'="'+q.id+'">'+(journalPaused(q.id)?'Resume':'Pause')+'</button>':'')+'</div>':'')+'</div>':'')+'</article>';}
function renderQuests(){if(journalTab==='notes'){renderCampNotes();return;}const all=questCatalog(),active=journalActiveRows(),paused=all.filter(q=>!q.done&&journalPaused(q.id)),history=all.filter(q=>q.done);let body='';if(journalTab==='active'){const shown=[];for(const kind of ['main','personal','optional']){const q=active.find(q=>journalKind(q.id)===kind);if(q){shown.push(q.id);body+=journalCard(q);}else body+='<article class="questEntry journalEmpty"><div class="journalBadge">'+({main:'MAIN STORY',personal:'PERSONAL STORY',optional:'OPTIONAL TASK'})[kind]+'</div><p>'+ (kind==='main'?'This chapter is closed. The roads still hold unanswered questions.':'No '+(kind==='personal'?'personal story':'optional task')+' accepted. Discover one by talking to people in the world.')+'</p></article>';}const extra=active.filter(q=>!shown.includes(q.id));if(extra.length)body+='<details class="journalLegacy"><summary>Earlier commitments · '+extra.length+' preserved</summary>'+extra.map(journalCard).join('')+'</details>';}else body=(journalTab==='paused'?paused:history).map(journalCard).join('')||'<p class="journalEmpty">'+(journalTab==='paused'?'No paused quests.':'Your history will grow with your choices.')+'</p>';const markup='<nav class="journalTabs" aria-label="Journal sections">'+[['active','Current · '+active.length+'/3'],['paused','Paused · '+paused.length],['history','Completed'],['notes','Story notes']].map(([id,label])=>'<button data-journal-tab="'+id+'" aria-pressed="'+(journalTab===id)+'">'+label+'</button>').join('')+'</nav>'+body;const list=document.getElementById('questList');if(list._questMarkup!==markup){list.innerHTML=markup;list._questMarkup=markup;}}
function installFocusedJournal(){const el=document.getElementById('questScreen');el.querySelector('.screenHead p').textContent='One chapter. One personal story. One optional task.';el.querySelector('.screenNotice').textContent='Tap a title for details. Finish or pause a commitment before accepting another of its kind.';document.getElementById('questList').setAttribute('aria-label','Your quest commitments');el.querySelector('.screenFoot span').textContent='The world remembers what you choose.';el.addEventListener('click',event=>{const t=event.target.closest('[data-journal-tab],[data-journal-detail],[data-journal-pause],[data-journal-resume]');if(!t)return;if(t.dataset.journalTab){journalTab=t.dataset.journalTab;renderQuests();}else if(t.dataset.journalDetail){const id=t.dataset.journalDetail;journalExpanded.has(id)?journalExpanded.delete(id):journalExpanded.add(id);renderQuests();}else if(t.dataset.journalPause)pauseJournalQuest(t.dataset.journalPause);else resumeJournalQuest(t.dataset.journalResume);});}

// Offline, deterministic conversational agents. Responses never grant items or mutate quest outcomes.
let npcConversation=null;
const npcVoices={warm:{hello:'Come, take a breath.',unknown:'I’m not quite following you. Tell me plainly—are you asking about work, this place, or me?',thanks:'You’re welcome. A little kindness travels a long way.'},blunt:{hello:'You look like you have a question.',unknown:'You have lost me. Ask about the job, the road, or the town.',thanks:'Fair enough. Look after yourself.'},cautious:{hello:'Keep your voice down a moment. What is it?',unknown:'I would rather admit I do not know than send you the wrong way. Ask about something nearby.',thanks:'Just be careful out there.'},curious:{hello:'There you are. What have you found?',unknown:'That is beyond what I know. Perhaps ask about the people here, our work, or these roads?',thanks:'Tell me how it turns out, will you?'},practical:{hello:'A moment to talk? I can spare one.',unknown:'Let us start with what I can help with: my work, this place, or what has changed.',thanks:'Good. One less thing weighing on us.'}};
function npcAgentKey(n){return (n.dialogueId?'story':mapId)+'|'+String(n.dialogueId||n.name||n.questId||n.role||'resident');}
function npcAgentMemory(n){const all=townQuestState._npcTalk||(townQuestState._npcTalk={});const key=npcAgentKey(n);return all[key]||(all[key]={visits:0,turns:0,trust:0,lastTopic:'',history:[]});}
function npcPersonalities(){return {"Reeve Mara":{"town":"ashvale","voice":"practical","past":"I was a bridge mason before anyone asked me to govern. I still keep a plumb line in my desk; it is the only adviser that never flatters me.","want":"I want a gate that stays open after sunset. Safety should mean people can come home, not that we can keep them out.","secret":"I wrote the first evacuation order and never sent it. I feared panic more than I feared being wrong. Dalen was not the only one who hesitated.","hello":"Mind the loose step. I have put its repair ahead of my own office for three budgets running."},"Tilda the Trader":{"town":"ashvale","voice":"warm","past":"My father taught me to weigh grain. My mother taught me to notice when someone was pretending they were not hungry. The second lesson costs me more.","want":"I want the caravans moving again. A shelf full of iron is no good when the road has forgotten how to bring bread.","secret":"The chipped blue bowl behind my counter is for travelers who cannot pay. I call it damaged stock because people accept that more easily than charity.","hello":"Boots muddy, pockets light? Tell me what you brought, and we will count it properly."},"Mayor Tamsin":{"town":"brackenford","voice":"cautious","past":"I used to guide smugglers through the reeds. These days I stamp permits for roads I once avoided. The council finds that less funny than I do.","want":"I want our scouts to bring back warnings before they become funerals. Sylvi and I disagree about what people are ready to hear.","secret":"I still keep my old route book. Some names in it sit at my council table. I have not decided whether that makes me patient or a coward.","hello":"Take the chair facing the window. I like to know whether a visitor watches the door."},"Iva the Herbalist":{"town":"brackenford","voice":"blunt","past":"I learned remedies by writing down every treatment that failed. Oren says my notebooks would frighten customers. Good. Medicine deserves care.","want":"I want scouts to stop calling an infected cut a scratch. Bring me facts, clean silk and no heroic exaggerations.","secret":"I keep a page for my brother, although he has been gone twelve winters. Every new remedy still gets tested against what might have saved him.","hello":"If you say it is only a scratch, I shall ask to see it twice."},"Captain Harlan":{"town":"stonewatch","voice":"blunt","past":"I was a cook before I was a captain. Feeding thirty frightened people taught me more about command than a sword ever did.","want":"I want everyone on the wall to eat before taking watch. Hungry courage is an unreliable defense.","secret":"I cannot remember the voice of my first commander. I remember how she split her last loaf. That is the part I try to keep.","hello":"Have you eaten? That is a readiness question, not small talk."},"Healer Elowen":{"town":"stonewatch","voice":"warm","past":"My first patient was a guard who had spent years frightening me. His hand shook just like mine. I have tried to remember that ever since.","want":"I want the stores full enough that nobody has to prove they deserve care. Harlan counts shields; I count suppers.","secret":"I do get angry. When the same wound comes back for the third time, I have to choose kindness all over again. It is work, not a gift.","hello":"Sit if you need to. You do not have to look brave while I am counting bandages."},"Harbormaster Vale":{"town":"sunmere","voice":"practical","past":"I survived a wreck by clinging to a crate of useless silver ornaments. Ever since, I have asked merchants what their cargo is actually for.","want":"I want the beacon reliable and the pass open. The Arcanum can argue about wonders after the fishing boats get home.","secret":"I cannot swim. I learned every tide and harbor chain instead. Eryn knows, and has never made a joke of it.","hello":"Wind is turning. If you have bad news, give me the useful part first."},"Ilan the Arcanist Smith":{"town":"sunmere","voice":"curious","past":"I trained as a mage until a careless flame ruined my casting hand. Making staffs taught me patience that casting never did. I teach both now.","want":"I want you to know why a spell works before you make it larger. Ember changes a crowd, Frost buys time, and Arcane rewards choosing one place well.","secret":"The first staff I made was for Eryn. I told her the crooked grip was deliberate. She has kept it through every better one I offered.","hello":"Show me your hands. Ink, soot or blisters? All three are respectable beginnings."}}}
function npcPersonality(n){const d=npcPersonalities()[n.name];return d?.town===mapId?d:null}
// Relationships are derived from saved deeds, never awarded by opening dialogue.
function npcRelationship(n){
const reasons=[];let deeds=0;const add=(value,text)=>{deeds+=value;reasons.push(text);};
if(n.questId&&townQuestState[n.questId]?.claimed)add(2,'You finished the work I asked of you.');
if(mapId==='frontier_outpost'){
 const m=townQuestState.npc_mara,c=townQuestState.npc_sera;
 if(m?.claimed&&m.choice==='shelter'){
  if(n.npcStoryId==='npc_mara'||n.name==='Mara')add(2,'You gave me a home when you knew the truth about me.');
  else if(n.name==='Nell the Gardener')add(1,'You heard my account before giving Mara a place here. Forgiveness will take longer.');
 }
 if(m?.claimed&&m.choice==='exile'&&n.name==='Nell the Gardener')add(-1,'You sent Mara away. I still remember that she helped my family escape.');
 if(c?.claimed&&c.choice==='protect')add(2,'You brought the convoy food back to the families who needed it.');
 if(c?.claimed&&c.choice==='divert')add(c.repaired?0:-3,c.repaired?'You repaid the food you diverted. I recognize the repair, and I remember the hunger.':'You traded our food for stone. Bring Sera 12 food to repay the families.');
 if(n.dialogueId==='edda'&&townQuestState._frontier?.rescued)add(2,'You came back for me at the quarry.');
}
const relations=townQuestState._politics?.relations,standing=Number(relations?.[mapId])||0;
if(standing<=-20)add(-2,'Your settlement has unsettled people here. Speak at your council table about repairing relations.');
else if(standing>=20)add(standing>=40?2:1,'Your settlement has earned goodwill in this town.');
const tone=Math.max(-2,Math.min(3,Number(npcAgentMemory(n).trust)||0));
const score=deeds+Math.min(0,tone),label=score<0?'Wary':score>=2?'Trusted':score>0?'Warming':'Getting acquainted';
return {score,deeds,label,reasons,tone};
}
function npcRelationshipReply(n){const r=npcRelationship(n);return (r.reasons.length?r.reasons.join('\n\n'):'We are still getting to know one another. Give me time, and let your actions speak.')+(r.tone<0?'\n\nAnd I would like us to speak without insults.':'')}
function npcAgentProfile(n){if(n.vampireId)return vampireNpcProfile(n);const name=n.name||'Traveler',roles={healer:'healer',innkeeper:'innkeeper',huntmaster:'hunt warden',house_broker:'house broker',companion:'pet keeper'};let job=(n.workerId?workerDefs[n.workerId].job:null)||roles[n.role]||(n.shopId?'merchant':n.questId?'quest giver':'resident');let voice=['warm','blunt','cautious','curious','practical'][[...name].reduce((a,c)=>a+c.charCodeAt(0),0)%5],past='I make my life here in '+activeMap.name+'. Most days it is the small jobs that keep us going.';
if(n.npcStoryId==='npc_mara'||name==='Mara'){voice='cautious';job='salvage worker';past='I carried tools for the raiders. I also opened the gate for Nell’s family. I do not expect one truth to erase the other.';}
else if(/Sera/.test(name)){voice='practical';job='courier';past='I carry food and letters between settlements. A delivery is somebody’s supper, or the word they have been waiting for.';}
else if(/Edda/.test(name)){voice='blunt';job='carpenter';past='I kept the old foundation plans when the raiders took me. A sound roof matters more to me than a grand promise.';}
else if(/Nell/.test(name)){voice='warm';job='gardener';past='My family escaped the raiders. I am trying to grow a life here that is about more than getting away.';}
else if(/Tomas/.test(name)){voice='curious';job='wayfarer';past='I followed Hearthstead’s light when I thought the safe roads were gone. I still listen to what travelers bring back.';}
else if(/Iona/.test(name)){voice='warm';job='riverkeeper';past='I carried an oar for a river that was no longer there. Now I can put it to use again.';}
else if(/Orren/.test(name)){voice='cautious';job='lanternkeeper';past='I kept listening for travelers on a road the maps had forgotten. Your light gave me a way home.';}
else if(n.lines?.length){past=String(n.lines[0]);}
const personal=npcPersonality(n);if(personal){voice=personal.voice;past=personal.past;}const harmed=townQuestState.npc_sera?.choice==='divert'&&!townQuestState.npc_sera.repaired;return {name,job,voice,past,mood:mapId==='frontier_outpost'&&harmed?'worried':npcAgentMemory(n).trust<0?'guarded':npcAgentMemory(n).visits>1?'familiar':'attentive'};}
function npcIntent(text){const t=text.toLowerCase().trim();if(/think of me|between us|our relationship|remember about me|do you trust me/.test(t))return 'relationship';if(/secret|confide|not telling|trust me/.test(t))return 'confidence';if(/hope|wish|dream|keeps you|want most/.test(t))return 'hopes';if(/spell|mastery|arcanum|specialization/.test(t))return 'spell study';if(/barter|stock|scarcity|supplies/.test(t))return 'town supplies';if(/\b(mara|raider|exile)\b/.test(t))return 'Mara';if(/\b(sera|convoy|food|hunger|reparation)\b/.test(t))return 'the convoy';if(/\b(river|iona|orren|lantern|bell|memory)\b/.test(t))return 'the valley';if(/\b(thank|thanks|appreciate|sorry)\b/.test(t))return 'kindness';if(/\b(stupid|idiot|shut up|hate you)\b/.test(t))return 'insult';if(/\b(quest|job|work|task|help|reward)\b/.test(t))return 'work';if(/\b(buy|sell|trade|shop|heal|healing|pet|house|tavern|hunt)\b/.test(t))return 'services';if(/\b(who|name|past|yourself|story|family)\b/.test(t))return 'their past';if(/\b(where|road|way|direction|lost)\b/.test(t))return 'directions';if(/\b(news|town|place|changed|rumor|rumour|here)\b/.test(t))return 'local news';if(/\b(hello|hi|hey|how are|how do you feel)\b/.test(t))return 'greeting';return 'unknown';}
function npcKnownWork(n){if(n.workerId)return workerDefs[n.workerId].detail+' Choose Manage my town job to see my progress.';const id=n.npcStoryId||n.questId;if(id&&npcStoryDefs[id]){const s=npcStoryState(id);if(s.claimed)return npcStoryConsequence(id);if(id==='npc_sera'&&!npcStoryState('npc_mara').claimed)return 'Settle Mara’s story first. Her knowledge could change what happens on my route.';return s.accepted?npcStoryObjective(id):'I have a personal matter to discuss: '+npcStoryDefs[id].title+'. Choose “Discuss my request” if you want to hear it. Talking does not accept it.';}if(n.questId&&townQuestDefs[n.questId]){const d=townQuestDefs[n.questId],s=townQuestState[n.questId];if(s?.claimed)return 'You finished '+d.title+'. I have not forgotten the help.';if(d.requires&&!townQuestState[d.requires]?.claimed)return 'Finish '+townQuestDefs[d.requires].title+' first. We will talk about what comes next afterward.';return s?.accepted?questGuide(questCatalog().find(q=>q.id===n.questId)).detail:'I could use help with '+d.title+'. '+d.desc+' Choose “Discuss my request” when you are ready.';}if(n.dialogueId==='edda')return frontierObjective();if(n.dialogueId==='memory_resident')return memoryObjective();if(n.role==='huntmaster')return 'The hall has monster contracts. Inspect the board before accepting one; a hunt uses your optional-task slot.';return 'I have no quest to offer you right now. Speak to people with a request when you have room for another commitment.';}
function npcLocalNews(n){const personal=npcPersonality(n);if(personal){if(n.name==='Ilan the Arcanist Smith'&&player.class==='mage'&&Object.values(mageStudy().ranks).some(r=>r>0))return 'Your '+mageSchools()[mageStudy().school].name+' studies are showing. Remember: mastery is what you learn from a fight, not what you pay for.';const stock=townStock(mapId);if(stock.items[personal.town==='stonewatch'?'river_fish':townBarterDefs()[mapId].resource]===0)return 'Our specialty reserve is empty. I can still talk, but I cannot promise goods we do not have. The next delivery will help.';if(huntRewarded)return 'People have heard about your First Hunt. '+personal.want;return personal.want;}const p=politicsState();if(mapId==='frontier_outpost'&&p.phase!=='peace')return politicsStatus()+' Speak at the council table southeast of the town center.';const s=townQuestState.npc_sera,m=townQuestState.npc_mara;if(mapId==='frontier_outpost'){if(s?.choice==='divert'&&!s.repaired)return 'People are going hungry after the convoy’s food was traded for stone. The Garden is producing half its usual food. Sera says 12 food would repay the families.';if(s?.repaired)return 'The food has been repaid, and the Garden is recovering. That helps. People still remember why it was needed.';if(s?.choice==='protect')return 'The convoy’s food reached its families. Sera has opened an exchange at the western camp.';if(m?.choice==='exile')return 'Mara’s camp is empty. Sera has lost someone who knew the raiders’ routes.';if(m?.choice==='shelter')return 'Mara has been given a place here. Nell has not forgotten either what she did or who she helped.';if(frontierState().complete)return 'The hearth is lit and families have arrived. There are people with stories to tell at the western camp.';return 'The old hall needs a carpenter. The workboard tells you what has happened.';}if(npcAgentMemory(n).lastTopic==='local news'&&n.lines?.length>1)return String(n.lines[1]);return n.lines?.length?String(n.lines[0]):'I know '+activeMap.name+' better than distant rumors. Ask the people you meet here what they need.';}
function npcReply(n,text){if(n.vampireId)return vampireNpcReply(n,text);const mem=npcAgentMemory(n),p=npcAgentProfile(n),v=npcVoices[p.voice];let topic=npcIntent(text);if(/^(why|how so|tell me more|what do you mean)[?.! ]*$/i.test(text.trim())&&mem.lastTopic)topic=mem.lastTopic;let reply='';const repeat=mem.lastTopic===topic&&topic!=='unknown';if(topic==='relationship')reply=npcRelationshipReply(n);else if(topic==='hopes')reply=npcPersonality(n)?.want||'I want the people who depend on me to have a quieter tomorrow.';else if(topic==='confidence'){const d=npcPersonality(n);reply=d?(mem.visits>=3&&npcRelationship(n).score>=2?d.secret:'I need time and a reason to trust you. Helping with my work or building goodwill here means more than kind words.'):'Some stories take more time to tell. Ask me about my work first.';}else if(topic==='spell study')reply=n.name==='Ilan the Arcanist Smith'?'Training takes more than a high level. Defeat worthy monsters yourself to earn mastery, then study Ember, Frost or Arcane here in Sunmere. Your pet cannot learn the lesson for you.':'Ilan teaches spell specializations at Sunmere’s Arcanum. He will explain what you need.';else if(topic==='town supplies'){const d=townBarterDefs()[mapId];reply=d?'Our specialty is '+itemDefs[d.resource].name+'. We have '+townStock(mapId).items[d.resource]+' in reserve. Bring materials to Town barter; the next delivery is due in '+Math.ceil(townStock(mapId).remaining/60)+' active minutes.':'The four original towns trade their specialties. Ask their traders about supplies.';}else if(topic==='Mara'){const s=townQuestState.npc_mara;reply=s?.claimed?npcStoryConsequence('npc_mara'):mapId==='frontier_outpost'?'Mara is at the western camp. Nell and the quarry ledger each hold part of her story. Hear both before you judge.':'I do not know enough about her to judge. Ask around Hearthstead.';}else if(topic==='the convoy'){reply=townQuestState.npc_sera?.claimed?npcStoryConsequence('npc_sera'):townQuestState.npc_sera?.accepted?npcStoryObjective('npc_sera'):'Sera knows the supply roads. Ask her at Hearthstead’s western camp; I will not guess what she has found.';}else if(topic==='the valley'){const s=frontierState().memory;reply=s?.choice?(s.choice==='river'?'Water has returned to the vale. Iona has made a home in Hearthstead. The old lantern road remains quiet.':'The lantern road is lit, and Orren has reached Hearthstead. The riverbed is still dry.'):s?.accepted?'The valley holds three accounts: a cradle, a ferry, and a lantern. Listen before deciding what the bell should remember.':'I have not learned that story. The old well and Hearthstead’s east road may be places to ask.';}else if(topic==='work')reply=npcKnownWork(n);else if(topic==='services')reply=npcServiceLabel(n)?'Choose “'+npcServiceLabel(n)+'” below. We can discuss the details there.': 'I am not a shopkeeper or a healer. I can talk, but I cannot offer that service.';else if(topic==='their past')reply=p.past;else if(topic==='directions')reply=mapId==='frontier_outpost'?'The workboard is in the old center. Mara and Sera camp to the west. The quarry is east of the hall; the Remembering Vale is farther east. The memory garden is southeast.':n.questId?npcKnownWork(n):'You are in '+activeMap.name+'. MAPS shows the surrounding regions; your tracked quest names its next destination.';else if(topic==='local news')reply=npcLocalNews(n);else if(topic==='kindness'){mem.trust=Math.min(3,(mem.trust||0)+1);reply=v.thanks;}else if(topic==='insult'){mem.trust=Math.max(-2,(mem.trust||0)-1);reply='You can speak to me without that. If you need something, ask plainly.';}else if(topic==='greeting')reply=p.mood==='worried'?'Worried, if you want the truth. It is hard to think about tomorrow when people are hungry.':mem.trust<0?'I am willing to talk. Let us keep it civil.':mem.visits>1?'I am glad you came back, '+player.name+'. There is comfort in seeing a familiar face.':v.hello+' I am '+p.name+'.';else reply=v.unknown;
if(topic==='Mara'&&mapId==='frontier_outpost'){const choice=townQuestState.npc_mara?.choice;if(/Nell/.test(p.name))reply=choice==='exile'?'You sent her away. I understand why. I still remember the hand that opened our gate.':choice==='shelter'?'I am glad she has a bed. I am not ready to pretend none of it happened. Let her show us who she is now.':'She worked for them. She also came back for us. Hear the ledger and my account; neither one is the whole woman.';else if(/Mara/.test(p.name))reply=choice==='shelter'?'You let me stay. I know that is not the same as forgiveness. I can start by making the roads safer for Sera.':'I cannot ask you to forget what I did. Only to hear Nell as well as the people who put my name in that book.';else if(/Sera/.test(p.name))reply=choice==='shelter'?'She knows the raiders’ blind approach. That warning could keep two of them away from my convoy.':choice==='exile'?'I cannot use knowledge we sent away. We will have to face all five of them.':'Before I trust the quarry road, I need to know whether Mara will be here to advise us.';}
if(repeat){const previous=mem.history?.at(-1)?.reply;if(previous===reply){const followups=topic==='work'?[npcKnownWork(n),'We do not have to settle it this minute. Check your journal, then come back when you are ready.']:topic==='their past'?['That is as much of my past as I am ready to share. What matters to me now is '+(p.job==='gardener'?'giving these families a place to grow.':p.job==='courier'?'getting the next delivery home.':'doing my part here.'),'I would rather hear what you have found on the road. Ask me about the town, and we can compare what we know.']:topic==='greeting'?['A little better for having someone to talk to. What brought you back?','Still here, still doing what I can. Some days that is enough.']:topic==='Mara'?['One decision will not make every memory agree. Listen to the people who lived through it.','What happens next matters too. Sera is the one who must travel that road.']:topic==='directions'?['Your tracked quest gives the next destination. There is no need to take every road today.']:['That is what I know so far. If something changes, ask me again.','I do not want to dress an old rumor up as new news. Is there something else on your mind?'];reply=followups[(mem.turns||0)%followups.length];if(reply===previous)reply=followups.find(x=>x!==previous)||v.unknown;}}
if(/Sera/.test(p.name))reply=reply.replaceAll('Sera opened a supply exchange','I opened a supply exchange').replaceAll('Sera reopened her exchange','I reopened my exchange').replaceAll('Bring Sera 12 food','Bring me 12 food').replaceAll('The journal keeps both decisions.','I remember both decisions.').replaceAll('Return to Sera at Hearthstead’s western camp.','Come back to me at the western camp.');mem.lastTopic=topic;mem.turns=Math.min(10000,(mem.turns||0)+1);mem.history=Array.isArray(mem.history)?mem.history:[];mem.history.push({ask:String(text).slice(0,180),reply,topic});mem.history=mem.history.slice(-3);saveGame();return reply;}
function npcServiceLabel(n){if(n.workerId)return 'Manage my town job';if(n.npcStoryId||n.questId||n.dialogueId==='edda'||n.dialogueId==='memory_resident'||n.worldObject)return 'Discuss my request';return ({healer:'Ask for healing',innkeeper:'Enter the tavern',huntmaster:'Visit the Slayers Hall',house_broker:'Discuss a home',companion:'Visit the pet sanctuary'})[n.role]||(n.shopId?'Browse the shop':null);}
function npcPerformService(n){if(n.workerId)return openWorker(n.workerId);if(n.worldObject)return worldObjectInteract(n.worldObject);if(n.role==='huntmaster')return openSlayersHall();if(n.role==='innkeeper')return openTavern();if(n.role==='healer')return healAtTown(n);if(n.role==='house_broker')return interactHouseBroker(n);if(n.role==='companion')return interactCompanion(n);if(n.questId)return interactQuest(n);if(n.shopId)return openShop(n.shopId);}
function npcWorldPerson(o){if(o.id==='npc_mara'&&townQuestState.npc_mara?.choice!=='exile')return {name:'Mara',npcStoryId:'npc_mara',worldObject:o};if(o.id==='npc_sera')return {name:'Sera',npcStoryId:'npc_sera',worldObject:o};if(o.id==='npc_testimony')return {name:'Nell the Gardener',worldObject:o};if(o.id==='frontier_carpenter_home'&&frontierState().home||o.id==='frontier_carpenter'&&!frontierState().rescued)return {name:'Edda the Carpenter',dialogueId:'edda',worldObject:o};if(o.id==='memory_resident'&&memoryState().choice)return {name:memoryState().choice==='river'?'Iona the Riverkeeper':'Orren the Lanternkeeper',dialogueId:'memory_resident',worldObject:o};if(o.id==='crossroads_medicine')return {name:'The Wounded Traveler',worldObject:o};if(o.id==='prisoner_cage'&&!townQuestState.world_rescue?.claimed)return {name:'The Captive Traveler',worldObject:o};return null;}
function openNpcConversation(n){const mem=npcAgentMemory(n),p=npcAgentProfile(n);mem.visits=Math.min(1000,(mem.visits||0)+1);npcConversation={npc:n,map:mapId,key:npcAgentKey(n)};const greeting=mem.visits>1?'Back again, '+player.name+'.'+(mem.lastTopic&&mem.lastTopic!=='unknown'?' Last time we spoke about '+mem.lastTopic+'.':'')+' '+(p.mood==='worried'?'People here have a lot on their minds.':npcVoices[p.voice].hello):npcVoices[p.voice].hello+' I am '+p.name+'.';npcConversation.greeting=npcPersonality(n)?npcPersonality(n).hello+(mem.visits>1?' Good to see you again, '+player.name+'.':''):greeting;const changeKey=JSON.stringify([!!townQuestState[n.questId]?.claimed,townQuestState.npc_mara?.choice,townQuestState.npc_sera?.choice,!!townQuestState.npc_sera?.repaired]);if(mem.worldSeen!==changeKey){if(n.questId&&townQuestState[n.questId]?.claimed)npcConversation.greeting=player.name+', you saw that job through. Thank you. I remember who helped.';else if(mapId==='frontier_outpost'&&townQuestState.npc_sera?.claimed)npcConversation.greeting=npcLocalNews(n);else if(n.npcStoryId==='npc_mara'&&townQuestState.npc_mara?.choice==='shelter')npcConversation.greeting='You gave me a place here, '+player.name+'. I intend to make that mean something.';mem.worldSeen=changeKey;}if(n.vampireId)npcConversation.greeting=vampireNpcGreeting(n);saveGame();renderNpcConversation();}
function renderNpcConversation(){const c=npcConversation;if(!c||c.map!==mapId)return;const n=c.npc,mem=npcAgentMemory(n),p=npcAgentProfile(n),service=npcServiceLabel(n);openFrontierDialog(p.name+' · '+p.job,'',[...(n.vampireId?[{label:'What happened in the raid?',action:()=>askNpc('What happened in the raid?')},{label:'What about Ada?',action:()=>askNpc('What about Ada?')},{label:'The stranger in the black cloak',action:()=>askNpc('Who was the stranger in the black cloak?')}]:[]),...(service?[{label:service,action:()=>npcPerformService(n)}]:[]),...(npcPersonality(n)?[{label:'What keeps you here?',action:()=>askNpc('What keeps you here?')},{label:'Anything you would confide in me?',action:()=>askNpc('Will you confide in me?')}]:[]),...(n.name==='Ilan the Arcanist Smith'&&player.class==='mage'?[{label:'Study mage spells',action:openMageStudy}]:[]),...(townBarterDefs()[mapId]&&n.shopId?[{label:'Barter town supplies',action:()=>openTownBarter()}]:[]),{label:'Where do we stand?',action:()=>askNpc('What do you think of me?')},{label:'How are you?',action:()=>askNpc('How are you?')},{label:'Any news around here?',action:()=>askNpc('Any news around here?')},{label:'Tell me about yourself',action:()=>askNpc('Tell me about yourself')},{label:'Goodbye',action:()=>{npcConversation=null;}}]);const panel=document.getElementById('adventureScreen');panel.classList.add('npcTalkView');panel.querySelector('.screenFoot').textContent='Talking does not accept quests or spend supplies.';const text=document.getElementById('adventureText');text.innerHTML=(n.vampireId?'<canvas id="vampireNpcPortrait" width="160" height="180" role="img" aria-label="'+questEscape(n.name)+' speaking" style="float:right;width:80px;height:90px;margin:0 0 8px 10px;pointer-events:none"></canvas>':'')+'<div class="npcMood">'+questEscape(p.mood)+' · '+questEscape(npcRelationship(n).label)+'</div><p class="npcGreeting">'+questEscape(c.greeting)+'</p><div class="npcChatHistory" role="log" aria-live="polite">'+(mem.history||[]).map(h=>'<div class="npcChatTurn"><p class="npcQuestion">'+questEscape(player.name)+': '+questEscape(h.ask)+'</p><p>'+questEscape(h.reply)+'</p></div>').join('')+'</div><form id="npcChatForm"><label for="npcQuestionInput">Ask about their work, their past, or the world</label><div><input id="npcQuestionInput" name="question" type="text" maxlength="180" autocomplete="off" placeholder="What news have you heard?"><button type="submit">Ask</button></div></form>';const latest=text.querySelector('.npcChatTurn:last-child');text.scrollTop=latest?Math.max(0,latest.getBoundingClientRect().top-text.getBoundingClientRect().top+text.scrollTop-14):0;}
function askNpc(text){if(!npcConversation||npcConversation.map!==mapId)return;const clean=String(text||'').trim().slice(0,180);if(!clean)return;npcReply(npcConversation.npc,clean);renderNpcConversation();}
function installNpcConversations(){document.getElementById('adventureScreen').addEventListener('submit',e=>{if(e.target.id!=='npcChatForm')return;e.preventDefault();askNpc(document.getElementById('npcQuestionInput').value);});}

const fishingSpotCoords={ashvale:[[700,145]],whisperwood:[[640,430]],brackenford:[[175,385]],redfen:[[460,195],[780,430]],stonewatch:[[790,390]],highmoor:[[490,500]],sunmere:[[825,390]],frostmarch:[[430,470]],sunharbor:[[740,470],[220,455]],greenhollow:[[480,495]],crowfield:[[770,470]],willowfen:[[470,495]]};
for(const id of Object.keys(newWorldRegions))fishingSpotCoords[id]=[[980,480]];
// Keep full scenery footprints clear of roofs, signs, NPCs, and town paths.
const townOutlyingHouses=[[-420,-245,122,94],[-115,-245,122,94],[760,-245,122,94],[1190,-245,122,94],[-420,575,122,94],[-115,575,122,94],[760,575,122,94],[1190,575,122,94]];
const OPEN_WORLD_WIDTH=3840,OPEN_WORLD_HEIGHT=2400,OPEN_WORLD_ORIGIN_X=1440,OPEN_WORLD_ORIGIN_Y=900;
function townPathRects(town){
 const ox=OPEN_WORLD_ORIGIN_X,oy=OPEN_WORLD_ORIGIN_Y;
 const roads=[[-ox,274,OPEN_WORLD_WIDTH-ox,374],[455,-oy,505,OPEN_WORLD_HEIGHT-oy]];
 for(const y of [-58,694])roads.push([-ox,y,OPEN_WORLD_WIDTH-ox,y+42]);
 for(const x of [-177,1125])roads.push([x,-oy,x+42,OPEN_WORLD_HEIGHT-oy]);
 const used=new Set(town.npcs.map(n=>n.frontage));used.add('classHome');
 for(const key of used){const f=townFrontages[key];if(!f)continue;const d=townDoor(f);
  const street=f.y<0?-37:f.y<300?316:f.y<550?550:715;
  roads.push([d.x-16,Math.min(d.y,street),d.x+16,Math.max(d.y,street)+8]);
  if(f.y>=300&&f.y<550)roads.push([Math.min(d.x,480)-16,534,Math.max(d.x,480)+16,566]);
 }
 return roads;
}
function drawTownGround(){
 for(const [x0,y0,x1,y1] of townPathRects(activeMap))drawTileField(6,0,x0,y0,x1,y1,32);
}
function townSceneryAreas(town){
 const used=new Set(town.npcs.map(n=>n.frontage));used.add('classHome');
 const areas=[...used].map(key=>{const f=townFrontages[key];return [f.x-24,f.y-32,f.x+f.w+24,f.y+f.h+18]});
 for(const [x,y,w,h] of townOutlyingHouses)areas.push([x-24,y-32,x+w+24,y+h+18]);
 for(const obj of town.worldObjects||[])areas.push([obj.x-80,obj.y-80,obj.x+80,obj.y+35]);
 for(const n of town.npcs)areas.push([n.x-38,n.y-66,n.x+38,n.y+26]);
 for(const r of townPathRects(town))areas.push([r[0]-8,r[1]-8,r[2]+8,r[3]+8]);
 // Decorative props and outlying garden plots also need clear footprints.
 for(const [x,y] of [[-70,110],[975,110],[-70,470],[975,470],[650,110]])areas.push([x-28,y-32,x+28,y+24]);
 for(const [x,y] of [[-280,-95],[970,-95]])areas.push([x-51,y-22,x+51,y+28]);
 // Central well and town sign, market stalls, lamps, garden beds.
 areas.push([610,145,695,245],[245,247,326,315],[640,247,722,315],[212,224,242,313],[720,224,750,313]);
 for(const [x,y] of [[320,260],[610,260],[320,600],[650,600]])areas.push([x-28,y-16,x+28,y+14]);
 return areas;
}
function sceneryRect(x,y,kind){return kind==='tree'?[x-32,y-36,x+32,y+28]:kind==='water'?[x-52,y-32,x+52,y+32]:[x-20,y-20,x+20,y+20]}
function rectsOverlap(a,b){return a[0]<b[2]&&a[2]>b[0]&&a[1]<b[3]&&a[3]>b[1]}
for(const id of ['ashvale','brackenford','stonewatch','sunmere']){
 const town=maps[id],reserved=townSceneryAreas(town);
 for(const [kind,points] of [['water',fishingSpotCoords[id]||[]],['tree',town.trees],['rock',town.stones]])for(const point of points){
  const clear=(x,y)=>!reserved.some(area=>rectsOverlap(sceneryRect(x,y,kind),area));
  if(!clear(...point)){
   let best=null,distance=Infinity;
   for(let y=-250;y<=850;y+=40)for(let x=-430;x<=1390;x+=40){const d=Math.hypot(x-point[0],y-point[1]);if(d<distance&&clear(x,y)){best=[x,y];distance=d}}
   if(!best)throw new Error('No clear town scenery space: '+id);point[0]=best[0];point[1]=best[1];
  }
  reserved.push(sceneryRect(...point,kind));
 }
}
for(const id of Object.keys(maps).filter(id=>!maps[id].town&&maps[id].worldObjects?.length)){
 const m=maps[id],areas=id==='northridge'?[[390,70,570,260]]:id==='meadowroad'?[[230,80,415,220],[530,60,710,210],[710,135,790,255]]:[];
 for(const obj of m.worldObjects){const portal=obj.id.startsWith('story_portal_');areas.push([obj.x-(portal?115:45),obj.y-(portal?132:80),obj.x+(portal?115:45),obj.y+30])}
 for(const [kind,points] of [['tree',m.trees],['rock',m.stones],['water',fishingSpotCoords[id]||[]]])for(const p of points){
  if(areas.some(a=>rectsOverlap(sceneryRect(...p,kind),a))){let spot=null,dist=Infinity;for(let y=-230;y<=830;y+=40)for(let x=-410;x<=1370;x+=40){const d=Math.hypot(x-p[0],y-p[1]);if(d<dist&&!areas.some(a=>rectsOverlap(sceneryRect(x,y,kind),a))){spot=[x,y];dist=d}}if(!spot)throw Error('No landmark scenery space');p[0]=spot[0];p[1]=spot[1]}
  areas.push(sceneryRect(...p,kind));
 }
}
// v1.81: one placement pass for the complete outdoor scenery footprints.
const marshSceneryPools={
 redfen:[[150,155,95,48],[460,195,125,58],[780,410,120,50],[315,455,90,40],[-370,-205,76,36],[170,-205,100,42],[920,-220,112,45],[1240,-85,80,34],[-385,490,96,40],[280,680,118,43],[850,685,82,34],[1240,535,112,46],[-120,515,66,32],[1080,175,74,33]],
 willowfen:[[165,190,95,45],[440,435,135,44],[755,190,115,52],[760,440,85,36]]
};
function outdoorRoadAreas(){return [[445,-600,515,1200],[-480,-58,1440,-4],[-480,260,1440,388],[-480,680,1440,734],[-180,-300,-126,900],[1100,-300,1154,900]]}

// Fixed scenery uses the same footprints for placement and movement.
function fixedSceneryAreas(id){
 if(id==='veilhaven')return veilhavenBuildings.map(([x,y,w,h])=>[x-5,y-35,x+w+5,y+h+30]);
 if(id==='briarhollow')return briarRuins.map(([x,y,w,h])=>[x,y,x+w,y+h]);
 const out=[];if(id==='frontier_outpost')out.push([1026,528,1117,578]);if(id==='frontier_outpost')out.push([-760,175,-645,270],[-390,175,-275,270]);if(id==='frontier_outpost')for(const [x,y,w,h] of Object.values(frontierPlots))out.push([x,y,x+w,y+h]);if(id==='frontier_quarry')out.push([200,200,400,234],[570,365,760,399]);
 if(id==='sunharbor')out.push([32,80,928,190]);
 if(id==='crowfield')out.push([408,105,552,270]);
 if(['frostmarch','glassridge'].includes(id))for(const [x,y] of [[160,150],[390,120],[675,160]])out.push([x-40,y-64,x+40,y+10]);
 if(id==='highmoor')for(const [x,y,w,h] of [[115,125,190,145],[580,70,170,170],[680,145,175,125],[260,410,170,135],[620,410,210,120],[-405,-232,168,118],[-105,-220,205,142],[930,-224,195,132],[1210,-168,160,125],[-405,440,188,138],[-90,690,205,128],[260,770,180,132],[925,430,208,140],[1220,770,168,125]])out.push([x,y,x+w,y+h]);
 if(maps[id].landmark==='watchtower')out.push([415,76,545,240]);
 if(maps[id].landmark==='bandit_camp')out.push([260,120,405,210],[560,100,705,190],[710,145,790,235]);
 return out;
}
function mapPlacementBlocked(id,x,y,r=14){
 const m=maps[id],outdoor=usesOpenWorld(id);
 const b=worldBounds(id);
 if(!Number.isFinite(x)||!Number.isFinite(y)||x<b.minX||x>b.maxX||y<b.minY||y>b.maxY)return true;
 if(storyDungeons[id]&&(x<68+r||x>892-r||y<76+r||(y>524-r&&Math.abs(x-480)>40-r)))return true;
 for(const [tx,ty] of m.trees||[])if(Math.hypot(x-tx,y-ty)<r+20)return true;
 for(const [tx,ty] of m.stones||[])if(Math.hypot(x-tx,y-ty)<r+14)return true;
 const areas=fixedSceneryAreas(id);
 if(m.interior){if(x<62+r||x>898-r||y<72+r||(y>528-r&&Math.abs(x-490)>25-r))return true;areas.push([638,120,792,312],[164,178,216,210],[799,183,851,215],[365,80,435,170]);}
 if(m.town){const used=new Set(m.npcs.map(n=>n.frontage));used.add('classHome');for(const key of used){const f=townFrontages[key];if(f)areas.push([f.x,f.y,f.x+f.w,f.y+f.h-6])}for(const [x,y,w,h] of townOutlyingHouses)areas.push([x,y,x+w,y+h]);areas.push([623,174,677,225],[252,265,322,305],[646,265,714,305]);}
 if(areas.some(a=>x>a[0]-r&&x<a[2]+r&&y>a[1]-r&&y<a[3]+r))return true;
 for(const [px,py,rx,ry] of [...(marshSceneryPools[id]||[]),...(fishingSpotCoords[id]||[]).map(p=>[...p,48,28])])if(((x-px)/(rx+r+3))**2+((y-py)/(ry+r+3))**2<1)return true;
 return false;
}
function safeMapPosition(id,x,y,r=14,occupied=[]){
 const free=(px,py)=>!mapPlacementBlocked(id,px,py,r)&&!occupied.some(p=>Math.hypot(px-p.x,py-p.y)<50);
 if(free(x,y))return {x,y};
 for(let radius=16;radius<=2200;radius+=16)for(let i=0;i<32;i++){const a=i*Math.PI/16,px=x+Math.cos(a)*radius,py=y+Math.sin(a)*radius;if(free(px,py))return {x:px,y:py};}
 throw Error('No safe placement in '+id);
}

function placeOutdoorScenery(){
 for(const [id,m] of Object.entries(maps)){
  if(m.frontier||m.town||m.interior||m.dungeon||storyDungeons[id]||['mosslight','emberdeep'].includes(id))continue;
  const expanded=worldGrid.flat().includes(id),limits=expanded?[-930,-550,1890,1160]:[32,42,928,558];const reserved=outdoorRoadAreas().concat(fixedSceneryAreas(id));if(id==='veilhaven')for(const n of m.npcs)reserved.push([n.x-85,n.y-65,n.x+85,n.y+50]);
  for(const obj of m.worldObjects||[]){const portal=obj.id.startsWith('story_portal_');reserved.push([obj.x-(portal?115:obj.piece!==undefined?22:obj.region?32:50),obj.y-(portal?132:obj.piece!==undefined?44:obj.region?64:80),obj.x+(portal?115:obj.piece!==undefined?22:obj.region?32:50),obj.y+(obj.region?16:35)])}
  if(m.landmark==='watchtower')reserved.push([390,65,575,255]);
  if(m.landmark==='bandit_camp')reserved.push([245,90,415,220],[545,70,720,210],[700,130,800,255]);
  const place=(point,rx,above,below)=>{
   const footprint=(x,y)=>[x-rx,y-above,x+rx,y+below];
   const clear=(x,y)=>x-rx>=limits[0]&&x+rx<=limits[2]&&y-above>=limits[1]&&y+below<=limits[3]&&!reserved.some(a=>rectsOverlap(footprint(x,y),a));
   if(!clear(point[0],point[1])){
    let best=null,distance=Infinity;
    for(let y=limits[1]+above;y<=limits[3]-below;y+=20)for(let x=limits[0]+rx;x<=limits[2]-rx;x+=20){const d=Math.hypot(x-point[0],y-point[1]);if(d<distance&&clear(x,y)){distance=d;best=[x,y]}}
    if(!best)throw Error('No clear outdoor scenery space: '+id);point[0]=best[0];point[1]=best[1];
   }
   reserved.push(footprint(point[0],point[1]));
  };
  for(const p of marshSceneryPools[id]||[])place(p,p[2]*1.07+8,p[3]*1.07+8,p[3]*1.07+18);
  for(const p of fishingSpotCoords[id]||[])place(p,60,38,42);
  for(const p of m.trees||[])place(p,38,42,34);
  for(const p of m.stones||[])place(p,25,25,25);
 }
}
placeOutdoorScenery();
// Expanded outskirts retain original landmarks and add resource clearings.
for(const id of ['ashvale','whisperwood','redfen','highmoor','frostmarch','brackenford','stonewatch','sunmere',...Object.keys(newWorldRegions)]){
 const m=maps[id];let index=0;
 for(let y=-490;y<=1090;y+=180)for(let x=-850;x<=1810;x+=190){
  if(x>=-480&&x<=1440&&y>=-300&&y<=900)continue;
  if(Math.abs(x-480)<85||Math.abs(y-315)<100||[-155,1125].some(v=>Math.abs(x-v)<65)||[-58,694].some(v=>Math.abs(y-v)<70))continue;
  const point=[x+((index%3)-1)*12,y+((index%2)*14)];
  (index++%4===0?m.stones:m.trees).push(point);
 }
}

for(const [id,m] of Object.entries(maps)){m.gatherNodes=[];if(!['ashvale','whisperwood','brackenford','redfen','stonewatch','highmoor','sunmere','frostmarch','glassridge','sunharbor','greenhollow','crowfield','willowfen','stonewatchroad',...Object.keys(newWorldRegions)].includes(id))continue;(m.trees||[]).forEach(([x,y],i)=>m.gatherNodes.push({id:'tree_'+i,skill:'woodcutting',x,y,readyAt:0}));(m.stones||[]).forEach(([x,y],i)=>m.gatherNodes.push({id:'rock_'+i,skill:'mining',x,y,readyAt:0}));(fishingSpotCoords[id]||[]).forEach(([x,y],i)=>m.gatherNodes.push({id:'water_'+i,skill:'fishing',x,y,readyAt:0}))}
for(const id of worldGrid.flat().filter(id=>!['mosslight','emberdeep'].includes(id))){const m=maps[id];for(let y=-760;y<=1370;y+=190)for(let x=-1280;x<=2250;x+=210){if(x>-940&&x<1910&&y>-560&&y<1190)continue;if(Math.abs(x-480)<85||Math.abs(y-315)<100||Math.abs(x+155)<65||Math.abs(x-1125)<65||Math.abs(y+58)<70||Math.abs(y-694)<70)continue;const wood=!!(Math.round(x+y)%3);(wood?m.trees:m.stones).push([x,y]);m.gatherNodes.push({id:'outer_'+x+'_'+y,skill:wood?'woodcutting':'mining',x,y,readyAt:0});}}
// Concentric world danger: outer towns -> borderlands -> heartland -> center.
const worldDangerLevels=[1,2,4,8,16];
worldGrid.forEach((row,y)=>row.forEach((id,x)=>{const m=maps[id],depth=4-Math.max(Math.abs(x-4),Math.abs(y-4));m.combatLevel=m.town||id==='frontier_outpost'?1:worldDangerLevels[depth];m.dangerBand=['Town outskirts','Borderlands','Heartland','Inner frontier','The center'][depth];m.recommended='Monster level '+m.combatLevel;if(m.respawnMs&&!m.town&&!m.dungeon)m.respawnMs=18000+m.combatLevel*2000;for(const e of m.enemies){e.combatBaseHp=Math.max(2,Math.ceil(e.hp*(m.combatLevel+1)/((m.level||1)+1)))}}));
function regionCombatLevel(id=mapId){return Math.max(1,maps[id]?.combatLevel||maps[id]?.level||1)}
// Regional variants retain quest species IDs; named story encounters keep authored behavior.
function monsterEcologies(){return {
 ashvale:{name:'Ironwood wilds',color:'#a8c77b',cue:'Woodland creatures brace before broad, slow strikes. Step out when they wind up.',names:{slime:'Ironbark Ash Slime',bat:'Canopy Bat',spider:'Bramble Weaver',skeleton:'Lost Watchman',bandit:'Timber Poacher',specter:'Hollowwood Wisp',ice:'Pale Bark Wisp'}},
 brackenford:{name:'Reedfen marshes',color:'#b9a3d8',cue:'Marsh hunters close quickly. Their longer ambush warning gives you time to dodge.',names:{slime:'Mire Slime',bat:'Reedwing Bat',spider:'Fen Stalker',skeleton:'Bog Revenant',bandit:'Marsh Cutpurse',specter:'Fenlight Wisp',ice:'Mist Wisp'}},
 stonewatch:{name:'Vigil highlands',color:'#d9c8a2',cue:'Graveyard creatures move slowly but sweep a wider area. Leave the marked circle.',names:{slime:'Gravemoss Slime',bat:'Belfry Bat',spider:'Crypt Weaver',skeleton:'Vigil Skeleton',bandit:'Oathless Deserter',specter:'Vigil Spirit',ice:'Pale Vigil Spirit'}},
 sunmere:{name:'Rimecoast',color:'#94ddec',cue:'Coastal creatures mark attacks from farther away. Frost hits briefly slow your movement; dodge the warning.',names:{slime:'Rime Slime',bat:'Frostwing Bat',spider:'Glassweb Weaver',skeleton:'Tidebound Skeleton',bandit:'Shore Raider',specter:'Beacon Wisp',ice:'Rime Wisp'}}
}}
worldGrid.forEach((row,y)=>row.forEach((id,x)=>{const m=maps[id];if(m.town||m.interior||m.dungeon||id==='frontier_outpost')return;const homes=[['ashvale',0,4],['brackenford',8,4],['stonewatch',4,8],['sunmere',4,0]],town=({whisperwood:'ashvale',redfen:'brackenford',highmoor:'stonewatch',frostmarch:'sunmere'})[id]||homes.sort((a,b)=>Math.hypot(x-a[1],y-a[2])-Math.hypot(x-b[1],y-b[2]))[0][0];m.ecology=town;for(const e of m.enemies){if(e.boss||e.eventRegion||e.wayfarerTrial!==undefined||e.storyBoss||e.townSiege||e.npcRaid)continue;const name=monsterEcologies()[town].names[e.kind];if(name){e.ecology=town;e.name=e.kind==='spider'&&id==='highmoor'?'Ruin Weaver':e.kind==='spider'&&id==='frostmarch'?'Ice Cave Weaver':name}}}));
function openBestiary(){const local=monsterEcologies()[activeMap.ecology];openAdventureDialog('Field bestiary',(local?'Here: '+local.name+' · Monster level '+enemyLevel()+'. '+local.cue+'\n\n':'')+Object.values(monsterEcologies()).map(d=>d.name+'\n'+d.cue+'\n'+Object.values(d.names).slice(0,5).join(', ')).join('\n\n')+vampireBestiaryText()+'\n\nRare Dread Wanderers are exceptions: watch their red level marker and avoid them until ready. Ordinary first-map monsters remain suitable for unarmed beginners.',[{label:'Return to adventure',action:()=>{}}])}

// Append optional encounters after authored enemies to preserve existing save indices.
for(const id of worldGrid.flat()){const m=maps[id];if(m.town||m.interior||m.dungeon||regionCombatLevel(id)<4||id==='frontier_outpost')continue;m.enemies.push({kind:'skeleton',name:'Dread Wanderer',roamingElite:true,combatLevel:regionCombatLevel(id)+20,x:-650,y:-420,hp:80,combatBaseHp:80,alive:false,seed:13,respawnAt:0})}
function tickRoamingElite(now=Date.now(),random=Math.random){
 const e=enemies.find(e=>e.roamingElite);if(!e||e.alive)return;
 if(!e.respawnAt){e.respawnAt=now+60000;return}if(now<e.respawnAt)return;
 e.respawnAt=now+180000;if(random()>=.25){saveGame();return}
 const corners=[[-650,-420],[1550,-420],[-650,1020],[1550,1020]],offset=Math.floor(random()*corners.length);
 for(let i=0;i<corners.length;i++){const [x,y]=corners[(i+offset)%corners.length],pos=safeMapPosition(mapId,x,y,18);if(Math.hypot(pos.x-player.x,pos.y-player.y)<450)continue;
 Object.assign(e,pos,{spawnX:pos.x,spawnY:pos.y,alive:true,hp:e.maxHp,respawnAt:0,windup:0,swing:null,stun:0,combatCool:2});say('DANGER: a level '+encounterLevel(e)+' Dread Wanderer roams the wilderness. Avoid the red marker.');saveGame();break}
}
for(const [id,d] of Object.entries(vampireMonsterDefs))maps[d.area].enemies.push({kind:'vampire',vampireType:id,name:d.name,combatLevel:d.level,combatBaseHp:d.hp,x:d.x,y:d.y,hp:d.hp,alive:true,seed:900+Object.keys(vampireMonsterDefs).indexOf(id),boss:!!d.boss});
for(const m of Object.values(maps))for(const e of m.enemies){e.spawnX=e.x;e.spawnY=e.y;e.baseHp=e.hp;e.maxHp=e.hp;e.respawnAt=e.respawnAt||0}
// Every map, including interiors, must declare a default entry and at least one exit.
const mapConnections={
 ashvale:{entries:{default:[480,340],from_home:[490,190],front_door:[490,190]},exits:[{trigger:'edge',side:'north',to:'glassridge'},{trigger:'edge',side:'east',to:'greenhollow'},{trigger:'edge',side:'south',to:'highmoor'},{trigger:'interact',x:490,y:130,radius:58,to:'ashvale_home',entry:'front_door',requires:'home_owned'},{trigger:'interact',x:850,y:315,radius:58,to:'whisperwood',entry:'from_ashvale'}]},
