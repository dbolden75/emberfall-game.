function validateMapConnections(){const errors=[];for(const [id,map] of Object.entries(maps)){const links=mapConnections[id];if(!links){errors.push(id+' is missing mapConnections');continue}if(!links.entries||!Array.isArray(links.entries.default))errors.push(id+' is missing a default entry');if(!Array.isArray(links.exits)||!links.exits.length){errors.push(id+' is missing exits');continue}if(map.town&&(!map.classHome||!classDefs[map.classHome]))errors.push(id+' is missing a valid classHome');for(const exit of links.exits){if(!maps[exit.to])errors.push(id+' points to unknown map '+exit.to);else if((exit.trigger!=='edge'||exit.edgeEntry==='named')&&!mapConnections[exit.to]?.entries?.[exit.entry])errors.push(id+' points to missing entry '+exit.to+'.'+exit.entry);if(exit.trigger==='edge'&&!['west','east','north','south'].includes(exit.side))errors.push(id+' has an invalid edge exit')}}return errors}
const mapConnectionErrors=validateMapConnections();if(mapConnectionErrors.length){console.error('Map connection setup needs attention:',mapConnectionErrors);document.documentElement.dataset.mapConnectionError='true'}
function mapEntry(id,entry='default'){return mapConnections[id]?.entries?.[entry]||maps[id]?.arrival||[480,315]}
function edgeMapEntry(id,side){const b=worldBounds(id),from=worldBounds(),vertical=side==='west'||side==='east',ratio=vertical?(player.y-from.minY)/(from.maxY-from.minY):(player.x-from.minX)/(from.maxX-from.minX),along=vertical?clamp(b.minY+ratio*(b.maxY-b.minY),b.minY+58,b.maxY-58):clamp(b.minX+ratio*(b.maxX-b.minX),b.minX+58,b.maxX-58);if(side==='west')return [b.minX+58,along];if(side==='east')return [b.maxX-58,along];if(side==='north')return [along,b.minY+58];return [along,b.maxY-58]}
function edgeSideAt(x,y,b){const edges=[['west',x-b.minX],['east',b.maxX-x],['north',y-b.minY],['south',b.maxY-y]].filter(e=>e[1]<=30&&mapConnections[mapId]?.exits.some(exit=>exit.trigger==='edge'&&exit.side===e[0])).sort((a,b)=>a[1]-b[1]);return edges[0]?.[0]||null}
function canUseMapExit(exit){if(exit.requires==='memory_chapter')return !!frontierState().complete;if(exit.requires==='frontier_rescue')return !!frontierState().accepted;if(exit.requires==='story_dungeon')return !storyPortalLock(exit.dungeon);if(exit.requires==='first_hunt')return !!done;if(exit.requires==='ember_sigil')return !!hasSigil;if(exit.requires==='home_owned')return ownsHome(activeMap.homeId);if(exit.requires==='fourfold_key')return !!hasFourfoldKey;if(exit.requires==='shrine_floor1')return !!hasSigil||!!maps.mosslight.chest?.open;if(exit.requires==='shrine_floor2')return !!maps.shrine_rootmaze.chest?.open;return true}
function takeMapExit(exit,edge=false){if(exit.to==='emberdeep'&&!deepQuestDone&&!maps.shrine_heart.treasure.opened&&!townQuestState._visited?.emberdeep){say('MAIN STORY: finish the Heart Chamber before entering Beneath Ashvale.');return true;}if(!canUseMapExit(exit)){const message=(exit.requires==='story_dungeon'?storyPortalLock(exit.dungeon):'')||exit.lockedMessage||(exit.requires==='home_owned'?'Speak with the local house broker first.':'The way is still sealed.');if(edge){if(!gateBlocked)say(message);gateBlocked=true}else say(message);return true}const [x,y]=exit.trigger==='edge'?(exit.edgeEntry==='named'?mapEntry(exit.to,exit.entry):edgeMapEntry(exit.to,{west:'east',east:'west',north:'south',south:'north'}[exit.side])):mapEntry(exit.to,exit.entry);if(!setMap(exit.to,x,y))return false;gateBlocked=false;say('Entered '+maps[exit.to].name+'.');saveGame();ui();return true}


