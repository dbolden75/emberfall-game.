 if(player.attack>0&&drawDetailedEffect('fx_Wind',player.x,player.y-20,1,1-player.attack/.32)){}else if(player.attack>0){ctx.strokeStyle='#ffdf86';ctx.lineWidth=4;ctx.beginPath();ctx.arc(player.x,player.y,34,-.9,1.15);ctx.stroke()}
 drawCombat();drawCombatFocus();
