};
// Keep home interaction and return points attached to the actual doorstep.
for(const id of ['ashvale','brackenford','stonewatch','sunmere']){
 const door=townDoor(townFrontages.classHome),entry=[door.x,door.y+28];
 maps[id].houseDoor=[door.x,door.y];
 mapConnections[id].entries.from_home=entry;
 if(mapConnections[id].entries.front_door)mapConnections[id].entries.front_door=entry;
 const exit=mapConnections[id].exits.find(e=>e.to===id+'_home');exit.x=door.x;exit.y=door.y;
}
// Generate reciprocal compass routes. Only the world border has no neighbor.
const worldPositions={};
worldGrid.forEach((row,y)=>row.forEach((id,x)=>{worldPositions[id]=[(x+.5)*100/row.length,(y+.5)*100/worldGrid.length];
 const links=mapConnections[id]||(mapConnections[id]={entries:{default:[480,315]},exits:[]});
 links.exits=links.exits.filter(e=>e.trigger!=='edge');
 for(const [side,dx,dy] of [['north',0,-1],['east',1,0],['south',0,1],['west',-1,0]]){
  const to=worldGrid[y+dy]?.[x+dx];if(!to)continue;
  const gate=to==='mosslight'?{requires:'fourfold_key',lockedMessage:'Complete all four companion stories to open Mosslight Shrine.'}:to==='emberdeep'?{requires:'ember_sigil',lockedMessage:'Find the Ember Rune before entering the Ashvault.'}:{};
  links.exits.push({trigger:'edge',side,to,...gate});
 }
}));
for(const [id,d] of Object.entries(storyDungeons)){const parent=mapConnections[d.parent];parent.entries['from_'+id]=[1040,240];parent.exits.push({trigger:'interact',x:1040,y:180,radius:55,to:id,entry:'default',requires:'story_dungeon',dungeon:id});mapConnections[id]={entries:{default:[480,450]},exits:[{trigger:'edge',side:'south',to:d.parent,entry:'from_'+id,edgeEntry:'named'},{trigger:'interact',x:480,y:550,radius:55,to:d.parent,entry:'from_'+id}]}}

maps.frontier_outpost.gatherNodes=maps.frontier_outpost.trees.map(([x,y],i)=>({id:'hearth_tree_'+i,skill:'woodcutting',x,y,readyAt:0}));
