ata:image/png;base64,"},"slime_die_down":{"w":64,"h":64,"n":7,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_idle_down":{"w":64,"h":64,"n":6,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_idle_up":{"w":64,"h":64,"n":6,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_walk_down":{"w":64,"h":64,"n":6,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_walk_up":{"w":64,"h":64,"n":6,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_walk_left":{"w":64,"h":64,"n":6,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_walk_right":{"w":64,"h":64,"n":6,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_hit_down":{"w":64,"h":64,"n":6,"px":32,"py":48,"src":"data:image/png;base64,"},"bat_die_down":{"w":64,"h":64,"n":8,"px":32,"py":48,"src":"data:image/png;base64,"},"fx_Fire_Ball":{"w":64,"h":64,"n":10,"px":32,"py":32,"src":"data:image/png;base64,"},"fx_Explosion":{"w":64,"h":64,"n":7,"px":32,"py":32,"src":"data:image/png;base64,"},"fx_Wind":{"w":64,"h":64,"n":10,"px":32,"py":32,"src":"data:image/png;base64,"},"fx_Portal":{"w":64,"h":64,"n":10,"px":32,"py":32,"src":"data:image/png;base64,"},"fx_Earth_Spike":{"w":64,"h":64,"n":9,"px":32,"py":32,"src":"data:image/png;base64,"}};
for(const asset of Object.values(battleArt)){asset.image=new Image();asset.image.src=asset.src}
function battleDirection(x,y){return Math.abs(x)>Math.abs(y)?(x<0?'left':'right'):(y<0?'up':'down')}
function drawBattleAsset(key,x,y,scale=1,progress=null){if(drawDetailedEffect(key,x,y,scale,progress??0))return true;const a=battleArt[key];if(!a||!a.image.complete||!a.image.naturalWidth)return false;const frame=progress===null?Math.floor(animationClock*8)%a.n:Math.min(a.n-1,Math.max(0,Math.floor(progress*a.n)));ctx.save();ctx.imageSmoothingEnabled=false;ctx.drawImage(a.image,frame*a.w,0,a.w,a.h,x-a.px*scale,y-a.py*scale,a.w*scale,a.h*scale);ctx.restore();return true}
// v1.81: approved class artwork, embedded for offline play.
const classSpriteAtlas=new Image();
classSpriteAtlas.src=embeddedArt[43];
const classSpriteFrames={"warrior":[[17,36,364,342],[36,403,324,291],[37,708,343,316]],"rogue":[[426,48,312,335],[412,407,296,286],[415,711,290,316]],"mage":[[758,34,285,354],[773,388,279,304],[790,703,253,321]],"cleric":[[1097,50,332,333],[1127,409,276,286],[1137,718,289,307]]};

const counterpartSpriteAtlas=new Image();counterpartSpriteAtlas.src=embeddedArt[44];
const counterpartSpriteFrames={"warrior": [[37, 46, 334, 343], [33, 395, 339, 310], [64, 710, 322, 339]], "rogue": [[419, 66, 304, 323], [400, 409, 309, 297], [422, 725, 275, 324]], "mage": [[756, 34, 283, 358], [762, 395, 292, 313], [758, 704, 281, 344]], "cleric": [[1084, 49, 325, 342], [1108, 402, 278, 306], [1131, 716, 298, 333]]};

const originalClassGenders={warrior:'male',rogue:'male',mage:'female',cleric:'female'};
function normalizedHeroGender(value,hero){return value==='female'||value==='male'?value:originalClassGenders[hero]||'male'}
function classAppearance(entity){const hero=classSpriteFrames[entity.class]?entity.class:'warrior',gender=normalizedHeroGender(entity.gender,hero),original=gender===originalClassGenders[hero];return {hero,gender,atlas:original?classSpriteAtlas:counterpartSpriteAtlas,frames:original?classSpriteFrames[hero]:counterpartSpriteFrames[hero]}}
function setCreationGender(value){selectedGender=value==='female'?'female':'male';for(const radio of document.querySelectorAll('input[name="heroGender"]'))radio.checked=radio.value===selectedGender;refreshClassPortraits()}

// Animation state stays outside saved character data; gait follows actual distance.
const heroMotion=new WeakMap();
function heroAnimation(entity){
 let m=heroMotion.get(entity);
 if(!m){m={x:entity.x,y:entity.y,phase:0,stride:0,clock:animationClock,map:mapId};heroMotion.set(entity,m)}
 const elapsed=Math.max(0,animationClock-m.clock),dt=Math.min(.1,elapsed),distance=Math.hypot(entity.x-m.x,entity.y-m.y);
 if(m.map!==mapId||distance>60||elapsed>.25){m.phase=0;m.stride=0;}
 else if(dt>0){
  const moving=distance>.01,speed=moving?distance/dt:0,target=Math.min(1,speed/110);
  m.stride+=(target-m.stride)*(1-Math.exp(-dt/(moving?.10:.14)));
  if(moving)m.phase=(m.phase+distance*Math.PI*2/68)%(Math.PI*2);
  if(m.stride<.001)m.stride=0;
 }
 m.x=entity.x;m.y=entity.y;m.clock=animationClock;m.map=mapId;
 return m;
}
function drawClassHero(entity,scale){
 const appearance=classAppearance(entity),atlas=appearance.atlas;if(!atlas.complete||!atlas.naturalWidth)return false;
 const direction=battleDirection(entity.faceX??0,entity.faceY??1);
 const row=direction==='up'?2:direction==='left'||direction==='right'?1:0;
 const [sx,sy,sw,sh]=appearance.frames[row],height=34*scale,width=sw/sh*height;
 const motion=heroAnimation(entity),gait=Math.sin(motion.phase)*motion.stride,sideways=direction==='left'||direction==='right',stepBounce=(1-Math.cos(motion.phase*2))*.45*motion.stride*scale;
 const strike=entity.attack>0?Math.sin(Math.PI*(1-Math.min(1,entity.attack/.32))):0;
 const cast=entity.castTime>0?Math.sin(Math.PI*(1-Math.min(1,entity.castTime/.48))):0;
 const magic=entity.class==='mage'||entity.class==='cleric';
 const dodge=entity.dodgeTime>0?Math.sin(Math.PI*(1-entity.dodgeTime/.4)):0;
 const recoil=entity.hitTime>0?Math.sin(Math.PI*(1-Math.min(1,entity.hitTime/.2))):0;
 const breathe=Math.sin(animationClock*2.5+(entity.x%7))*.35;
 const fx=entity.faceX??0,fy=entity.faceY??1,lunge=strike*(magic?1.5:entity.class==='rogue'?7:5)*scale;
 ctx.save();ctx.translate(entity.x+fx*lunge-fx*recoil*2,entity.y+7-stepBounce-breathe+fy*lunge);
 if(direction==='left')ctx.scale(-1,1);
 ctx.rotate(gait*.010+strike*(magic?-.04:.13)+dodge*.28-recoil*.07);
 ctx.imageSmoothingEnabled=true;
 if(entity.hitTime>0)ctx.globalAlpha=.65+.35*Math.abs(Math.sin(animationClock*35));
 // Idle bodies need one texture submission; breathing, facing and recoil remain above.
 if(motion.stride<.01&&strike===0&&cast===0){
  ctx.drawImage(atlas,sx,sy,sw,sh,-width/2,-height,width,height);
  ctx.restore();return true;
 }
 // Bend the existing artwork in narrow bands, keeping every class and gender design.
 const bands=28;
 for(let i=0;i<bands;i++){
  const top=i/bands,bottom=(i+1)/bands,srcY=sy+sh*top,srcH=sh*(bottom-top);
  const y=-height+height*top,h=height/bands;
  const lower=Math.max(0,(top-.68)/.32),sway=-gait*Math.sin(top*Math.PI)*.8*scale;
  if(lower>0){
   for(let leg=0;leg<2;leg++){
    const phase=motion.phase+leg*Math.PI,step=Math.sin(phase)*motion.stride,bend=lower*lower,offset=step*bend*(sideways?3.6:1.8)*scale,footLift=Math.pow(Math.max(0,Math.cos(phase)),2)*motion.stride*bend*2.4*scale;
    ctx.drawImage(atlas,sx+leg*sw/2,srcY,sw/2,srcH,-width/2+leg*width/2+offset,y-footLift,width/2,h+.35);
   }
  }else{
   const gesture=(strike*(magic?-1:2)+cast*-2)*Math.sin(top*Math.PI)*scale;
   ctx.drawImage(atlas,sx,srcY,sw,srcH,-width/2+sway+gesture,y,width,h+.35);
  }
 }
 ctx.restore();return true;
}

function drawBattleHero(entity,scale){if(entity.petId&&petDefs[entity.id])return drawPet(entity);if(drawClassHero(entity,scale))return true;if(entity.class!=='warrior')return false;const direction=battleDirection(entity.faceX||0,entity.faceY||1);let state=entity.hitTime>0?'hit':entity.attack>0?'attack':entity.walking||entity.moving?'walk':'idle';let key='warrior_'+state+'_'+(state==='hit'?'down':direction);if(!battleArt[key])key='warrior_idle_'+(direction==='up'?'up':'down');return drawBattleAsset(key,entity.x,entity.y,scale,state==='attack'?1-entity.attack/.32:state==='hit'?1-entity.hitTime/.2:null)}
function drawBattleMonster(e){const kind=e.kind==='bat'?'bat':e.kind==='slime'?'slime':null;if(!kind)return false;const dir=battleDirection(player.x-e.x,player.y-e.y);const state=e.hitTime>0?'hit':e.windup>0?'attack':Math.hypot(player.x-e.x,player.y-e.y)<230?'walk':'idle';let key=kind+'_'+state+'_'+(state==='hit'?'down':dir);if(!battleArt[key])key=kind+'_idle_down';return drawBattleAsset(key,e.x,e.y,2,state==='attack'?1-e.windup/(e.windupLength||.8):state==='hit'?1-e.hitTime/.2:null)}
function battleVfx(name,x,y,size=80,endX=null,endY=null){combatEffects.push({asset:'fx_'+name,x,y,endX,endY,scale:size/64,life:.55,duration:.55})}

const keys=new Set(), player={name:'Hero',class:'warrior',gender:'male',x:450,y:355,r:13,hp:100,max:100,speed:190,faceX:0,faceY:-1,attack:0,cool:0,xp:0,level:1,coins:12,inventory:[],weapon:null,armor:null,shield:null,earrings:null,necklace:null,legs:null,boots:null};

const GEAR_SLOTS=['weapon','armor','shield','earrings','necklace','legs','boots'];
const GEAR_LABELS={weapon:'Weapon',armor:'Body Armor',shield:'Shield',earrings:'Earrings',necklace:'Necklace',legs:'Leg Armor',boots:'Boots'};
const GEAR_ICONS={weapon:'⚔️',armor:'🛡️',shield:'🛡️',earrings:'💎',necklace:'📿',legs:'👖',boots:'🥾'};
const GEAR_TIERS={1:{name:'Common',level:1,color:'#cbd1bd'},2:{name:'Uncommon',level:8,color:'#93cc86'},3:{name:'Rare',level:16,color:'#88baff'},4:{name:'Epic',level:25,color:'#cfa0ed'},5:{name:'Legendary',level:40,color:'#f1c568'}};
const GEAR_SET_NAMES={warrior:'Emberguard',rogue:'Shadowthorn',mage:'Tideglass',cleric:'Dawnwarden'};
function gearRequirements(id,owner=player){const item=itemDefs[id];if(!item||!GEAR_SLOTS.includes(item.slot))return false;return (!itemClassRules[id]||itemClassRules[id].includes(owner.class))&&(owner.level||1)>=(item.minLevel||1)}
function gearTierLabel(id){const d=itemDefs[id];return d?.tier?'T'+d.tier+' '+GEAR_TIERS[d.tier].name:''}
function gearSetGroups(owner){const groups={};for(const slot of GEAR_SLOTS){const id=owner[slot],d=itemDefs[id];if(!d?.set||d.slot!==slot)continue;const g=groups[d.set]||(groups[d.set]={name:GEAR_SET_NAMES[d.set],count:0,tier:5});g.count++;g.tier=Math.min(g.tier,d.tier||1);}return Object.values(groups)}
function gearSetBonus(owner){let attack=0,guard=0;for(const g of gearSetGroups(owner)){if(g.count>=3)attack+=g.tier;if(g.count>=5)guard+=g.tier;if(g.count>=7){attack+=g.tier*2;guard+=g.tier*2;}}return {attack,guard}}
function equipmentSetSummary(owner){const groups=gearSetGroups(owner);if(!groups.length)return 'Sets: equip 3, 5, or 7 matching pieces for bonuses.';const b=gearSetBonus(owner);return groups.map(g=>g.name+' '+g.count+'/7 · T'+g.tier).join(' · ')+' | Set bonus +'+b.attack+' attack, +'+b.guard+' guard';}
function equipmentStat(owner,stat){return GEAR_SLOTS.reduce((n,slot)=>n+(owner[slot]?gearStat(owner[slot],stat):0),0)}
function equipmentGuard(owner){if(owner.petId&&petDefs[owner.id])return petGuard(owner);return equipmentStat(owner,'guard')+gearSetBonus(owner).guard+(owner===player?buildGuard():companionStoryGuard(owner))}
function gearMainStat(id){return itemDefs[id]?.bonus?'bonus':'guard'}
function setGearId(hero,tier,slot){if(tier===3&&['weapon','armor','shield'].includes(slot))return classGearProfiles[hero].items[['weapon','armor','shield'].indexOf(slot)];return 'set_'+hero+'_t'+tier+'_'+slot;}
const itemDefs={health_tonic:{name:'Health Tonic',icon:'🧪',category:'consumable',price:8,sell:4,heal:35,description:'Restores 35 vitality.'},field_ration:{name:'Field Ration',icon:'🍞',category:'consumable',price:5,sell:2,heal:15,description:'Restores 15 vitality.'},potion_25:{name:'Small Healing Potion',icon:'🧪',category:'consumable',price:6,sell:3,heal:25,description:'A simple red draught. Restores 25 vitality.'},potion_50:{name:'Greater Healing Potion',icon:'⚗️',category:'consumable',price:14,sell:7,heal:50,description:'A stronger red draught. Restores 50 vitality.'},ashwood_blade:{name:'Ashwood Blade',icon:'⚔️',category:'gear',slot:'weapon',price:18,sell:9,bonus:1,description:'A light blade. Adds 1 damage.'},short_sword:{name:'Short Sword',icon:'🗡️',category:'gear',slot:'weapon',price:10,sell:5,bonus:2,description:'A reliable starter sword. Adds 2 damage.'},sabre:{name:'Sabre',icon:'⚔️',category:'gear',slot:'weapon',price:30,sell:15,bonus:3,description:'A quick curved blade. Adds 3 damage.'},trail_vest:{name:'Trail Vest',icon:'🛡️',category:'gear',slot:'armor',price:15,sell:7,guard:2,description:'Woven bark armor. Reduces each hit by 2.'},light_chainmail:{name:'Light Chainmail',icon:'⛓️',category:'gear',slot:'armor',price:30,sell:15,guard:3,description:'Linked steel rings. Reduces each hit by 3.'},buckler:{name:'Buckler',icon:'🛡️',category:'gear',slot:'shield',price:12,sell:6,guard:2,description:'A compact shield. Reduces each hit by 2.'},battle_shield:{name:'Battle Shield',icon:'🛡️',category:'gear',slot:'shield',price:28,sell:14,guard:3,description:'A broad shield. Reduces each hit by 3.'},bone_shard:{name:'Bone Shard',icon:'🦴',category:'quest',sell:2,description:'A brittle piece from a vault skeleton. Useful for future crafting.'},spider_silk:{name:'Spider Silk',icon:'🕸️',category:'quest',sell:3,description:'Tough silk harvested from a giant ash spider.'},warden_crest:{name:'Cinder Crest',icon:'🔥',category:'quest',description:'The Cinder Warden’s mark. Proof of your Ashvault victory.'},ash_mote:{name:'Ash Mote',icon:'✨',category:'quest',sell:2,description:'A warm mote shed by an Ash Slime in Whisperwood.'},bog_resin:{name:'Bog Resin',icon:'🟢',category:'quest',sell:2,description:'Sticky marsh resin gathered from Redfen creatures.'},fen_venom:{name:'Fen Venom Gland',icon:'☠️',category:'quest',sell:3,description:'A venom gland dropped by a Fen Stalker.'},grave_iron:{name:'Grave Iron',icon:'⛓️',category:'quest',sell:3,description:'A corroded iron fragment carried by Highmoor skeletons.'},ruin_silk:{name:'Ruin Weaver Silk',icon:'🕸️',category:'quest',sell:3,description:'Strong silk spun by a Highmoor Ruin Weaver.'},frost_shard:{name:'Frost Shard',icon:'❄️',category:'quest',sell:3,description:'A cold crystal found on monsters in Frostmarch Pass.'},ice_silk:{name:'Ice Cave Silk',icon:'🕸️',category:'quest',sell:4,description:'A frost-proof strand dropped by an Ice Cave Weaver.'},glass_shard:{name:'Frostglass Shard',icon:'🔹',category:'quest',sell:5,description:'A sharp crystal shed by creatures on Frostglass Ridge.'},sunken_coin:{name:'Sunken Coin',icon:'🪙',category:'quest',sell:4,description:'A tarnished harbor coin recovered from tide-haunted creatures.'},greenleaf:{name:'Greenleaf',icon:'🌿',category:'quest',sell:3,description:'A bright leaf carried by creatures in Greenhollow Wood.'},grain_bundle:{name:'Grain Bundle',icon:'🌾',category:'quest',sell:3,description:'A bundle of hard-won grain from Crowfield’s monsters.'},fen_lily:{name:'Fen Lily',icon:'🪷',category:'quest',sell:4,description:'A rare flower growing in Willow Fen.'},road_iron:{name:'Road Iron',icon:'🔩',category:'quest',sell:5,description:'A rusted iron fragment taken from the Stonewatch Road.'},mining_pick:{name:'Mining Pick',icon:'⛏️',category:'tool',price:8,sell:4,description:'Required to mine exposed stone and ore.'},woodcutting_hatchet:{name:'Woodcutting Hatchet',icon:'🪓',category:'tool',price:7,sell:3,description:'Required to chop trees for usable logs.'},fishing_rod:{name:'Fishing Rod',icon:'🎣',category:'tool',price:6,sell:3,description:'Required to fish at marked pools, rivers, and harbors.'},copper_ore:{name:'Copper Ore',icon:'🟠',category:'material',sell:3,description:'Common ore mined from surface rocks.'},iron_ore:{name:'Iron Ore',icon:'⚙️',category:'material',sell:5,description:'Dense ore mined from older stone.'},silver_ore:{name:'Silver Ore',icon:'💠',category:'material',sell:8,description:'A pale ore found in Frostmarch.'},wood_log:{name:'Wood Log',icon:'🪵',category:'material',sell:2,description:'A sturdy log chopped from common trees.'},hardwood_log:{name:'Hardwood Log',icon:'🪵',category:'material',sell:4,description:'Dense timber from older woodland.'},river_fish:{name:'River Fish',icon:'🐟',category:'material',sell:3,description:'A fresh catch from a river pool.'},marsh_fish:{name:'Marsh Fish',icon:'🐠',category:'material',sell:4,description:'A fish adapted to the Redfen waters.'},coast_fish:{name:'Coast Fish',icon:'🐟',category:'material',sell:5,description:'A saltwater catch from the Sunmere coast.'},ice_trout:{name:'Ice Trout',icon:'🐟',category:'material',sell:6,description:'A cold-water trout from Frostmarch.'}};
itemDefs.ashwood_staff={name:'Ashwood Staff',icon:'🪄',category:'gear',slot:'weapon',price:18,sell:9,bonus:1,description:'A simple mage’s staff. Adds 1 damage.'};const itemClassRules={ashwood_staff:['mage'],ashwood_blade:['warrior','rogue','cleric'],short_sword:['warrior','rogue','cleric'],sabre:['warrior','rogue'],trail_vest:['rogue','mage'],light_chainmail:['warrior','cleric'],buckler:['warrior','rogue','cleric'],battle_shield:['warrior','cleric']};function canUseItem(id){return gearRequirements(id,player)}function itemClassNames(id){return (itemClassRules[id]||Object.keys(classDefs)).map(key=>classDefs[key].title).join(', ')}const shopDefs={ashvale_market:{name:'Ashvale Market',seller:'Tilda the Trader',stock:['field_ration','potion_25','health_tonic','potion_50','trail_vest']},ashvale_forge:{name:'Ashvale Forge',seller:'Bran the Smith',stock:['short_sword','sabre','buckler','battle_shield','light_chainmail','ashwood_blade','ashwood_staff']}};
const MAX_BAG_ITEMS=24;function bagLimit(){return MAX_BAG_ITEMS}
const townQuestDefs={ashvale_watch:{title:'Whisperwood Watch',town:'Ashvale',giver:'Reeve Mara',arc:'Dalen · The Watchman’s Oath · Chapter 1',intro:'Dalen once ordered Ashvale’s gate shut while his patrol was still beyond it. The old road is exposed again. Help him hold it this time.',area:'whisperwood',kind:'slime',target:3,coins:24,xp:18,desc:'Defeat three Ash Slimes and bring three Ash Motes back to Dalen.',drop:'ash_mote',dropTarget:3},ashvale_scout:{title:'Scout’s Report',town:'Ashvale',giver:'Rowan the Scout',arc:'Dalen · The Watchman’s Oath · Chapter 2',intro:'A signal from the lost patrol may still be hidden among the old stones. Find it with Rowan and let Dalen face the names he left behind.',requires:'ashvale_watch',area:'whisperwood',kind:'slime',target:2,coins:16,xp:12,desc:'Defeat two Ash Slimes and recover two Ash Motes from their nest for the patrol signal.',drop:'ash_mote',dropTarget:2},bracken_patrol:{title:'Redfen Patrol',town:'Brackenford',giver:'Mayor Tamsin',arc:'Sylvi · The Unsent Warning · Chapter 1',intro:'Sylvi kept a warning map from Brackenford’s council, afraid it would send the town into panic. Scouts are now stranded in Redfen. Help her reach them.',area:'redfen',kind:'any',target:3,coins:30,xp:22,desc:'Defeat three Redfen monsters and collect three jars of Bog Resin to mark the scouts’ trail.',drop:'bog_resin',dropTarget:3},bracken_herbs:{title:'Marsh Samples',town:'Brackenford',giver:'Iva the Herbalist',arc:'Sylvi · The Unsent Warning · Chapter 2',intro:'The stranded scouts need medicine, and Sylvi must tell them why the warning came late. Gather what Iva needs, then help Sylvi deliver the truth.',requires:'bracken_patrol',area:'redfen',kind:'spider',target:2,coins:22,xp:16,desc:'Defeat two Fen Stalkers and bring two Venom Glands to Iva for an antidote.',drop:'fen_venom',dropTarget:2},stonewatch_sweep:{title:'Clear the Moor',town:'Stonewatch',giver:'Captain Harlan',arc:'Corin · The Unheard Vigil · Chapter 1',intro:'Corin froze when the vigil bell sounded and the dead rose at Stonewatch. Skeletons have gathered again in Highmoor. Go with him to meet the duty he once fled.',area:'highmoor',kind:'skeleton',target:3,coins:42,xp:28,desc:'Defeat three Highmoor skeletons and collect three Grave Iron pieces for the vigil bell.',drop:'grave_iron',dropTarget:3},stonewatch_silk:{title:'A Weaver’s Thread',town:'Stonewatch',giver:'Mara the Herbalist',arc:'Corin · The Unheard Vigil · Chapter 2',intro:'Corin wants to give the fallen their rites, but the old shrine cloth has rotted away. Recover strong weaver silk so he can ring the bell and finish the vigil.',requires:'stonewatch_sweep',area:'highmoor',kind:'spider',target:2,coins:28,xp:20,desc:'Defeat two Ruin Weavers and bring two bundles of Ruin Weaver Silk for the vigil cloth.',drop:'ruin_silk',dropTarget:2},sunmere_hunt:{title:'Pass Watch',town:'Sunmere',giver:'Harbormaster Vale',arc:'Eryn · The Broken Beacon · Chapter 1',intro:'Eryn’s spell experiment cracked Sunmere’s beacon ward. She has hidden the truth while the harbor and mountain pass remain exposed. Help her secure the route.',area:'frostmarch',kind:'any',target:4,coins:55,xp:34,desc:'Defeat four Frostmarch monsters and collect four Frost Shards to stabilize the beacon.',drop:'frost_shard',dropTarget:4},sunmere_weavers:{title:'Cold Silk',town:'Sunmere',giver:'Neri the Netmaker',arc:'Eryn · The Broken Beacon · Chapter 2',intro:'Ice cave silk can bind the beacon’s fractured ward. Eryn must admit what she broke, then use the thread to mend it before the next storm.',requires:'sunmere_hunt',area:'frostmarch',kind:'spider',target:2,coins:36,xp:24,desc:'Defeat two Ice Cave Weavers and bring two strands of Ice Cave Silk to repair the beacon.',drop:'ice_silk',dropTarget:2}};
Object.assign(itemDefs,{ashvale_seal:{name:'Ashvale Ember Seal',icon:'🔥',category:'quest',description:'A fire-warmed seal earned from Ashvale’s watch.'},sunmere_seal:{name:'Sunmere Tide Seal',icon:'🌊',category:'quest',description:'A salt-bright seal earned from Sunmere’s harbor.'},brackenford_seal:{name:'Brackenford Fen Seal',icon:'🌿',category:'quest',description:'A living seal earned from Brackenford’s marsh wardens.'},stonewatch_seal:{name:'Stonewatch Stone Seal',icon:'🪨',category:'quest',description:'A carved seal earned from Stonewatch’s order.'},fourfold_key:{name:'Fourfold Keystone',icon:'✥',category:'quest',description:'The four town seals joined into one key. It opens Mosslight Shrine.'}});
const townRelicQuestSets={ashvale:{hero:'Dalen',arc:'The Watchman’s Oath',quests:['ashvale_watch','ashvale_scout'],item:'ashvale_seal',name:'Ashvale Ember Seal'},sunmere:{hero:'Eryn',arc:'The Broken Beacon',quests:['sunmere_hunt','sunmere_weavers'],item:'sunmere_seal',name:'Sunmere Tide Seal'},brackenford:{hero:'Sylvi',arc:'The Unsent Warning',quests:['bracken_patrol','bracken_herbs'],item:'brackenford_seal',name:'Brackenford Fen Seal'},stonewatch:{hero:'Corin',arc:'The Unheard Vigil',quests:['stonewatch_sweep','stonewatch_silk'],item:'stonewatch_seal',name:'Stonewatch Stone Seal'}};
const regionalDropTables={whisperwood:{slime:['ash_mote']},redfen:{slime:['bog_resin'],spider:['bog_resin','fen_venom']},highmoor:{skeleton:['grave_iron'],spider:['ruin_silk']},frostmarch:{skeleton:['frost_shard'],spider:['frost_shard','ice_silk']},glassridge:{skeleton:['glass_shard'],spider:['glass_shard']},sunharbor:{slime:['sunken_coin'],spider:['sunken_coin'],skeleton:['sunken_coin']},greenhollow:{slime:['greenleaf'],spider:['greenleaf']},crowfield:{slime:['grain_bundle'],spider:['grain_bundle'],skeleton:['grain_bundle']},willowfen:{slime:['fen_lily'],spider:['fen_lily']},stonewatchroad:{skeleton:['road_iron'],spider:['road_iron']}};function getRegionalDropIds(area,enemy){return regionalDropTables[area]?.[enemy.kind]||[]}function activeQuestDrops(area,enemy){const ids=new Set();for(const [id,q] of Object.entries(townQuestDefs)){const st=townQuestState[id];if(st&&st.accepted&&!st.claimed&&q.area===area&&q.kind!=='any'&&q.kind!==enemy.kind)continue;if(humanQuestReady(id)&&!journalPaused(id)&&st&&st.accepted&&!st.claimed&&q.area===area&&q.drop&&getRegionalDropIds(area,enemy).includes(q.drop)&&(bagCount(q.drop)||0)<q.dropTarget)ids.add(q.drop)}return [...ids]}
