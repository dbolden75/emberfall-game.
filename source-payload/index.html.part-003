let defeated=0,last=performance.now(),toastTimer=0,done=false,saveClock=0,gateBlocked=false,hasStarted=false,selectedClass='warrior',selectedGender='male',huntRewarded=false,shrineRewarded=false,deepQuestDone=false,tapTarget=null,cameraX=0,cameraY=0,animationClock=0,footstepClock=0;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const openWorldMapIds=new Set([...worldGrid.flat().filter(id=>!['mosslight','emberdeep'].includes(id)),'frontier_outpost','memory_valley','worldsend']);
function usesOpenWorld(id=mapId){return openWorldMapIds.has(id)}
function worldBounds(id=mapId){return usesOpenWorld(id)?{minX:-OPEN_WORLD_ORIGIN_X+22,maxX:OPEN_WORLD_WIDTH-OPEN_WORLD_ORIGIN_X-22,minY:-OPEN_WORLD_ORIGIN_Y+45,maxY:OPEN_WORLD_HEIGHT-OPEN_WORLD_ORIGIN_Y-35}:{minX:22,maxX:W-22,minY:45,maxY:H-35}}
const ZOOM_PREF='emberfall_camera_zoom_v1';let cameraZoom=1;
try{const stored=Number(localStorage.getItem(ZOOM_PREF));if(stored>=.6&&stored<=1.8)cameraZoom=stored}catch{}
function cameraAxis(center,span,total){return span>=total?(total-span)/2:clamp(center-span/2,0,total-span)}
function updateCamera(){
 const outdoor=usesOpenWorld();roomScale=(outdoor?1:Math.max(viewW/W,viewH/H))*cameraZoom;
 const spanW=viewW/roomScale,spanH=viewH/roomScale;
 cameraX=cameraAxis(player.x+(outdoor?OPEN_WORLD_ORIGIN_X:0),spanW,outdoor?OPEN_WORLD_WIDTH:W);
 cameraY=cameraAxis(player.y+(outdoor?OPEN_WORLD_ORIGIN_Y:0),spanH,outdoor?OPEN_WORLD_HEIGHT:H);
}
function screenToMap(screenX,screenY){return {x:screenX/roomScale+cameraX-(usesOpenWorld()?OPEN_WORLD_ORIGIN_X:0),y:screenY/roomScale+cameraY-(usesOpenWorld()?OPEN_WORLD_ORIGIN_Y:0)}}
function mapToScreen(mapX,mapY){return {x:(mapX+(usesOpenWorld()?OPEN_WORLD_ORIGIN_X:0)-cameraX)*roomScale,y:(mapY+(usesOpenWorld()?OPEN_WORLD_ORIGIN_Y:0)-cameraY)*roomScale}}
function setCameraZoom(value){if(!Number.isFinite(value))return;cameraZoom=clamp(value,.6,1.8);updateCamera();const label=document.getElementById('zoomReset');if(label)label.textContent=Math.round(cameraZoom*100)+'%';document.getElementById('zoomOut').disabled=cameraZoom<=.6001;document.getElementById('zoomIn').disabled=cameraZoom>=1.7999;try{localStorage.setItem(ZOOM_PREF,String(cameraZoom))}catch{}}
const CONTROL_PREF='emberfall_control_side_v1';
function setControlSide(side){const value=side==='left'?'left':'right';document.body.dataset.controlSide=value;document.querySelectorAll('[data-side-choice]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.sideChoice===value)));try{localStorage.setItem(CONTROL_PREF,value)}catch{}}
const SOUND_PREF='emberfall_sound_effects_v1';let soundVolume=.75;try{const v=localStorage.getItem('thornhaven_sound_volume');if(v!==null&&Number.isFinite(Number(v)))soundVolume=Math.max(0,Math.min(1,Number(v)))}catch{}let soundEnabled=true;try{soundEnabled=localStorage.getItem(SOUND_PREF)!=='off'}catch{}let soundCtx=null;function updateSoundButton(){const b=document.getElementById('soundToggle');if(b){b.textContent='SOUND EFFECTS: '+(soundEnabled?'ON':'OFF');b.setAttribute('aria-pressed',String(soundEnabled))}}function toggleSound(){soundEnabled=!soundEnabled;try{localStorage.setItem(SOUND_PREF,soundEnabled?'on':'off')}catch{}updateSoundButton();if(soundEnabled)playSfx('menu')}function playSfx(kind){if(!soundEnabled||soundVolume===0)return;try{const AudioCtor=window.AudioContext||window.webkitAudioContext;if(!AudioCtor)return;soundCtx=soundCtx||new AudioCtor();if(soundCtx.state==='suspended')soundCtx.resume().catch(()=>{});const sounds={step:[155,.035,'square',.018],attack:[245,.07,'triangle',.035],hit:[520,.09,'triangle',.045],quest:[660,.14,'sine',.055],level:[760,.22,'sine',.06],menu:[420,.055,'sine',.025]},spec=sounds[kind]||sounds.menu,osc=soundCtx.createOscillator(),gain=soundCtx.createGain(),now=soundCtx.currentTime;osc.type=spec[2];osc.frequency.setValueAtTime(spec[0],now);osc.frequency.exponentialRampToValueAtTime(Math.max(80,spec[0]*.72),now+spec[1]);gain.gain.setValueAtTime(Math.max(.001,spec[3]*soundVolume),now);gain.gain.exponentialRampToValueAtTime(.001,now+spec[1]);osc.connect(gain);gain.connect(soundCtx.destination);osc.start(now);osc.stop(now+spec[1])}catch{}}
let savedControlSide='right';try{savedControlSide=localStorage.getItem(CONTROL_PREF)||'right'}catch{}setControlSide(savedControlSide);

const SAVE_KEY='emberfall_singleplayer_v1',SAVE_SLOTS_KEY='emberfall_character_slots_v1',ACTIVE_SLOT_KEY='emberfall_active_character_slot_v1';
const SAVE_SLOT_IDS=['slot1','slot2','slot3','slot4'];let activeSlotId='slot1',saveSlots={},saveFilesReturnToGame=false,switchingCharacter=false;
const worldAtlas=new Image(),charAtlas=new Image();worldAtlas.src=embeddedArt[45];charAtlas.src=embeddedArt[46];
function applyClass(kind){player.class=kind in classDefs?kind:'warrior';syncHeroStats();applyDanTestProfile()}
function setMap(id,x,y,announce=true){if(!maps[id])return false;if(mapId==='frontier_outpost'&&id!==mapId&&politicsState().phase==='siege')endTownSiege(false);tapTarget=null;keys.clear();attackHeld=false;lockedEnemy=null;slowTimer=0;dodgeGuard=0;impactShake=0;combatEffects=[];for(const e of maps[id].enemies){e.windup=0;e.swing=null;e.stun=0;e.combatCool=.5;e.specialClock=5;e.specialPhase=0}dungeonHazards=[];mapId=id;activeMap=maps[id];frontierEnter(id);townQuestState._visited=townQuestState._visited||{};townQuestState._visited[id]=true;if(activeMap.town)activeMap.enemies.length=0;trees=activeMap.trees;stones=activeMap.stones;enemies=activeMap.enemies;npcs=activeMap.npcs;runes=activeMap.runes||[];traps=activeMap.traps||[];chest=activeMap.chest||null;treasure=activeMap.treasure||null;Object.assign(player,safeMapPosition(id,x,y,player.r));scaleEnemiesForRegion();updateCamera();snapCompanionsToPlayer();document.getElementById('mapName').textContent=activeMap.name;if(regionalAdventures[id]&&hasStarted&&!townQuestState['visit_'+id]){townQuestState['visit_'+id]={claimed:true};say(regionalAdventures[id].lore)}else if(announce)say('Entered '+activeMap.name+'.');return true}
// Pet collection v1. Saves retain legacy companion ids so story flags remain compatible.
const petDefs={
 dalen:{name:'Cinder',species:'Road Wolf',tier:1,tierName:'Common',class:'warrior',icon:'🐺',cost:0,hp:68,attack:2,guard:0,skill:'Pack Rush',color:'#a9bbc1',accent:'#e7dfc6',story:'The bells fell silent, but one wolf kept calling. You freed Cinder from the broken cart on the Ashvale road. Now the rescued pup follows your footsteps.',unlock:'Your first friend joins when your adventure begins.'},
 sylvi:{name:'Briar',species:'Briar Fox',tier:2,tierName:'Rare',class:'rogue',icon:'🦊',cost:90,hp:62,attack:3,guard:0,skill:'Thorn Pounce',color:'#bd693d',accent:'#f2d8a0',quest:'bracken_patrol',story:'A fox carried warning ribbons through the marsh when Sylvi could not. Clear Redfen Patrol, then help Sylvi prepare its refuge. Briar repays kindness with a fierce pounce.',unlock:'Complete Redfen Patrol, then adopt for 90 crowns.'},
 corin:{name:'Lumen',species:'Moon Owl',tier:3,tierName:'Epic',class:'cleric',icon:'🦉',cost:180,hp:72,attack:3,guard:1,skill:'Moonmend',color:'#b0a4d6',accent:'#fff0c5',quest:'stonewatch_silk',story:'Corin hears a wingbeat where the vigil bell once rang. Finish both Stonewatch chapters and weave a safe roost. Lumen watches over the living, mending wounded travelers.',unlock:'Complete A Weaver’s Thread, then adopt for 180 crowns.'},
 eryn:{name:'Tempest',species:'Storm Griffin',tier:3,tierName:'Epic',class:'mage',icon:'🦅',cost:240,hp:82,attack:4,guard:1,skill:'Stormcall',color:'#779cb2',accent:'#efcc83',quest:'sunmere_weavers',story:'The broken beacon stranded a young griffin in the frost. Help Eryn repair it through both Sunmere chapters. Tempest remembers the way home and brings a spark of the storm.',unlock:'Complete Cold Silk, then adopt for 240 crowns.'},
 ember_dragon:{name:'Sol',species:'Ember Dragon',tier:4,tierName:'Legendary',class:'mage',icon:'🐉',cost:650,hp:96,attack:5,guard:2,skill:'Ember Breath',color:'#a84e38',accent:'#f3bc61',story:'Under the Cinder Warden’s coffer rests an ember that still breathes. Clear the Ashvault to rescue the egg. The sanctuary needs 650 earned crowns for its fireproof nest; Sol then chooses you as its keeper.',unlock:'Clear the Ashvault and claim its coffer, then purchase for 650 crowns.'}
};
companionDefs.ember_dragon={id:'ember_dragon',name:'Sol',class:'mage',gender:'male',cost:650};
function petLevel(){return Math.max(1,Math.floor((Number(player.level)||1)/2))}
function petMaxHealth(id,level=petLevel()){return petDefs[id].hp+(level-1)*7}
function petUnlocked(id){const d=petDefs[id];return !!d&&(id==='dalen'||id==='ember_dragon'?id==='dalen'||deepQuestDone:!!townQuestState[d.quest]?.claimed)}
function normalizePets(){
 let following=false;const seen=new Set();companions=companions.filter(p=>petDefs[p.id]&&!seen.has(p.id)&&seen.add(p.id));
 for(const p of companions){const d=petDefs[p.id],oldMax=Math.max(1,Number(p.max)||d.hp),ratio=Math.max(0,Math.min(1,(Number(p.hp)||0)/oldMax));
  if(p.petVersion!==1){for(const slot of GEAR_SLOTS){const id=p[slot];if(id&&itemDefs[id]){const row=player.inventory.find(r=>r.id===id);if(row)row.count++;else player.inventory.push({id,count:1});}p[slot]=null;}p.petVersion=1;}
  Object.assign(p,{petId:p.id,name:d.name,class:d.class,level:petLevel(),xp:0,max:petMaxHealth(p.id)});p.hp=ratio===0?0:Math.max(1,Math.round(p.max*ratio));
  p.active=!!p.active&&p.hp>0&&!following;if(p.active)following=true;
 }
}
function ensureStarterPet(){if(!hasStarted||switchingCharacter)return;if(!companions.some(p=>p.id==='dalen')){const p=makeCompanion('dalen');p.active=!companions.some(p=>p.active&&p.hp>0);companions.push(p);}normalizePets();}
function petAttackPower(p){const d=petDefs[p.id];return d.attack+Math.floor((p.level-1)*.8)+companionStoryAttack(p)}
function petGuard(p){return petDefs[p.id].guard+Math.floor((p.level-1)/4)+companionStoryGuard(p)}
function adoptPet(id){const d=petDefs[id];if(!hasStarted||!d)return false;if(companions.some(p=>p.id===id)){renderParty('You have already bonded with '+d.name+'.');return false;}if(!petUnlocked(id)){renderParty(d.unlock);return false;}if(player.coins<d.cost){renderParty('You need '+(d.cost-player.coins)+' more crowns to welcome '+d.name+'.');return false;}
 player.coins-=d.cost;for(const p of companions)p.active=false;const p=makeCompanion(id);companions.push(p);selectedCompanionId=id;snapCompanionsToPlayer();ui();saveGame();renderParty(d.name+' has joined you. '+d.skill+' activates automatically in battle.');return true;
}
function petStory(id){const d=petDefs[id];if(!d)return;const owned=companions.some(p=>p.id===id),ready=petUnlocked(id),choices=[];
 if(!owned&&ready)choices.push({label:(d.cost?'Welcome '+d.name+' · '+d.cost+' crowns':'Bond with '+d.name+' · Free'),disabled:player.coins<d.cost,action:()=>{openPartyScreen();adoptPet(id);}});
 choices.push({label:'Back to pets',action:openPartyScreen});openAdventureDialog(d.name+' · '+d.species,d.story+'\n\n'+(owned?'This pet is part of your sanctuary.':d.unlock)+'\n\n'+d.tierName+' · Level '+petLevel()+' · '+d.skill+'\nOne pet follows at a time. Pets fight automatically at half your level, rounded down (minimum 1).',choices);
}
// Detailed fantasy creature art shared by the sanctuary and world.
const petArtwork={dalen:'wolf',sylvi:'fox',corin:'owl',eryn:'griffin',ember_dragon:'dragon'};
const petImages={};
for(const [id,file] of Object.entries(petArtwork)){const img=new Image();img.src='assets/pets/'+file+'-v2.webp';petImages[id]=img;}
function petPortrait(id){return '<img class="petPortrait" src="assets/pets/'+petArtwork[id]+'-v2.webp" alt="'+petDefs[id].species+'" width="112" height="112">';}

// Directional front/back art uses isolated alpha components, avoiding atlas-cell clipping.
const petDirectionalImages={};
const petDirectionAtlas=new Image();
petDirectionAtlas.onload=()=>{
 const w=petDirectionAtlas.naturalWidth,h=petDirectionAtlas.naturalHeight,canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;
 const cx=canvas.getContext('2d',{willReadFrequently:true});cx.drawImage(petDirectionAtlas,0,0);
 const pixels=cx.getImageData(0,0,w,h),data=pixels.data,labels=new Int32Array(w*h),queue=new Int32Array(w*h),parts=[];let label=0;
 for(let start=0;start<w*h;start++){
  if(labels[start]||data[start*4+3]<80)continue;
  label++;let head=0,tail=1,minX=w,minY=h,maxX=0,maxY=0;queue[0]=start;labels[start]=label;
  while(head<tail){const i=queue[head++],x=i%w,y=Math.floor(i/w);minX=Math.min(minX,x);maxX=Math.max(maxX,x);minY=Math.min(minY,y);maxY=Math.max(maxY,y);
   for(const n of [x>0?i-1:-1,x<w-1?i+1:-1,y>0?i-w:-1,y<h-1?i+w:-1])if(n>=0&&!labels[n]&&data[n*4+3]>=80){labels[n]=label;queue[tail++]=n;}
  }
  if(tail>5000)parts.push({label,count:tail,minX,maxX,minY,maxY});
 }
 const ids=['dalen','sylvi','corin','eryn','ember_dragon'];
 for(const [col,direction]of ['down','up'].entries()){
  const rows=parts.filter(p=>(p.minX+p.maxX)/2<(w/2)?col===0:col===1).sort((a,b)=>a.minY-b.minY);
  rows.slice(0,5).forEach((p,row)=>{
   const sprite=document.createElement('canvas');sprite.width=p.maxX-p.minX+5;sprite.height=p.maxY-p.minY+5;
   const target=sprite.getContext('2d'),out=target.createImageData(sprite.width,sprite.height);
   for(let y=p.minY;y<=p.maxY;y++)for(let x=p.minX;x<=p.maxX;x++){const i=y*w+x;if(labels[i]!==p.label)continue;const j=((y-p.minY+2)*sprite.width+x-p.minX+2)*4;for(let k=0;k<4;k++)out.data[j+k]=data[i*4+k];}
   target.putImageData(out,0,0);(petDirectionalImages[ids[row]]||={})[direction]=sprite;
  });
 }
};
petDirectionAtlas.src='data:image/png;base64,';
const petFacingState=new WeakMap();
function petFacing(p){
 let state=petFacingState.get(p);if(!state){state={x:p.x,y:p.y,direction:'right'};petFacingState.set(p,state);}
 const dx=p.x-state.x,dy=p.y-state.y,dist=Math.hypot(dx,dy);let x=p.faceX||0,y=p.faceY||0;
 // Actual travel wins over a stale combat heading while moving. Ignore teleports.
 if(dist>.05&&dist<40){x=dx;y=dy;}
 if(Math.hypot(x,y)>.01){
  const vertical=state.direction==='up'||state.direction==='down',ratio=vertical?.85:1.15;
  state.direction=Math.abs(y)>Math.abs(x)*ratio?(y<0?'up':'down'):(x<0?'left':'right');
 }
 state.x=p.x;state.y=p.y;return state.direction;
}

const petGaits=new WeakMap();
function petAnimationPose(p,time){
 let g=petGaits.get(p);if(!g){g={x:p.x,y:p.y,time,phase:0,weight:0};petGaits.set(p,g);}
 const dt=Math.max(0,Math.min(.1,time-g.time)),distance=Math.hypot(p.x-g.x,p.y-g.y);
 const walking=distance>.01&&distance<40;
 if(walking)g.phase+=distance/({dalen:36,sylvi:34,eryn:45,ember_dragon:47}[p.id]||36)*Math.PI*2;
 g.weight+=(Number(walking)-g.weight)*Math.min(1,dt*14);
 Object.assign(g,{x:p.x,y:p.y,time});
 const pulse=(v,d)=>v>0?Math.sin(Math.PI*(1-Math.min(1,v/d))):0;
 const attack=pulse(p.attack,.32),cast=pulse(p.castTime,.45),hit=pulse(p.hitTime,.2);
 const length=Math.hypot(p.faceX||0,p.faceY||0)||1;
 return {phase:g.phase,weight:g.weight,time,flying:p.id==='corin',attack,cast,hit,
 x:(p.faceX||0)/length*(attack*9-hit*4),
 y:(p.id==='corin'?-8+Math.sin(time*9)*1.2:0)+(p.faceY||0)/length*attack*6,
 sx:1,sy:1,rotation:0,alpha:p.hitTime>0?.6:1};
}
// Deform a connected texture mesh: joints stay attached to the torso.
function drawArticulatedPet(img,id,width,height,pose,ctx){
 const n=20,sw=img.naturalWidth||img.width,sh=img.naturalHeight||img.height,vertices=[];
 const clamp01=v=>Math.max(0,Math.min(1,v));
 for(let row=0;row<=n;row++)for(let col=0;col<=n;col++){
  const u=col/n,v=row/n;let x=u*width,y=v*height;
  if(pose.direction==='up'||pose.direction==='down'){
   const gait=Math.sin(pose.phase+(u<.5?0:Math.PI)),feet=clamp01((v-.60)/.35);
   if(id==='corin'){const wing=Math.pow(Math.abs(u-.5)*2,1.1)*clamp01((.85-v)/.35);y+=Math.sin(pose.time*9)*height*.10*wing;x+=(u-.5)*Math.sin(pose.time*9)*width*.08;}
   else{y-=Math.max(0,gait)*height*.07*feet*pose.weight;x+=gait*width*.025*feet*pose.weight;if(id==='eryn'||id==='ember_dragon')y+=Math.sin(pose.time*3)*height*.018*Math.abs(u-.5)*2;}
  }else if(id==='corin'){
   const left=clamp01((.53-u)/.42)*clamp01((.7-v)/.4);
   const right=clamp01((u-.7)/.3)*clamp01((.78-v)/.4);
   const beat=Math.sin(pose.time*9);
   y+=height*beat*(left*.30+right*.25);x+=width*beat*(left*.09-right*.09);
  }else{
   // A planted stance followed by a lifted return, with diagonal pairs.
   // The foot travels backward during stance as the body moves forward.
   const leg=clamp01((v-.54)/.36),front=u>.56;
   const smooth=(a,b,x)=>{const t=clamp01((x-a)/(b-a));return t*t*(3-2*t)};
   const pairing=smooth(.28,.37,u)-smooth(.53,.61,u)+smooth(.73,.82,u);
   const phase=pose.phase+pairing*Math.PI;
   const cycle=((phase/(Math.PI*2))%1+1)%1,stance=.6;
   const swing=clamp01((cycle-stance)/(1-stance));
   const stride=cycle<stance?1-2*cycle/stance:-Math.cos(swing*Math.PI);
   const lift=cycle<stance?0:Math.sin(swing*Math.PI);
   const legRegion=clamp01((u-.19)/.09);
   const knee=Math.sin(leg*Math.PI)*lift;
   x+=(stride*width*.125*leg + knee*width*.045)*legRegion*pose.weight;
   y-=lift*height*.115*leg*legRegion*pose.weight;
   // Tail motion fades smoothly into the hip.
   const tail=clamp01((.35-u)/.3)*clamp01((v-.35)/.2);
   y+=Math.sin(pose.time*3+u*4)*height*.022*tail;
   // Shoulder breathing is subtle and does not lift the feet.
   y-=Math.sin(pose.time*2.4)*height*.004*Math.sin(v*Math.PI);
   if(id==='eryn'||id==='ember_dragon'){
    const wing=clamp01((.56-v)/.3)*clamp01((.7-u)/.3);
    y+=Math.sin(pose.time*2)*height*.025*wing;
   }
  }
  vertices.push({x:x-width/2,y:y-height*.88,u:u*sw,v:v*sh});
 }
 function triangle(a,b,c){
  const ux=b.u-a.u,uy=b.v-a.v,vx=c.u-a.u,vy=c.v-a.v,det=ux*vy-uy*vx;
  const ax=b.x-a.x,ay=b.y-a.y,bx=c.x-a.x,by=c.y-a.y;
  const A=(ax*vy-bx*uy)/det,B=(ay*vy-by*uy)/det,C=(bx*ux-ax*vx)/det,D=(by*ux-ay*vx)/det;
  ctx.save();ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.lineTo(c.x,c.y);ctx.closePath();ctx.clip();
  ctx.transform(A,B,C,D,a.x-A*a.u-C*a.v,a.y-B*a.u-D*a.v);ctx.drawImage(img,0,0);ctx.restore();
 }
 for(let r=0;r<n;r++)for(let c=0;c<n;c++){const i=r*(n+1)+c;triangle(vertices[i],vertices[i+1],vertices[i+n+1]);triangle(vertices[i+1],vertices[i+n+2],vertices[i+n+1]);}
}
const petFrameCache=new Map();
function drawPetFrame(img,id,width,height,pose){
 const flying=id==='corin',moving=pose.weight>.15;
 const phase=flying?pose.time*9:moving?pose.phase:pose.time*2.4;
 const frame=((Math.round(phase/(Math.PI*2)*24)%24)+24)%24;
 const key=id+':'+(pose.direction||'side')+':'+(moving?'walk':'idle')+':'+frame;
 let cached=petFrameCache.get(key);
 if(!cached){
  cached=document.createElement('canvas');
  const density=2,pad=width*.4;
  cached.width=Math.ceil((width+pad*2)*density);cached.height=Math.ceil((height+pad*2)*density);
  const target=cached.getContext('2d');
  target.scale(density,density);target.translate(pad+width/2,pad+height*.88);
  const quantized=frame/24*Math.PI*2;
  drawArticulatedPet(img,id,width,height,{...pose,phase:quantized,weight:moving?1:0,time:quantized/(flying?9:2.4)},target);
  petFrameCache.set(key,cached);
 }
 const pad=width*.4;
 ctx.drawImage(cached,-pad-width/2,-pad-height*.88,cached.width/2,cached.height/2);
}
function drawPet(p){
 const direction=petFacing(p),directional=petDirectionalImages[p.id]?.[direction],img=directional||petImages[p.id];if(!img||(!directional&&(!img.complete||!img.naturalWidth)))return true;
 const pose={...petAnimationPose(p,animationClock),direction:directional?direction:'side'};
 const size={dalen:74,sylvi:70,corin:68,eryn:92,ember_dragon:96}[p.id],sw=img.naturalWidth||img.width,sh=img.naturalHeight||img.height;
 const width=directional?size*sw/Math.max(sw,sh):size,height=directional?size*sh/Math.max(sw,sh):size*sh/sw;
 ctx.save();
 // Casting ring stays on the ground while the creature rises above it.
 if(pose.cast>0){ctx.save();ctx.translate(p.x,p.y);ctx.globalAlpha=pose.cast*.65;ctx.strokeStyle=petDefs[p.id].accent;ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(0,0,width*(.24+pose.cast*.12),8+pose.cast*4,0,0,Math.PI*2);ctx.stroke();ctx.restore();}
 ctx.translate(p.x+pose.x,p.y+pose.y);
 if(direction==='left')ctx.scale(-1,1);
 ctx.rotate(pose.rotation);ctx.scale(pose.sx,pose.sy);
 ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';ctx.globalAlpha=pose.alpha;
 drawPetFrame(img,p.id,width,height,pose);
 ctx.restore();return true;
}
function renderPetCollection(message=''){
 normalizePets();document.getElementById('partyNotice').textContent=message||'One loyal pet at your side · Pet level '+petLevel()+' · Half your level, rounded down (minimum 1).';
 document.getElementById('petWallet').textContent=player.coins+' crowns · All adoptions use earned game currency.';
 document.getElementById('partyMembers').innerHTML=Object.entries(petDefs).map(([id,d])=>{const p=companions.find(c=>c.id===id),owned=!!p,unlocked=petUnlocked(id),ready=unlocked&&player.coins>=d.cost;
 return '<article class="petCard petTier'+d.tier+(p?.active?' petFollowing':'')+'"><div class="petCardTop">'+petPortrait(id)+'<div><span class="petTierLabel">'+d.tierName+'</span><h3>'+d.name+' <small>'+d.species+'</small></h3><p>Level '+petLevel()+' · '+d.skill+'</p></div></div><p class="petStory">'+d.story+'</p><p class="petStats">'+(owned?'Vitality '+p.hp+'/'+p.max+' · Attack '+petAttackPower(p)+' · Guard '+petGuard(p):'Vitality '+petMaxHealth(id)+' · '+d.unlock)+'</p><div class="petCardActions">'+(owned?'<button type="button" data-pet-active="'+id+'" '+(p.hp<=0?'disabled':'')+' aria-pressed="'+p.active+'">'+(p.hp<=0?'Resting · visit a healer':p.active?'Following · Rest':'Bring along')+'</button>':'<button type="button" data-pet-adopt="'+id+'" '+(!ready?'disabled':'')+'>'+(unlocked?(d.cost?'Adopt · '+d.cost+' crowns':'Bond · Free'):'Story locked')+'</button>')+'<button type="button" data-pet-story="'+id+'">Read story</button></div></article>';
 }).join('');
}
function installPetUI(){
 const panel=document.querySelector('#partyScreen .screenPanel');panel.classList.add('petPanel');document.getElementById('partyTitle').textContent='Pet Sanctuary';panel.querySelector('.screenHead p').textContent='A small companion. A story of their own.';panel.querySelector('.screenClose').setAttribute('aria-label','Close pet sanctuary');
 const layout=panel.querySelector('.partyLayout');layout.className='petCollection';layout.innerHTML='<div id="petWallet" class="petWallet"></div><div id="partyMembers" class="petGrid"></div>';
 panel.querySelector('.screenFoot span').textContent='Pets follow, attack, and use their skills automatically. A town healer revives resting pets.';
 const button=document.querySelector('[data-character-action="party"]');button.textContent='Manage Pets';
 const options=document.getElementById('optionsMenu').querySelector('.optionsCard'),b=document.createElement('button');b.type='button';b.textContent='PET SANCTUARY · 1.0.6';b.id='petSanctuaryButton';b.addEventListener('click',()=>{document.getElementById('optionsMenu').hidden=true;openPartyScreen()});options.insertBefore(b,options.querySelector('.optionsDone'));
 const stats=document.querySelector('.hud .stats'),pill=document.createElement('button');pill.type='button';pill.id='petStatusButton';pill.className='petStatusButton';pill.setAttribute('aria-label','Open pet sanctuary');pill.addEventListener('click',openPartyScreen);stats.appendChild(pill);
 panel.addEventListener('click',e=>{const b=e.target.closest('[data-pet-active],[data-pet-adopt],[data-pet-story]');if(!b||b.disabled)return;if(b.dataset.petActive)setCompanionActive(b.dataset.petActive);else if(b.dataset.petAdopt)petStory(b.dataset.petAdopt);else petStory(b.dataset.petStory);});
}

function applySavedGame(save){if(!save)return;if(save.player)Object.assign(player,save.player);player.class=classDefs[player.class]?player.class:'warrior';player.gender=normalizedHeroGender(save.player?.gender,player.class);const safeClass=classDefs[player.class];player.speed=Number.isFinite(Number(player.speed))&&Number(player.speed)>0?Number(player.speed):safeClass.speed;player.max=Number.isFinite(Number(player.max))&&Number(player.max)>0?Number(player.max):safeClass.hp;player.hp=Number.isFinite(Number(player.hp))?Math.max(1,Math.min(player.max,Number(player.hp))):player.max;player.x=Number(player.x);player.y=Number(player.y);if(!Number.isFinite(player.x)||!Number.isFinite(player.y)){const fallback=maps[save.mapId]?.arrival||[480,500];player.x=fallback[0];player.y=fallback[1]}hasStarted=!!(save.player&&save.player.name&&classDefs[save.player.class]);defeated=Number(save.defeated)||0;done=!!save.done;hasSigil=!!save.hasSigil;hasFourfoldKey=!!save.hasFourfoldKey||!!save.hasSigil||!!save.deepQuestDone;townRelicState=save.townRelicState&&typeof save.townRelicState==='object'?{ashvale:!!save.townRelicState.ashvale,sunmere:!!save.townRelicState.sunmere,brackenford:!!save.townRelicState.brackenford,stonewatch:!!save.townRelicState.stonewatch}:{ashvale:false,sunmere:false,brackenford:false,stonewatch:false};if(!save.hasFourfoldKey&&(save.hasSigil||save.deepQuestDone))townRelicState={ashvale:true,sunmere:true,brackenford:true,stonewatch:true};huntRewarded=!!save.huntRewarded;shrineRewarded=!!save.shrineRewarded;deepQuestDone=!!save.deepQuestDone;houseBought=!!save.houseBought;ownedHomes=save.ownedHomes&&typeof save.ownedHomes==='object'?{ashvale:!!save.ownedHomes.ashvale,brackenford:!!save.ownedHomes.brackenford||!!save.houseBought,stonewatch:!!save.ownedHomes.stonewatch,sunmere:!!save.ownedHomes.sunmere}:{ashvale:false,brackenford:!!save.houseBought,stonewatch:false,sunmere:false};townQuestState=save.townQuestState&&typeof save.townQuestState==='object'?save.townQuestState:{};houseStorage=normalizeHouseStorage(save.houseStorage);companions=Array.isArray(save.companions)?save.companions.filter(c=>c&&petDefs[c.id]).map(c=>({...makeCompanion(c.id),...c,petVersion:c.petVersion===1?1:0})):[];let activeSeen=0;for(const c of companions)if(c.active){activeSeen++;if(activeSeen>3)c.active=false}selectedCompanionId=companions[0]?.id||null;if(save.mapId&&maps[save.mapId])setMap(save.mapId,player.x,player.y,false);gatheringSkills=normalizeGatheringSkills(save.gatheringSkills);gearUpgradeLevels=save.gearUpgradeLevels&&typeof save.gearUpgradeLevels==='object'?Object.fromEntries(Object.entries(save.gearUpgradeLevels).map(([id,rank])=>[id,Math.max(0,Math.min(gearUpgradeCap(id),Math.floor(Number(rank)||0)))])):{};if(save.mapStates)for(const id of Object.keys(maps)){const saved=save.mapStates[id];if(saved&&Array.isArray(saved.gatherNodes))saved.gatherNodes.forEach((readyAt,i)=>{if(maps[id].gatherNodes&&maps[id].gatherNodes[i])maps[id].gatherNodes[i].readyAt=Math.max(0,Number(readyAt)||0)});if(saved&&Array.isArray(saved.enemies))saved.enemies.forEach((e,i)=>{const enemy=maps[id].enemies[i];if(!enemy)return;const nextMax=enemyMaxForLevel(enemy,regionCombatLevel(id)),savedMax=Math.max(1,Number(e.maxHp)||enemy.baseHp||1),savedHp=Number(e.hp)||0;enemy.maxHp=nextMax;Object.assign(enemy,{x:e.x,y:e.y,spawnX:Number.isFinite(e.spawnX)?e.spawnX:enemy.spawnX,spawnY:Number.isFinite(e.spawnY)?e.spawnY:enemy.spawnY,hp:savedHp>0?Math.max(1,Math.ceil(savedHp/savedMax*nextMax)):0,alive:e.alive,lootClaimed:!!e.lootClaimed,respawnAt:e.respawnAt||0})});if(saved&&Array.isArray(saved.runes))saved.runes.forEach((on,i)=>{if(maps[id].runes&&maps[id].runes[i])maps[id].runes[i].on=!!on});if(saved&&Number.isFinite(Number(saved.runeProgress)))maps[id].runeProgress=Math.max(0,Math.min((maps[id].runeSequence||[]).length,Number(saved.runeProgress)));else if(id==='mosslight'&&!hasSigil){maps[id].runes.forEach(r=>r.on=false);maps[id].runeProgress=0}if(saved&&Array.isArray(saved.traps))saved.traps.forEach((armed,i)=>{if(maps[id].traps&&maps[id].traps[i])maps[id].traps[i].armed=!!armed});if(saved&&saved.chest&&maps[id].chest)maps[id].chest.open=!!saved.chest.open;if(saved&&saved.treasure&&maps[id].treasure)maps[id].treasure.opened=!!saved.treasure.opened}for(const m of Object.values(maps))if(m.town||m.interior)m.enemies.length=0;if(!save.mapStates&&Array.isArray(save.enemies))save.enemies.forEach((e,i)=>{const enemy=enemies[i];if(!enemy)return;const savedMax=Math.max(1,Number(e.maxHp)||enemy.baseHp||1),savedHp=Number(e.hp)||0;Object.assign(enemy,{x:e.x,y:e.y,hp:savedHp>0?Math.max(1,Math.ceil(savedHp/savedMax*enemy.maxHp)):0,alive:e.alive,lootClaimed:!!e.lootClaimed,respawnAt:e.respawnAt||0})});if(done&&!huntRewarded){huntRewarded=true;player.coins+=20;grantXp(20)}if(hasSigil&&!shrineRewarded){shrineRewarded=true;player.coins+=30;grantXp(25)}refreshTownRelics(false);const savedBounds=worldBounds();player.x=clamp(player.x,savedBounds.minX,savedBounds.maxX);player.y=clamp(player.y,savedBounds.minY,savedBounds.maxY);syncHeroStats();applyDanTestProfile();normalizePets();restoreTownPolitics()}
const freshCharacterState=snapshotGameState();
let legacySave=null;try{legacySave=JSON.parse(localStorage.getItem(SAVE_KEY)||'null');const hasSlotStore=localStorage.getItem(SAVE_SLOTS_KEY)!==null;saveSlots=JSON.parse(localStorage.getItem(SAVE_SLOTS_KEY)||'{}');if(!saveSlots||Array.isArray(saveSlots)||typeof saveSlots!=='object')saveSlots={};if(!hasSlotStore&&legacySave){saveSlots.slot1={id:'slot1',name:legacySave.player?.name||'Hero',class:legacySave.player?.class||'warrior',level:legacySave.player?.level||1,updated:Date.now(),state:legacySave};localStorage.setItem(SAVE_SLOTS_KEY,JSON.stringify(saveSlots))}activeSlotId=localStorage.getItem(ACTIVE_SLOT_KEY)||'slot1';if(!SAVE_SLOT_IDS.includes(activeSlotId))activeSlotId='slot1';const selectedRecord=saveSlots[activeSlotId];applySavedGame(selectedRecord?(selectedRecord.state||selectedRecord):null)}catch{}
function snapshotGameState(){const mapStates={};for(const id of Object.keys(maps)){const m=maps[id];mapStates[id]={enemies:m.enemies.map(e=>({x:e.x,y:e.y,spawnX:e.spawnX,spawnY:e.spawnY,hp:e.hp,maxHp:e.maxHp,alive:e.alive,lootClaimed:!!e.lootClaimed,respawnAt:e.respawnAt||0})),runes:(m.runes||[]).map(r=>r.on),runeProgress:Number(m.runeProgress)||0,traps:(m.traps||[]).map(t=>t.armed),chest:m.chest?{open:m.chest.open}:null,treasure:m.treasure?{opened:m.treasure.opened}:null,gatherNodes:(m.gatherNodes||[]).map(node=>Math.max(0,Number(node.readyAt)||0))}}const data={gatheringSkills,gearUpgradeLevels,player:{name:player.name,class:player.class,gender:player.gender,x:player.x,y:player.y,hp:player.hp,max:player.max,speed:player.speed,xp:player.xp,level:player.level,coins:player.coins,inventory:player.inventory,weapon:player.weapon,armor:player.armor,shield:player.shield,earrings:player.earrings,necklace:player.necklace,legs:player.legs,boots:player.boots},mapId,defeated,done,hasSigil,hasFourfoldKey,townRelicState,huntRewarded,shrineRewarded,deepQuestDone,houseBought:ownsHome('brackenford'),ownedHomes,townQuestState,houseStorage,companions,mapStates};return JSON.parse(JSON.stringify(data))}
function saveGame(){if((window.regionalPanelOpen&&window.regionalPanelOpen())||window.jarvisPaused||titleMenuActive||!hasStarted||switchingCharacter)return;try{const data=snapshotGameState();localStorage.setItem(SAVE_KEY,JSON.stringify(data));saveSlots[activeSlotId]={id:activeSlotId,name:player.name,class:player.class,level:player.level,updated:Date.now(),state:data};localStorage.setItem(SAVE_SLOTS_KEY,JSON.stringify(saveSlots));localStorage.setItem(ACTIVE_SLOT_KEY,activeSlotId)}catch{}}
function applyDanCompanionGear(c){
 return; // Test-only changes are disabled in the public build.
 if(String(player.name||'').trim().toLowerCase()!=='dan')return;
 const profile=classGearProfiles[c.class];if(!profile)return;
 for(const slot of GEAR_SLOTS){const id=setGearId(c.class,5,slot);c[slot]=id;gearUpgradeLevels[id]=gearUpgradeCap(id);}
}
function makeCompanion(id){const d=petDefs[id];if(!d)return null;const max=petMaxHealth(id);return {id,petId:id,petVersion:1,name:d.name,class:d.class,gender:'male',hp:max,max,level:petLevel(),xp:0,active:true,cool:0,skillCool:0,attack:0,x:player.x,y:player.y,faceX:1,faceY:0,weapon:null,armor:null,shield:null,earrings:null,necklace:null,legs:null,boots:null};}
function activeCompanions(){return companions.filter(p=>petDefs[p.id]&&p.active&&p.hp>0).slice(0,1)}
function gearUpgradeCap(id){return itemDefs[id]?.tier>=3?5:Object.values(classGearQuests).some(q=>q.item===id)?5:3}function gearUpgradeRank(id){return Math.max(0,Math.min(gearUpgradeCap(id),Number(gearUpgradeLevels[id])||0))}function gearStat(id,stat){const item=itemDefs[id];if(!item||!Number(item[stat]))return 0;return Number(item[stat])+(['bonus','guard'].includes(stat)?gearUpgradeRank(id):0)}
function classGrowth(hero=player.class){return {warrior:{health:12,damage:1},rogue:{health:9,damage:1},mage:{health:8,damage:.92},cleric:{health:10,damage:.94}}[hero]||{health:12,damage:1}}
function veteranProgress(level=player.level){const excess=Math.max(0,level-100);return excess/(excess+100)}
function heroMaxHealth(hero=player.class,level=player.level){return classDefs[hero].hp+Math.max(0,level-1)*classGrowth(hero).health+(hero==='warrior'?Math.max(0,level-100)*3:0)}
function syncHeroStats(){const ratio=Math.max(0,Math.min(1,player.hp/Math.max(1,player.max)));player.max=heroMaxHealth();player.hp=Math.max(1,Math.min(player.max,Math.round(player.max*ratio)));player.speed=classDefs[player.class].speed*(player.class==='rogue'?1+.15*veteranProgress():1)}
function playerAttackCooldown(){return classDefs[player.class].cooldown*(player.class==='rogue'?1-.2*veteranProgress():1)}
function playerDodgeCooldown(){return (player.class==='rogue'?2:2.5)*(player.class==='rogue'?1-.2*veteranProgress():1)}
function healingPower(base){return Math.ceil(base*(player.class==='cleric'?1+.4*veteranProgress():1))}
function classAdvantage(){return {warrior:'Warrior advantage: highest vitality; broad Sweep staggers nearby foes.',rogue:'Rogue advantage: fastest movement and strikes; 2-second dodge cooldown; focused Ambush burst.',mage:'Mage advantage: ranged attacks and earned area/control spells; casting slows movement.',cleric:'Cleric advantage: healing on kills and Holy Pulse recovery for nearby allies.'}[player.class]}
function veteranDescription(){const p=veteranProgress();if(player.level<=100)return 'Veteran bonus unlocks at level 101.';return {warrior:'Iron Resolve: +'+(player.level-100)*3+' vitality and '+(p*15).toFixed(1)+'% less incoming damage.',rogue:'Shadow Tempo: '+(p*20).toFixed(1)+'% shorter attack/dodge cooldowns; +'+(p*15).toFixed(1)+'% movement speed.',mage:'Arcane Ascendance: +'+(p*30).toFixed(1)+'% spell damage and +'+Math.round(p*40)+' spell range.',cleric:'Enduring Grace: +'+(p*40).toFixed(1)+'% healing from your class abilities.'}[player.class]}

function playerAttackPower(){const weaponBonus=equipmentStat(player,'bonus')+gearSetBonus(player).attack;const base=classDefs[player.class].damage+(buildAttack()+weaponBonus+(hasSigil?1:0)+Math.max(0,player.level-1)/3)*classDefs[player.class].cooldown/.42*classGrowth().damage;return Math.max(1,Math.round(base*vampirePower()))}
function companionAttackPower(c){return petAttackPower(c)}
// Solo encounter scaling requested by Dan: every monster rises with the hero.
function encounterLevel(e={},heroLevel=player.level,regionLevel=regionCombatLevel()){
 const floor=Math.max(1,Math.floor(Number(e.combatLevel)||1),Math.floor(Number(regionLevel)||1)),hero=Math.max(1,Math.floor(Number(heroLevel)||1));
 return Math.max(floor,hero+(e.roamingElite?20:e.boss?2:0));
}
function enemyLevel(e={}){return encounterLevel(e)}
function enemyMaxForLevel(e,regionLevel,heroLevel=player.level){const level=encounterLevel(e,heroLevel,regionLevel),base=Math.max(1,e.combatBaseHp||e.baseHp||1);return Math.max(12+6*(level-1),Math.ceil(base*2)+4*(level-1))}
function scaleEnemiesForRegion(){for(const e of enemies){const oldMax=Math.max(1,e.maxHp||e.baseHp||e.hp||1),nextMax=enemyMaxForLevel(e,regionCombatLevel());if(e.alive&&nextMax!==oldMax)e.hp=Math.max(1,Math.ceil((e.hp/oldMax)*nextMax));e.maxHp=nextMax}}
function enemyAttackDamage(e){return 7+Math.floor((encounterLevel(e)-1)*1.8)}
function enemyRewards(e,heroLevel=player.level,regionLevel=regionCombatLevel()){const level=encounterLevel(e,heroLevel,regionLevel);return {xp:Math.max(1,Math.round((14+4*(level-1))*(e.boss?2:1))),coins:(3+Math.floor((level-1)/2))*(e.boss?2:1)}}
function snapCompanionsToPlayer(){const formation=[[-68,38],[68,38],[0,108]],bounds=worldBounds();activeCompanions().forEach((c,index)=>{if(c.hp<=0)return;const [ox,oy]=formation[index];Object.assign(c,safeMapPosition(mapId,clamp(player.x+ox,bounds.minX+18,bounds.maxX-18),clamp(player.y+oy,bounds.minY+28,bounds.maxY-18),14,[player,...activeCompanions().slice(0,index)]))})}
function interactCompanion(n){if(!petDefs[n.companionId])return false;selectedCompanionId=n.companionId;openPartyScreen();renderParty(n.name+' tends the sanctuary. Their town quests still help protect the Reach.');return true}
function openPartyScreen(){preparePanel('partyScreen');keys.clear();saveFilesScreen.hidden=true;characterScreen.hidden=true;inventoryScreen.hidden=true;shopScreen.hidden=true;storageScreen.hidden=true;questScreen.hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;partyScreen.hidden=false;renderParty();refreshPanelState()}
function companionCanUse(id,c){return gearRequirements(id,c)}
function renderParty(message=''){renderPetCollection(message)}
function equipCompanionItem(){renderParty('Pets grow naturally with you and do not wear hero equipment.');}
function unequipCompanionItem(){renderParty('Legacy companion equipment has been returned to your bag.');}
function setCompanionActive(id){const p=companions.find(c=>c.id===id);if(!p)return;if(p.hp<=0){renderParty(p.name+' needs a town healer before returning.');return}const bring=!p.active;for(const c of companions)c.active=false;p.active=bring;selectedCompanionId=id;snapCompanionsToPlayer();saveGame();ui();renderParty(p.name+(bring?' is following you.':' is resting safely.'));}
function bindPartyControl(event){const button=event.target.closest('[data-party-select],[data-party-active],[data-party-equip],[data-party-unequip]');if(!button||button.disabled||!partyScreen.contains(button))return;if(button.dataset.partySelect){selectedCompanionId=button.dataset.partySelect;renderParty()}else if(button.dataset.partyActive)setCompanionActive(button.dataset.partyActive);else if(button.dataset.partyEquip)equipCompanionItem(button.dataset.partyEquip);else if(button.dataset.partyUnequip)unequipCompanionItem(button.dataset.partyUnequip)}

function useCompanionSkill(p,dt){p.skillCool=Math.max(0,(p.skillCool||0)-dt);if(p.hp<=0||!p.active||activeMap.town||p.skillCool>0)return;const targets=enemies.filter(e=>e.alive&&Math.hypot(e.x-p.x,e.y-p.y)<(p.class==='mage'?210:90)&&clearCombatLine(p.x,p.y,e.x,e.y)).sort((a,b)=>Math.hypot(a.x-p.x,a.y-p.y)-Math.hypot(b.x-p.x,b.y-p.y));const power=petAttackPower(p);if(p.id==='corin'){const allies=[player,p].filter(a=>a.hp>0&&a.hp<a.max*.8&&Math.hypot(a.x-p.x,a.y-p.y)<180);if(!allies.length)return;for(const a of allies){const heal=Math.min(a.max-a.hp,8+p.level*2);a.hp+=heal;combatText(a.x,a.y-28,'+'+heal,'#bcebc4')}battleVfx('Portal',p.x,p.y-15,80);}else{if(!targets.length)return;const t=targets[0],aim=Math.hypot(t.x-p.x,t.y-p.y)||1;p.faceX=(t.x-p.x)/aim;p.faceY=(t.y-p.y)/aim;const area=p.id==='ember_dragon'?85:p.id==='eryn'?55:p.id==='dalen'?55:0;const victims=area?targets.filter(e=>Math.hypot(e.x-t.x,e.y-t.y)<=area):[t];const multiplier=p.id==='sylvi'?2.4:p.id==='ember_dragon'?2.2:1.6;for(const e of victims)damageEnemy(e,Math.max(1,Math.round(power*multiplier)),p.id==='dalen'?.5:0,p);battleVfx(p.class==='mage'?'Fire_Ball':'Wind',t.x,t.y-15,area?95:55);}
 p.skillCool=p.id==='ember_dragon'?9:p.id==='corin'?8:7;p.castTime=.45;p.attack=.32;p.cool=.5;combatText(p.x,p.y-45,petDefs[p.id].skill,petDefs[p.id].accent);ui();saveGame();}
function updateCompanions(dt){
 const active=activeCompanions(),formation=[[-68,38],[68,38],[0,108]],bounds=worldBounds();
 active.forEach((c,index)=>{c.cool=Math.max(0,(c.cool||0)-dt);c.attack=Math.max(0,(c.attack||0)-dt);if(c.hp<=0)return;const [ox,oy]=formation[index],def=classDefs[c.class];let target=null,best=Infinity;
 if(!activeMap.town)for(const e of enemies){const d=Math.hypot(e.x-c.x,e.y-c.y);if(e.alive&&Math.hypot(e.x-player.x,e.y-player.y)<240&&d<best&&clearCombatLine(c.x,c.y,e.x,e.y)){best=d;target=e}}
 let tx=player.x+ox,ty=player.y+oy;
 if(target){const angle=Math.atan2(c.y-target.y,c.x-target.x)+(index-1)*.15,distance=c.class==='mage'?125:c.class==='cleric'?48:40;tx=target.x+Math.cos(angle)*distance;ty=target.y+Math.sin(angle)*distance}
 const warning=c.human?enemies.find(e=>e.alive&&e.swing&&e.windup>0&&Math.hypot(c.x-e.swing.x,c.y-e.swing.y)<e.swing.radius+20):null;
 if(warning){const a=Math.atan2(c.y-warning.swing.y,c.x-warning.swing.x)||((index+1)*2);tx=warning.swing.x+Math.cos(a)*(warning.swing.radius+44);ty=warning.swing.y+Math.sin(a)*(warning.swing.radius+44)}
 tx=clamp(tx,bounds.minX+18,bounds.maxX-18);ty=clamp(ty,bounds.minY+28,bounds.maxY-18);c.moving=steerActor(c,tx,ty,warning?230:190,dt,14);
 for(const other of [player,...active.slice(0,index)])if(Math.hypot(c.x-other.x,c.y-other.y)<30){const d=Math.hypot(c.x-other.x,c.y-other.y)||1,nx=c.x+(c.x-other.x)/d*4,ny=c.y+(c.y-other.y)/d*4;if(!overlaps(nx,ny,14)){c.x=nx;c.y=ny}}
 if(Math.hypot(c.x-player.x,c.y-player.y)>380||overlaps(c.x,c.y,14))Object.assign(c,safeMapPosition(mapId,player.x+ox,player.y+oy,14,[player,...active.slice(0,index)]));
 useCompanionSkill(c,dt);if(!target||warning||c.cool>0||Math.hypot(target.x-c.x,target.y-c.y)>def.range||!clearCombatLine(c.x,c.y,target.x,target.y))return;c.cool=Math.max(.45,def.cooldown*1.35);c.attack=.32;const aim=Math.hypot(target.x-c.x,target.y-c.y)||1;c.faceX=(target.x-c.x)/aim;c.faceY=(target.y-c.y)/aim;damageEnemy(target,companionAttackPower(c),0,c);
 });
}
function finishEnemy(e,killerClass){if(!e.alive)return;vampireKill(e);if(!e.townSiege)recordMageMastery(e,killerClass);tutorialMark('kill');if(e.townSiege){e.alive=false;e.hp=0;e.deathAnim=.6;e.respawnAt=0;combatText(e.x,e.y-25,'Driven back','#e6d29b');if(!maps.frontier_outpost.enemies.some(n=>n.townSiege&&n.alive))endTownSiege(true);saveGame();return;}playSfx('hit');e.alive=false;e.deathAnim=.6;e.respawnAt=e.roamingElite?Date.now()+600000:activeMap.respawnMs&&!e.boss&&!e.eventRegion?Date.now()+activeMap.respawnMs:0;if(mapId==='whisperwood'&&!done)defeated++;const reward=enemyRewards(e);reward.xp=boostedCombatXp(reward.xp);grantXp(reward.xp);player.coins+=reward.coins;let loot='';if(!e.lootClaimed){let drops=[];if(mapId==='emberdeep'){const drop=e.kind==='skeleton'?'bone_shard':e.kind==='spider'?'spider_silk':e.boss?'warden_crest':null;if(drop)drops=[drop]}else{const available=getRegionalDropIds(mapId,e),guaranteed=activeQuestDrops(mapId,e);if(guaranteed.length)drops=guaranteed;else if(available.length&&Math.random()<.35)drops=[available[Math.floor(Math.random()*available.length)]]}const found=drops.filter(id=>addItem(id));if(found.length){e.lootClaimed=true;loot=' · found '+found.map(id=>itemDefs[id].name).join(', ')}}recordQuestKill(mapId,e);recordSlayerKill(mapId,e);if(killerClass&&classDefs[killerClass].heal)player.hp=Math.min(player.max,player.hp+healingPower(Math.max(classDefs[killerClass].heal,Math.floor(player.max*.02))));const slain=e.name||(e.kind==='skeleton'?'Vault skeleton':e.kind==='spider'?'Giant ash spider':e.boss?'Cinder Warden':'Ash slime');if(mapId==='whisperwood'&&defeated>=3&&!done){playSfx('quest');done=true;if(!huntRewarded){huntRewarded=true;player.coins+=20;grantXp(20)}say('First Hunt complete · +20 crowns · +20 XP')}else say(slain+' defeated · +'+reward.xp+' XP, +'+reward.coins+' crowns'+loot);ui();saveGame()}
window.saveGame=saveGame;
function say(s){const t=document.getElementById('toast');t.textContent=s;t.classList.add('show');toastTimer=2.2}
function ui(){refreshXpBoost();refreshTutorialHint();refreshHeroPortrait();syncSettlementName();document.getElementById('hp').style.width=(player.hp/player.max*100)+'%';document.getElementById('hpText').textContent=player.hp+' / '+player.max;document.getElementById('xp').style.width=(Math.min(1,player.xp/xpToNextLevel(player.level))*100)+'%';document.getElementById('xpText').textContent=player.xp+' / '+xpToNextLevel(player.level);document.getElementById('level').textContent=player.level;document.getElementById('coins').textContent=player.coins;document.getElementById('progress').textContent=done?(hasFourfoldKey?(hasSigil?(deepQuestDone?'Complete':'Unlock the Ashvault'):'Enter Mosslight Shrine'):'Town seals '+Object.values(townRelicState).filter(Boolean).length+'/4'):(Math.min(defeated,3)+' / 3');document.getElementById('itemPill').hidden=!hasSigil;document.getElementById('keystonePill').hidden=!hasFourfoldKey;document.getElementById('heroName').textContent=player.name;document.getElementById('className').textContent=classDefs[player.class].title;const title=!done?'First Hunt':!hasFourfoldKey?'The Fourfold Keystone':!hasSigil?'The Ember Rune':!deepQuestDone?'Beneath Ashvale':'Ashvale Remembered';const remaining=Math.max(0,3-Math.min(defeated,3)),details=!done?(mapId==='whisperwood'?'Defeat '+remaining+' Ash Slime'+(remaining===1?'':'s')+' on this trail. Your reward is automatic; no NPC turn-in is needed.':'Use MAPS to locate Whisperwood Trail, walk there, and defeat three Ash Slimes.') :!hasFourfoldKey?'Complete both town quests in each of Ashvale, Sunmere, Brackenford, and Stonewatch to earn the four seals.':!hasSigil?'Travel to Mosslight Shrine, solve West → North → East, then open the chest.':!deepQuestDone?'Travel to Ashvault Depths, defeat its guardian, and open the coffer.':'The Ashvault is quiet again.';document.getElementById('questTitle').textContent=title;document.getElementById('questDetails').textContent=details;campaignHud();refreshMainQuestHud();refreshTrackedQuest();saveGame()}

function questCatalogRaw(){const relicCount=Object.values(townRelicState).filter(Boolean).length;const rows=[...frontierQuestEntries(),...slayerQuestEntries(),{id:'main_hunt',title:'First Hunt',desc:'Go to Whisperwood and defeat three Ash Slimes. Whisperwood lies southwest of Ashvale: travel south to Redfen, then west. Use MAPS to plan your route.',reward:'Reward: 20 crowns · 20 XP',done:huntRewarded,active:!done},{id:'main_seals',title:'The Fourfold Keystone',desc:'Finish all four companions’ personal stories. Each keeper’s story has two chapters in its home town and nearby hunting region; bring back the monster materials each quest requests to earn one seal. The shrine stays closed until Dalen, Sylvi, Corin, and Eryn have all resolved their pasts. Seals collected: '+relicCount+'/4.',reward:'Reward: four town seals joined into the Fourfold Keystone',done:hasFourfoldKey,active:done&&!hasFourfoldKey},{id:'main_rune',title:'The Ember Rune',desc:'At Mosslight Shrine, solve the West → North → East lantern puzzle and claim the chest.',reward:'Reward: Ember Rune · 30 crowns · 25 XP',done:shrineRewarded,active:hasFourfoldKey&&done&&!hasSigil},{id:'main_maze',title:'Rootbound Maze · Floor II',desc:'Read the inscription. Touch North → East → West, open the chest, and descend.',reward:'Reward: shrine passage · 25 crowns · 20 XP',done:!!maps.shrine_rootmaze.chest.open,active:!!hasSigil&&!maps.shrine_rootmaze.chest.open},{id:'main_heart',title:'Heart Chamber · Floor III',desc:'Solve East → West → South, defeat the guardian, and open the shrine heart.',reward:'Reward: 75 crowns · 60 XP',done:!!maps.shrine_heart.treasure.opened,active:!!maps.shrine_rootmaze.chest.open&&!maps.shrine_heart.treasure.opened},{id:'main_vault',title:'Beneath Ashvale',desc:'Enter the Ashvault, defeat the Cinder Warden, and open the treasure coffer.',reward:'Reward: 50 crowns · 35 XP',done:deepQuestDone,active:hasSigil&&!deepQuestDone}];for(const [id,d] of Object.entries(storyDungeons)){rows.push({id:'story_'+id,title:d.name,desc:'Find the entrance in '+maps[d.parent].name+'. '+d.hint+' Defeat every guard and claim the cache.'+(storyPortalLock(id)?' Unlock: '+storyPortalLock(id):''),reward:'Reward: story heart · 5 Ancient Alloy · '+d.coins+' crowns · '+d.xp+' XP',done:storyCleared(id),active:!storyPortalLock(id)&&!storyCleared(id)})}
for(const [id,q] of Object.entries(companionEpilogues)){rows.push({id:'epilogue_'+id,title:q.title,desc:q.text+' Travel with this companion and finish both town chapters; then find their epilogue marker on the east side of '+maps[q.town].name+'.',reward:'Choose a permanent companion bonus: +1 attack or +2 defense · 35 XP',done:!!townQuestState['epilogue_'+id]?.claimed,active:q.quests.every(key=>townQuestState[key]?.claimed)&&companions.some(c=>c.id===id)})}
rows.push({id:'crossroads_medicine',title:'Medicine at the Crossroads',desc:'Bring a Small Healing Potion to the wounded traveler in Coast Road. Decide who receives it.',reward:'Choose: 35 crowns and a roadside healer, or 75 crowns · 25 XP',done:!!townQuestState.crossroads_medicine?.claimed,active:!!townQuestState.crossroads_medicine?.accepted});
const secrets=hiddenTrailCaches.filter(c=>townQuestState[c.id]?.claimed).length;rows.push({id:'main_caches',title:'Caches off the Beaten Path',desc:'Search the edges of Westwood, Coast Road, and Southwood. Hidden caches found: '+secrets+'/3.',reward:'Each cache: Ancient Alloy · 30 crowns · 20 XP',done:secrets===3,active:secrets>0});
for(const [id,q] of Object.entries(classGearQuests)){const st=townQuestState[id]||{},progress=q.type==='waystones'?(st.waystones||[]).length:st.progress||0;rows.push({id,title:q.title,desc:classGearQuestDetail(q)+' Progress: '+progress+'/'+q.target+'. '+(st.accepted?'Return to ':'Start at ')+maps[q.town].name+' armory. Complete that class’s weapon, armor, and shield quests in order.',reward:'Reward: '+itemDefs[q.item].name+' ('+classDefs[q.hero].title+' only) · '+q.coins+' crowns · '+q.xp+' XP',done:!!st.claimed,active:!!st.accepted&&!st.claimed})}for(const [id,q] of Object.entries(worldQuestDefs)){const st=townQuestState[id]||{},left=maps.meadowroad.enemies.filter(e=>e.worldBandit&&e.alive).length;rows.push({id,title:q.title,desc:id==='world_watchtower'?'Explore North Ridge, directly north of Sunmere. Read the tablet, light the beacons in its order, then open the cache. Beacons: '+(st.progress||0)+'/3.':'Explore Meadow Road, directly south of Stonewatch. Defeat the four camp guards and free the traveler at the cage. Guards remaining: '+left+'.',reward:'Reward: '+itemDefs[q.item].name+' · '+q.coins+' crowns · '+q.xp+' XP',done:!!st.claimed,active:!!st.accepted&&!st.claimed})}for(const [id,q] of Object.entries(townQuestDefs)){const st=townQuestState[id]||{};rows.push({id,title:q.title,desc:q.arc+' · '+q.desc+' ('+q.town+') · kills '+(st.kills||0)+'/'+q.target+(q.drop?' · '+(bagCount(q.drop)||0)+'/'+q.dropTarget+' '+itemDefs[q.drop].name:''),reward:'Reward: '+q.coins+' crowns · '+q.xp+' XP',done:!!st.claimed,active:!!st.accepted&&!st.claimed})}for(const [id,d] of Object.entries(regionalAdventures)){const st=townQuestState['regional_'+id]||{};rows.push({id:'regional_'+id,title:d.title,desc:maps[id].name+' · '+d.text,reward:d.coins+' crowns · '+itemDefs[d.reward].name+' ×'+d.amount,done:!!st.claimed,active:!!st.accepted&&!st.claimed})}rows.push({id:'wayfarer_compass',title:'The Lost Wayfarer’s Compass',desc:'Read THE LOST COMPASS in Ashvale. Complete the guarded rune trials in Westwood, Ice Coast, and Southwood, then defeat the Roadbound Guardian and both warders at the Compass Vault in North Ridge. Recommended level 12+, upgraded gear, a pet, and healing supplies.',reward:'Wayfarer’s Compass · reusable fast travel · 150 crowns · 100 XP',done:!!townQuestState.wayfarer_compass?.claimed,active:!!townQuestState.wayfarer_compass?.accepted});return rows;}
function openQuestJournal(){preparePanel('questScreen');keys.clear();saveFilesScreen.hidden=true;characterScreen.hidden=true;renderQuests();inventoryScreen.hidden=true;shopScreen.hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;questScreen.hidden=false;refreshPanelState()}
function bagUnits(){return (player.inventory||[]).reduce((n,row)=>n+(itemDefs[row.id]?.category==='quest'?0:row.count),0)}
function bagCount(id){const row=(player.inventory||[]).find(x=>x.id===id);return row?row.count:0}
function grantQuestArtifact(id){if(!itemDefs[id]||itemDefs[id].category!=='quest')return false;if(!player.inventory.some(row=>row.id===id))player.inventory.push({id,count:1});return true}
function addItem(id,amount=1){if(!itemDefs[id]||bagUnits()+amount>bagLimit())return false;let row=player.inventory.find(x=>x.id===id);if(!row){row={id,count:0};player.inventory.push(row)}row.count+=amount;return true}
function removeItem(id,amount=1){const row=player.inventory.find(x=>x.id===id);if(!row||row.count<amount)return false;row.count-=amount;if(row.count<=0)player.inventory=player.inventory.filter(x=>x.id!==id);return true}
const HOME_CHEST_CAPACITY=24;let activeStorageChest='front_chest';
function storageUnits(id){return (houseStorage[activeStorageHome]?.[id]||[]).reduce((n,row)=>n+(Number(row.count)||0),0)}
function moveToStorage(id){const bag=player.inventory.find(x=>x.id===id);if(!bag)return;if(storageUnits(activeStorageChest)>=HOME_CHEST_CAPACITY){document.getElementById('storageNotice').textContent='This chest is full.';return}if(!removeItem(id,1))return;if(bag.count<=0){for(const slot of GEAR_SLOTS)if(player[slot]===id)player[slot]=null}let stored=houseStorage[activeStorageHome][activeStorageChest].find(x=>x.id===id);if(!stored){stored={id,count:0};houseStorage[activeStorageHome][activeStorageChest].push(stored)}stored.count++;document.getElementById('storageNotice').textContent='Stored '+itemDefs[id].name+'.';saveGame();renderStorage()}
function takeFromStorage(id){const rows=houseStorage[activeStorageHome][activeStorageChest],row=rows.find(x=>x.id===id);if(!row)return;if(bagUnits()>=bagLimit()){document.getElementById('storageNotice').textContent='Your pack is full.';return}if(!addItem(id,1))return;row.count--;if(row.count<=0)houseStorage[activeStorageHome][activeStorageChest]=rows.filter(x=>x.id!==id);document.getElementById('storageNotice').textContent='Moved '+itemDefs[id].name+' to your pack.';saveGame();renderStorage()}
function storageRows(rows,action,disabled){if(!rows.length)return '<div class="emptyInventory">Nothing here yet.</div>';return rows.map(row=>{const item=itemDefs[row.id];if(!item)return '';const label=action==='store'?'Store 1':'Take 1';return '<article class="itemRow"><div class="itemInfo"><div class="itemName">'+item.icon+' '+item.name+' <span class="itemCount">× '+row.count+'</span></div><div class="itemDescription">'+(item.description||'')+'</div></div><div class="itemActions"><button type="button" class="itemAction '+(action==='store'?'buy':'')+'" data-storage-action="'+action+'" data-id="'+row.id+'" '+(disabled?'disabled':'')+'>'+label+'</button></div></article>'}).join('')}
function renderStorage(){const chest=houseStorage[activeStorageHome]?.[activeStorageChest]||[];document.getElementById('storageChestName').textContent=homeDefs[activeStorageHome].name+' · '+(activeStorageChest==='front_chest'?'Front Room Chest':'Side Room Chest');document.getElementById('storageCapacity').textContent=storageUnits(activeStorageChest)+' / '+HOME_CHEST_CAPACITY+' items';document.getElementById('storageChestList').innerHTML=storageRows(chest,'take',bagUnits()>=bagLimit());document.getElementById('storageBagList').innerHTML=storageRows(player.inventory,'store',storageUnits(activeStorageChest)>=HOME_CHEST_CAPACITY)}
function openStorage(homeId,chestId){if(!ownsHome(homeId)){say('Buy the '+homeDefs[homeId].name+' to use its storage.');return}preparePanel('storageScreen');keys.clear();activeStorageHome=homeId;activeStorageChest=chestId;saveFilesScreen.hidden=true;characterScreen.hidden=true;inventoryScreen.hidden=true;shopScreen.hidden=true;questScreen.hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;document.getElementById('storageNotice').textContent='Store or take items one at a time.';storageScreen.hidden=false;renderStorage();refreshPanelState()}
function refreshPanelState(){document.body.classList.toggle('panel-open',!document.getElementById('optionsMenu').hidden||!document.getElementById('premiumScreen').hidden||!document.getElementById('adventureScreen').hidden||!travelScreen.hidden||!inventoryScreen.hidden||!characterScreen.hidden||!skillsScreen.hidden||!shopScreen.hidden||!partyScreen.hidden||!storageScreen.hidden||!questScreen.hidden||!saveFilesScreen.hidden)}
function travelLock(id){if(maps[id].town)return '';if(id==='mosslight'&&!hasFourfoldKey)return 'Complete all four pet keeper stories (two chapters each) to forge the Fourfold Keystone';if(id==='emberdeep'&&!hasSigil)return 'Find the Ember Rune';return ''}

// v1.81: readable parchment atlas; the compass grid and all travel gates are retained.
function atlasBiome(id){if(frontierBiomes[id])return frontierBiomes[id];return ['glassridge','frostwood','northridge','frostmarch','icecoast'].includes(id)?'snow':['redfen','willowfen','fenroad'].includes(id)?'marsh':['coastroad','sunharbor'].includes(id)?'coast':['cinderfields','emberdeep'].includes(id)?'ash':['crowfield','meadowroad','stonewatchroad'].includes(id)?'plains':'forest'}
function atlasIcon(id){const m=maps[id];return m.town?'town':id==='mosslight'?'shrine':id==='emberdeep'?'cave':m.landmark==='vampire_ruins'?'ruin':m.landmark==='watchtower'?'tower':m.landmark==='bandit_camp'?'camp':atlasBiome(id)==='snow'?'mountain':atlasBiome(id)==='coast'?'anchor':atlasBiome(id)==='marsh'?'reeds':atlasBiome(id)==='ash'?'cave':atlasBiome(id)==='plains'?'wheat':'pine'}
function atlasLocationArt(id){const m=maps[id];return (m.town||id==='frontier_outpost')?'hall':id==='mosslight'?'runestone':id==='emberdeep'?'ruin':m.landmark==='watchtower'?'tower':m.landmark==='bandit_camp'?'tent':atlasBiome(id)==='snow'?'rock':atlasBiome(id)==='ash'?'ruin':'pine'}
function drawThemedWorldMap(targetCanvas){
 const canvas=targetCanvas||document.getElementById('themedWorldMap');if(!canvas)return;const size=worldGrid.length*180;canvas.width=canvas.height=size;const g=canvas.getContext('2d');if(!g)return;
 const colors={grass:'#b5bd87',snow:'#e3e3ce',marsh:'#899b7d',stone:'#aeaa92',dirt:'#b69665',dungeon:'#a69985',water:'#8fb6ba'},patterns={};
 const surface=key=>colors[key]||colors.grass;
 const sprite=(key,x,y,h,target=g)=>{if(!artReady('environment'))return;const f=detailedFrames.environment[key],w=h*f[2]/f[3];target.drawImage(detailedArt.environment,...f,x-w/2,y-h,w,h);};
 g.clearRect(0,0,size,size);g.fillStyle=surface('grass');g.fillRect(0,0,size,size);
 // Soft biome boundaries keep the world continuous instead of dividing it into tiles.
 worldGrid.forEach((row,y)=>row.forEach((id,x)=>{const biome=atlasBiome(id),key={snow:'snow',marsh:'marsh',coast:'grass',ash:'dungeon',plains:'grass',forest:'grass'}[biome];if(key==='grass')return;
  const patch=document.createElement('canvas');patch.width=patch.height=300;const p=patch.getContext('2d');p.translate(-x*180+60,-y*180+60);p.fillStyle=surface(key);p.fillRect(x*180-60,y*180-60,300,300);p.setTransform(1,0,0,1,0,0);p.globalCompositeOperation='destination-in';const fade=p.createRadialGradient(150,150,75,150,150,150);fade.addColorStop(0,'#fff');fade.addColorStop(1,'#fff0');p.fillStyle=fade;p.fillRect(0,0,300,300);g.drawImage(patch,x*180-60,y*180-60);
 }));
 g.save();g.scale(size/900,size/900);g.beginPath();g.moveTo(845,0);g.bezierCurveTo(780,150,875,260,838,390);g.bezierCurveTo(810,520,860,680,900,900);g.lineTo(900,0);g.closePath();g.fillStyle=surface('water');g.fill();g.lineWidth=4;g.strokeStyle='#6c81735c';g.stroke();g.restore();
 g.save();g.scale(size/900,size/900);const river=()=>{g.beginPath();g.moveTo(360,0);g.bezierCurveTo(335,170,405,260,365,450);g.bezierCurveTo(325,610,405,745,355,900);};river();g.lineWidth=21;g.strokeStyle='#23382b';g.stroke();river();g.lineWidth=13;g.strokeStyle=surface('water');g.stroke();g.restore();
 // Dirt roads connect exactly the same neighboring regions as the playable world.
 g.beginPath();worldGrid.forEach((row,y)=>row.forEach((id,x)=>{const cx=x*180+90,cy=y*180+90;if(x<row.length-1){g.moveTo(cx,cy);g.lineTo(cx+180,cy);}if(y<worldGrid.length-1){g.moveTo(cx,cy);g.lineTo(cx,cy+180);}}));g.lineWidth=9;g.strokeStyle='#e7d7b0';g.stroke();g.lineWidth=3;g.strokeStyle='#927950';g.setLineDash([9,6]);g.stroke();g.setLineDash([]);
 // Timber bridges carry the east-west roads across the river.
 for(let y=90;y<size;y+=180){g.fillStyle='#816948';g.fillRect(size*.4-48,y-10,96,20);g.strokeStyle='#403426';g.lineWidth=2;for(let x=size*.4-45;x<size*.4+48;x+=7){g.beginPath();g.moveTo(x,y-10);g.lineTo(x,y+10);g.stroke();}}
 worldGrid.forEach((row,y)=>row.forEach((id,x)=>{const biome=atlasBiome(id);for(let i=0;i<10;i++){const px=x*180+18+(i*47+x*17)%145,py=y*180+24+(i*67+y*23)%135;if(Math.abs(px-(x*180+90))<48&&Math.abs(py-(y*180+90))<45)continue;if(px>size-80)continue;const key=biome==='snow'?(i%3?'pine':'rock'):biome==='ash'?(i%3?'rock':'ruin'):biome==='marsh'?(i%2?'bush':'oak'):i%4?'pine':'oak';sprite(key,px,py,biome==='ash'?25:34+(i%3)*9);}}));
 const shade=g.createRadialGradient(size/2,size/2,size*.18,size/2,size/2,size*.69);shade.addColorStop(0,'#c4ab6c00');shade.addColorStop(1,'#76563145');g.fillStyle=shade;g.fillRect(0,0,size,size);g.strokeStyle='#8b90664d';g.lineWidth=2;g.strokeRect(8,8,size-16,size-16);g.save();g.globalAlpha=.07;g.fillStyle='#6b502d';for(let i=0;i<5000;i++)g.fillRect((i*173)%size,(i*317)%size,1,2);g.restore();
 document.querySelectorAll('.mapLocationArt').forEach(icon=>{const c=icon.getContext('2d');if(!c)return;c.clearRect(0,0,70,62);sprite(atlasLocationArt(icon.dataset.mapIcon),35,60,56,c);});
 // Assets also load asynchronously when opening a freshly downloaded game.
 for(const group of ['terrain','environment'])if(!artReady(group)&&detailedArt[group]&&!detailedArt[group]._worldMapWait){detailedArt[group]._worldMapWait=true;detailedArt[group].addEventListener('load',()=>{detailedArt[group]._worldMapWait=false;drawThemedWorldMap();if(titleMenuActive)drawThemedWorldMap(document.getElementById('titleMap'));},{once:true});}
}
// Persistent exploration fog: revealed locations remain visible on future visits.
function paintExplorationFog(){
 const canvas=document.getElementById('thornhavenAtlasFog');if(!canvas)return;
 const base=document.getElementById('themedWorldMap');if(!base)return;
 canvas.width=base.width;canvas.height=base.height;
 const ctx=canvas.getContext('2d');if(!ctx)return;
 const visited=new Set(Object.keys(townQuestState._visited||{}).filter(id=>townQuestState._visited[id]));visited.add(mapId);
 ctx.fillStyle='rgba(9,14,19,.94)';ctx.fillRect(0,0,canvas.width,canvas.height);
 ctx.globalCompositeOperation='destination-out';
 for(const id of visited){const pos=worldPositions[id];if(!pos)continue;const x=canvas.width*pos[0]/100,y=canvas.height*pos[1]/100;
 const radius=canvas.width*.105;const grad=ctx.createRadialGradient(x,y,radius*.58,x,y,radius);grad.addColorStop(0,'rgba(0,0,0,1)');grad.addColorStop(.75,'rgba(0,0,0,.98)');grad.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=grad;ctx.beginPath();ctx.arc(x,y,radius,0,Math.PI*2);ctx.fill();}
 ctx.globalCompositeOperation='source-over';
}
function renderTravel(){
 const el=document.getElementById('travelDestinations');
 document.getElementById('travelCurrent').textContent='Current location: '+activeMap.name;
 document.querySelector('#travelScreen .screenHead p').textContent=fastTravelArmed?'Compass active · choose a visited destination':'Ashvale Reach · four border towns · settlement in the southeast';
 document.querySelector('#travelScreen .screenFoot span').textContent=fastTravelArmed?'One journey per activation. The Compass is reusable.':'Travel on foot, or activate the Wayfarer’s Compass from BAG.';
 const shortName={glassridge:'Frostglass Ridge',northridge:'North Ridge',stonewatchroad:'Stonewatch Road',mosslight:'Mosslight Shrine',emberdeep:'Ashvault Depths'};
 const node=id=>{const m=maps[id],locked=travelLock(id)||(fastTravelArmed&&!townQuestState._visited?.[id]&&id!==mapId?'Explore on foot first':''),current=id===mapId,visited=!!townQuestState._visited?.[id]||current,label=(m.name||id)+(locked?' · '+locked:current?' · Your location':'');return '<button type="button" class="mapNode atlasNode '+(m.town?'atlasTown ':'')+(visited?'visited':'unexplored')+'" data-travel-to="'+id+'" style="left:'+worldPositions[id][0]+'%;top:'+worldPositions[id][1]+'%" '+(locked?'disabled':'')+(current?' aria-current="location"':'')+' aria-label="'+questEscape(label)+'"><span class="atlasStamp"><canvas class="mapLocationArt" width="70" height="62" data-map-icon="'+id+'" aria-hidden="true"></canvas></span><span class="mapName">'+questEscape(shortName[id]||m.name)+'</span><span class="mapKind">'+(locked?'LOCKED':current?'YOU ARE HERE':id==='wayfarers_camp'?'SAFE CAMP':id==='frontier_outpost'?'YOUR SETTLEMENT':m.town?'TOWN':id==='briarhollow'?'ABANDONED TOWN':'LV '+encounterLevel({},player.level,regionCombatLevel(id))+' · '+(visited?'EXPLORED':'WILDS'))+'</span></button>';};
 el.innerHTML='<details class="atlasRoutes"><summary>Camp · Town routes · Settlement</summary><div class="atlasHint"><b>WAYFARER’S CAMP · SAFE CAMPSITE</b><p>Separate camp map linked to Ashvale. Walk onto the marked camp path in Ashvale, near the bottom left of center.</p><button type="button" data-travel-to="wayfarers_camp">Wayfarer’s Camp route</button></div><div class="atlasHint"><b>VEILHAVEN · BEYOND THE EASTERN SEA</b><p>Remote vampire town · ferry from Worldsend, east of Hearthstead.</p><button type="button" data-travel-to="veilhaven">Veilhaven · '+(townQuestState._visited?.veilhaven?'Visited':'Undiscovered')+'</button></div><div class="atlasHint settlementAtlasSummary"><b>'+questEscape(settlementName().toUpperCase())+' · YOUR SETTLEMENT</b><p>Your own town map in the southeast corner · enter along its north or west border · '+(mapId==='frontier_outpost'?'YOU ARE HERE':townQuestState._visited?.frontier_outpost?'Discovered':'Visit on foot to discover')+'</p><button type="button" data-travel-to="frontier_outpost">'+(fastTravelArmed?'Compass journey to settlement':'Settlement route')+'</button></div></details><div class="atlasToolbar"><button type="button" id="atlasFit">Full map</button><button type="button" id="atlasHere">My location</button><button type="button" id="atlasDetail">Fill screen</button><button type="button" id="settlementAtlasButton">Settlement</button></div><div class="atlasLegend"><span>◆ Your location</span><span>✦ Tracked quest</span><span>◇ Unexplored</span><span>Monsters scale with your level · harder regions retain their minimum levels</span></div><div class="atlasScroller" id="atlasScroller" tabindex="0" aria-label="Scrollable world map"><div class="worldMapView atlasView"><canvas id="themedWorldMap" class="atlasArt" width="1620" height="1620" aria-hidden="true"></canvas><canvas id="thornhavenAtlasFog" class="atlasFog" aria-hidden="true"></canvas><span class="mapLabel north">NORTH · FROSTLANDS</span><span class="mapLabel south">SOUTH · ASHEN FRONTIER</span><span class="mapLabel west">WEST · OLD FORESTS</span><span class="mapLabel east">EAST · TIDELANDS</span>'+Object.keys(worldPositions).map(node).join('')+'</div></div><div class="atlasHint" id="atlasSelection">Copper: towns · Blue: you · Gold: quest · Tap a region for detail.</div>';
 document.getElementById('settlementAtlasButton').addEventListener('click',openSettlementMap);
 document.getElementById('atlasFit').onclick=()=>sizeAtlas(true);
 document.getElementById('atlasHere').onclick=()=>sizeAtlas(false,mapId);
 document.getElementById('atlasDetail').onclick=()=>sizeAtlas('screen',mapId);
 requestAnimationFrame(()=>{drawThemedWorldMap();paintExplorationFog();sizeAtlas(false,mapId);});
}

function sizeAtlas(fit=true,focusId=mapId){
 const scroller=document.getElementById('atlasScroller'),view=scroller?.querySelector('.atlasView');if(!view)return;
 const overview=fit!==false,fill=fit==='screen';
 const side=overview?Math.max(120,(fill?Math.max:Math.min)(scroller.clientWidth,scroller.clientHeight)):Math.max(1080,scroller.clientWidth,scroller.clientHeight);
 view.dataset.atlasMode=fill?'screen':fit?'fit':'detail';
 view.classList.toggle('atlasOverview',overview);view.style.setProperty('width',side+'px','important');view.style.setProperty('height',side+'px','important');
 view.style.setProperty('min-width',side+'px','important');view.style.setProperty('min-height',side+'px','important');
 document.getElementById('atlasFit').setAttribute('aria-pressed',String(fit===true));
 document.getElementById('atlasDetail').setAttribute('aria-pressed',String(fill));
 for(const node of view.querySelectorAll('.atlasNode')){const label=node.querySelector('.mapName'),[x,y]=worldPositions[node.dataset.travelTo];label.style.cssText='';if(fit){if(x<15){label.style.left='0';label.style.transform='none'}if(x>85){label.style.left='auto';label.style.right='0';label.style.transform='none'}if(y>85){label.style.top='auto';label.style.bottom='100%'}}}
 if(fit===true){scroller.scrollTop=0;scroller.scrollLeft=0}else{const focus=view.querySelector('[data-travel-to="'+focusId+'"]');if(focus){scroller.scrollLeft=Math.max(0,focus.offsetLeft-scroller.clientWidth/2);scroller.scrollTop=Math.max(0,focus.offsetTop-scroller.clientHeight/2)}}
}
window.addEventListener('resize',()=>{if(!travelScreen.hidden)requestAnimationFrame(()=>sizeAtlas(document.querySelector('.atlasView')?.dataset.atlasMode==='screen'?'screen':document.querySelector('.atlasView')?.dataset.atlasMode==='fit'))});
function openTravelScreen(activate=false){fastTravelArmed=activate===true&&!compassActivationLock();preparePanel('travelScreen');keys.clear();travelScreen.hidden=false;inventoryScreen.hidden=true;characterScreen.hidden=true;shopScreen.hidden=true;questScreen.hidden=true;saveFilesScreen.hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;renderTravel();markQuestDestination();refreshPanelState()}
function travelTo(id){if(!maps[id])return;if(id==='frontier_outpost'&&!fastTravelArmed){openSettlementMap();return;}if(!fastTravelArmed){const info=document.getElementById('atlasSelection');if(info)info.textContent=maps[id].name+' · '+(maps[id].hint||maps[id].recommended||'Follow the roads to this region.');say(bagCount('wayfarer_compass')?'Activate the Compass from BAG to fast travel.':'Travel on foot. Find the Wayfarer’s Compass through THE LOST COMPASS quest in Ashvale.');return;}const blocked=compassActivationLock();if(blocked){fastTravelArmed=false;say(blocked);return;}if(!townQuestState._visited?.[id]&&id!==mapId){say('Explore this place on foot before using the Compass to return.');return;}const locked=travelLock(id);if(locked){say(locked);return}const [x,y]=mapEntry(id,'default');setMap(id,x,y);fastTravelArmed=false;travelScreen.hidden=true;document.getElementById('gameView').hidden=false;document.getElementById('controlRow').hidden=false;refreshPanelState();saveGame();ui()}
function closePanel(id){if(id==='travelScreen')fastTravelArmed=false;if(id==='inventoryScreen')closeItemDetail();document.getElementById(id).hidden=true;if(['adventureScreen','travelScreen','inventoryScreen','characterScreen','skillsScreen','shopScreen','partyScreen','storageScreen','questScreen','premiumScreen'].includes(id)){document.getElementById('gameView').hidden=false;document.getElementById('controlRow').hidden=false}if(id==='saveFilesScreen'){if(saveFilesReturnToGame&&hasStarted){document.getElementById('gameView').hidden=false;document.getElementById('controlRow').hidden=false}else{document.getElementById('characterSetup').hidden=false;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true}}refreshPanelState()}
function openInventory(){preparePanel('inventoryScreen');keys.clear();saveFilesScreen.hidden=true;characterScreen.hidden=true;inventoryFilter='all';document.getElementById('inventorySummary').textContent=player.name+' · '+classDefs[player.class].title;document.getElementById('inventoryNotice').textContent='';shopScreen.hidden=true;questScreen.hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;inventoryScreen.hidden=false;closeItemDetail();renderInventory();refreshPanelState()}
function openShop(id){if(!shopDefs[id])return;preparePanel('shopScreen');keys.clear();saveFilesScreen.hidden=true;characterScreen.hidden=true;activeShopId=id;shopMode=shopDefs[id].workshopOnly?'upgrade':'buy';document.getElementById('shopTitle').textContent=shopDefs[id].name;document.getElementById('shopSeller').textContent=shopDefs[id].seller;document.getElementById('shopNotice').textContent='';inventoryScreen.hidden=true;questScreen.hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;shopScreen.hidden=false;renderShop();refreshPanelState()}
function renderSaveSlots(){const list=document.getElementById('saveSlotList'),escapeHTML=value=>String(value).replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[ch]));list.innerHTML=SAVE_SLOT_IDS.map((id,index)=>{const row=saveSlots[id],occupied=!!row,active=id===activeSlotId,name=occupied?escapeHTML(row.name||row.state?.player?.name||'Hero'):'Empty slot',meta=occupied?((classDefs[row.class||row.state?.player?.class]?.title)||'Adventurer')+' · Level '+(row.level||row.state?.player?.level||1)+(active?' · Current character':''):'Start a separate character and save';const actions=occupied?'<button type="button" data-slot-action="load" data-slot="'+id+'">'+(active?'Continue':'Use character')+'</button><button type="button" class="deleteSlot" data-slot-action="delete" data-slot="'+id+'">Delete</button>':'<button type="button" data-slot-action="new" data-slot="'+id+'">New character</button>';return '<article class="saveSlot '+(active?'current':'')+'"><div><div class="saveSlotName">Slot '+(index+1)+' · '+name+'</div><div class="saveSlotMeta">'+meta+'</div></div><div class="saveSlotActions">'+actions+'</div></article>'}).join('')}function openSaveFiles(returnToGame=true){preparePanel('saveFilesScreen');saveGame();keys.clear();saveFilesReturnToGame=returnToGame;document.getElementById('optionsMenu').hidden=true;document.getElementById('optionsToggle').setAttribute('aria-expanded','false');document.getElementById('characterSetup').hidden=true;document.querySelectorAll('[data-close-screen="saveFilesScreen"]').forEach(button=>button.hidden=!returnToGame);document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;inventoryScreen.hidden=true;characterScreen.hidden=true;shopScreen.hidden=true;questScreen.hidden=true;renderSaveSlots();saveFilesScreen.hidden=false;refreshPanelState()}function selectSaveSlot(id){
 if(!SAVE_SLOT_IDS.includes(id)||switchingCharacter)return;
 if(id===activeSlotId&&hasStarted){saveGame();saveFilesReturnToGame=true;closePanel('saveFilesScreen');return}
 saveGame();switchingCharacter=true;
 try{
  const record=saveSlots[id];
  applySavedGame(JSON.parse(JSON.stringify(record?(record.state||record):freshCharacterState)));
  activeSlotId=id;hasStarted=!!record;saveFilesReturnToGame=hasStarted;
  localStorage.setItem(ACTIVE_SLOT_KEY,id);
  keys.clear();attackHeld=false;tapTarget=null;lockedEnemy=null;skillCooldown=0;saveClock=0;player.cool=0;player.attack=0;
  preparePanel('characterSetup');saveFilesScreen.hidden=true;
  document.getElementById('characterSetup').hidden=hasStarted;
  document.getElementById('gameView').hidden=!hasStarted;
  document.getElementById('controlRow').hidden=!hasStarted;
  if(!record){document.getElementById('characterName').value='';document.getElementById('characterName').setCustomValidity('');}
  refreshPanelState();ui();
  if(hasStarted)say('Welcome back, '+player.name+'. Your story continues in '+activeMap.name+'.');
 }finally{switchingCharacter=false}
}
function deleteSaveSlot(id){if(!SAVE_SLOT_IDS.includes(id)||!saveSlots[id])return;const name=saveSlots[id].name||'this character';if(!window.confirm('Delete '+name+' and all progress in this slot?'))return;delete saveSlots[id];localStorage.setItem(SAVE_SLOTS_KEY,JSON.stringify(saveSlots));if(id==='slot1')localStorage.removeItem(SAVE_KEY);if(id===activeSlotId){switchingCharacter=true;localStorage.setItem(ACTIVE_SLOT_KEY,'slot1');window.location.reload();return}renderSaveSlots()}function closeGameToSaveMenu(){showTitleMenu()}
function shopGearRequirementsHTML(id){const item=itemDefs[id];if(!item?.slot)return '';const classes=itemClassRules[id],classOK=!classes||classes.includes(player.class),levelOK=(player.level||1)>=(item.minLevel||1);return '<div class="shopGearRequirements'+(!classOK||!levelOK?' restricted':'')+'"><b>Classes: '+(classes?itemClassNames(id):'All classes')+'</b> · Level '+(item.minLevel||1)+'<br>'+(!classOK?'Cannot equip as '+classDefs[player.class].title:!levelOK?'Requires level '+item.minLevel+' to equip':'Your class can equip this')+'</div>'}
function itemRowHTML(id,count,context){const item=itemDefs[id];if(!item)return '';const equipped=!!item.slot&&player[item.slot]===id,allowed=canUseItem(id),classNames=itemClassNames(id)+' · Level '+(item.minLevel||1);let actions='';if(context==='inventory'){if(item.fastTravel)actions+='<button type="button" class="itemAction" data-detail-action="use" data-id="'+id+'">Activate fast travel</button>';if(item.heal)actions+='<button class="itemAction" data-item-action="use" data-id="'+id+'">Use</button>';if(item.slot)actions+='<button class="itemAction" data-item-action="equip" data-id="'+id+'" '+(allowed?'':'disabled title="Requires '+classNames+'"')+'>'+(allowed?(equipped?'Equipped':'Equip'):'Class restricted')+'</button>';if(item.sell)actions+='<button class="itemAction sell" data-item-action="sell" data-id="'+id+'">Sell · '+item.sell+'</button>'}else if(context==='character'){actions='<button class="itemAction" data-character-action="equip" data-id="'+id+'" '+(allowed?'':'disabled title="Requires '+classNames+'"')+'>'+(allowed?(equipped?'Unequip':'Equip'):'Class restricted')+'</button>'}else if(context==='buy'){const shortage=Math.max(0,item.price-player.coins),full=bagUnits()>=bagLimit(),restricted=false,soldOut=townStockAvailable(id)<1,unavailable=shortage>0||full||soldOut,reason=soldOut?'Town stock exhausted.':full?'Your pack is full.':shortage?'Need '+shortage+' more crowns.':'Buy '+item.name;actions='<button type="button" class="itemAction buy'+(unavailable?' unavailable':'')+'" data-shop-action="buy" data-id="'+id+'" aria-disabled="'+unavailable+'" '+(unavailable?'disabled':'')+' title="'+reason+'">Buy · '+item.price+'</button>'}else if(context==='sell'&&item.sell){actions=shopSellControls(id)}return '<article class="itemRow"><div class="itemInfo"><div class="itemName">'+item.icon+' '+item.name+' <span class="itemCount">× '+count+'</span></div>'+((context==='buy'||context==='sell')?shopGearRequirementsHTML(id):'')+'<div class="itemDescription">'+item.description+(item.slot&&context!=='buy'&&context!=='sell'?'<br><b>Classes:</b> '+classNames:'')+'</div></div><div class="itemActions">'+actions+'</div></article>'}
function inventoryTileHTML(id,count=1,equipped=false){const item=itemDefs[id];if(!item)return '';return '<button type="button" class="itemTile'+(equipped?' equipped':'')+'" style="'+(item.tier?'border-color:'+GEAR_TIERS[item.tier].color:'')+'" data-inventory-id="'+id+'" aria-label="Inspect '+item.name+'"><span class="itemTileIcon">'+item.icon+'</span><span class="itemTileName">'+item.name+'</span>'+(count>1?'<span class="itemTileCount">×'+count+'</span>':'')+'</button>'}
function renderInventory(){const list=document.getElementById('inventoryList');document.getElementById('inventoryWallet').textContent='◈ '+player.coins+' crowns';document.getElementById('equipmentSummary').textContent='Weapon: '+(player.weapon?itemDefs[player.weapon].name:'none')+' · Armor: '+(player.armor?itemDefs[player.armor].name:'none')+' · Shield: '+(player.shield?itemDefs[player.shield].name:'none');document.getElementById('bagCapacity').textContent=bagUnits()+' / '+bagLimit()+' items';document.getElementById('inventoryHeroName').textContent=player.name;document.getElementById('inventoryHeroClass').textContent=classDefs[player.class].title+' · '+(normalizedHeroGender(player.gender,player.class)==='female'?'Female':'Male')+' · Level '+player.level;document.getElementById('inventoryVitality').textContent=player.hp+' / '+player.max;document.getElementById('inventoryVitalBar').style.width=Math.max(0,Math.min(100,player.hp/player.max*100))+'%';const weaponBonus=player.weapon&&itemDefs[player.weapon]?gearStat(player.weapon,'bonus'):0,armorGuard=player.armor&&itemDefs[player.armor]?gearStat(player.armor,'guard'):0,shieldGuard=player.shield&&itemDefs[player.shield]?gearStat(player.shield,'guard'):0;document.getElementById('inventoryAttack').textContent=playerAttackPower();document.getElementById('inventoryGuard').textContent=equipmentGuard(player);document.getElementById('inventorySetBonuses').textContent=equipmentSetSummary(player);document.querySelectorAll('[data-inventory-tab]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.inventoryTab===inventoryFilter)));const slots=GEAR_SLOTS.map(slot=>[slot,GEAR_LABELS[slot],GEAR_ICONS[slot]]),slotList=document.getElementById('inventoryGearSlots');slotList.innerHTML=slots.map(([slot,label,icon])=>{const id=player[slot],item=id?itemDefs[id]:null;return '<button type="button" class="inventoryGearSlot'+(item?' equipped':'')+'" data-inventory-equipped="'+(id||'')+'" data-equipped-slot="'+slot+'"><span class="slotIcon">'+(item?item.icon:icon)+'</span><span><b>'+label+'</b>'+(item?'<span>'+item.name+'</span>':'<span>Empty slot</span>')+'</span></button>'}).join('');const rows=player.inventory.filter(row=>itemDefs[row.id]&&(inventoryFilter==='all'||(inventoryFilter==='quest'?itemDefs[row.id].category==='quest':inventoryFilter==='gathering'?['tool','material'].includes(itemDefs[row.id].category):itemDefs[row.id].category===inventoryFilter)));let out=rows.map(row=>inventoryTileHTML(row.id,row.count,GEAR_SLOTS.some(slot=>player[slot]===row.id))).join('');if(hasSigil&&(inventoryFilter==='all'||inventoryFilter==='quest'))out+='<button type="button" class="itemTile" data-inventory-id="ember_sigil" aria-label="Inspect Ember Rune"><span class="itemTileIcon">✦</span><span class="itemTileName">Ember Rune</span><span class="itemTileCount">Quest</span></button>';const occupied=rows.length+(hasSigil&&(inventoryFilter==='all'||inventoryFilter==='quest')?1:0);for(let i=occupied;i<24;i++)out+='<div class="emptyItemTile" aria-hidden="true"></div>';list.innerHTML=out;document.getElementById('inventoryNotice').textContent=rows.length?'Select an item for details and actions.':(inventoryFilter==='all'?'Your pack is empty. Visit Tilda in Ashvale for supplies.':'No items in this category.')}
function showItemDetail(id){const sigil=id==='ember_sigil',item=itemDefs[id];if(!sigil&&!item)return;selectedInventoryItem=id;const name=sigil?'Ember Rune':item.name,icon=sigil?'✦':item.icon,type=sigil?'Quest Relic':item.slot?GEAR_LABELS[item.slot]:item.heal?'Supply':item.category==='quest'?'Crafting / Quest item':item.category==='tool'?'Gathering tool':item.category==='material'?'Gathering material':'Item',stats=[];if(sigil)stats.push('+1 attack');else{if(item.slot)stats.push('Classes: '+itemClassNames(id));if(item.tier){stats.push(gearTierLabel(id)+' · Level '+(item.minLevel||1));stats.push(GEAR_SET_NAMES[item.set]+' set · '+(gearSetGroups(player).find(g=>g.name===GEAR_SET_NAMES[item.set])?.count||0)+'/7 equipped');}if(item.slot&&!canUseItem(id))stats.push('Requires matching class and level '+(item.minLevel||1));if(item.bonus)stats.push('Damage +'+gearStat(id,'bonus')+(gearUpgradeRank(id)?' · Forge +'+gearUpgradeRank(id):''));if(item.guard)stats.push('Guard +'+gearStat(id,'guard')+(gearUpgradeRank(id)?' · Forge +'+gearUpgradeRank(id):''));if(item.heal)stats.push('Heal '+item.heal);if(item.sell)stats.push('Sell '+item.sell+' crowns');if(!stats.length)stats.push('No combat bonus')}document.getElementById('itemDetailName').textContent=name;document.getElementById('itemDetailIcon').textContent=icon;document.getElementById('itemDetailType').textContent=type;document.getElementById('itemDetailStats').innerHTML=stats.map(x=>'<span>'+x+'</span>').join('');document.getElementById('itemDetailDescription').textContent=sigil?'A shrine relic that strengthens your attacks.':item.description;let actions='';if(!sigil){if(item.fastTravel)actions+='<button type="button" class="itemAction" data-detail-action="use" data-id="'+id+'">Activate fast travel</button>';if(item.heal)actions+='<button type="button" class="itemAction" data-detail-action="use" data-id="'+id+'">Use</button>';if(item.slot){const equipped=player[item.slot]===id;actions+=canUseItem(id)?'<button type="button" class="itemAction buy" data-detail-action="'+(equipped?'unequip':'equip')+'" data-slot="'+item.slot+'" data-id="'+id+'">'+(equipped?'Unequip':'Equip')+'</button>':'<button type="button" class="itemAction unavailable" disabled>Requires '+itemClassNames(id)+' · Lv '+(item.minLevel||1)+'</button>'}if(item.sell)actions+='<button type="button" class="itemAction sell" data-detail-action="sell" data-id="'+id+'">Sell · '+item.sell+'</button>'}document.getElementById('itemDetailActions').innerHTML=actions;document.getElementById('itemDetailShade').hidden=false}
function closeItemDetail(){document.getElementById('itemDetailShade').hidden=true;selectedInventoryItem=null}
function preparePanel(activeId){stopWorldTouch();clearPadTouches();keys.clear();tapTarget=null;if(activeId!=='travelScreen')fastTravelArmed=false;attackHeld=false;for(const id of ['adventureScreen','travelScreen','inventoryScreen','characterScreen','skillsScreen','shopScreen','partyScreen','storageScreen','questScreen','saveFilesScreen','premiumScreen'])if(id!==activeId)document.getElementById(id).hidden=true;const detail=document.getElementById('itemDetailShade');if(detail)detail.hidden=true;const menu=document.getElementById('optionsMenu');if(menu)menu.hidden=true;const toggle=document.getElementById('optionsToggle');if(toggle)toggle.setAttribute('aria-expanded','false')}
const forgeCosts=[{coins:35,materials:{copper_ore:2,wood_log:2}},{coins:80,materials:{iron_ore:3,hardwood_log:2}},{coins:160,materials:{silver_ore:3,hardwood_log:4}},{coins:250,materials:{ancient_alloy:2,silver_ore:2}},{coins:400,materials:{ancient_alloy:3,hardwood_log:4}}];function forgeCanUpgrade(id){const shop=shopDefs[activeShopId],item=itemDefs[id],classes=itemClassRules[id]||[];return !!(shop&&shop.forgeClass&&item&&item.slot&&classes.includes(shop.forgeClass)&&bagCount(id)>0)}function renderForge(){const list=document.getElementById('shopList'),shop=shopDefs[activeShopId],eligible=player.inventory.filter(row=>forgeCanUpgrade(row.id));if(!eligible.length){list.innerHTML='<div class="emptyInventory">Bring class gear to this town’s forge. Each forge only upgrades gear for its town’s class.</div>';return}list.innerHTML=eligible.map(row=>{const id=row.id,item=itemDefs[id],rank=gearUpgradeRank(id),cost=rank<gearUpgradeCap(id)?forgeCosts[rank]:null,stat=gearMainStat(id)==='bonus'?'Attack':'Guard',current=gearStat(id,gearMainStat(id)),materials=cost?Object.entries(cost.materials).map(([mat,amount])=>itemDefs[mat].name+' '+(bagCount(mat)||0)+'/'+amount).join(' · '):'Maximum rank reached',ready=cost&&player.coins>=cost.coins&&Object.entries(cost.materials).every(([mat,amount])=>(bagCount(mat)||0)>=amount),button=cost?'<button type="button" class="itemAction buy'+(ready?'':' unavailable')+'" data-shop-action="upgrade" data-id="'+id+'" '+(ready?'':'disabled')+' title="'+(ready?'Upgrade this item':'Gather the listed materials and crowns')+'">Upgrade · '+cost.coins+' crowns</button>':'<button type="button" class="itemAction unavailable" disabled>Max rank</button>';return '<article class="itemRow"><div class="itemIcon">'+item.icon+'</div><div class="itemInfo"><div class="itemName">'+item.name+' · Forge rank '+rank+'/'+gearUpgradeCap(id)+'</div><div class="itemDescription">'+stat+' '+current+' → '+(current+(cost?1:0))+' · '+materials+'</div></div><div class="itemActions">'+button+'</div></article>'}).join('')}function upgradeForgeGear(id){if(!forgeCanUpgrade(id))return;const rank=gearUpgradeRank(id),cost=rank<gearUpgradeCap(id)?forgeCosts[rank]:null;if(!cost){document.getElementById('shopNotice').textContent='This gear has reached its maximum forge rank.';return}const missing=Object.entries(cost.materials).find(([mat,amount])=>(bagCount(mat)||0)<amount);if(player.coins<cost.coins||missing){document.getElementById('shopNotice').textContent=missing?'Gather '+missing[1]+' '+itemDefs[missing[0]].name+'.':'You need '+(cost.coins-player.coins)+' more crowns.';return}for(const [mat,amount] of Object.entries(cost.materials))removeItem(mat,amount);player.coins-=cost.coins;gearUpgradeLevels[id]=rank+1;document.getElementById('shopNotice').textContent=itemDefs[id].name+' reforged · rank '+(rank+1)+' · '+(gearMainStat(id)==='bonus'?'+1 attack':'+1 guard');saveGame();ui();renderShop()}
function xpBoostSeconds(){return Math.max(0,Number(townQuestState._xpBoost?.seconds)||0)}
function xpBoostTime(){const n=Math.ceil(xpBoostSeconds());return Math.floor(n/60)+':'+String(n%60).padStart(2,'0')}
function refreshXpBoost(){const b=document.getElementById('xpBoostStatus');if(b){b.hidden=xpBoostSeconds()<=0;b.textContent='+25% combat XP · '+xpBoostTime()}}
function tickXpBoost(dt){if(xpBoostSeconds()<=0)return;townQuestState._xpBoost.seconds=Math.max(0,xpBoostSeconds()-dt);refreshXpBoost();if(!xpBoostSeconds()){say('Your XP boost has ended.');saveGame()}}
function boostedCombatXp(base){return base<=0?0:xpBoostSeconds()>0?Math.floor(base*1.25):base}
// Game-side activation is reserved for verified delivery. No UI or native bridge
// can call this until authenticated, idempotent billing delivery is implemented.
function startXpBoost(){if(xpBoostSeconds()>0)return false;townQuestState._xpBoost={seconds:900};refreshXpBoost();saveGame();return true}
function renderShop(){const list=document.getElementById('shopList'),shop=shopDefs[activeShopId],forgeTab=shopScreen.querySelector('[data-shop-tab="upgrade"]');document.getElementById('shopWallet').textContent='◈ '+player.coins+' crowns'+(shopTown()?' · Delivery in '+Math.ceil(townStock(shopTown()).remaining/60)+' active min':'');forgeTab.hidden=!shop.forgeClass;shopScreen.querySelector('[data-shop-tab="buy"]').hidden=!!shop.workshopOnly;renderBulkSell();shopScreen.querySelector('[data-shop-tab="sets"]').hidden=!shop.forgeClass;document.querySelectorAll('[data-shop-tab]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.shopTab===shopMode)));if(shopMode==='sets'&&shop.forgeClass)renderSetForge();else if(shopMode==='upgrade'&&shop.forgeClass)renderForge();else if(shopMode==='buy')list.innerHTML=shop.stock.map(id=>itemRowHTML(id,1,'buy')).join('');else{const rows=player.inventory.filter(row=>itemDefs[row.id].sell);list.innerHTML=rows.map(row=>itemRowHTML(row.id,row.count,'sell')).join('')||'<div class="emptyInventory">Nothing to sell from your pack.</div>'}}
function useItem(id){if(id==='wayfarer_compass'){activateWayfarerCompass();return;}const item=itemDefs[id];if(!item||!item.heal||!bagCount(id))return;const recovered=Math.min(item.heal,player.max-player.hp);if(recovered<=0){document.getElementById('inventoryNotice').textContent='Your vitality is already full.';return}removeItem(id);player.hp+=recovered;document.getElementById('inventoryNotice').textContent=item.name+' restored '+recovered+' vitality.';ui();renderInventory()}
function equipItem(id,fromCharacter=false){const item=itemDefs[id];if(!item||!item.slot||!bagCount(id))return;if(!canUseItem(id)){const message=item.name+' requires '+itemClassNames(id)+' · level '+(item.minLevel||1)+'.';if(fromCharacter)renderCharacter(message);else document.getElementById('inventoryNotice').textContent=message;return}player[item.slot]=player[item.slot]===id?null:id;const equipped=player[item.slot]===id;if(equipped)tutorialMark('gear');saveGame();if(fromCharacter)renderCharacter(item.name+(equipped?' equipped.':' unequipped.'));else{document.getElementById('inventoryNotice').textContent=item.name+(equipped?' equipped.':' unequipped.');renderInventory()}}
function renderCharacter(message=''){renderBuildChoices();document.getElementById('characterSheetName').textContent=player.name;document.getElementById('characterSheetClass').textContent=classDefs[player.class].title+' · '+(normalizedHeroGender(player.gender,player.class)==='female'?'Female':'Male')+' · Level '+player.level;const weaponBonus=player.weapon&&itemDefs[player.weapon]?gearStat(player.weapon,'bonus'):0,armorGuard=player.armor&&itemDefs[player.armor]?gearStat(player.armor,'guard'):0,shieldGuard=player.shield&&itemDefs[player.shield]?gearStat(player.shield,'guard'):0;document.getElementById('characterSheetStats').textContent='Vitality '+player.hp+' / '+player.max+' · Attack '+playerAttackPower()+' · Guard '+equipmentGuard(player);document.getElementById('characterNotice').textContent=(message?message+' ':'')+equipmentSetSummary(player)+' '+classAdvantage()+' '+veteranDescription();const slots=GEAR_SLOTS.map(slot=>[slot,GEAR_LABELS[slot],player[slot]]),slotList=document.getElementById('gearSlots');slotList.innerHTML=slots.map(([slot,label,id])=>{const item=id?itemDefs[id]:null,detail=item?(item.bonus?'+'+gearStat(id,'bonus')+' attack · Forge +'+gearUpgradeRank(id):item.guard?'+'+gearStat(id,'guard')+' guard · Forge +'+gearUpgradeRank(id):'Equipped'):'Empty slot';return '<article class="gearSlot"><div class="gearSlotIcon">'+(item?item.icon:'◇')+'</div><div><b>'+label+'</b>'+(item?item.name:detail)+'<small style="display:block;color:#b8b39e">'+(item?detail:'No item equipped')+'</small></div>'+(item?'<button type="button" data-character-action="unequip" data-slot="'+slot+'">Remove</button>':'')+'</article>'}).join('');const gear=player.inventory.filter(row=>itemDefs[row.id]&&itemDefs[row.id].slot);document.getElementById('characterGearList').innerHTML=gear.map(row=>itemRowHTML(row.id,row.count,'character')).join('')||'<div class="emptyInventory">No equipment in your bag. Visit Bran the Smith in Ashvale.</div>'}
function openCharacterScreen(){preparePanel('characterScreen');keys.clear();saveFilesScreen.hidden=true;inventoryScreen.hidden=true;shopScreen.hidden=true;questScreen.hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;renderCharacter();characterScreen.hidden=false;refreshPanelState()}
function sellItem(id,fromShop=false){const item=itemDefs[id];if(!item||!item.sell||!bagCount(id))return;removeItem(id);for(const slot of GEAR_SLOTS)if(player[slot]===id&&!bagCount(id))player[slot]=null;player.coins+=item.sell;saveGame();if(fromShop){document.getElementById('shopNotice').textContent='Sold '+item.name+' for '+item.sell+' crowns.';renderShop()}else{document.getElementById('inventoryNotice').textContent='Sold '+item.name+' for '+item.sell+' crowns.';ui();renderInventory()}}
function townBarterDefs(){return {
 ashvale:{hero:'Warrior',resource:'iron_ore',cap:20,level:3,imports:{wood_log:6},amount:2,gear:'short_sword',gearCost:{copper_ore:2,wood_log:3}},
 brackenford:{hero:'Rogue',resource:'hardwood_log',cap:20,level:3,imports:{wood_log:6},amount:2,gear:'sabre',gearCost:{copper_ore:4,wood_log:6}},
 stonewatch:{hero:'Cleric',resource:'river_fish',cap:24,level:1,imports:{wood_log:5},amount:3,gear:'buckler',gearCost:{copper_ore:4,wood_log:3}},
 sunmere:{hero:'Mage',resource:'silver_ore',cap:12,level:8,imports:{copper_ore:10},amount:2,gear:'ashwood_staff',gearCost:{copper_ore:2,wood_log:6}}
}}
function shopTown(id=activeShopId){return Object.keys(townBarterDefs()).find(t=>String(id||'').startsWith(t+'_'))||null}
function townStockCap(town,id){const d=townBarterDefs()[town];return id===d.resource?d.cap:itemDefs[id]?.category==='gear'?2:itemDefs[id]?.category==='tool'?3:8}
function townStock(town){const all=townQuestState._townStock||(townQuestState._townStock={});let s=all[town];if(!s)s=all[town]={remaining:900,items:{}};const d=townBarterDefs()[town],ids=new Set([d.resource,d.gear,'potion_25','woodcutting_hatchet']);for(const [id,shop] of Object.entries(shopDefs))if(shopTown(id)===town)for(const item of shop.stock)ids.add(item);for(const id of ids)if(!Number.isFinite(s.items[id]))s.items[id]=townStockCap(town,id);return s}
function townStockAvailable(id){const town=shopTown();return town?townStock(town).items[id]||0:Infinity}
function tickTownStock(dt){if(!Number.isFinite(dt)||dt<=0||document.hidden)return;for(const town of Object.keys(townBarterDefs())){const s=townStock(town);s.remaining=Math.max(0,s.remaining-dt);if(!s.remaining){for(const id of Object.keys(s.items))s.items[id]=townStockCap(town,id);s.remaining=900;saveGame()}}}
function barterOffers(town){const d=townBarterDefs()[town];if(!d)return [];return [
 {id:'resource',out:d.resource,n:d.amount,cost:d.imports,level:d.level},
 {id:'aid',out:'potion_25',n:1,cost:{[d.resource]:3},level:1},
 {id:'gear',out:d.gear,n:1,cost:d.gearCost,level:1},
 {id:'tool',out:'woodcutting_hatchet',n:1,cost:{copper_ore:4},level:1}
 ]}
function barterReason(town,offer){if(mapId!==town||!activeMap.town)return 'Visit this town to trade';if(!offer)return 'Unknown offer';if(player.level<offer.level)return 'Requires level '+offer.level;if((townStock(town).items[offer.out]||0)<offer.n)return 'Town stock exhausted';if(Object.entries(offer.cost).some(([id,n])=>bagCount(id)<n))return 'Gather the listed materials';if(bagUnits()-Object.values(offer.cost).reduce((a,n)=>a+n,0)+offer.n>bagLimit())return 'Make room in your bag';return ''}
function barterTrade(town,offerId){const offer=barterOffers(town).find(o=>o.id===offerId),reason=barterReason(town,offer);if(reason)return false;const before=JSON.parse(JSON.stringify(player.inventory));for(const [id,n] of Object.entries(offer.cost))if(!removeItem(id,n)){player.inventory=before;return false}if(!addItem(offer.out,offer.n)){player.inventory=before;return false}townStock(town).items[offer.out]-=offer.n;saveGame();ui();openTownBarter('Received '+offer.n+' '+itemDefs[offer.out].name+'.');return true}
function openTownBarter(note=''){const town=mapId,d=townBarterDefs()[town];if(!d||!activeMap.town){say('Visit Ashvale, Brackenford, Stonewatch or Sunmere to barter.');return}const stock=townStock(town),offers=barterOffers(town);openAdventureDialog(maps[town].name+' · Barter',(note?note+'\n\n':'')+d.hero+' specialty: '+itemDefs[d.resource].name+'. Trade gathered materials without spending crowns or real money. Stock is shared with local shops and refills after '+Math.ceil(stock.remaining/60)+' more minutes of active play. Menus, offline time and reloads do not refill it.\n\n'+offers.map(o=>itemDefs[o.out].name+' ×'+o.n+' ← '+Object.entries(o.cost).map(([id,n])=>itemDefs[id].name+' '+bagCount(id)+'/'+n).join(', ')+' · Stock '+stock.items[o.out]+(o.level>1?' · Level '+o.level:'')).join('\n'),offers.map(o=>({label:'Trade for '+itemDefs[o.out].name+' ×'+o.n+(barterReason(town,o)?' · '+barterReason(town,o):''),disabled:!!barterReason(town,o),action:()=>barterTrade(town,o.id)})).concat([{label:'Return to town',action:()=>{}}]))}

function buyItem(id){const item=itemDefs[id],shop=shopDefs[activeShopId];if(!item||!shop?.stock.includes(id)||!Number.isFinite(item.price))return;if(townStockAvailable(id)<1){document.getElementById('shopNotice').textContent='Town stock exhausted. Return after the next supply delivery.';return}if(player.coins<item.price){document.getElementById('shopNotice').textContent='You need '+(item.price-player.coins)+' more crowns.';return}if(!addItem(id)){document.getElementById('shopNotice').textContent='Your pack is full.';return}player.coins-=item.price;const town=shopTown();if(town)townStock(town).items[id]--;saveGame();document.getElementById('shopNotice').textContent='Bought '+item.name+'.';ui();renderShop()}
document.getElementById('inventoryList').addEventListener('click',event=>{const tile=event.target.closest('[data-inventory-id]');if(tile)showItemDetail(tile.dataset.inventoryId)});document.getElementById('inventoryGearSlots').addEventListener('click',event=>{const slot=event.target.closest('[data-equipped-slot]');if(slot&&slot.dataset.inventoryEquipped)showItemDetail(slot.dataset.inventoryEquipped)});document.getElementById('itemDetailShade').addEventListener('click',event=>{if(event.target.closest('[data-close-item-detail]')){closeItemDetail();return}const button=event.target.closest('[data-detail-action]');if(!button)return;const id=button.dataset.id,action=button.dataset.detailAction;if(action==='use'){useItem(id);closeItemDetail()}else if(action==='sell'){sellItem(id);closeItemDetail()}else if(action==='equip'){equipItem(id);showItemDetail(id)}else if(action==='unequip'){if(GEAR_SLOTS.includes(button.dataset.slot)){player[button.dataset.slot]=null;saveGame();renderInventory();showItemDetail(id)}}});document.getElementById('itemDetailShade').addEventListener('pointerdown',event=>{if(event.target===event.currentTarget)closeItemDetail()});
function runCharacterControl(button){if(button.dataset.characterAction==='close')closePanel('characterScreen');else if(button.dataset.characterAction==='party')openPartyScreen();else if(button.dataset.characterAction==='skills')openSkillsScreen();else if(button.dataset.characterAction==='settlement')openSettlement();else if(button.dataset.characterAction==='equip')equipItem(button.dataset.id,true);else if(button.dataset.characterAction==='unequip'){const slot=button.dataset.slot;if(GEAR_SLOTS.includes(slot)){player[slot]=null;saveGame();renderCharacter('Removed '+slot+'.')}}}function bindCharacterControl(event){const button=event.target.closest('[data-character-action]');if(!button||!characterScreen.contains(button))return;if(event.type==='click'&&event.detail!==0)return;if(event.type==='pointerdown'){event.preventDefault();event.stopPropagation()}runCharacterControl(button)}characterScreen.addEventListener('pointerdown',bindCharacterControl);characterScreen.addEventListener('click',bindCharacterControl);
function runShopControl(button){if(button.dataset.shopAction==='barter'){openTownBarter();return;}if(button.dataset.shopAction==='sell-item-all'){sellShopQuantity(button.dataset.id,true);return;}if(button.dataset.craftTier){craftTier=Number(button.dataset.craftTier);renderSetForge();return;}if(button.dataset.shopAction==='buy')buyItem(button.dataset.id);else if(button.dataset.shopAction==='sell')sellShopQuantity(button.dataset.id);else if(button.dataset.shopAction==='craft')craftSetGear(button.dataset.id);else if(button.dataset.shopAction==='upgrade')upgradeForgeGear(button.dataset.id);else if(button.dataset.shopTab){shopMode=button.dataset.shopTab;document.getElementById('shopNotice').textContent='';renderShop()}else if(button.dataset.closeScreen)closePanel(button.dataset.closeScreen)}let lastShopPointerAt=-Infinity;shopScreen.addEventListener('keydown',()=>{lastShopPointerAt=-Infinity});function bindShopControls(event){const button=event.target.closest('[data-shop-action],[data-shop-tab],[data-craft-tier],[data-close-screen]');if(!button||!shopScreen.contains(button))return;if(event.type==='click'&&(event.detail!==0||performance.now()-lastShopPointerAt<750))return;if(event.type==='pointerdown'){lastShopPointerAt=performance.now();event.preventDefault();}runShopControl(button)}shopScreen.addEventListener('input',event=>{const input=event.target.closest('[data-sell-quantity]');if(!input)return;const id=input.dataset.sellQuantity;shopSellQuantities[id]=Number(input.value);const quantity=shopSellQuantity(id),controls=input.closest('.sellQuantity');controls.querySelector('output').textContent=quantity+' / '+shopSellAvailable(id);controls.querySelector('[data-shop-action="sell"]').textContent='Sell '+quantity+' · '+quantity*itemDefs[id].sell+' crowns';});shopScreen.addEventListener('pointerdown',bindShopControls);shopScreen.addEventListener('click',bindShopControls);function runSaveSlotControl(button){const id=button.dataset.slot;if(button.dataset.slotAction==='load'||button.dataset.slotAction==='new')selectSaveSlot(id);else if(button.dataset.slotAction==='delete')deleteSaveSlot(id);else if(button.dataset.closeScreen)closePanel(button.dataset.closeScreen)}function bindSaveSlotControl(event){const button=event.target.closest('[data-slot-action],[data-close-screen]');if(!button||!saveFilesScreen.contains(button))return;if(event.type==='click'&&event.detail!==0)return;if(event.type==='pointerdown')event.preventDefault();runSaveSlotControl(button)}saveFilesScreen.addEventListener('pointerdown',bindSaveSlotControl);saveFilesScreen.addEventListener('click',bindSaveSlotControl);
document.querySelectorAll('[data-inventory-tab]').forEach(b=>b.addEventListener('click',()=>{inventoryFilter=b.dataset.inventoryTab;renderInventory()}));
document.querySelectorAll('[data-close-screen]').forEach(b=>b.addEventListener('click',()=>closePanel(b.dataset.closeScreen)));partyScreen.addEventListener('click',bindPartyControl);
storageScreen.addEventListener('click',event=>{const button=event.target.closest('[data-storage-action]');if(!button)return;if(button.dataset.storageAction==='store')moveToStorage(button.dataset.id);else if(button.dataset.storageAction==='take')takeFromStorage(button.dataset.id)});

// v1.81: cohesive fantasy artwork embedded for offline play.
const detailedArt={};
for(const [group,source] of Object.entries({"environment":embeddedArt[47],"actors":embeddedArt[48],"terrain":embeddedArt[49],"items":embeddedArt[50],"extras":embeddedArt[51]})){const image=new Image();image.src=source;detailedArt[group]=image;}
const detailedFrames={"environment":{"house":[10,43,276,289],"shop":[310,44,251,285],"forge":[579,42,268,287],"hall":[856,14,307,335],"tower":[1177,6,218,364],"oak":[10,343,299,288],"pine":[333,344,208,285],"rock":[582,423,268,215],"ruin":[850,392,295,227],"bush":[1172,469,212,153],"chest":[48,695,206,159],"well":[323,644,213,225],"stall":[571,638,293,229],"lamp":[918,628,144,248],"tent":[1123,641,276,238],"portal":[13,864,297,242],"runestone":[310,870,238,236],"bed":[594,885,236,205],"crate":[878,913,233,165],"campfire":[1160,906,211,184]},"actors":{"slime":[85,29,225,206],"bat":[363,12,461,226],"spider":[834,32,308,206],"skeleton":[1229,14,228,225],"bandit":[81,266,299,241],"warden":[439,239,359,279],"ice":[847,239,295,278],"specter":[1204,239,254,275],"elder":[95,523,219,236],"smith":[500,519,207,238],"merchant":[890,519,183,241],"healer":[1263,525,179,233],"farmer":[123,768,167,241],"traveler":[500,761,186,249],"scribe":[894,767,183,243],"guard":[1270,758,177,255]},"items":{"sword":[35,24,279,272],"dagger":[400,59,223,228],"staff":[716,19,222,294],"mace":[1029,19,256,294],"armor":[29,325,293,289],"vest":[367,322,256,299],"shield":[692,313,287,309],"sacredshield":[1053,313,229,309],"potion":[68,634,204,253],"food":[337,663,311,216],"copper":[687,668,289,199],"silver":[1013,648,281,239],"logs":[25,887,306,269],"rune":[331,911,250,258],"pickaxe":[694,889,279,282],"rod":[1012,887,280,285]},"extras":{"openchest":[56,35,288,307],"hatchet":[462,51,250,270],"scroll":[824,118,276,206],"coins":[1216,89,259,240],"tablet":[54,360,285,302],"trap":[411,401,340,240],"notice":[826,369,280,290],"hearth":[1164,382,336,270],"slash":[49,706,334,267],"fireball":[416,737,333,184],"burst":[784,670,333,311],"heal":[1164,692,330,284]},"terrain":{"grass":[4,4,435,435],"dirt":[447,4,435,435],"stone":[891,4,435,435],"water":[1334,4,435,435],"snow":[4,447,435,435],"marsh":[447,447,435,435],"wood":[891,447,435,435],"dungeon":[1334,447,435,435]}};
const surfacePatterns={};
function artReady(group){const a=detailedArt[group];return !!(a&&a.complete&&a.naturalWidth)}
function paintArt(key,x,y,w,h,group='environment',opacity=1){
 const a=detailedArt[group],f=detailedFrames[group]?.[key];if(!artReady(group)||!f)return false;
 // Cull using the actual canvas transform, including camera, zoom and portrait mode.
 // Rotated art uses the normal draw path to preserve its full bounds.
 const transform=ctx.getTransform();
 if(transform.b===0&&transform.c===0){
  const x0=transform.a*x+transform.e,x1=transform.a*(x+w)+transform.e;
  const y0=transform.d*y+transform.f,y1=transform.d*(y+h)+transform.f;
  if(Math.max(x0,x1)<-4||Math.min(x0,x1)>c.width+4||Math.max(y0,y1)<-4||Math.min(y0,y1)>c.height+4)return true;
 }
 ctx.save();ctx.imageSmoothingEnabled=true;ctx.globalAlpha*=opacity;
 ctx.drawImage(a,...f,x,y,w,h);ctx.restore();return true;
}
function standArt(key,x,y,height,group='environment',opacity=1){const f=detailedFrames[group]?.[key];if(!f)return false;const width=height*f[2]/f[3];return paintArt(key,x-width/2,y-height+7,width,height,group,opacity)}
const thornGround=new Image();thornGround.src='assets/thornhaven-ground-v1.png';
const thornPatterns={};
function paintThornGround(key,x,y,w,h){
 if(!['grass','dirt','marsh'].includes(key)||!thornGround.complete||!thornGround.naturalWidth)return false;
 if(!thornPatterns[key]){const tile=document.createElement('canvas');tile.width=tile.height=384;const g=tile.getContext('2d');g.drawImage(thornGround,0,0,384,384);g.fillStyle=key==='dirt'?'#9b784c66':key==='marsh'?'#263c3970':'#3e513c66';g.fillRect(0,0,384,384);thornPatterns[key]=ctx.createPattern(tile,'repeat');}
 ctx.save();ctx.fillStyle=thornPatterns[key];ctx.fillRect(x,y,w,h);ctx.restore();return true;
}
let heroPortraitKey='';
function refreshHeroPortrait(){
 const canvas=document.getElementById('heroHudPortrait');if(!canvas)return;
 const a=classAppearance(player);if(!a.atlas.complete||!a.atlas.naturalWidth)return;
 const key=a.hero+':'+a.gender;if(heroPortraitKey===key)return;
 const [x,y,w,h]=a.frames[0],g=canvas.getContext('2d');if(!g)return;
 g.clearRect(0,0,canvas.width,canvas.height);g.imageSmoothingEnabled=true;
 const scale=Math.min((canvas.width-8)/w,(canvas.height-8)/h);
 g.drawImage(a.atlas,x,y,w,h,(canvas.width-w*scale)/2,(canvas.height-h*scale)/2,w*scale,h*scale);
 heroPortraitKey=key;
}
classSpriteAtlas.addEventListener('load',()=>refreshHeroPortrait());
counterpartSpriteAtlas.addEventListener('load',()=>refreshHeroPortrait());


function regionSurface(){
 if(activeMap.interior)return 'wood';if(activeMap.dungeon||storyDungeons[mapId]||['mosslight','emberdeep'].includes(mapId))return 'dungeon';
 if(frontierBiomes[mapId]==='snow'||/frost|glassridge/.test(mapId))return 'snow';if(frontierBiomes[mapId]==='marsh'||/fen/.test(mapId))return 'marsh';if(frontierBiomes[mapId]==='ash')return 'dungeon';if(/highmoor|stonewatchroad/.test(mapId))return 'stone';return 'grass';
}
function paintSurface(key,x,y,w,h,size=112){
 if(paintThornGround(key,x,y,w,h))return true;
 if(!artReady('terrain'))return false;const f=detailedFrames.terrain[key];if(!f)return false;
 const cacheKey=key+':'+size;let p=surfacePatterns[cacheKey];
 if(!p){
  const c=document.createElement('canvas'),n=4,stride=Math.round(size*.7);c.width=c.height=stride*n;const g=c.getContext('2d');g.imageSmoothingEnabled=true;
  const colors={grass:'#4b6234',marsh:'#414a2f',stone:'#737065',snow:'#c8d5d0',dirt:'#90663c',dungeon:'#49484c',wood:'#765436',water:'#285e69'};
  g.fillStyle=colors[key]||'#46513b';g.fillRect(0,0,c.width,c.height);
  const tile=document.createElement('canvas');tile.width=tile.height=size;const t=tile.getContext('2d');
  t.drawImage(detailedArt.terrain,...f,0,0,size,size);
  // Feather all four edges so generated atlas borders do not form a grid.
  t.globalCompositeOperation='destination-in';let fade=t.createLinearGradient(0,0,size,0);
  fade.addColorStop(0,'rgba(255,255,255,0)');fade.addColorStop(.16,'rgba(255,255,255,1)');fade.addColorStop(.84,'rgba(255,255,255,1)');fade.addColorStop(1,'rgba(255,255,255,0)');t.fillStyle=fade;t.fillRect(0,0,size,size);
  fade=t.createLinearGradient(0,0,0,size);fade.addColorStop(0,'rgba(255,255,255,0)');fade.addColorStop(.16,'rgba(255,255,255,1)');fade.addColorStop(.84,'rgba(255,255,255,1)');fade.addColorStop(1,'rgba(255,255,255,0)');t.fillStyle=fade;t.fillRect(0,0,size,size);
  for(let row=-1;row<=n;row++)for(let col=-1;col<=n;col++){
   const seed=((row+n)%n*37+(col+n)%n*19)%8,px=col*stride+(row%2?stride/2:0),py=row*stride;
   g.save();g.translate(px+size/2,py+size/2);g.scale(seed%2?-1:1,seed%3?-1:1);g.globalAlpha=key==='marsh'?.72:.9;g.drawImage(tile,-size/2,-size/2);g.restore();
  }
  p=ctx.createPattern(c,'repeat');surfacePatterns[cacheKey]=p;
 }
 ctx.save();ctx.fillStyle=p;ctx.fillRect(x,y,w,h);ctx.restore();return true;
}
function drawRegionFloor(x,y,w,h){if(!paintSurface(regionSurface(),x,y,w,h))ctx.fillRect(x,y,w,h)}
function drawDetailedHouse(x,y,w,h,variant,feature){
 const key=feature==='forge'?'forge':feature==='shop'?'shop':feature==='elder'?'hall':'house';
 // Place the base and doorway within the existing collision footprint.
 return paintArt(key,x,y,w,h);
}
function drawDetailedTown(){
 if(!artReady('environment'))return false;
 standArt('well',650,225,68);
 for(const [x,y] of [[320,260],[610,260],[320,600],[650,600]])standArt('bush',x,y,28);
 for(const [x,y] of [[286,290],[680,290]])standArt('stall',x,y+18,72);
 for(const x of [226,734]){const glow=ctx.createRadialGradient(x,258,0,x,258,35);glow.addColorStop(0,'#ffcc6638');glow.addColorStop(1,'#ffcc6600');ctx.fillStyle=glow;ctx.fillRect(x-35,223,70,70);standArt('lamp',x,307,64);}
 for(const [x,y] of [[-70,110],[975,110],[-70,470],[975,470],[650,110]])standArt('crate',x,y,40);
 return true;
}
function villagerKey(n){
 if(n.role==='leader'||/reeve|mayor|elder|harbormaster/i.test(n.name))return 'elder';
 if(n.shopId?.endsWith('_forge')||/smith/i.test(n.name))return 'smith';if(n.shopId)return 'merchant';
 if(n.role==='healer'||/herb|heal/i.test(n.name))return 'healer';
 if(/captain|guard|watch/i.test(n.name))return 'guard';if(/scribe|scholar|arcan/i.test(n.name))return 'scribe';if(/farmer|gardener|mill/i.test(n.name))return 'farmer';return 'traveler';
}
function drawDetailedVillager(n){return drawLivingVillager(n)}
function monsterKey(e){return e.kind==='slime'?'slime':e.kind==='bat'?'bat':e.kind==='spider'?'spider':e.kind==='bandit'?'bandit':e.kind==='warden'?'warden':e.kind==='skeleton'?'skeleton':/frost|ice/i.test(e.name||'')?'ice':'specter'}
function drawDetailedMonster(e,dead=false){
 if(e.kind==='vampire'&&drawVampireMonster(e,dead))return true;
 if(!artReady('actors'))return false;const key=monsterKey(e),f=detailedFrames.actors[key];if(!f)return false;
 const h=(e.boss?74:key==='slime'?34:key==='bat'?34:key==='spider'?38:54),w=h*f[2]/f[3];
 ctx.save();ctx.translate(e.x,e.y+7);if(player.x<e.x)ctx.scale(-1,1);
 if(dead){ctx.globalAlpha*=Math.max(0,e.deathAnim/.6);ctx.scale(1,Math.max(.1,e.deathAnim/.6));}
 else if(e.hitTime>0)ctx.globalAlpha=.72;
 const bounce=dead?0:Math.sin(animationClock*(key==='bat'?12:5)+(e.seed||0))*(key==='bat'?3:1);
 paintArt(key,-w/2,-h-bounce,w,h,'actors');ctx.restore();return true;
}
function drawDetailedWorldObject(obj){
 let key=null,height=48,dim=false;
 if(obj.id.startsWith('story_portal_')){drawCaveEntrance(obj.x,obj.y,storyDungeons[obj.dungeon].style,!!storyPortalLock(obj.dungeon));return true}
 else if(obj.id.startsWith('secret_')){if(Math.hypot(player.x-obj.x,player.y-obj.y)>115)return true;key='chest';height=35;dim=!!townQuestState[obj.id]?.claimed}
 else if(obj.id.startsWith('story_cache_')||obj.id==='tower_cache'){key='chest';height=40;dim=!!townQuestState['story_'+obj.dungeon]?.claimed}
 else if(obj.id.startsWith('story_ward_')){key='runestone';height=52;dim=townQuestState['story_'+obj.dungeon]?.wards?.includes(obj.index)}
 else if(obj.id.startsWith('armory_')||obj.id==='campaign_chronicle'||obj.id==='tower_tablet'||obj.id==='rescue_notice'){return standArt(obj.id==='tower_tablet'?'tablet':'notice',obj.x,obj.y,48,'extras')}
 else if(obj.id.startsWith('gear_waystone_')){key='runestone';height=55}
 else if(obj.id.startsWith('beacon_')){key='campfire';height=36}
 else if(obj.id.startsWith('epilogue_')||obj.id==='crossroads_medicine')return standArt('traveler',obj.x,obj.y,50,'actors');
 if(key==='chest'&&dim)return standArt('openchest',obj.x,obj.y,height,'extras');return key?standArt(key,obj.x,obj.y,height,'environment',dim?.5:1):false;
}
function drawDetailedLandmark(){
 if(!artReady('environment')||!activeMap.landmark)return false;
 ctx.save();ctx.textAlign='center';ctx.font='bold 14px system-ui';ctx.strokeStyle='#172019';ctx.lineWidth=4;ctx.fillStyle='#fff0b2';
 if(activeMap.landmark==='watchtower'){paintArt('tower',415,76,130,164);ctx.strokeText('SILENT WATCHTOWER',480,450);ctx.fillText('SILENT WATCHTOWER',480,450)}
 if(activeMap.landmark==='bandit_camp'){paintArt('tent',260,120,145,90);paintArt('tent',560,100,145,90);standArt('campfire',500,210,45);const freed=!!townQuestState.world_rescue?.claimed;if(!freed){standArt('traveler',750,219,44,'actors');ctx.strokeStyle='#918c7e';ctx.lineWidth=4;ctx.strokeRect(710,145,80,90);for(let x=720;x<785;x+=13){ctx.beginPath();ctx.moveTo(x,148);ctx.lineTo(x,233);ctx.stroke()}}ctx.fillText(freed?'TRAVELER FREED':'SOUTHERN BANDIT CAMP',520,52)}
 for(const obj of activeMap.worldObjects||[]){if(!obj.id.startsWith('beacon_')&&!['tower_tablet','tower_cache','rescue_notice','prisoner_cage'].includes(obj.id))continue;drawDetailedWorldObject(obj);ctx.strokeText(obj.label,obj.x,obj.y-52);ctx.fillText(obj.label,obj.x,obj.y-52)}
 ctx.restore();return true;
}
function textureWater(x,y,rx,ry){
 const outline=()=>{ctx.beginPath();for(let i=0;i<=48;i++){const a=i/48*Math.PI*2,r=1+.035*Math.sin(a*5+x)+.025*Math.sin(a*3+y),px=x+Math.cos(a)*rx*r,py=y+Math.sin(a)*ry*r;i?ctx.lineTo(px,py):ctx.moveTo(px,py)}ctx.closePath()};
 ctx.save();outline();ctx.fillStyle='#285e69';ctx.fill();ctx.save();ctx.clip();paintSurface('water',x-rx*1.1,y-ry*1.1,rx*2.2,ry*2.2,96);
 ctx.strokeStyle='#a1cec340';ctx.lineWidth=1.4;for(let i=0;i<5;i++){const px=x-rx*.6+i*rx*.28,py=y+Math.sin(i*2+x)*ry*.55;ctx.beginPath();ctx.ellipse(px,py,8+i%3*3,2,0,0,Math.PI);ctx.stroke()}ctx.restore();
 outline();ctx.strokeStyle='#5f7961';ctx.lineWidth=5;ctx.stroke();outline();ctx.strokeStyle='#a6b49288';ctx.lineWidth=1.5;ctx.stroke();ctx.restore();
}
function detailedExtraScenery(){
 if(!artReady('environment'))return;
 if(activeMap.interior){paintSurface('wood',48,58,864,484);paintArt('bed',638,120,154,192);for(const [x,y] of [[190,210],[825,215]])standArt('chest',x,y,47);ctx.fillStyle='#4e3727';ctx.fillRect(465,492,50,50);standArt('hearth',400,170,90,'extras');ctx.fillStyle='#f6e4ae';ctx.font='bold 16px Georgia';ctx.fillText(homeDefs[activeMap.homeId].name.toUpperCase(),390,90);ctx.font='12px system-ui';ctx.fillText('INTERACT BY THE BED TO REST',625,330);ctx.fillText('STORAGE CHESTS',135,260);ctx.fillText('STORAGE CHESTS',770,265);}
 if(mapId==='glassridge'||mapId==='frostmarch'){for(const [x,y] of [[160,150],[390,120],[675,160]])standArt('rock',x,y,64);}
 if(mapId==='highmoor'){for(const [x,y,w,h] of [[115,125,190,145],[580,70,170,170],[680,145,175,125],[260,410,170,135],[620,410,210,120]])paintArt('ruin',x,y,w,h);}
 if(mapId==='crowfield')paintArt('house',408,105,144,165);
 if(mapId==='sunharbor'){paintSurface('dirt',32,200,896,358);paintSurface('water',32,80,896,110,96);paintSurface('wood',390,180,180,260,100);}
 const pools=marshSceneryPools[mapId]||[];
 for(const p of pools)textureWater(...p);if(mapId==='willowfen'){paintSurface('wood',0,0,0,0,80);ctx.save();ctx.strokeStyle=surfacePatterns['wood:80'];ctx.lineWidth=18;ctx.beginPath();ctx.moveTo(32,315);ctx.bezierCurveTo(245,260,290,400,480,325);ctx.bezierCurveTo(650,260,745,385,928,305);ctx.stroke();ctx.restore()}
 if(treasure)standArt(treasure.opened?'openchest':'chest',treasure.x||865,treasure.y||318,44,treasure.opened?'extras':'environment');
}
const gearVectorPaths={
 '🔥':'<path d="M22 3c3 12 14 13 12 24-1 10-24 14-27 0-2-8 5-10 5-17 4 3 4 7 5 8 5-6 4-10 5-15z"/>',
 '🍃':'<path d="M34 6C5 1 2 20 10 29c10 8 25-5 24-23zM6 37 29 12M13 29l1-11M20 22l10-1"/>',
 '🧭':'<circle cx="20" cy="23" r="16"/><path d="m25 12-2 14-9 8 3-14zM20 7V2"/>',
 '🎁':'<path d="M5 18h30v20H5zM3 12h34v7H3zM18 12v26M23 12v26M20 12C4 12 8 1 14 4l6 8c17 0 13-11 7-8z"/>',
 '💎':'<path d="M8 12V8a4 4 0 0 1 8 0M24 12V8a4 4 0 0 1 8 0"/><circle cx="12" cy="23" r="8"/><circle cx="28" cy="23" r="8"/>',
 '📿':'<path d="M6 6c-2 23 30 23 28 0M20 26v4"/><path d="m20 29 6 6-6 6-6-6z"/>',
 '👖':'<path d="M9 5h22l2 31H23l-3-20-3 20H7zM9 10h22M20 5v8"/>',
 '🥾':'<path d="M12 5h15v20l9 4v8H8V26h4zM12 12h9M12 18h9M8 33h28"/>'
};
function gearVectorIcon(key){return 'data:image/svg+xml,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 44"><g fill="#34483a" stroke="#e2c57c" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round">'+gearVectorPaths[key]+'</g></svg>');}
const itemSpriteKeys={'⚔️':'sword','⚔':'sword','🗡️':'dagger','🗡':'dagger','🪄':'staff','🛡️':'shield','🛡':'shield','🧥':'vest','🪓':'hatchet','⛏':'pickaxe','⛏️':'pickaxe','🎣':'rod','🧪':'potion','🍞':'food','🪵':'logs','💎':'rune','✦':'rune','🪨':'silver','🔮':'rune'};
function decorateItemIcons(root=document){
 if(!artReady('items'))return;
 for(const el of root.querySelectorAll('.itemIcon,.itemTileIcon,.gearSlotIcon,.slotIcon,#itemDetailIcon')){
  const text=el.textContent.trim();if(!text)continue;if(gearVectorPaths[text]){el.textContent='';el.classList.add('paintedGearVector');el.style.backgroundImage='url("'+gearVectorIcon(text)+'")';continue;}let key=itemSpriteKeys[text];
  const context=el.parentElement?.textContent||'';
  if(/ore|alloy|iron|copper|silver/i.test(context))key=/copper/i.test(context)?'copper':'silver';
  if(/armor|chainmail|plate|cuirass/i.test(context)&&!(/staff|blade/i.test(context)))key='armor';
  if(/shield/i.test(context)&&/cleric|sacred|ivory|order/i.test(context))key='sacredshield';
  if(/potion|tonic|ration/i.test(context))key=/ration/i.test(context)?'food':'potion';
  if(/scroll|parchment|map/i.test(context))key='scroll';if(/coin|crown|gold pouch/i.test(context))key='coins';if(!key)key='rune';const group=detailedFrames.extras[key]?'extras':'items',f=detailedFrames[group][key],a=detailedArt[group];
  el.textContent='';el.classList.add('paintedItemIcon');el.classList.toggle('paintedExtraIcon',group==='extras');
  el.style.backgroundImage='url('+a.src+')'; // Keep equipped icons visible despite slot background styling.
  el.style.backgroundSize=(a.naturalWidth/f[2]*100)+'% '+(a.naturalHeight/f[3]*100)+'%';
  el.style.backgroundPosition=(f[0]/(a.naturalWidth-f[2])*100)+'% '+(f[1]/(a.naturalHeight-f[3])*100)+'%';
 }
}
const itemArtStyle=document.createElement('style');itemArtStyle.textContent='.paintedGearVector{background-repeat:no-repeat;background-position:center;background-size:contain;display:inline-block;width:34px;height:34px;flex-shrink:0}.slotIcon.paintedGearVector{background-color:#121a15!important;background-size:contain!important}.itemTileIcon.paintedGearVector{width:38px;height:38px}#itemDetailIcon.paintedGearVector{width:70px;height:70px}.paintedItemIcon{background-image:url('+detailedArt.items.src+');background-repeat:no-repeat;display:inline-block;width:42px;height:42px;flex:0 0 42px;vertical-align:middle}.itemTileIcon.paintedItemIcon{width:46px;height:46px}#itemDetailIcon.paintedItemIcon{width:70px;height:70px}.slotIcon.paintedItemIcon{width:30px;height:30px;flex-basis:30px}.paintedExtraIcon{background-image:url('+detailedArt.extras.src+')}';document.head.appendChild(itemArtStyle);detailedArt.items.onload=()=>decorateItemIcons();
const iconObserver=new MutationObserver(()=>decorateItemIcons());
iconObserver.observe(document.querySelector('.shell'),{childList:true,subtree:true});

function drawDetailedEffect(key,x,y,scale=1,progress=0){
 const name={fx_Fire_Ball:'fireball',fx_Explosion:'burst',fx_Portal:'heal',fx_Wind:'slash'}[key];if(!name||!artReady('extras'))return false;
 const size=64*scale*(.7+.3*Math.sin(progress*Math.PI));ctx.save();ctx.translate(x,y);ctx.rotate(name==='fireball'?Math.PI:0);paintArt(name,-size/2,-size/2,size,size,'extras');ctx.restore();return true;
}

function circle(x,y,r,fill,stroke){ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=2;ctx.stroke()}}
const tilePatterns={};
function drawTile(tx,ty,x,y,size=32){const key=ty===9?(tx===13?'oak':tx===15?'pine':'bush'):ty===13?'rock':ty===10?'bush':null;if(key&&paintArt(key,x,y,size,size))return;
 if(!worldAtlas.complete||!worldAtlas.naturalWidth)return;
 ctx.drawImage(worldAtlas,tx*17,ty*17,16,16,x,y,size,size);
}
function drawTileField(tx,ty,x0,y0,x1,y1,size=32){const surface=tx===6?'dirt':tx===7?'dungeon':ty===15?regionSurface():tx===0&&ty===0?'water':'stone';if(paintSurface(surface,x0,y0,x1-x0,y1-y0))return;if(!worldAtlas.complete||!worldAtlas.naturalWidth)return;const key=tx+','+ty+','+size;let pattern=tilePatterns[key];if(!pattern){const tile=document.createElement('canvas');tile.width=tile.height=size;tile.getContext('2d').drawImage(worldAtlas,tx*17,ty*17,16,16,0,0,size,size);pattern=ctx.createPattern(tile,'repeat');tilePatterns[key]=pattern}ctx.fillStyle=pattern;ctx.fillRect(x0,y0,x1-x0,y1-y0)}
function drawSpritePerson(tx,ty,x,y,w=36,h=36,frame=0){if(standArt(ty===9?'healer':'traveler',x,y,h,'actors'))return;
 if(charAtlas.complete&&charAtlas.naturalWidth){try{ctx.drawImage(charAtlas,(tx+(frame&1))*17,ty*17,16,16,x-w/2,y-h+5,w,h);return}catch{}}
 // Keep people visible if the local embedded atlas fails to decode on a device.
 const unit=Math.max(2,Math.round(w/12)),step=frame?unit:0;ctx.save();ctx.fillStyle='#d6b77b';ctx.fillRect(x-4*unit,y-h+7*unit,8*unit,5*unit);ctx.fillStyle='#283a42';ctx.fillRect(x-5*unit,y-h+12*unit,10*unit,10*unit);ctx.fillStyle='#d0a277';ctx.fillRect(x-7*unit,y-h+13*unit,2*unit,7*unit);ctx.fillRect(x+5*unit,y-h+13*unit,2*unit,7*unit);ctx.fillStyle='#332a25';ctx.fillRect(x-4*unit-step,y-h+22*unit,3*unit,5*unit);ctx.fillRect(x+1*unit+step,y-h+22*unit,3*unit,5*unit);ctx.restore();
}
function drawPixelHouse(x,y,w,h,variant=0,feature='home'){if(drawDetailedHouse(x,y,w,h,variant,feature))return;
 const sets=[
  {roof:'#704436',light:'#a75f42',dark:'#422f31',wall:'#c99a63',shade:'#916647',trim:'#573b30',window:'#72a7ad'},
  {roof:'#534b4b',light:'#837779',dark:'#34353d',wall:'#b3ad99',shade:'#77796f',trim:'#44464a',window:'#84a9b0'},
  {roof:'#76503c',light:'#bd8050',dark:'#48322c',wall:'#d4ad78',shade:'#9e7956',trim:'#604530',window:'#78b9bd'},
  {roof:'#52605b',light:'#829078',dark:'#35483f',wall:'#c3ad7c',shade:'#8b7958',trim:'#4a4939',window:'#8cbfbd'}
 ];
 const p=sets[variant%sets.length],roofH=Math.round(h*.40),bodyY=y+roofH-3,bodyH=h-roofH+6,doorW=Math.max(20,Math.round(w*.16)),doorH=Math.round(bodyH*.62),doorX=Math.round(x+w*.54),doorY=bodyY+bodyH-doorH;
 ctx.save();ctx.imageSmoothingEnabled=false;
 // Crisp layered silhouette and a steep, individually tiled roof.
 ctx.fillStyle='#17251f99';ctx.fillRect(x+8,y+10,w,h);
 ctx.fillStyle=p.dark;ctx.beginPath();ctx.moveTo(x-7,y+roofH);ctx.lineTo(x+w*.5,y-5);ctx.lineTo(x+w+7,y+roofH);ctx.lineTo(x+w+3,y+roofH+8);ctx.lineTo(x+w*.5,y+9);ctx.lineTo(x-3,y+roofH+8);ctx.closePath();ctx.fill();
 ctx.save();ctx.beginPath();ctx.moveTo(x-2,y+roofH+3);ctx.lineTo(x+w*.5,y+2);ctx.lineTo(x+w+2,y+roofH+3);ctx.closePath();ctx.clip();ctx.fillStyle=p.roof;ctx.fillRect(x-8,y,w+16,roofH+12);
 for(let row=0;row<5;row++){const yy=y+8+row*7,half=Math.floor((w*.5-5)*((yy-y+2)/(roofH+6))),left=x+w*.5-half,right=x+w*.5+half;ctx.fillStyle=row%2?p.roof:p.light;ctx.fillRect(left,yy,right-left,5);ctx.fillStyle=p.dark;for(let col=left+9;col<right;col+=18)ctx.fillRect(col,yy,2,5);ctx.fillRect(left,yy+5,right-left,2)}
 ctx.restore();
 // Timber framed facade, shaded side walls, and a stone doorstep.
 ctx.fillStyle=p.trim;ctx.fillRect(x-2,bodyY,w+4,bodyH+3);ctx.fillStyle=p.wall;ctx.fillRect(x+3,bodyY+3,w-6,bodyH-4);ctx.fillStyle=p.shade;ctx.fillRect(x+w-15,bodyY+3,12,bodyH-4);ctx.fillStyle='#ead0a0';ctx.fillRect(x+4,bodyY+4,w-20,4);ctx.fillStyle=p.trim;ctx.fillRect(x+7,bodyY+9,5,bodyH-12);ctx.fillRect(x+w-22,bodyY+9,5,bodyH-12);
 for(let yy=bodyY+17;yy<bodyY+bodyH-4;yy+=15){ctx.fillStyle='#e0b77f55';ctx.fillRect(x+12,yy,w-38,2);ctx.fillStyle=p.shade;for(let xx=x+19+(yy%2?8:0);xx<x+w-28;xx+=25)ctx.fillRect(xx,yy+5,3,3)}
 // Two framed, illuminated windows make each shop and home read at phone size.
 for(const wx of [x+20,x+w-48]){ctx.fillStyle=p.trim;ctx.fillRect(wx,bodyY+17,27,28);ctx.fillStyle='#e4ce9a';ctx.fillRect(wx+3,bodyY+20,21,19);ctx.fillStyle=p.window;ctx.fillRect(wx+5,bodyY+22,17,15);ctx.fillStyle='#cce7cf';ctx.fillRect(wx+6,bodyY+23,5,5);ctx.fillStyle=p.trim;ctx.fillRect(wx+12,bodyY+20,3,19);ctx.fillRect(wx+3,bodyY+29,21,3)}
 // Deep-set doorway, lantern, and wooden sign.
 ctx.fillStyle=p.dark;ctx.fillRect(doorX-3,doorY-4,doorW+6,doorH+5);ctx.fillStyle='#684631';ctx.fillRect(doorX,doorY,doorW,doorH);ctx.fillStyle='#91613b';ctx.fillRect(doorX+3,doorY+3,doorW-6,doorH-4);ctx.fillStyle=p.dark;ctx.fillRect(doorX+doorW*.28,doorY+7,2,doorH-11);ctx.fillStyle='#edcf78';ctx.fillRect(doorX+doorW-7,doorY+doorH*.58,3,4);ctx.fillStyle='#b7aa8b';ctx.fillRect(doorX-8,bodyY+bodyH-1,doorW+16,6);
 ctx.fillStyle=p.trim;ctx.fillRect(x+w*.34,bodyY+6,34,14);ctx.fillStyle='#f1d797';ctx.fillRect(x+w*.34+3,bodyY+9,28,8);ctx.fillStyle=p.trim;ctx.fillRect(x+w*.34+8,bodyY+11,3,3);ctx.fillRect(x+w*.34+20,bodyY+11,3,3);
 if(feature==='shop'){ctx.fillStyle='#f3d17d';ctx.fillRect(x+7,bodyY-4,w-14,9);ctx.fillStyle=p.light;for(let xx=x+9;xx<x+w-9;xx+=18)ctx.fillRect(xx,bodyY-4,7,9)}
 if(feature==='inn'){ctx.fillStyle='#ad5548';ctx.fillRect(x+9,bodyY+bodyH-14,w-24,6);ctx.fillStyle='#f1d797';ctx.fillRect(x+14,bodyY+bodyH-13,w-34,2)}
 ctx.restore();
}
function drawTownLandmarks(){if(drawDetailedTown())return;
 // Tiny tile-set props at a four-times pixel scale keep the town and sprites cohesive.
 const props=mapId==='brackenford'?[[19,9],[21,9],[23,9],[26,10],[29,10]]:mapId==='stonewatch'?[[15,9],[17,9],[24,10],[29,10]]:mapId==='sunmere'?[[19,9],[21,9],[24,10],[27,10],[30,10]]:[[15,9],[18,9],[23,10],[27,10]];
 props.forEach(([tx,ty],i)=>{const points=[[-70,110],[975,110],[-70,470],[975,470],[650,110]];const [x,y]=points[i%points.length];drawTile(tx,ty,x-24,y-28,48)});
 // A fountain/well anchors the square; nearby planting beds break up open grass.
 ctx.save();ctx.translate(170,-9);ctx.fillStyle='#17251f99';ctx.beginPath();ctx.ellipse(480,230,37,13,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#716252';ctx.fillRect(449,205,62,27);ctx.fillStyle='#b5a184';ctx.fillRect(445,199,70,10);ctx.fillStyle='#537e7c';ctx.fillRect(453,210,54,17);ctx.fillStyle='#e2c386';ctx.fillRect(475,187,10,16);ctx.fillStyle='#78573d';ctx.fillRect(463,184,34,5);
 ctx.restore();for(const [x,y] of [[320,260],[610,260],[320,600],[650,600]]){ctx.fillStyle='#604d37';ctx.fillRect(x-24,y-8,48,18);ctx.fillStyle='#a67747';ctx.fillRect(x-22,y-6,44,12);ctx.fillStyle='#709c55';for(let i=-1;i<=1;i++)ctx.fillRect(x+i*13,y-4,7,7);ctx.fillStyle='#e7c974';ctx.fillRect(x-16,y-12,4,4);ctx.fillRect(x+10,y-11,4,4)}
 // Market stall and lamps give the main street a lived-in scale.
 for(const [x,y] of [[286,290],[680,290]]){ctx.fillStyle='#342f28';ctx.fillRect(x-34,y-22,68,31);ctx.fillStyle='#b8874f';ctx.fillRect(x-31,y-18,62,25);ctx.fillStyle='#e6cf9d';ctx.fillRect(x-36,y-25,72,8);ctx.fillStyle='#8e5342';ctx.fillRect(x-30,y-25,14,8);ctx.fillRect(x-2,y-25,14,8);ctx.fillStyle='#d6bb7b';ctx.fillRect(x-30,y+7,5,12);ctx.fillRect(x+25,y+7,5,12);ctx.fillStyle='#967249';ctx.fillRect(x-19,y-14,38,10)}
 for(const x of [226,734]){const glow=ctx.createRadialGradient(x,258,2,x,258,32),flicker=.8+Math.sin(animationClock*7+x)*.12;glow.addColorStop(0,'rgba(255,218,135,'+(.24*flicker)+')');glow.addColorStop(1,'rgba(255,218,135,0)');ctx.fillStyle=glow;ctx.fillRect(x-32,226,64,64);ctx.fillStyle='#332c28';ctx.fillRect(x-3,268,6,39);ctx.fillStyle='#b98a50';ctx.fillRect(x-8,266,16,4);ctx.fillStyle='#f6dc91';ctx.fillRect(x-6,251,12,15);ctx.fillStyle='#fff0b2';ctx.fillRect(x-3,254,6,7)}
}

// Cave silhouettes are cached so rock detail does not add work each frame.
const caveEntranceArt=new Map();
function drawCaveEntrance(x,y,style='ash',locked=false){
 const key=style+':'+locked;let art=caveEntranceArt.get(key);
 if(!art){
  art=document.createElement('canvas');art.width=320;art.height=280;const c=art.getContext('2d');c.scale(2,2);c.translate(80,116);
  const accent={ash:'#b7a477',fire:'#e59a50',tide:'#7dc8c4',storm:'#a3b5dc',crown:'#bd9fc8'}[style]||'#b7a477';
  const poly=(pts,fill,stroke)=>{c.beginPath();pts.forEach(([px,py],i)=>i?c.lineTo(px,py):c.moveTo(px,py));c.closePath();c.fillStyle=fill;c.fill();if(stroke){c.strokeStyle=stroke;c.lineWidth=1;c.stroke()}};
  const shadow=c.createRadialGradient(0,2,8,0,2,72);shadow.addColorStop(0,'#11181199');shadow.addColorStop(1,'#11181100');c.save();c.scale(1,.34);c.fillStyle=shadow;c.fillRect(-77,-75,154,150);c.restore();
  poly([[-53,8],[-44,-2],[-27,-5],[27,-5],[50,5],[61,15],[33,19],[-35,17]],'#75675366');
  const rock=c.createLinearGradient(-45,-100,55,8);rock.addColorStop(0,'#aaa696');rock.addColorStop(.38,'#77796b');rock.addColorStop(1,'#393f38');
  poly([[-62,6],[-57,-25],[-49,-36],[-47,-60],[-34,-67],[-29,-87],[-8,-100],[13,-97],[34,-84],[39,-65],[52,-50],[51,-29],[63,5],[39,12],[-39,12]],rock,'#323a32');
  poly([[-49,-36],[-47,-60],[-34,-67],[-29,-87],[-8,-100],[-12,-80],[-28,-62],[-30,-39]],'#c0bd9e55');
  poly([[13,-97],[34,-84],[39,-65],[52,-50],[51,-29],[63,5],[40,10],[35,-35],[21,-65]],'#252d3355');
  const mouth=c.createLinearGradient(0,-70,0,5);mouth.addColorStop(0,'#03080b');mouth.addColorStop(.7,'#0c1517');mouth.addColorStop(1,'#3b3e35');
  poly([[-30,7],[-31,-30],[-25,-51],[-15,-68],[0,-74],[17,-65],[28,-48],[32,-22],[31,7]],mouth,'#252d2a');
  poly([[-30,7],[-31,-30],[-25,-51],[-15,-68],[0,-74],[-5,-65],[-18,-51],[-23,-27],[-23,7]],'#151d1c');
  const facets=[ [[-60,3],[-53,-23],[-36,-20],[-32,8]], [[-52,-25],[-47,-51],[-30,-43],[-35,-19]], [[-45,-55],[-33,-77],[-18,-68],[-27,-49]], [[-30,-81],[-9,-95],[1,-79],[-14,-70]], [[-5,-96],[17,-92],[18,-76],[2,-79]], [[20,-88],[34,-76],[31,-57],[18,-69]], [[36,-63],[48,-47],[34,-36],[28,-52]], [[48,-43],[51,-21],[35,-17],[34,-32]], [[53,-18],[61,5],[35,10],[36,-12]] ];
  facets.forEach((pts,i)=>{poly(pts,['#7e8272','#8f9180','#a1a18b','#aaa58c','#8e927f','#777e71','#677265','#606d61','#596354'][i],'#39453b');c.beginPath();c.moveTo(pts[0][0]+2,pts[0][1]+2);c.lineTo(pts[1][0]-2,pts[1][1]+2);c.strokeStyle='#d3cfb24d';c.stroke()});
  // Small cracks and moss break up the rock without a rectangular backdrop.
  c.strokeStyle='#313c3599';c.lineWidth=1.1;for(const [px,py] of [[-44,-33],[-22,-82],[27,-74],[43,-26]]){c.beginPath();c.moveTo(px,py);c.lineTo(px+4,py+7);c.lineTo(px+1,py+12);c.stroke()}
  for(const [px,py] of [[-49,-14],[-39,-58],[-17,-91],[37,-46],[48,0]]){poly([[px-5,py],[px,py-3],[px+7,py+1],[px+3,py+4]],style==='tide'?'#6c9a9188':'#74845488')}
  poly([[-28,9],[-21,2],[21,2],[31,9]],'#9a9176');poly([[-30,14],[-27,9],[30,9],[37,14]],'#615e4f');c.strokeStyle='#c2b89b66';c.beginPath();c.moveTo(-24,3);c.lineTo(21,3);c.stroke();
  for(const [px,py,r] of [[-58,11,8],[-43,17,5],[51,13,7],[40,19,4]]){poly([[px-r,py],[px-r*.6,py-r*.7],[px+r*.3,py-r],[px+r,py-1],[px+r*.5,py+3]],'#71786a','#404b40')}
  for(const px of [-37,38]){poly([[px-3,-31],[px+2,-34],[px+5,-26],[px+2,-20],[px-2,-24]],locked?'#7e8174':accent);}
  if(!locked){const glow=c.createRadialGradient(0,-14,2,0,-14,28);glow.addColorStop(0,accent+'30');glow.addColorStop(1,accent+'00');c.fillStyle=glow;c.fillRect(-28,-42,56,49)}
  caveEntranceArt.set(key,art);
 }
 ctx.drawImage(art,x-80,y-116,160,140);
}

function drawAdventureScenery(){const d=storyDungeons[mapId];ctx.save();ctx.textAlign='center';const label=(text,x,y)=>{ctx.font='bold 13px system-ui';ctx.lineWidth=4;ctx.strokeStyle='#141b1e';ctx.strokeText(text,x,y);ctx.fillStyle='#ffe1a0';ctx.fillText(text,x,y)};
 if(d){ctx.fillStyle='#171b22';ctx.fillRect(0,0,960,600);ctx.fillStyle=d.color;drawRegionFloor(48,58,864,485);ctx.strokeStyle='#282a30';ctx.lineWidth=20;ctx.strokeRect(48,58,864,485);for(let y=76;y<530;y+=34)for(let x=68;x<895;x+=44){ctx.strokeStyle='#c5c1a222';ctx.lineWidth=1;ctx.strokeRect(x,y,42,32)}label(d.name.toUpperCase(),480,28);ctx.fillStyle='#302923';ctx.fillRect(441,523,78,35);ctx.fillStyle='#302923';}
 for(const obj of activeMap.worldObjects||[]){if(!(obj.id.startsWith('story_')||obj.id.startsWith('secret_')||obj.id.startsWith('epilogue_')||obj.id==='crossroads_medicine'||obj.id==='campaign_chronicle'))continue;
  if(obj.id.startsWith('secret_')){if(Math.hypot(player.x-obj.x,player.y-obj.y)>115)continue;ctx.fillStyle=townQuestState[obj.id]?.claimed?'#494333':'#8d6138';ctx.fillRect(obj.x-19,obj.y-15,38,26);ctx.strokeStyle='#bdaf79';ctx.lineWidth=3;ctx.strokeRect(obj.x-19,obj.y-15,38,26)}
  else if(obj.id.startsWith('story_portal_')){drawCaveEntrance(obj.x,obj.y,storyDungeons[obj.dungeon].style,!!storyPortalLock(obj.dungeon))}
  else if(obj.id.startsWith('story_ward_')){const off=townQuestState['story_'+obj.dungeon]?.wards?.includes(obj.index);ctx.fillStyle='#707a80';ctx.fillRect(obj.x-17,obj.y-38,34,42);ctx.fillStyle=off?'#333a41':'#b6e6ef';ctx.beginPath();ctx.arc(obj.x,obj.y-42,13,0,Math.PI*2);ctx.fill()}
  else if(obj.id.startsWith('story_cache_')){ctx.fillStyle='#926038';ctx.fillRect(obj.x-27,obj.y-23,54,36);ctx.strokeStyle='#e9c675';ctx.lineWidth=4;ctx.strokeRect(obj.x-27,obj.y-23,54,36);ctx.fillStyle='#eed69a';ctx.fillRect(obj.x-4,obj.y-12,8,15)}
  else if(obj.id.startsWith('epilogue_')||obj.id==='crossroads_medicine')drawSpritePerson(1,5,obj.x,obj.y,42,50);
  else{ctx.fillStyle='#776655';ctx.fillRect(obj.x-27,obj.y-35,54,42);ctx.fillStyle='#d7c18b';ctx.fillRect(obj.x-22,obj.y-29,44,28)}
  if(obj.label){const parts=obj.label.split(' · ');const ly=obj.y-(obj.id.startsWith('story_portal_')?124:obj.id.startsWith('story_cache_')?-35:58);parts.forEach((part,i)=>label(part,obj.x,ly-(parts.length-1-i)*15));}
 }
 ctx.restore();if(d)drawDungeonHazards();
}
function drawClassGearObjects(){
 for(const obj of activeMap.worldObjects||[]){if(!obj.id.startsWith('armory_')&&!obj.id.startsWith('gear_waystone_'))continue;
  ctx.save();ctx.textAlign='center';
  if(drawDetailedWorldObject(obj)){}else if(obj.id.startsWith('armory_')){ctx.fillStyle='#453326';ctx.fillRect(obj.x-38,obj.y-46,76,45);ctx.fillStyle='#ceba82';ctx.fillRect(obj.x-31,obj.y-39,62,30);ctx.fillStyle='#4c4432';for(let y=obj.y-32;y<obj.y-13;y+=8)ctx.fillRect(obj.x-23,y,46,3);ctx.fillStyle='#795c3b';ctx.fillRect(obj.x-26,obj.y-1,7,20);ctx.fillRect(obj.x+19,obj.y-1,7,20)}
  else{const st=townQuestState['gear_'+obj.hero+'_shield'],lit=st?.claimed||st?.waystones?.includes(mapId);ctx.fillStyle='#677777';ctx.beginPath();ctx.moveTo(obj.x-20,obj.y+10);ctx.lineTo(obj.x-13,obj.y-39);ctx.lineTo(obj.x+5,obj.y-48);ctx.lineTo(obj.x+21,obj.y-32);ctx.lineTo(obj.x+25,obj.y+10);ctx.closePath();ctx.fill();ctx.strokeStyle=lit?'#ffe191':'#a4c4cc';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(obj.x,obj.y-32);ctx.lineTo(obj.x+8,obj.y-18);ctx.lineTo(obj.x,obj.y-5);ctx.lineTo(obj.x-8,obj.y-18);ctx.closePath();ctx.stroke()}
  ctx.font='bold 13px system-ui';ctx.lineWidth=4;ctx.strokeStyle='#172019';ctx.fillStyle='#fff0b2';ctx.strokeText(obj.label,obj.x,obj.y-52);ctx.fillText(obj.label,obj.x,obj.y-52);ctx.restore();
 }
}
function drawWorldLandmarks(){if(drawDetailedLandmark())return;
 if(!activeMap.landmark)return;
 ctx.save();ctx.textAlign='center';
 const label=(text,x,y)=>{ctx.font='bold 14px system-ui';ctx.lineWidth=4;ctx.strokeStyle='#172019';ctx.strokeText(text,x,y);ctx.fillStyle='#fff0b2';ctx.fillText(text,x,y)};
 if(activeMap.landmark==='watchtower'){
  ctx.fillStyle='#17201988';ctx.fillRect(416,104,136,149);ctx.fillStyle='#4a514e';ctx.fillRect(415,90,130,150);ctx.fillStyle='#87918a';ctx.fillRect(421,94,118,141);
  for(let y=100;y<234;y+=18){ctx.strokeStyle='#535d57';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(421,y);ctx.lineTo(539,y);ctx.stroke();for(let x=425+(y%36?18:0);x<535;x+=36){ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,y+18);ctx.stroke()}}
  for(let x=415;x<545;x+=26){ctx.fillStyle='#a0aaa0';ctx.fillRect(x,76,16,22)}ctx.fillStyle='#273a3b';ctx.fillRect(459,119,42,44);ctx.fillStyle='#d2b970';ctx.fillRect(475,121,9,40);ctx.fillStyle='#302a22';ctx.fillRect(461,195,38,45);label('SILENT WATCHTOWER',480,450);
 }
 if(activeMap.landmark==='bandit_camp'){
  for(const [x,y] of [[260,120],[560,100]]){ctx.fillStyle='#352b2788';ctx.fillRect(x+5,y+7,145,90);ctx.fillStyle='#805242';ctx.beginPath();ctx.moveTo(x,y+90);ctx.lineTo(x+73,y);ctx.lineTo(x+145,y+90);ctx.closePath();ctx.fill();ctx.fillStyle='#ba8e61';ctx.beginPath();ctx.moveTo(x+73,y+12);ctx.lineTo(x+83,y+87);ctx.lineTo(x+68,y+87);ctx.closePath();ctx.fill();ctx.fillStyle='#302921';ctx.fillRect(x+60,y+58,26,32)}
  const rescued=!!townQuestState.world_rescue?.claimed;ctx.fillStyle='#332b22';ctx.fillRect(710,145,80,90);ctx.strokeStyle='#bfac80';ctx.lineWidth=5;ctx.strokeRect(710,145,80,90);if(!rescued)drawSpritePerson(1,5,750,219,38,44);ctx.strokeStyle='#918c7e';ctx.lineWidth=4;for(let x=720;x<785;x+=13){ctx.beginPath();ctx.moveTo(x,148);ctx.lineTo(x,233);ctx.stroke()}label(rescued?'TRAVELER FREED':'SOUTHERN BANDIT CAMP',520,52);
 }
 for(const obj of activeMap.worldObjects){
  if(!obj.id.startsWith('beacon_')&&!['tower_tablet','tower_cache','rescue_notice','prisoner_cage'].includes(obj.id))continue;
  if(obj.id.startsWith('beacon_')){const order=['beacon_east','beacon_west','beacon_north'],st=townQuestState.world_watchtower||{},lit=st.claimed||order.indexOf(obj.id)<(st.progress||0);ctx.fillStyle='#65594a';ctx.fillRect(obj.x-12,obj.y-17,24,22);ctx.fillStyle=lit?'#ffcf70':'#302d27';ctx.beginPath();ctx.arc(obj.x,obj.y-22,lit?11:7,0,Math.PI*2);ctx.fill();if(lit){ctx.fillStyle='#ff8c47';ctx.fillRect(obj.x-4,obj.y-36,8,16)}}
  else if(obj.id==='tower_cache'){ctx.fillStyle='#7b512f';ctx.fillRect(obj.x-22,obj.y-18,44,29);ctx.strokeStyle='#d4b16b';ctx.lineWidth=3;ctx.strokeRect(obj.x-22,obj.y-18,44,29);ctx.fillStyle='#edd795';ctx.fillRect(obj.x-3,obj.y-9,6,10)}
  else if(obj.id!=='prisoner_cage'){ctx.fillStyle='#574431';ctx.fillRect(obj.x-3,obj.y-20,6,27);ctx.fillStyle='#c8b483';ctx.fillRect(obj.x-27,obj.y-38,54,28);ctx.fillStyle='#5d5141';ctx.fillRect(obj.x-19,obj.y-30,38,3);ctx.fillRect(obj.x-19,obj.y-23,27,3)}
  label(obj.label,obj.x,obj.y-48);
 }
 ctx.restore();
}
function drawFlowerPot(x,y){
 ctx.save();ctx.translate(x,y);
 ctx.fillStyle='#10201466';ctx.beginPath();ctx.ellipse(1,13,25,7,0,0,Math.PI*2);ctx.fill();
 const clay=ctx.createLinearGradient(-22,0,22,0);clay.addColorStop(0,'#68412a');clay.addColorStop(.3,'#b47e4c');clay.addColorStop(.65,'#94603a');clay.addColorStop(1,'#503423');
 ctx.fillStyle=clay;ctx.beginPath();ctx.moveTo(-23,-8);ctx.lineTo(-16,12);ctx.quadraticCurveTo(0,20,16,12);ctx.lineTo(23,-8);ctx.closePath();ctx.fill();
 ctx.strokeStyle='#cc9c64';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(0,-8,24,8,0,0,Math.PI*2);ctx.fillStyle='#5c412b';ctx.fill();ctx.stroke();
 standArt('bush',-8,-7,30);standArt('bush',9,-7,27);
 for(const [fx,fy,color] of [[-15,-27,'#d79c87'],[-3,-34,'#ecd291'],[12,-28,'#d6a8b3'],[2,-19,'#dba17e']]){
  ctx.fillStyle='#31552c';ctx.fillRect(fx-1,fy,2,12);
  for(let i=0;i<5;i++){const a=i*Math.PI*2/5;ctx.fillStyle=color;ctx.beginPath();ctx.arc(fx+Math.cos(a)*2.6,fy+Math.sin(a)*2.6,2.2,0,Math.PI*2);ctx.fill();}
  ctx.fillStyle='#f5d981';ctx.beginPath();ctx.arc(fx,fy,1.4,0,Math.PI*2);ctx.fill();
 }
 ctx.restore();
}

function drawRegionalScenery(){
 if(activeMap.interior||activeMap.dungeon||storyDungeons[mapId]||mapId==='emberdeep')return;
 const surface=regionSurface();ctx.save();
 const snowy=surface==='snow',marsh=surface==='marsh',coast=['sunmere','sunharbor','coastroad','icecoast'].includes(mapId),ember=['cinderfields','westwood'].includes(mapId),farm=['crowfield','meadowroad'].includes(mapId);
 for(const [i,p] of (activeMap.trees||[]).entries()){const x=p[0]+48,y=p[1]+18;if(mapPlacementBlocked(mapId,x,y,9)||Math.abs(y-322)<68)continue;if(farm){ctx.strokeStyle='#b2a06299';ctx.lineWidth=2;for(let j=0;j<4;j++){ctx.beginPath();ctx.moveTo(x+j*7,y);ctx.lineTo(x+j*7+3,y-18);ctx.stroke()}}else if(coast){standArt('rock',x,y,22)}else if(marsh){standArt('bush',x,y,22)}else if(ember){standArt('rock',x,y,22)}else standArt('bush',x,y,20);}
 for(const obj of activeMap.worldObjects||[]){if(!obj.id.startsWith('regional_'))continue;const d=regionalAdventures[obj.region],st=regionalState(obj.region),piece=obj.piece!==undefined,found=piece&&(st.found||[]).includes(obj.piece);if(found||st.claimed&&piece)continue;
 const key=piece?(d.type==='sequence'?'runestone':obj.region==='crowfield'?'crate':'lamp'):d.type==='hunt'?(obj.region==='greenhollow'?'tent':obj.region==='sunharbor'?'runestone':'portal'):d.type==='supply'?'campfire':d.type==='sequence'?'runestone':'notice';
 standArt(st.claimed&&d.type!=='supply'?'openchest':key,obj.x,obj.y,piece?32:52,st.claimed&&d.type!=='supply'?'extras':key==='notice'?'extras':'environment');
 ctx.fillStyle=d.color;ctx.globalAlpha=.45+.2*Math.sin(animationClock*2);ctx.beginPath();ctx.ellipse(obj.x,obj.y+6,piece?15:25,7,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
 if(Math.hypot(obj.x-player.x,obj.y-player.y)<140)drawLocationLabel(obj.x,obj.y-70,st.claimed?'COMPLETE':obj.label);
 }
 ctx.restore();
}
function drawRegionalAtmosphere(){if(activeMap.interior||activeMap.dungeon||storyDungeons[mapId])return;const snow=regionSurface()==='snow',marsh=regionSurface()==='marsh',embers=mapId==='cinderfields',coast=['sunharbor','sunmere','coastroad'].includes(mapId);if(!snow&&!marsh&&!embers&&!coast)return;ctx.save();ctx.fillStyle=snow?'#edf8fa':marsh?'#cbe79a':embers?'#ffb46b':'#edf2dd';ctx.globalAlpha=snow?.36:.28;for(let i=0;i<16;i++){const x=((i*97+animationClock*(snow?10:4))%viewW),y=((i*73+Math.sin(animationClock+i)*8+(snow?animationClock*14:0))%Math.max(1,viewH-45));if(coast){ctx.strokeStyle='#e4eed880';ctx.lineWidth=1;ctx.beginPath();ctx.arc(x,y,5,Math.PI,Math.PI*1.7);ctx.arc(x+8,y,5,Math.PI*1.3,Math.PI*2);ctx.stroke()}else{ctx.beginPath();ctx.arc(x,y,snow?1.5:1.2,0,Math.PI*2);ctx.fill()}}ctx.restore()}

function drawExpandedWorldScenery(){
 if(!usesOpenWorld())return;
 const ox=OPEN_WORLD_ORIGIN_X,oy=OPEN_WORLD_ORIGIN_Y,worldW=OPEN_WORLD_WIDTH,worldH=OPEN_WORLD_HEIGHT;
 // Secondary paths, clearings, and districts continue beyond the first viewport.
 if(activeMap.town){
  const townSet={ashvale:0,brackenford:3,stonewatch:1,sunmere:2}[mapId]||0;
  // Small outlying neighborhoods and garden plots give the whole town room to explore.
  const homes=townOutlyingHouses.filter(([x,y])=>!['weapons','armorShop','jewelry'].some(key=>townFrontages[key].x===x&&townFrontages[key].y===y));
  homes.forEach(([x,y,w,h],i)=>{ctx.fillStyle='#17251f66';ctx.fillRect(x+7,y+9,w,h);drawPixelHouse(x,y,w,h,(townSet+i+1)%4,i%3===0?'inn':'home')});
  for(const [x,y] of [[-280,-95],[970,-95]])drawFlowerPot(x,y);
 }else if(mapId==='highmoor'){
  const sites=[[-405,-232,168,118],[-105,-220,205,142],[930,-224,195,132],[1210,-168,160,125],[-405,440,188,138],[-90,690,205,128],[260,770,180,132],[925,430,208,140],[1220,770,168,125]];
  sites.forEach(([x,y,w,h])=>{if(!paintArt('ruin',x,y,w,h)){ctx.fillStyle='#777267';ctx.fillRect(x,y,w,h)}});
 }else if(mapId==='redfen'){
  // Marsh pools are drawn once from the validated scenery coordinates.
 }else if(mapId==='frostmarch'){
  for(const [x,y,w,h] of [[-400,-235,170,72],[115,-220,220,64],[880,-215,205,75],[1220,-90,160,62],[-390,500,220,76],[160,690,260,70],[820,675,210,78],[1200,500,190,70]]){ctx.fillStyle='#d9e2df';ctx.beginPath();ctx.ellipse(x+w/2,y+h/2,w/2,h/2,.03,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#aebfc0';ctx.lineWidth=3;ctx.stroke();ctx.fillStyle='#edf2eb';for(let i=0;i<5;i++)ctx.fillRect(x+18+i*31,y+12+(i%2)*19,18,7)}
 }else if(mapId==='whisperwood'){
  for(const [x,y] of [[-410,-225],[-255,-210],[115,-220],[995,-220],[1260,-205],[-410,680],[-250,700],[160,700],[990,690],[1260,670],[-425,90],[1250,450]]){drawTile(13,9,x-29,y-32,58);drawTile(15,9,x+24,y-18,44)}
 }
 // Paths tie the new districts into the old east-west travel road.
 if(!activeMap.town){for(const y of [-48,690]){ctx.save();ctx.beginPath();ctx.rect(-ox,y,worldW,34);ctx.clip();drawTileField(6,0,-ox,y,worldW-ox,y+34,32);ctx.restore()}for(const x of [-170,1110]){ctx.save();ctx.beginPath();ctx.rect(x,-oy,34,worldH);ctx.clip();drawTileField(6,0,x,-oy,x+34,worldH-oy,32);ctx.restore()}}
}
function labelCoversActor(left,top,right,bottom){
 const actors=[player,...activeCompanions().filter(c=>c.hp>0),...(activeMap.town?activeMap.npcs:[])];
 return actors.some(a=>rectsOverlap([left,top,right,bottom],[a.x-24,a.y-58,a.x+24,a.y+12]));
}
function drawLocationLabel(x,y,label){ctx.save();ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';const w=ctx.measureText(label).width+16;if(labelCoversActor(x-w/2,y-12,x+w/2,y+12)){ctx.restore();return}ctx.fillStyle='#142019f2';ctx.fillRect(x-w/2,y-12,w,24);ctx.strokeStyle='#bda572';ctx.lineWidth=1;ctx.strokeRect(x-w/2,y-12,w,24);ctx.fillStyle='#fff0b2';ctx.fillText(label,x,y);ctx.restore();}
function drawTownHouseLabels(){
 if(!activeMap.town)return;
 const used=new Set(activeMap.npcs.map(n=>n.frontage));used.add('classHome');
 ctx.save();ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';
 for(const key of used){
  const front=townFrontages[key];if(!front)continue;
  const door=townDoor(front);if(Math.hypot(player.x-door.x,player.y-door.y)>260)continue;
  const lines=key==='slayers'?['SLAYERS','HALL']:key==='classHome'?['CLASS HOUSE',ownsHome(activeMap.homeId)?'OWNED':'FOR SALE']:key==='companion'?['PET','SANCTUARY']:[front.label];
  const width=Math.ceil(Math.max(...lines.map(line=>ctx.measureText(line).width)))+16,height=lines.length*16+8;
  const top=usesOpenWorld()?cameraY-OPEN_WORLD_ORIGIN_Y:0;
  if(front.y+front.h<top||front.y>top+(viewH/roomScale)-22)continue;
  const x=front.x+front.w/2,y=front.y+4-height;const left=usesOpenWorld()?cameraX-OPEN_WORLD_ORIGIN_X:cameraX,right=left+viewW/roomScale,bottom=top+viewH/roomScale-24;if(x-width/2<left+4||x+width/2>right-4||y<top+48||y+height>bottom)continue;
  if(labelCoversActor(x-width/2,y,x+width/2,y+height))continue;
  ctx.fillStyle='#172019';ctx.fillRect(x-width/2,y,width,height);
  ctx.strokeStyle='#d6bd86';ctx.lineWidth=2;ctx.strokeRect(x-width/2,y,width,height);
  ctx.fillStyle='#fff0b2';lines.forEach((line,i)=>ctx.fillText(line,x,y+12+i*16));
 }
 ctx.restore();
}
function drawCompanionLabels(){
 ctx.save();ctx.font='bold 11px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';const placed=[];
 for(const c of activeCompanions()){
  if(c.hp<=0||Math.hypot(player.x-c.x,player.y-c.y)>=160)continue;
  const name=c.name+' · Lv '+c.level,w=ctx.measureText(name).width+12;let y=c.y-66;
  while(placed.some(r=>Math.abs(c.x-r.x)<(w+r.w)/2+5&&Math.abs(y-r.y)<21))y-=22;
  placed.push({x:c.x,y,w});ctx.strokeStyle='#d6c59066';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(c.x,y+10);ctx.lineTo(c.x,c.y-55);ctx.stroke();
  ctx.fillStyle='#132019e8';ctx.fillRect(c.x-w/2,y-9,w,18);ctx.fillStyle='#fff0b2';ctx.fillText(name,c.x,y);
 }
 ctx.restore();
}
function draw(){
 refreshHeroPortrait();
 // Outdoor locations use a larger top-down world with a player-following camera.
 const outdoor=usesOpenWorld(),ox=outdoor?OPEN_WORLD_ORIGIN_X:0,oy=outdoor?OPEN_WORLD_ORIGIN_Y:0,worldW=outdoor?OPEN_WORLD_WIDTH:W,worldH=outdoor?OPEN_WORLD_HEIGHT:H;
 ctx.setTransform(1,0,0,1,0,0);ctx.fillStyle='#18211d';ctx.fillRect(0,0,viewW,viewH);ctx.save();ctx.scale(roomScale,roomScale);ctx.translate(ox-cameraX+(impactShake>0?Math.sin(animationClock*95)*2:0),oy-cameraY);
 // Pixel-tiled meadow and scene floor
 ctx.fillStyle=(activeMap.dungeon||mapId==='emberdeep')?'#393844':'#3a6633';ctx.fillRect(-ox,-oy,worldW,worldH);
 drawTileField(0,15,-ox,-oy,worldW-ox,worldH-oy,32);
 if(outdoor){ctx.save();ctx.beginPath();ctx.rect(-ox,270,worldW,105);ctx.clip();drawTileField(6,0,-ox,270,worldW-ox,375,32);ctx.restore()}
 if(mapId==='ashvale'&&!activeMap.town){
   // A shallow pond gives the village road a clear landmark.
   ctx.save();ctx.beginPath();ctx.ellipse(696,145,76,43,-.14,0,Math.PI*2);ctx.clip();
   drawTileField(0,0,610,95,785,195,32);ctx.restore();
   ctx.strokeStyle='#b4bd8d';ctx.lineWidth=5;ctx.beginPath();ctx.ellipse(696,145,77,44,-.14,0,Math.PI*2);ctx.stroke();
   ctx.save();ctx.beginPath();ctx.moveTo(0,286);ctx.lineTo(960,258);ctx.lineTo(960,352);ctx.lineTo(0,380);ctx.closePath();ctx.clip();drawTileField(6,0,0,250,W,400,32);ctx.restore();
   ctx.fillStyle='#322e26';ctx.fillRect(72,145,133,50);ctx.fillStyle='#f0dda5';ctx.font='bold 14px Georgia';ctx.fillText('ASHVALE',91,175);
   
 }else if(mapId==='whisperwood'){
   ctx.save();ctx.beginPath();ctx.moveTo(0,275);ctx.lineTo(960,305);ctx.lineTo(960,390);ctx.lineTo(0,355);ctx.closePath();ctx.clip();drawTileField(6,0,0,265,W,400,32);ctx.restore();
   
   drawTile(13,10,816,170,48);drawTile(13,10,835,177,32);drawCaveEntrance(850,500,'ash',!hasSigil);
 }else if(mapId==='mosslight'){
   ctx.fillStyle='#514d4c';drawRegionFloor(32,42,896,516);ctx.strokeStyle='#a69d84';ctx.lineWidth=6;ctx.strokeRect(32,42,896,516);
   drawTileField(7,0,42,52,918,548,32);
   ctx.fillStyle='#27252b';ctx.fillRect(0,264,42,105);ctx.fillRect(918,264,42,105);
   ctx.fillStyle='#fff0b2';ctx.font='bold 16px Georgia';ctx.fillText('M O S S L I G H T   S H R I N E',350,84);
   ctx.strokeStyle='#716d68';ctx.lineWidth=1;for(let x=100;x<900;x+=100){ctx.beginPath();ctx.moveTo(x,100);ctx.lineTo(x,540);ctx.stroke()}for(let y=140;y<540;y+=100){ctx.beginPath();ctx.moveTo(45,y);ctx.lineTo(915,y);ctx.stroke()}
 }else if(mapId==='emberdeep'){
   ctx.fillStyle='#332f35';drawRegionFloor(32,42,896,516);ctx.strokeStyle='#93836c';ctx.lineWidth=8;ctx.strokeRect(32,42,896,516);drawTileField(7,0,42,52,918,548,32);
   ctx.fillStyle='#242127';ctx.fillRect(0,250,42,130);ctx.fillRect(918,250,42,130);
   ctx.strokeStyle='#51484a';ctx.lineWidth=4;for(let x=100;x<900;x+=100){ctx.beginPath();ctx.moveTo(x,60);ctx.lineTo(x,540);ctx.stroke()}for(let y=145;y<540;y+=100){ctx.beginPath();ctx.moveTo(45,y);ctx.lineTo(915,y);ctx.stroke()}
   ctx.fillStyle='#ead39a';ctx.font='bold 16px Georgia';ctx.fillText('A S H V A U L T   D E P T H S',335,82);
   ctx.fillStyle='#62472d';ctx.fillRect(834,278,62,44);ctx.fillStyle='#c59650';ctx.fillRect(834,273,62,13);ctx.strokeStyle='#f1d287';ctx.lineWidth=2;ctx.strokeRect(834,278,62,44);ctx.fillStyle='#f1d287';ctx.fillRect(860,290,8,15);ctx.font='11px system-ui';ctx.fillText(treasure&&treasure.opened?'EMPTY COFFER':'VAULT COFFER',824,340);
 }

 else if(activeMap.town){
   drawTownGround();
   const townSet={ashvale:0,brackenford:3,stonewatch:1,sunmere:2}[mapId]||0;
   const used=new Set(activeMap.npcs.map(n=>n.frontage));used.add('classHome');
   for(const key of used){const front=townFrontages[key];if(!front)continue;
    drawPixelHouse(front.x,front.y,front.w,front.h,townSet,key==='elder'?'elder':key==='forge'?'forge':front.kind);
    if(key==='slayers')standArt('shield',front.x+27,front.y+front.h-22,30,'items');
   }
   drawTownLandmarks();drawTownBanners();
 }else if(activeMap.interior){const home=homeDefs[activeMap.homeId];ctx.fillStyle=home.roof;drawRegionFloor(32,42,896,516);ctx.fillStyle=home.wall;ctx.fillRect(48,58,864,484);ctx.strokeStyle='#4c3425';ctx.lineWidth=12;ctx.strokeRect(48,58,864,484);ctx.fillStyle='#61472f';ctx.fillRect(650,132,130,180);ctx.fillStyle='#917348';ctx.fillRect(638,120,154,22);ctx.fillStyle='#4c3425';ctx.fillRect(682,190,65,122);ctx.fillStyle='#d5b978';ctx.fillRect(725,246,7,7);ctx.fillStyle='#4e3727';ctx.fillRect(465,492,50,50);for(const [cx,cy] of [[190,210],[825,215]]){ctx.fillStyle='#493321';ctx.fillRect(cx-30,cy-18,60,38);ctx.fillStyle='#a8793e';ctx.fillRect(cx-32,cy-23,64,14);ctx.strokeStyle='#e1bd72';ctx.lineWidth=2;ctx.strokeRect(cx-30,cy-18,60,38);ctx.fillStyle='#e5ca83';ctx.fillRect(cx-4,cy-13,8,10)}ctx.fillStyle='#f6e4ae';ctx.font='bold 16px Georgia';ctx.fillText(home.name.toUpperCase(),390,90);ctx.font='12px system-ui';ctx.fillText('INTERACT BY THE BED TO REST',625,330);ctx.fillText('STORAGE CHESTS',135,260);ctx.fillText('STORAGE CHESTS',770,265);
 }else if(['glassridge','sunharbor','greenhollow','crowfield','willowfen','stonewatchroad','redfen','highmoor','frostmarch'].includes(mapId)){drawRegionFloor(32,42,896,516); }
 // Every outdoor region keeps a walkable road running through its expanded boundaries.
 if(outdoor&&!activeMap.town){ctx.save();ctx.beginPath();ctx.rect(-ox,274,worldW,100);ctx.clip();drawTileField(6,0,-ox,270,worldW-ox,378,32);ctx.restore()}
 if(outdoor&&!activeMap.town){ctx.save();ctx.beginPath();ctx.rect(455,-oy,50,worldH);ctx.clip();drawTileField(6,0,455,-oy,505,worldH-oy,32);ctx.restore()}drawExpandedWorldScenery();drawRegionalScenery();drawAdventureScenery();drawWorldLandmarks();drawBriarHollow();drawVeilhaven();drawClassGearObjects();drawWayfarerObjects();detailedExtraScenery();drawFrontierScenery();drawWorkingTown();drawPoliticsScenery();drawNpcStories();drawWayfarerCamp();for(const node of activeMap.gatherNodes||[]){if(node.skill==='fishing')textureWater(node.x,node.y,48,28)}for(const node of activeMap.gatherNodes||[]){const distance=Math.hypot(player.x-node.x,player.y-node.y);if(node.skill==='fishing'&&distance>115)continue;if(node.skill!=='fishing'&&distance>105)continue;const point=node.skill==='woodcutting'?'🪓':node.skill==='mining'?'⛏':'🎣',label=node.skill==='woodcutting'?'CHOP':node.skill==='mining'?'MINE':'FISH',ready=node.readyAt<=Date.now();ctx.save();ctx.font='bold 13px system-ui';ctx.textAlign='center';ctx.fillStyle=ready?'#fff0b2':'#b4b0a1';ctx.strokeStyle='#152019';ctx.lineWidth=3;ctx.strokeText(point+' '+(distance<62?label:''),node.x,node.y-24);ctx.fillText(point+' '+(distance<62?label:''),node.x,node.y-24);ctx.restore()}
