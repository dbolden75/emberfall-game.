 const sceneNpcs=[...(activeMap.town?activeMap.npcs:npcs)].sort((a,b)=>a.y-b.y),labelNpc=sceneNpcs.reduce((best,n)=>!best||Math.hypot(player.x-n.x,player.y-n.y)<Math.hypot(player.x-best.x,player.y-best.y)?n:best,null);for(const n of sceneNpcs){ctx.fillStyle='#151a1799';ctx.beginPath();ctx.ellipse(n.x,n.y+5,17,8,0,0,Math.PI*2);ctx.fill();if(!(n.companionId&&companionDefs[n.companionId]?drawNpcHero(n):drawDetailedVillager(n)))drawSpritePerson(n.name.includes('Mara')||n.shopId||n.role==='leader'?0:1,n.name.includes('Mara')||n.role==='leader'?9:5,n.x,n.y,activeMap.town?52:38,activeMap.town?58:42);if(activeMap.town){ctx.fillStyle='#ffe08a';ctx.beginPath();ctx.moveTo(n.x,n.y-56);ctx.lineTo(n.x+6,n.y-50);ctx.lineTo(n.x,n.y-44);ctx.lineTo(n.x-6,n.y-50);ctx.closePath();ctx.fill()}if(n===labelNpc&&Math.hypot(player.x-n.x,player.y-n.y)<78){ctx.font='bold 13px system-ui';ctx.textAlign='center';ctx.lineWidth=3;ctx.strokeStyle='#172019';ctx.strokeText(n.name+(n.shopId?(n.shopId.endsWith('_forge')?' · FORGE':' · TRADE'):n.role==='healer'?' · HEAL':n.role==='house_broker'?' · HOUSE':n.role==='companion'?' · RECRUIT':n.questId?' · QUEST':' · TALK'),n.x,n.y-61);ctx.fillStyle='#fff0b2';ctx.fillText(n.name+(n.shopId?(n.shopId.endsWith('_forge')?' · FORGE':' · TRADE'):n.role==='healer'?' · HEAL':n.role==='house_broker'?' · HOUSE':n.role==='companion'?' · RECRUIT':n.questId?' · QUEST':' · TALK'),n.x,n.y-61);ctx.textAlign='start'}const routine=npcRoutines.get(n);if(n===labelNpc&&routine&&Math.hypot(player.x-n.x,player.y-n.y)<145&&Math.hypot(player.x-n.x,player.y-n.y)>=78){ctx.save();ctx.font='10px system-ui';ctx.textAlign='center';ctx.strokeStyle='#13231f';ctx.lineWidth=3;ctx.strokeText(routine.activity||'At work',n.x,n.y-58);ctx.fillStyle='#d2dfbc';ctx.fillText(routine.activity||'At work',n.x,n.y-58);ctx.restore();}}
 for(const e of enemies)if(!e.alive&&e.deathAnim>0&&!drawDetailedMonster(e,true))drawBattleAsset((e.kind==='slime'?'slime':e.kind==='bat'?'bat':'none')+'_die_down',e.x,e.y,2,1-e.deathAnim/.6);
 // Slimes and class-specific player sprites
 for(const e of enemies){if(!e.alive)continue;ctx.save();if(slayerTarget(mapId,e)){ctx.strokeStyle='#d6b66b';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(e.x,e.y+5,23,9,0,0,Math.PI*2);ctx.stroke();}ctx.translate(0,Math.sin(animationClock*3+(e.seed||0))*1.35);ctx.fillStyle='#151a1766';ctx.beginPath();ctx.ellipse(e.x,e.y+4,e.boss?21:14,6,0,0,Math.PI*2);ctx.fill();if(drawDetailedMonster(e)){}else if(e.kind==='bandit'){drawSpritePerson(0,9,e.x,e.y,e.name==='Bandit Captain'?50:42,52);ctx.fillStyle='#7d2929';ctx.fillRect(e.x-11,e.y-35,22,5);ctx.strokeStyle='#d8c6a0';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(e.x+15,e.y-9);ctx.lineTo(e.x+24,e.y-24);ctx.stroke()}else if(e.kind==='skeleton'||e.kind==='warden'){ctx.fillStyle=e.boss?'#6d3430':'#ddd2ae';ctx.fillRect(e.x-8,e.y-22,16,17);ctx.fillRect(e.x-12,e.y-5,24,e.boss?22:18);ctx.fillStyle='#30272a';ctx.fillRect(e.x-5,e.y-17,3,3);ctx.fillRect(e.x+2,e.y-17,3,3);ctx.strokeStyle=e.boss?'#b94c3f':'#e8ddbc';ctx.lineWidth=3;for(let k=-1;k<=1;k++){ctx.beginPath();ctx.moveTo(e.x+k*6,e.y);ctx.lineTo(e.x+k*6,e.y+11);ctx.stroke()}if(e.boss){ctx.fillStyle='#d2a34d';ctx.fillRect(e.x-13,e.y-25,26,5)}}else if(e.kind==='spider'){ctx.strokeStyle='#2d2224';ctx.lineWidth=4;for(let k=-1;k<=1;k++){ctx.beginPath();ctx.moveTo(e.x-7,e.y-3+k*6);ctx.lineTo(e.x-18,e.y-12+k*11);ctx.moveTo(e.x+7,e.y-3+k*6);ctx.lineTo(e.x+18,e.y-12+k*11);ctx.stroke()}ctx.fillStyle='#4e2f32';ctx.beginPath();ctx.ellipse(e.x,e.y,12,10,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ffcf77';ctx.fillRect(e.x-5,e.y-3,3,3);ctx.fillRect(e.x+2,e.y-3,3,3)}else if(!drawBattleMonster(e))drawSpritePerson(0,3,e.x,e.y,36,36,e.kind==='slime'?Math.floor(animationClock*5+(e.seed||0))%2:0);if(mapId==='whisperwood'&&!done&&e.kind==='slime'){const pulse=2+Math.sin(animationClock*4+(e.seed||0))*1.5;ctx.fillStyle='#f6d77c';ctx.beginPath();ctx.moveTo(e.x,e.y-35-pulse);ctx.lineTo(e.x+5,e.y-30-pulse);ctx.lineTo(e.x,e.y-25-pulse);ctx.lineTo(e.x-5,e.y-30-pulse);ctx.closePath();ctx.fill()}if(e.roamingElite){ctx.strokeStyle='#ff554f';ctx.lineWidth=3;ctx.beginPath();ctx.ellipse(e.x,e.y+5,25,10,0,0,Math.PI*2);ctx.stroke();ctx.fillStyle='#ff8070';ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.fillText('DANGER · Lv '+encounterLevel(e),e.x,e.y-64)}if(!e.roamingElite){ctx.save();ctx.font='bold 11px system-ui';ctx.textAlign='center';ctx.strokeStyle='#111b17';ctx.lineWidth=3;ctx.fillStyle=e.boss?'#f3c66d':'#e6dabb';const label=(e.boss?'BOSS · ':'')+'Lv '+encounterLevel(e),ly=e.y-(e.boss?94:70);ctx.strokeText(label,e.x,ly);ctx.fillText(label,e.x,ly);ctx.restore();}if(e.hp<e.maxHp){ctx.fillStyle='#362c2a';ctx.fillRect(e.x-15,e.y-(e.boss?80:58),30,4);ctx.fillStyle='#d44c43';ctx.fillRect(e.x-15,e.y-(e.boss?80:58),30*Math.max(0,e.hp/e.maxHp),4)}ctx.restore()}
 // Larger artwork needs clear party spacing and consistent depth order.
 const heroSprites={warrior:[0,0],rogue:[0,5],mage:[0,7],cleric:[0,9]};
 for(const actor of [player,...activeCompanions().filter(c=>c.hp>0)].sort((a,b)=>a.y-b.y)){
  const isPlayer=actor===player,sprite=heroSprites[actor.class]||heroSprites.warrior;
  ctx.fillStyle='#151a1766';ctx.beginPath();ctx.ellipse(actor.x,actor.y+5,isPlayer?14:12,isPlayer?7:6,0,0,Math.PI*2);ctx.fill();
