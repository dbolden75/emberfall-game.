 // Subtle in-world direction label
 drawWorldHint(activeMap.interior?'Your home · INTERACT near a chest for storage or the bed to rest.':activeMap.town?'Open town · explore the wider area and follow the road to neighboring regions. Find healers, leaders, and local quest givers.':(activeMap.hint||(mapId==='ashvale'?(done?'Hunt complete. The gate to Whisperwood is open.':'Ash slimes are drawn to the old road. Stay alert.'):mapId==='whisperwood'?'Whisperwood Trail · find Rowan, then follow the Ashvault trail.':mapId==='mosslight'?(hasSigil?'The Ember Rune strengthens your blade. Take the lower stair for the Rootbound Maze.':'Follow the WEST, NORTH, EAST lantern order, then claim the Ember Rune.'):(deepQuestDone?'The vault is quiet. Return west to Whisperwood.':'Disarm the rune snares with INTERACT, then defeat the Cinder Warden.'))));
}
function drawWorldHint(text){ctx.save();ctx.font='12px Georgia';ctx.fillStyle='#121610c9';ctx.fillRect(0,viewH-25,viewW,25);ctx.fillStyle='#e7d4a5';ctx.textBaseline='middle';ctx.fillText(mapId==='frontier_outpost'?politicsHudTitle():activeMap.name,12,viewH-12,viewW-24);ctx.restore();}

function xpToNextLevel(level=player.level){const n=Math.max(0,Math.floor(Number(level)||1)-1);return 40+10*n+2*n*n}
function grantXp(amount){const value=Number(amount);if(!Number.isFinite(value)||value<=0)return;player.xp+=value;while(player.xp>=xpToNextLevel(player.level)){player.xp-=xpToNextLevel(player.level);player.level++;syncHeroStats();player.hp=player.max;playSfx('level');say('Level up! Your pet grows with you.')}normalizePets();scaleEnemiesForRegion()}
function talk(n){openNpcConversation(n);}
function refreshTownRelics(showMessage=false){let newlyEarned=[];for(const [town,def] of Object.entries(townRelicQuestSets)){const complete=def.quests.every(id=>!!townQuestState[id]?.claimed);if(complete&&!townRelicState[town]){townRelicState[town]=true;newlyEarned.push(def)}if(townRelicState[town])grantQuestArtifact(def.item)}const all=Object.values(townRelicState).every(Boolean);if(all){hasFourfoldKey=true;grantQuestArtifact('fourfold_key')}if(showMessage){if(all&&newlyEarned.length){const last=newlyEarned[0];say(last.hero+' completes '+last.arc+'. The four seals answer together: the Fourfold Keystone is forged, and Mosslight Shrine opens.')}else if(newlyEarned.length){const def=newlyEarned[0];say(def.hero+' completes '+def.arc+'. '+def.name+' earned. One companion’s story is resolved; finish the other three before entering Mosslight Shrine.')}}return all}
function interactQuest(n){if(!journalCanAccept(n.questId))return true;const q=townQuestDefs[n.questId];if(!q)return talk(n);let state=townQuestState[n.questId];if(!state){if(q.requires&&!townQuestState[q.requires]?.claimed){say('Finish '+townQuestDefs[q.requires].title+' first to continue '+q.arc.split(' · ')[1]+'.');return true}townQuestState[n.questId]={accepted:true,kills:0,claimed:false};say(q.arc+' — '+q.intro+' Objective: '+q.desc);saveGame();return true}if(state.claimed){say(q.title+' is complete. Thanks for helping '+q.town+'.');return true}if(state.kills>=q.target&&(!q.drop||bagCount(q.drop)>=q.dropTarget)){if(q.drop)removeItem(q.drop,q.dropTarget);state.claimed=true;player.coins+=q.coins;grantXp(q.xp);say(q.title+' complete · materials delivered · +'+q.coins+' crowns · +'+q.xp+' XP');refreshTownRelics(true);ui();saveGame();return true}say(q.title+' · kills '+state.kills+'/'+q.target+(q.drop?' · '+(bagCount(q.drop)||0)+'/'+q.dropTarget+' '+itemDefs[q.drop].name:'')+'. '+q.desc);return true}
function recordQuestKill(area,e){settlementKill(area);recordClassGearProgress('hunt',area,e.kind);let changed=false;for(const [id,q] of Object.entries(townQuestDefs)){const st=townQuestState[id];if(!humanQuestReady(id)||journalPaused(id)||!st||!st.accepted||st.claimed||q.area!==area||(q.kind!=='any'&&q.kind!==e.kind))continue;st.kills=Math.min(q.target,st.kills+1);changed=true;if(st.kills===q.target&&(!q.drop||bagCount(q.drop)>=q.dropTarget))say(q.title+' objectives complete. Return to '+q.giver+' with '+(q.dropTarget||0)+' '+(q.drop?itemDefs[q.drop].name:'materials')+' for your reward.')}if(changed)saveGame()}
function healAtTown(n){if(player.hp>=player.max&&companions.every(c=>c.hp>=c.max)){say(n.name+': You are already in good health.');return true}const fee=5;if(player.coins<fee){say(n.name+': Healing costs '+fee+' crowns.');return true}player.coins-=fee;player.hp=player.max;for(const c of companions)c.hp=c.max;say(n.name+' restores your party’s vitality · -'+fee+' crowns.');ui();saveGame();return true}
function interactHouseBroker(n){const id=n.homeId||mapId,home=homeDefs[id],price=250;if(!home)return talk(n);if(ownsHome(id)){say(n.name+': Your '+home.name+' is ready.');return true}if(player.coins<price){say(n.name+': The '+home.name+' costs '+price+' crowns.');return true}player.coins-=price;ownedHomes[id]=true;if(id==='brackenford')houseBought=true;say('You bought the '+home.name+' for '+price+' crowns. Its front door is nearby.');ui();saveGame();return true}
function restAtHome(){player.hp=player.max;say('You rest at home and recover all vitality.');ui();saveGame();return true}
function disarmTrap(t){if(!t||!t.armed)return false;t.armed=false;player.coins+=3;say('Ash rune disarmed · +3 crowns');ui();saveGame();return true}
const gatheringSkillDefs={mining:{name:'Mining',tool:'mining_pick',icon:'⛏️'},woodcutting:{name:'Woodcutting',tool:'woodcutting_hatchet',icon:'🪓'},fishing:{name:'Fishing',tool:'fishing_rod',icon:'🎣'}};function renderGatheringSkills(){const list=document.getElementById('gatheringSkillList');if(!list)return;list.innerHTML=Object.entries(gatheringSkillDefs).map(([id,def])=>{const row=gatheringSkills[id],within=row.level>=10?50:row.xp%50,have=!!bagCount(def.tool);return '<article class="gatheringSkillCard"><h3>'+def.icon+' '+def.name+' · Level '+row.level+'</h3><p>'+(row.level>=10?'Maximum level reached':within+' / 50 XP to level '+Math.min(10,row.level+1))+'</p><div class="skillTrack"><i style="width:'+within*2+'%"></i></div><p>'+(have?'Tool ready: '+itemDefs[def.tool].name:'Needs '+itemDefs[def.tool].name)+'</p></article>'}).join('');document.getElementById('gatheringToolStatus').textContent='Skill level increases every 50 XP, up to level 10.'}function openSkillsScreen(){preparePanel('skillsScreen');keys.clear();document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;renderGatheringSkills();skillsScreen.hidden=false;refreshPanelState()}function gatherOutput(node){if(node.skill==='mining')return activeMap.level>=6?'silver_ore':activeMap.level>=4?'iron_ore':'copper_ore';if(node.skill==='woodcutting')return activeMap.level>=4?'hardwood_log':'wood_log';if(node.skill==='fishing')return ['redfen','willowfen'].includes(mapId)?'marsh_fish':['sunmere','sunharbor'].includes(mapId)?'coast_fish':['frostmarch','glassridge'].includes(mapId)?'ice_trout':'river_fish';return null}function gatherNode(node){if(!node)return false;const skill=gatheringSkills[node.skill],def=gatheringSkillDefs[node.skill],itemId=gatherOutput(node),item=itemDefs[itemId];if(!skill||!def||!item)return false;if(bagCount(def.tool)<1){say('You need a '+itemDefs[def.tool].name+' to train '+def.name+'. Buy one in a town shop.');return true}if(node.readyAt>Date.now()){const seconds=Math.ceil((node.readyAt-Date.now())/1000);say('This '+def.name.toLowerCase()+' spot is depleted. It will be ready in '+seconds+' seconds.');return true}const required=node.skill==='mining'?(itemId==='silver_ore'?5:itemId==='iron_ore'?3:1):node.skill==='woodcutting'&&itemId==='hardwood_log'?3:node.skill==='fishing'&&itemId==='ice_trout'?3:1;if(skill.level<required){say(item.name+' needs '+def.name+' level '+required+'. Your level is '+skill.level+'.');return true}if(!addItem(itemId)){say('Your pack is full. Make room before gathering.');return true}recordClassGearProgress('gather',mapId,node.skill);settlementGather(node.skill);node.readyAt=Date.now()+30000;skill.xp=Math.min(450,skill.xp+12);const oldLevel=skill.level;skill.level=Math.min(10,1+Math.floor(skill.xp/50));const bonus=skill.level>=4&&Math.random()<.25&&addItem(itemId);let message=def.name+' · found '+item.name+(bonus?' x2':'')+' · +12 skill XP';if(skill.level>oldLevel)message+=' · Level '+skill.level+'!';say(message);renderGatheringSkills();ui();saveGame();return true}function nearestGatheringNode(){return (activeMap.gatherNodes||[]).find(node=>Math.hypot(player.x-node.x,player.y-node.y)<56)}
function activateRune(r){if(r.on){say('This rune is already glowing.');return}const sequence=activeMap.runeSequence,actual=runes.indexOf(r);if(Array.isArray(sequence)){const progress=Number(activeMap.runeProgress)||0;if(sequence[progress]!==actual){for(const rune of runes)rune.on=false;activeMap.runeProgress=0;say('The order is wrong. The runes dim; read the inscription and try again.');saveGame();return}activeMap.runeProgress=progress+1}r.on=true;const complete=runes.every(x=>x.on);say(complete?'All shrine runes glow. The chest is unlocked.':Array.isArray(sequence)?'Correct. '+(activeMap.runeSequence.length-activeMap.runeProgress)+' rune'+(activeMap.runeSequence.length-activeMap.runeProgress===1?'':'s')+' remain.':'The rune wakes with a soft amber light.');saveGame()}
function openChest(){if(!chest)return false;if(!runes.every(r=>r.on)){say('The chest is sealed. Solve the rune puzzle first.');return true}if(mapId==='mosslight'){if(hasSigil){chest.open=true;say('The shrine chest is empty.');return true}chest.open=true;hasSigil=true;if(!shrineRewarded){shrineRewarded=true;player.coins+=30;grantXp(25)}ui();say('Ember Rune found · +30 crowns · +25 XP');saveGame();return true}if(chest.open){say('The chest is empty.');return true}chest.open=true;player.coins+=25;grantXp(20);ui();say('Rootbound cache opened · +25 crowns · +20 XP');saveGame();return true}
function interact(){const worldObj=nearestWorldObject();const closeNpc=npcs.filter(n=>Math.hypot(player.x-n.x,player.y-n.y)<64).sort((a,b)=>Math.hypot(player.x-a.x,player.y-a.y)-Math.hypot(player.x-b.x,player.y-b.y))[0];if(closeNpc&&(!worldObj||Math.hypot(player.x-closeNpc.x,player.y-closeNpc.y)+4<Math.hypot(player.x-worldObj.x,player.y-worldObj.y))){openNpcConversation(closeNpc);return true;}if(worldObj){const person=npcWorldPerson(worldObj);if(person){openNpcConversation(person);return true;}return worldObjectInteract(worldObj);}let nearest=null,distance=64;for(const n of npcs){const d=Math.hypot(player.x-n.x,player.y-n.y);if(d<distance){nearest=n;distance=d}}if(nearest){openNpcConversation(nearest);return true}const mapExit=mapConnections[mapId].exits.find(exit=>exit.trigger==='interact'&&Math.hypot(player.x-exit.x,player.y-exit.y)<exit.radius);if(mapExit)return takeMapExit(mapExit);const resourceNode=nearestGatheringNode();if(resourceNode)return gatherNode(resourceNode);if(activeMap.interior){const homeId=activeMap.homeId;if(Math.hypot(player.x-190,player.y-210)<62){openStorage(homeId,'front_chest');return true}if(Math.hypot(player.x-825,player.y-215)<62){openStorage(homeId,'side_chest');return true}if(Math.hypot(player.x-705,player.y-210)<62)return restAtHome()}if(mapId==='emberdeep'){for(const t of traps)if(t.armed&&Math.hypot(player.x-t.x,player.y-t.y)<62)return disarmTrap(t)}if(runes.length){for(const r of runes)if(Math.hypot(player.x-r.x,player.y-r.y)<58){activateRune(r);return true}if(chest&&Math.hypot(player.x-chest.x,player.y-chest.y)<65)return openChest()}if(treasure&&Math.hypot(player.x-treasure.x,player.y-treasure.y)<72){if(enemies.some(e=>e.boss&&e.alive)){say(mapId==='emberdeep'?'The Cinder Warden still guards the coffer.':'The shrine guardian still guards the heart.');return true}if(!runes.every(r=>!activeMap.runeSequence||r.on)){say('The shrine heart remains sealed by its runes.');return true}if(!treasure.opened){treasure.opened=true;if(mapId==='emberdeep'){deepQuestDone=true;player.coins+=50;grantXp(35);say('Ashvault cleared · +50 crowns · +35 XP')}else{player.coins+=75;grantXp(60);say('Mosslight Heart claimed · +75 crowns · +60 XP')}ui();saveGame()}else say('The coffer is empty.');return true}say('Move closer to a person, rune, trap, chest, or cave entrance.');return false}
// Route taps through the same collision geometry used by movement.
const walkGridCache=new Map();
function walkingLine(id,a,b,r){const d=Math.hypot(b.x-a.x,b.y-a.y),n=Math.ceil(d/8);for(let i=1;i<=n;i++)if(mapPlacementBlocked(id,a.x+(b.x-a.x)*i/n,a.y+(b.y-a.y)*i/n,r))return false;return true}
function walkingGrid(id,r){const key=id+':'+r;if(walkGridCache.has(key))return walkGridCache.get(key);const b=worldBounds(id),step=24,cols=Math.floor((b.maxX-b.minX)/step)+1,rows=Math.floor((b.maxY-b.minY)/step)+1,free=new Uint8Array(cols*rows),point=i=>({x:b.minX+i%cols*step,y:b.minY+Math.floor(i/cols)*step});for(let i=0;i<free.length;i++){const p=point(i);free[i]=!mapPlacementBlocked(id,p.x,p.y,r)}const grid={b,step,cols,rows,free,point};walkGridCache.set(key,grid);return grid}
function findWalkingPath(id,start,target,r=14){
 if(walkingLine(id,start,target,r))return [target];
 const g=walkingGrid(id,r),{cols,rows,free,point,step,b}=g;
 const nearest=p=>{let best=-1,dist=Infinity;const cx=Math.round((p.x-b.minX)/step),cy=Math.round((p.y-b.minY)/step);for(let dy=-4;dy<=4;dy++)for(let dx=-4;dx<=4;dx++){const x=cx+dx,y=cy+dy;if(x<0||y<0||x>=cols||y>=rows)continue;const i=y*cols+x,q=point(i),d=Math.hypot(p.x-q.x,p.y-q.y);if(free[i]&&d<dist&&walkingLine(id,p,q,r)){best=i;dist=d}}return best};
 const source=nearest(start),goal=nearest(target);if(source<0||goal<0)return null;
 const prev=new Int32Array(free.length);prev.fill(-1);prev[source]=source;const queue=[source];
 for(let head=0;head<queue.length&&prev[goal]<0;head++){const i=queue[head],x=i%cols,y=Math.floor(i/cols);for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){const nx=x+dx,ny=y+dy;if(nx<0||ny<0||nx>=cols||ny>=rows)continue;const j=ny*cols+nx;if(!free[j]||prev[j]>=0||!walkingLine(id,point(i),point(j),r))continue;prev[j]=i;queue.push(j)}}
 if(prev[goal]<0)return null;const path=[target];for(let i=goal;i!==source;i=prev[i])path.push(point(i));path.push(point(source));path.reverse();return path;
}
function nextWalkingTarget(){if(!tapTarget)return null;if(tapTarget.routeMap!==mapId||!tapTarget.path){const destination=safeMapPosition(mapId,tapTarget.x,tapTarget.y,player.r);const path=findWalkingPath(mapId,player,destination,player.r);if(!path){tapTarget=null;say('No clear walking route. Try a nearby road.');return null}tapTarget={...destination,routeMap:mapId,path}}while(tapTarget.path.length&&Math.hypot(tapTarget.path[0].x-player.x,tapTarget.path[0].y-player.y)<4)tapTarget.path.shift();if(!tapTarget.path.length){tapTarget=null;return null}return tapTarget.path[0]}
function overlaps(x,y,r){return mapPlacementBlocked(mapId,x,y,r);}
function legacySceneryOverlap(x,y,r){if(storyDungeons[mapId]&&(x<68+r||x>892-r||y<76+r||(y>524-r&&Math.abs(x-480)>40-r)))return true;for(const [tx,ty] of trees)if(Math.hypot(x-tx,y-ty)<r+17)return true;for(const [sx,sy] of stones)if(Math.hypot(x-sx,y-sy)<r+10)return true;return false}

function storyBossSpecial(e,dt){e.specialClock=(e.specialClock??5)-dt;if(e.specialClock>0)return;const d=storyDungeons[e.storyBoss],style=d.style==='crown'?['fire','tide','storm'][(e.specialPhase||0)%3]:d.style;e.specialPhase=(e.specialPhase||0)+1;e.specialClock=d.style==='storm'&&storyWards(e.storyBoss)>=2?9:6;
 if(style==='fire')dungeonHazards.push({kind:'ring',x:e.x,y:e.y,inner:55,radius:135,delay:1,life:1.35,source:e});
 if(style==='tide'){if(storyWards(e.storyBoss)<2){const heal=Math.min(e.maxHp-e.hp,Math.ceil(e.maxHp*.08));e.hp+=heal;if(heal)combatText(e.x,e.y-35,'+'+heal,'#8dddf0')}for(const ally of [player,...activeCompanions()].slice(0,3))dungeonHazards.push({kind:'pool',x:ally.x,y:ally.y,radius:48,delay:1.1,life:1.45,source:e})}
 if(style==='storm')for(const x of [200,480,760])dungeonHazards.push({kind:'lane',x,width:70,delay:1,life:1.35,source:e});
}
function tickDungeonHazards(dt){for(const h of dungeonHazards){h.delay-=dt;h.life-=dt;if(h.delay<=0&&!h.hit){h.hit=true;if(!h.source.alive)continue;for(const ally of [player,...activeCompanions()]){const d=Math.hypot(ally.x-h.x,ally.y-(h.y||0)),inside=h.kind==='lane'?Math.abs(ally.x-h.x)<h.width/2:h.kind==='ring'?d<h.radius&&d>h.inner:d<h.radius;if(ally.hp>0&&inside)enemyHit(ally,h.source)}}}dungeonHazards=dungeonHazards.filter(h=>h.life>0&&h.source.alive)}
function drawDungeonHazards(){ctx.save();for(const h of dungeonHazards){ctx.fillStyle=h.hit?'#ff735c88':'#ffb35355';ctx.strokeStyle='#ffc27e';ctx.lineWidth=3;if(h.kind==='lane'){ctx.fillRect(h.x-h.width/2,70,h.width,470);ctx.strokeRect(h.x-h.width/2,70,h.width,470)}else{ctx.beginPath();ctx.arc(h.x,h.y,h.radius,0,Math.PI*2);if(h.kind==='ring')ctx.arc(h.x,h.y,h.inner,0,Math.PI*2,true);ctx.fill('evenodd');ctx.stroke()}}ctx.restore()}
function mageStudy(){const m=townQuestState._mageStudy||(townQuestState._mageStudy={mastery:0,school:'ember',ranks:{ember:0,frost:0,arcane:0}});return m}
function mageSchools(){return {ember:{name:'Ember',text:'Wide area damage. Each rank adds 0.5× attack damage and 5 blast radius.'},frost:{name:'Frost',text:'Area control. Damage 2× attack plus 0.25× per rank; stagger lasts 0.4 seconds plus 0.2 per rank. Bosses and rare elites resist half the stagger.'},arcane:{name:'Arcane',text:'Focused blast: 35 radius, 3× attack plus 0.25× per rank. Each rank reduces cooldown by 0.5 seconds and adds 15 cast range.'}}}
function mageSpell(){const m=mageStudy(),school=mageSchools()[m.school]?m.school:'ember',rank=Math.max(0,Math.min(3,Number(m.ranks[school])||0));return {school,rank,name:school==='frost'?'FROST NOVA':school==='arcane'?'ARCANE BURST':'FIRE BURST',cool:school==='arcane'?7-.5*rank:7,range:210+(school==='arcane'?15*rank:0)+Math.round(40*veteranProgress()),radius:school==='arcane'?35:75+(school==='ember'?5*rank:0),damage:(school==='frost'?2+.25*rank:3+(school==='ember'?.5:.25)*rank)*(1+.3*veteranProgress()),stun:school==='frost'?.4+.2*rank:0,color:school==='frost'?'#9fe8ff':school==='arcane'?'#cba7ff':'#ff9a52'}}
function currentCombatSkill(){return player.class==='mage'?mageSpell():combatSkills[player.class]}
function mageTrainingReason(school){if(player.class!=='mage')return 'Mages only';if(mapId!=='sunmere')return 'Visit Sunmere to study';if(!mageSchools()[school])return 'Unknown school';const rank=mageStudy().ranks[school]||0;if(rank>=3)return 'Fully trained';if(player.level<[5,10,20][rank])return 'Requires level '+[5,10,20][rank];if(mageStudy().mastery<[5,10,20][rank])return 'Requires '+[5,10,20][rank]+' mastery';return ''}
function trainMageSchool(school){if(mageTrainingReason(school))return false;const m=mageStudy(),rank=m.ranks[school]||0;m.mastery-=[5,10,20][rank];m.ranks[school]=rank+1;m.school=school;saveGame();refreshCombatControls();openMageStudy();return true}
function selectMageSchool(school){if(player.class!=='mage'||mapId!=='sunmere'||!mageSchools()[school]||!mageStudy().ranks[school])return false;mageStudy().school=school;saveGame();refreshCombatControls();openMageStudy();return true}
function recordMageMastery(e,killerClass){if(player.class==='mage'&&killerClass==='mage'&&enemyRewards(e).xp>0)mageStudy().mastery++}
function openMageStudy(){if(player.class!=='mage'){say('The Arcanum trains mages.');return}const m=mageStudy();openAdventureDialog('Sunmere Arcanum · Spell study','Earn 1 mastery when you defeat a monster as a mage and it awards kill XP. Pet kills, trivial monsters and paid XP multipliers do not award extra mastery. Train in Sunmere at levels 5 / 10 / 20 for 5 / 10 / 20 mastery per rank. Each school has three ranks. Training and switching do not reset your spell cooldown.\n\nAvailable mastery: '+m.mastery+' · Active school: '+mageSchools()[m.school].name+'\n\n'+Object.entries(mageSchools()).map(([id,d])=>d.name+' '+(m.ranks[id]||0)+'/3 · '+d.text).join('\n'),Object.entries(mageSchools()).flatMap(([id,d])=>[{label:'Train '+d.name+' · '+(mageTrainingReason(id)||'Rank '+((m.ranks[id]||0)+1)),disabled:!!mageTrainingReason(id),action:()=>trainMageSchool(id)},{label:'Use '+d.name+(m.school===id?' · Active':''),disabled:mapId!=='sunmere'||!m.ranks[id]||m.school===id,action:()=>selectMageSchool(id)}]).concat([{label:'Return to adventure',action:()=>{}}]))}

const combatSkills={warrior:{name:'SWEEP',cool:6},rogue:{name:'AMBUSH',cool:5},mage:{name:'FIRE BURST',cool:7},cleric:{name:'HOLY PULSE',cool:8}};

const classMysteryStories={"warrior": {"title": "The Watch That Never Sleeps", "prologue": "On the road home, a pale soldier tears the warrior away from a wounded traveler and throws them behind a broken wall. The warrior sees blood on his mouth and reaches for a weapon. He disappears into the trees. Only afterward does the warrior notice arrows buried in the ground where they had been standing. The wounded traveler is alive, but cannot explain what happened.\n\nA veteran at Ashvale's armory recognizes the knot on your sword belt. Your first captain tied it that way. He vanished years ago while escorting families through the forest. Last night, someone used his old challenge at the gate. The watchman swears the voice had not aged.", "chapters": [{"title": "An Old Command", "text": "After the hunt, the armorer brings out a report recovered from the same road. A wounded traveler describes a pale soldier holding the creatures back until the families escaped. He refused a place beside their fire. His parting words were your captain's: ‘Count the living before you count the dead.’ You have heard them a hundred times. You cannot mistake them."}, {"title": "Steel Against the Skin", "text": "With the armory supplied, the veteran shows you a broken clasp found near the rescue. Its silver lining is scorched on the inside. Beneath it is your captain's old unit mark. The quartermaster insists an oath-breaker stole it. You remember a captain who once disobeyed an order rather than abandon a child. You keep the clasp's meaning to yourself."}, {"title": "The Last Sentry", "text": "The three waystones mark an old evacuation route. Their inscriptions form an oath: ‘Hold until the last has crossed.’ At the armory, a witness finally admits the pale soldier waited beneath a ruined arch until sunrise, then fled the first light. He saved everyone he could. Your captain may still be keeping his oath—but what has keeping it cost him? A night traveler named Serin might know.\n\nThe witness at the last waystone describes a soldier biting through a leather tourniquet because his injured hands could not untie it. The blood was the traveler’s. The throw behind the wall saved the warrior from an ambush. The witness repeats the soldier’s command: “Count the living before you count the dead.” It was Edric—the captain the warrior had mistaken for an attacker."}], "serin": "You ask about the soldier who still speaks your captain's oath. Serin lowers her eyes. ‘Some of us remember the people we promised to protect. Ask what he has done, before you decide what he is.’ She does not yet promise a reunion."}, "rogue": {"title": "A Debt Paid After Midnight", "prologue": "A veiled woman intercepts the rogue at a midnight crossing. She takes their purse, cuts the strap from their shoulder, and pushes them into the freezing river. The rogue escapes downstream, furious and certain a predator nearly killed them. By morning, the crossing has burned. Their stolen purse is waiting beside a dry cloak, with every coin still inside.\n\nAt Brackenford's armory, a folded scrap bears the private mark of the fence who taught you your first clean escape. She disappeared owing half the district money. The scrap contains an address, a payment, and one instruction: ‘If they offer you a drink, leave.’", "chapters": [{"title": "The Unopened Purse", "text": "Your hunt clears a route used by discreet couriers. The armorer receives a purse from that road: your mentor's debt, repaid to the last crown. No thief touched it, although the courier was found terrified and unharmed. He remembers a carriage with covered windows and a passenger who knew the name of his great-grandmother."}, {"title": "Cargo Without a Price", "text": "While your supplies are weighed, a hidden shipping slip falls from the merchant's ledger. The entries list blankets, medicine, and passengers. Another hand has crossed out ‘passengers’ and written ‘stock.’ Beside the alteration is a split-crown seal. Your mentor's mark appears underneath: ‘Not this shipment.’ Someone in the smuggling chain is protecting the people another buyer wants to own."}, {"title": "The Exit She Left You", "text": "At the last waystone, the route finally makes sense: these are escape points, not delivery stops. The armorer gives you your mentor's sealed reply. ‘The court has two faces. Trust the one that lets you leave.’ She names Serin, who meets travelers in Ashvale after dusk. Your mentor is alive long enough to write. Whether she is free is another question.\n\nRessa’s final message identifies the woman as Ysra, a courier working with Serin. The purse carried a tracking charm planted by a debt buyer. Ysra cut it loose and drew the pursuers onto the bridge while the rogue floated beyond their search. The cloak contains a stitch the rogue remembers from the veil. Ysra saved them, but Ressa insists they are still entitled to ask why she offered no warning."}], "serin": "You show Serin the split-crown seal. She refuses to touch it. ‘That buyer does not speak for my people. Your mentor refused them.’ Her door remains open behind you. For now, she is keeping the only promise your mentor told you to test."}, "mage": {"title": "The Scholar's Missing Dawn", "prologue": "While examining the old notebook, the mage feels a hand clamp over their mouth. A gaunt stranger snaps their wand and drags them across the laboratory threshold. The mage sees sharp teeth, hears breaking glass, and loses consciousness. They wake outside with a ruined wand beside them. The stranger is gone. Something inside the laboratory has burned a human-shaped shadow into the wall.\n\nSunmere's armory has inherited a damaged research notebook from your former tutor. You were told the tutor died at sea. The newest entry is dated last week. It asks a question your lessons never answered: can a mind survive by borrowing life rather than creating it?", "chapters": [{"title": "A Spell With No Ember", "text": "After the hunt, an armory scholar compares residue from the region with the notebook. There is no ash, frost, or conventional enchantment. The diagram describes energy passing from one living body to another. In the margin, your tutor has written: ‘The donor must have a choice.’ Someone has struck out the final word."}, {"title": "The Closed Shutters", "text": "Your gathered supplies repair the scholar's instrument. Under ordinary light, the notebook appears blank. Beneath a darkened hood, a second set of calculations emerges. The author has spent decades recording the same signature without signs of aging. Every experiment ends before dawn. Immortality is no longer an abstract problem, and the notebook's objections are becoming pleas."}, {"title": "An Equation of Hunger", "text": "The waystones complete a ward diagram your tutor deliberately scattered. It limits the borrowing of life; it does not cure the need. The final page reads: ‘A restraint can be chosen. It cannot be assumed.’ A letter addressed to Serin remains unsent. If she knows the author, you may finally learn whether your tutor sought a cure—or merely an excuse.\n\nAt the final waystone, the completed ward diagram reveals that the notebook’s concealed phrase was a summons using its reader as fuel. The stranger broke the wand to interrupt the spell and carried the mage beyond its boundary. On the wand’s repaired grip is Ilyan’s familiar correction mark. The tutor did not return to steal the mage’s work. He returned because someone had turned his work into a trap."}], "serin": "Serin recognizes the ward equation. ‘Your tutor helped us make an oath we could keep. Others wanted a way to feed without consequence.’ She cannot tell you where the tutor is now. The uncertainty feels more honest than the academy's tidy obituary."}, "cleric": {"title": "The Mercy Beneath the Bell", "prologue": "At a roadside shelter, the cleric finds a pale woman bending over a feverish child. There is blood on the blanket. When the cleric raises a holy symbol, the woman knocks a cup from their hand, seizes the child, and escapes through the back door. The cleric follows and finds the child breathing beneath a clean cloak. The woman has vanished. Her violence seems impossible to reconcile with that careful shelter.\n\nStonewatch's armory keeps a prayer book from the hospice where you first served. Your teacher's name has been scraped from its cover. A novice says an unknown benefactor leaves medicine at the hospice each night—and asks that no candle be brought to the door.", "chapters": [{"title": "The Prayer Remembered", "text": "After the hunt, an injured traveler recites the prayer spoken by the stranger who sheltered him. It is your teacher's private version, including the line the elders removed: ‘Mercy is a deed before it is a judgment.’ The traveler recalls cold hands and a voice that shook at the smell of his wound. The stranger bound it anyway."}, {"title": "A Name Removed", "text": "Your armory supplies earn access to the hospice's sealed account. Your teacher was not buried. The elders expelled a healer who returned from a journey changed, then continued accepting the medicine left at their door. One entry records a refused meal and three patients saved. You cannot tell whether the silence protected the hospice or its reputation."}, {"title": "Who May Be Forgiven", "text": "The waystone prayers contain a forgotten rite of restoration. Beside its final verse is a warning: ‘Do not confuse the afflicted with the willing cruel.’ The armorer offers no easy answer. A night envoy named Serin has been asking after that same rite. Before you condemn or absolve her, you intend to hear what she has done.\n\nThe last hospice record identifies the supposed medicine as a contaminated preparation linked to the same fever. The woman had cut her hand opening a jammed shutter, not bitten the child. A witness watched her carry the child into fresh air and remain until the breathing steadied. The clean cloak bears Maelin’s mending stitch. The cleric’s teacher saved the child—and stopped the cleric from giving another dose."}], "serin": "You recite your teacher's prayer. Serin finishes its forbidden line. ‘Hunger is not innocence,’ she says. ‘But neither is it a verdict.’ She will answer for her actions. You must decide whether your faith asks for anything less—or anything more."}};
function classMysteryProgress(hero=player.class){return ['weapon','armor','shield'].filter(slot=>townQuestState['gear_'+hero+'_'+slot]?.claimed).length;}
function openClassMystery(){const d=classMysteryStories[player.class];if(!d)return;const slots=['weapon','armor','shield'],chapters=d.chapters.filter((_,i)=>townQuestState['gear_'+player.class+'_'+slots[i]]?.claimed);let text=d.prologue;for(const ch of chapters)text+='\n\n'+ch.title+'\n'+ch.text;if(chapters.length<3)text+='\n\nNext chapter: complete your next class armory quest in '+maps[classGearProfiles[player.class].town].name+'.';else text+='\n\nYour trail leads to Ashvale after dusk. Open Night Visitor to continue.';openAdventureDialog(d.title,text,[...(chapters.length===3?[{label:'Follow the Night Visitor',action:openVampireStory}]:[]),{label:'Return to adventure',action:()=>{}}]);document.getElementById('adventureScreen').classList.add('narrativeView');}
function classMysterySerin(){return classMysteryProgress()===3?'\n\n'+classMysteryStories[player.class].serin:'';}

// The Night Visitor: optional, character-local story and reversible vampirism.
function vampireState(){let s=townQuestState._vampire;if(!s||typeof s!=='object'||Array.isArray(s))s=townQuestState._vampire={};s.clock=Math.max(0,Number(s.clock)||0)%600;s.hunger=clamp(Number(s.hunger)||0,0,100);s.clues=Array.isArray(s.clues)?s.clues:[];s.cureClues=Array.isArray(s.cureClues)?s.cureClues:[];return s;}
function vampireNight(){return vampireState().clock>=300;}
function vampirePower(){const s=vampireState();return !s.turned?1:(vampireNight()?1.2:.8)*(s.hunger>=80?.85:1);}
function vampireStatus(){const s=vampireState();return (vampireNight()?'Night':'Day')+' · '+Math.ceil((vampireNight()?600:300)-s.clock)+'s to '+(vampireNight()?'dawn':'dusk')+(s.turned?' · Vampire · Hunger '+Math.floor(s.hunger)+'/100':s.cured?' · Cured':'');}
function refreshVampireHud(){const el=document.getElementById('vampireStatus');if(!el)return;const s=vampireState();el.hidden=!s.accepted;el.textContent=vampireStatus();}
function tickVampire(dt){const s=vampireState();if(!s.accepted||!Number.isFinite(dt)||dt<=0||document.hidden||!combatReady())return;const night=vampireNight();s.clock=(s.clock+Math.min(dt,.25))%600;if(s.turned)s.hunger=Math.min(100,s.hunger+dt/6);if(night!==vampireNight())say(vampireNight()?'Dusk falls. The Night Visitor can be found in Ashvale.':'Dawn breaks. Vampires lose their night strength.');refreshVampireHud();}
function vampireKill(e){const s=vampireState();if(e.townSiege)return;if(s.turned)s.hunger=Math.max(0,s.hunger-12);if(s.choice==='hunt'&&!s.complete&&mapId==='redfen'&&!journalPaused('night_visitor'))s.hunts=Math.min(6,(s.hunts||0)+1);}
function vampireLeech(damage){const s=vampireState();if(!s.turned||!vampireNight()||s.hunger>=80)return;const heal=Math.min(player.max-player.hp,Math.max(0,damage)*.08);player.hp=Math.min(player.max,player.hp+heal);}
function vampireQuestEntry(){const s=vampireState();return {id:'night_visitor',title:'The Night Visitor',active:!!s.accepted&&!s.complete,done:!!s.complete,desc:s.complete?'You chose '+(s.choice==='hunt'?'the hunters':s.turned?'the turning':s.cured?'a return to humanity':'an alliance')+'. Your choice remains in your story.':'Investigate the stranger who appears in Ashvale only at night. Open MENU → Night Visitor for clues and choices.',reward:'120 crowns · 80 XP · Choose hunting, alliance, or a reversible vampire transformation.'};}
function vampireGuide(){const s=vampireState();return {destination:s.clues.length<3?['whisperwood','redfen','mosslight'].find(id=>!s.clues.includes(id)):'ashvale',detail:s.choice==='hunt'?'Defeat 6 creatures in Redfen, then report to Ashvale at night.':s.choice==='ally'&&!s.complete?'Bring 3 healing draughts to Ashvale at night.':'Follow the clues through MENU → Night Visitor. The stranger appears in Ashvale at night.',progress:s.choice==='hunt'?(s.hunts||0)+'/6 creatures':s.clues.length+'/3 clues',ready:false};}
function vampireMeeting(){return mapId==='ashvale'&&vampireNight();}
function vampireSave(){saveGame();ui();refreshVampireHud();}
function startVampireStory(){const s=vampireState();if(s.accepted||!vampireMeeting()||player.level<3||!journalCanAccept('night_visitor'))return;s.accepted=true;vampireSave();openVampireStory();}
function vampireInvestigate(){const s=vampireState();if(!s.accepted||s.choice||journalPaused('night_visitor')||!['whisperwood','redfen','mosslight'].includes(mapId)||s.clues.includes(mapId))return;s.clues.push(mapId);vampireSave();const clue={whisperwood:'At the empty camp, two untouched meals sit beside a scrap of black velvet. The missing travelers left willingly.',redfen:'A ferryman remembers pale passengers shielding a wounded child. Someone followed them into the reeds.',mosslight:'A shrine ledger names the Veiled Court: vampires bound by an oath never to feed on unwilling people. The stranger is their envoy, Serin.'};openAdventureDialog('A trail after sunset',clue[mapId],[{label:'Review the mystery',action:openVampireStory},{label:'Continue exploring',action:()=>{}}]);}
function chooseVampirePath(choice){const s=vampireState();if(!s.accepted||s.choice||s.clues.length<3||!vampireMeeting()||journalPaused('night_visitor')||!['hunt','ally'].includes(choice))return;s.choice=choice;vampireSave();openVampireStory();}
function finishVampireStory(){const s=vampireState();if(s.complete||!vampireMeeting()||journalPaused('night_visitor'))return;if(s.choice==='hunt'){if((s.hunts||0)<6)return;}else if(s.choice==='ally'){if(bagCount('potion_25')<3)return;for(let i=0;i<3;i++)removeItem('potion_25');}else return;s.complete=true;player.coins+=120;grantXp(80);vampireSave();openVampireStory();}
function confirmVampireTurning(){const s=vampireState();if(!s.complete||s.choice!=='ally'||s.turned||s.cured||!vampireMeeting())return;openAdventureDialog('Serin’s offer · The Turning','Serin tells you the truth before offering her blood. Your class and gear remain yours. At night: +20% attack and 8% life-steal from damage actually dealt. In daylight: −20% attack. Hunger rises during active play; monster kills reduce it. At 80 hunger, life-steal stops and attack falls another 15%. Hunger never kills you.\n\nThe cure requires visiting Mosslight and Sunmere, then completing a daylight ritual in Ashvale. You can refuse without losing your alliance.',[{label:'Accept the turning',action:()=>{const s=vampireState();if(!s.complete||s.choice!=='ally'||s.turned||s.cured||!vampireMeeting())return;s.turned=true;s.hunger=20;vampireSave();openVampireStory();}},{label:'Remain human',action:openVampireStory}]);}
function vampireCureClue(){const s=vampireState();if(!s.turned||!['mosslight','sunmere'].includes(mapId)||s.cureClues.includes(mapId))return;s.cureClues.push(mapId);vampireSave();openVampireStory();}
function cureVampire(){const s=vampireState();if(!s.turned||s.cureClues.length<2||mapId!=='ashvale'||vampireNight())return;s.turned=false;s.cured=true;s.hunger=0;vampireSave();openAdventureDialog('A heartbeat at dawn','The ritual restores your humanity. Serin keeps her promise: your alliance survives. The turning’s powers and weaknesses are gone.',[{label:'Continue',action:openVampireStory}]);}
function offerVampireSanctuary(){const s=vampireState();if(!s.complete||s.choice!=='ally'||s.sanctuary||mapId!=='frontier_outpost'||!frontierState().complete)return;s.sanctuary=true;const p=politicsState();for(const id of Object.keys(townPowers))p.relations[id]=Math.max(-100,p.relations[id]-10);vampireSave();openVampireStory();}
function openVampireStory(){const s=vampireState(),choices=[];let text=vampireStatus()+'\n\n';
 if(!s.accepted){text+='Travelers whisper about a courteous stranger who never appears before dusk. Meet Serin in Ashvale at night, once you reach level 3. The cycle advances only while you play. You may wait safely in Ashvale using the option below.';choices.push({label:'Meet the stranger',disabled:!vampireMeeting()||player.level<3,action:startVampireStory});}
 else if(!s.choice){text+='Serin asks you to find three missing travelers. Her hands are cold; her concern seems real. Search Whisperwood’s abandoned camp, the Redfen crossing, and Mosslight’s shrine records.\n\nClues: '+s.clues.length+'/3.';choices.push({label:'Investigate this region',disabled:!['whisperwood','redfen','mosslight'].includes(mapId)||s.clues.includes(mapId)||journalPaused('night_visitor'),action:vampireInvestigate});if(s.clues.length===3){text+='\n\nThe travelers live under the Veiled Court’s protection. Serin admits she is a vampire. Hunters want the Court gone; Serin offers a peaceful alliance.';choices.push({label:'Side with the hunters',disabled:!vampireMeeting(),action:()=>chooseVampirePath('hunt')},{label:'Help the Veiled Court',disabled:!vampireMeeting(),action:()=>chooseVampirePath('ally')});}}
 else if(!s.complete){text+=s.choice==='hunt'?'The hunters need Redfen’s roads cleared before they drive the Court away. Defeat 6 creatures in Redfen. Serin will leave peacefully when you return.\nProgress: '+(s.hunts||0)+'/6.':'Serin needs medicine for the human refugees. Bring 3 Small Healing Potions to Ashvale at night.\nYou carry '+bagCount('potion_25')+'/3.';choices.push({label:'Complete the agreement',disabled:!vampireMeeting()||(s.choice==='hunt'?(s.hunts||0)<6:bagCount('potion_25')<3),action:finishVampireStory});}
 else {text+=s.choice==='hunt'?'The Veiled Court has left. The hunters honor your bargain.':(s.cured?'The refugees are safe. Serin honors your decision to remain human.':'The refugees are safe. Serin offers friendship—and, only if you choose, the turning.');if(s.choice==='ally'&&!s.turned&&!s.cured)choices.push({label:'Ask about becoming a vampire',disabled:!vampireMeeting(),action:confirmVampireTurning});if(s.turned){text+='\n\nYou are a vampire. Night attack +20%; daylight attack −20%. Night life-steal: 8%. Kills reduce hunger by 12. At 80 hunger: no life-steal and another −15% attack.\n\nCure: visit Mosslight and Sunmere for ritual knowledge ('+s.cureClues.length+'/2), then return to Ashvale by day.';choices.push({label:'Seek cure knowledge here',disabled:!['mosslight','sunmere'].includes(mapId)||s.cureClues.includes(mapId),action:vampireCureClue},{label:'Complete the daylight cure',disabled:s.cureClues.length<2||mapId!=='ashvale'||vampireNight(),action:cureVampire});}if(s.cured)text+='\n\nYour heartbeat is restored. You remain Serin’s human ally.';if(s.choice==='ally'){text+='\n\n'+(s.sanctuary?'Hearthstead has granted the Court sanctuary. Neighboring towns remember your decision.':'At your completed settlement you may offer sanctuary: each neighboring town loses 10 relation points.');choices.push({label:'Grant sanctuary · −10 town relations',disabled:s.sanctuary||mapId!=='frontier_outpost'||!frontierState().complete,action:()=>openAdventureDialog('Sanctuary for the Veiled Court','This decree shelters vampires in Hearthstead and lowers relations with every neighboring town by 10. Existing political consequences apply.',[{label:'Grant sanctuary',action:offerVampireSanctuary},{label:'Not now',action:openVampireStory}])});}}
 if(mapId==='ashvale')choices.push({label:vampireNight()?'Wait safely until dawn':'Wait safely until dusk',action:()=>{if(mapId!=='ashvale')return;const s=vampireState();s.clock=vampireNight()?0:300;vampireSave();openVampireStory();}});
 choices.push({label:'Return to adventure',action:()=>{}});if(s.clues.length===3)text+=classMysterySerin();openAdventureDialog('The Night Visitor',text,choices);
}

function combatReady(){return !titleMenuActive&&!document.hidden&&document.getElementById('optionsMenu').hidden&&hasStarted&&!document.getElementById('gameView').hidden&&!document.body.classList.contains('panel-open')}
function combatText(x,y,text,color='#ffe08a'){combatEffects.push({x,y,text,color,life:.8})}

function clearCombatLine(x,y,tx,ty){const d=Math.hypot(tx-x,ty-y),steps=Math.max(1,Math.ceil(d/14));for(let i=1;i<steps;i++)if(overlaps(x+(tx-x)*i/steps,y+(ty-y)*i/steps,4))return false;return true}
function steerActor(actor,tx,ty,speed,dt,r=12){const d=Math.hypot(tx-actor.x,ty-actor.y);if(d<3)return false;const angle=Math.atan2(ty-actor.y,tx-actor.x),step=Math.min(d,speed*dt);for(const turn of [0,.55,-.55,1.05,-1.05,1.57,-1.57]){const dx=Math.cos(angle+turn)*step,dy=Math.sin(angle+turn)*step;if(!overlaps(actor.x+dx,actor.y+dy,r)){actor.x+=dx;actor.y+=dy;actor.faceX=Math.cos(angle+turn);actor.faceY=Math.sin(angle+turn);return true}}return false}
function damageEnemy(e,damage,stun=0,owner=player){if(!e.alive)return;if(e.storyBoss&&['fire','crown'].includes(storyDungeons[e.storyBoss].style)&&storyWards(e.storyBoss)<2){damage=Math.max(1,Math.round(damage*.35));combatText(e.x,e.y-42,'WARD','#ffd58a')}if(owner===player)vampireLeech(Math.min(Math.max(0,e.hp),Math.max(0,damage)));e.hitTime=.2;e.hp-=damage;e.stun=Math.max(e.stun||0,stun);combatText(e.x,e.y-28,String(damage),owner===player?'#fff0b0':'#bfe8aa');battleVfx('Explosion',e.x,e.y-12,38);playSfx('hit');if(owner===player)impactShake=.12;if(e.hp<=0)finishEnemy(e,owner===player?player.class:null)}
function baseEnemyPattern(e){if(e.boss)return {label:'HEAVY STRIKE',range:85,radius:64,speed:48,windup:1,cool:1.66};if(e.kind==='spider')return {label:'VENOM SPIT',range:145,radius:29,speed:76,windup:.9,cool:1.8,ranged:true};if(e.kind==='bat')return {label:'DIVE',range:80,radius:27,speed:105,windup:.65,cool:1.15};if(e.kind==='skeleton')return {label:'CLEAVE',range:58,radius:40,speed:52,windup:.95,cool:1.45};if(e.kind==='bandit')return {label:'LUNGE',range:72,radius:32,speed:90,windup:.65,cool:1.25};if(e.kind==='specter'||e.kind==='ice')return {label:'TIDE MARK',range:160,radius:43,speed:55,windup:1.15,cool:2,ranged:true};return {label:'SLIME HOP',range:52,radius:31,speed:59,windup:.85,cool:1.3}}
function enemyPattern(e){if(e.kind==='vampire'&&vampireMonsterDefs[e.vampireType])return vampireMonsterDefs[e.vampireType].pattern;const p=baseEnemyPattern(e);if(!e.ecology||e.boss)return p;if(e.ecology==='ashvale')return {...p,label:'BRAMBLE STRIKE',speed:p.speed*.9,windup:p.windup*1.2,radius:p.radius+6,cool:p.cool+.15};if(e.ecology==='brackenford')return {...p,label:'REED AMBUSH',speed:p.speed*1.2,windup:p.windup*1.15,cool:p.cool+.1};if(e.ecology==='stonewatch')return {...p,label:'GRAVE SWEEP',speed:p.speed*.8,windup:p.windup*1.3,radius:p.radius+8,cool:p.cool+.25};return {...p,label:'FROST MARK',ranged:true,range:p.range+35,radius:Math.max(22,p.radius*.8),speed:p.speed*.9,windup:p.windup+.25,cool:p.cool+.3}}
function drawCombatFocus(){const target=lockedEnemy?.alive?lockedEnemy:nearestCombatEnemy(210);if(target){ctx.save();ctx.strokeStyle='#f6d68d';ctx.lineWidth=2;ctx.setLineDash([5,4]);ctx.beginPath();ctx.ellipse(target.x,target.y+6,23,11,0,0,Math.PI*2);ctx.stroke();ctx.setLineDash([]);ctx.restore()}}
function drawTargetPanel(){const e=lockedEnemy?.alive?lockedEnemy:nearestCombatEnemy(210);if(!e||activeMap.town)return;ctx.save();const w=Math.min(210,viewW-28),x=viewW-w-12,y=145;ctx.fillStyle='#121d19e8';ctx.fillRect(x,y,w,43);ctx.strokeStyle='#8c8159';ctx.strokeRect(x,y,w,43);ctx.fillStyle='#f2dfab';ctx.font='bold 11px system-ui';ctx.fillText('Lv '+encounterLevel(e)+' · '+(e.name||enemyPattern(e).label),x+8,y+14,w-16);ctx.fillStyle='#3d332d';ctx.fillRect(x+8,y+22,w-16,6);ctx.fillStyle='#d58167';ctx.fillRect(x+8,y+22,(w-16)*Math.max(0,e.hp/e.maxHp),6);ctx.fillStyle='#c9d4bc';ctx.font='10px system-ui';ctx.fillText(e.windup>0?enemyPattern(e).label+' · DODGE':e.stun>0?'STAGGERED':'Auto attack in range · touch to move',x+8,y+39,w-16);ctx.restore()}

function strikeEnemy(e,damage,stun=0){damageEnemy(e,damage,stun,player)}
function nearestCombatEnemy(range){if(lockedEnemy?.alive&&Math.hypot(lockedEnemy.x-player.x,lockedEnemy.y-player.y)<=range&&clearCombatLine(player.x,player.y,lockedEnemy.x,lockedEnemy.y))return lockedEnemy;return enemies.filter(e=>e.alive&&Math.hypot(e.x-player.x,e.y-player.y)<=range&&clearCombatLine(player.x,player.y,e.x,e.y)).sort((a,b)=>Math.hypot(a.x-player.x,a.y-player.y)-Math.hypot(b.x-player.x,b.y-player.y))[0]}
function useCombatSkill(){if(!combatReady()||skillCooldown>0)return;const def=currentCombatSkill(),target=nearestCombatEnemy(player.class==='mage'?def.range:90);if(player.class!=='cleric'&&!target){say('Move closer to an enemy to use '+def.name+'.');return}if(target){const dx=target.x-player.x,dy=target.y-player.y,d=Math.hypot(dx,dy)||1;player.faceX=dx/d;player.faceY=dy/d;}skillCooldown=def.cool;if(playerBuild()==='recovery'){const healed=Math.min(player.max-player.hp,healingPower(Math.ceil(player.max*.08)));player.hp+=healed;if(healed)combatText(player.x,player.y-28,'+'+healed,'#a6edac')}player.cool=.35;player.attack=.32;player.castTime=.48;playSfx('attack');const power=playerAttackPower();if(player.class==='cleric'){battleVfx('Portal',player.x,player.y-20,130);for(const ally of [player,...activeCompanions()].filter(a=>a.hp>0&&Math.hypot(a.x-player.x,a.y-player.y)<150)){const heal=Math.min(ally.max-ally.hp,healingPower(Math.max(25,Math.ceil(ally.max*.25))));ally.hp+=heal;combatText(ally.x,ally.y-28,'+'+heal,'#a6edac')}for(const e of enemies)if(e.alive&&Math.hypot(e.x-player.x,e.y-player.y)<110&&clearCombatLine(player.x,player.y,e.x,e.y))strikeEnemy(e,power*2);combatEffects.push({x:player.x,y:player.y,radius:110,color:'#a6edac',life:.45})}else if(player.class==='mage'){const x=target.x,y=target.y,spell=mageSpell();battleVfx(spell.school==='ember'?'Fire_Ball':spell.school==='frost'?'Earth_Spike':'Portal',player.x,player.y-20,90,x,y-15);battleVfx('Explosion',x,y-10,140);for(const e of enemies)if(e.alive&&Math.hypot(e.x-x,e.y-y)<spell.radius&&clearCombatLine(x,y,e.x,e.y))strikeEnemy(e,Math.round(power*spell.damage),spell.stun*(e.boss||e.roamingElite?.5:1));combatEffects.push({x,y,radius:spell.radius,color:spell.color,life:.45})}else if(player.class==='warrior'){battleVfx('Wind',player.x,player.y-10,140);for(const e of enemies)if(e.alive&&Math.hypot(e.x-player.x,e.y-player.y)<90&&clearCombatLine(player.x,player.y,e.x,e.y))strikeEnemy(e,power*2,.9);combatEffects.push({x:player.x,y:player.y,radius:90,color:'#ffe08a',life:.45})}else{battleVfx('Wind',target.x,target.y-12,75);strikeEnemy(target,power*4);dodgeGuard=.3}ui();refreshCombatControls()}
function dodge(){if(!combatReady()||dodgeCooldown>0)return;let [dx,dy]=movementAxes();if(!dx&&!dy){dx=player.faceX;dy=player.faceY}const n=Math.hypot(dx,dy)||1,b=worldBounds();tapTarget=null;for(let i=0;i<15;i++){const x=clamp(player.x+dx/n*6,b.minX,b.maxX),y=clamp(player.y+dy/n*6,b.minY,b.maxY);if(overlaps(x,y,player.r))break;player.x=x;player.y=y}player.dodgeTime=.4;dodgeCooldown=playerDodgeCooldown();dodgeGuard=.4;combatText(player.x,player.y-28,'DODGE','#a4dfff');updateCamera();refreshCombatControls()}
function combatActionTarget(){if(activeMap.town)return null;if(lockedEnemy?.alive&&Math.hypot(lockedEnemy.x-player.x,lockedEnemy.y-player.y)<=320)return lockedEnemy;return nearestCombatEnemy(Math.max(220,classDefs[player.class].range))||enemies.filter(e=>e.alive&&Math.hypot(e.x-player.x,e.y-player.y)<180).sort((a,b)=>Math.hypot(a.x-player.x,a.y-player.y)-Math.hypot(b.x-player.x,b.y-player.y))[0]}function contextAction(){if(!combatReady())return;const target=combatActionTarget();if(target){lockedEnemy=target;tapTarget=null;if(nearestCombatEnemy(classDefs[player.class].range))attack();else say('Approach your target to attack automatically. DODGE to evade.');return}interact()}
function refreshCombatControls(){const action=document.getElementById('attack'),inRange=!!combatActionTarget();action.textContent=inRange?'ATTACK':'INTERACT';action.classList.toggle('contextInteract',!inRange);action.setAttribute('aria-label',inRange?'Hold to attack nearby target':'Interact with nearby person or object');action.style.setProperty('--cooldown',String(Math.max(0,player.cool/playerAttackCooldown())));document.getElementById('skillButton').style.setProperty('--cooldown',String(skillCooldown/currentCombatSkill().cool));const skill=document.getElementById('skillButton'),roll=document.getElementById('dodgeButton');skill.textContent=skillCooldown>0?currentCombatSkill().name+' '+Math.ceil(skillCooldown)+'s':currentCombatSkill().name;roll.textContent=dodgeCooldown>0?'DODGE '+Math.ceil(dodgeCooldown)+'s':'DODGE';skill.disabled=skillCooldown>0;roll.disabled=dodgeCooldown>0}
function tickCombat(dt){tickTouchSteering(dt);tickProximity(dt);impactShake=Math.max(0,impactShake-dt);slowTimer=Math.max(0,slowTimer-dt);if(attackHeld){const target=combatActionTarget();if(target){lockedEnemy=target;const [mx,my]=movementAxes();if(!mx&&!my&&dodgeGuard<=0&&!nearestCombatEnemy(classDefs[player.class].range)){steerActor(player,target.x,target.y,player.speed*(slowTimer>0?.65:1),dt,player.r);const bounds=worldBounds();player.x=clamp(player.x,bounds.minX,bounds.maxX);player.y=clamp(player.y,bounds.minY,bounds.maxY)}attack()}else attackHeld=false}tickDungeonHazards(dt);for(const entity of [player,...companions,...enemies]){entity.hitTime=Math.max(0,(entity.hitTime||0)-dt);entity.castTime=Math.max(0,(entity.castTime||0)-dt);entity.dodgeTime=Math.max(0,(entity.dodgeTime||0)-dt);entity.deathAnim=Math.max(0,(entity.deathAnim||0)-dt)}skillCooldown=Math.max(0,skillCooldown-dt);dodgeCooldown=Math.max(0,dodgeCooldown-dt);dodgeGuard=Math.max(0,dodgeGuard-dt);for(const fx of combatEffects)fx.life-=dt;combatEffects=combatEffects.filter(fx=>fx.life>0);refreshCombatControls()}
function enemyHit(victim,e){if(victim===player&&dodgeGuard>0){combatText(player.x,player.y-28,'EVADE','#a4dfff');return}const guard=equipmentGuard(victim),damage=Math.max(1,Math.round((Math.round(enemyAttackDamage(e)*(e.boss?1.5:1)*(e.wayfarerTrial!==undefined?1.4:1))-guard)*(victim===player&&player.class==='warrior'?1-.15*veteranProgress():1)));victim.hitTime=.2;battleVfx('Explosion',victim.x,victim.y-15,42);victim.hp=Math.max(0,victim.hp-damage);combatText(victim.x,victim.y-28,'-'+damage,'#ff8c80');if(victim.hp===0){if(victim!==player){victim.active=false;say(victim.name+' is knocked out. Visit a healer.')}else{if(politicsState().phase==='siege')endTownSiege(false);player.hp=player.max;const pos=activeMap.arrival||[48,315];Object.assign(player,safeMapPosition(mapId,pos[0],pos[1],player.r));slowTimer=0;attackHeld=false;lockedEnemy=null;dodgeGuard=2;for(const enemy of enemies){enemy.windup=0;enemy.swing=null;enemy.combatCool=1.5}snapCompanionsToPlayer();say('You retreat to the road and recover.')}}ui();saveGame()}
function updateEnemyCombat(e,dt){
 // Recovery is a readable opening after a committed strike.
 if(e.recoveryTime>0){e.recoveryTime=Math.max(0,e.recoveryTime-dt);e.combatCool=Math.max(0,(e.combatCool||0)-dt);return;}
 if(e.townSiege&&Math.hypot(player.x-e.x,player.y-e.y)>240){steerActor(e,player.x,player.y,55,dt);return;}
 if(e.storyBoss)storyBossSpecial(e,dt);e.combatCool=Math.max(0,(e.combatCool||0)-dt);const pattern=enemyPattern(e);
 if(e.stun>0){e.stun=Math.max(0,e.stun-dt);e.windup=0;e.swing=null;return}
 if(e.windup>0&&e.swing){e.windup-=dt;if(e.windup<=0){const swing=e.swing;e.swing=null;combatEffects.push({x:swing.x,y:swing.y,radius:swing.radius,color:'#ff7061',life:.25});if(pattern.ranged)battleVfx('Earth_Spike',swing.x,swing.y-15,80);for(const victim of [player,...activeCompanions()])if(victim.hp>0&&Math.hypot(victim.x-swing.x,victim.y-swing.y)<swing.radius+10){enemyHit(victim,e);if(victim===player&&dodgeGuard<=0&&(e.kind==='spider'||e.ecology==='sunmere')){slowTimer=e.ecology==='sunmere'?1:1.5;combatText(player.x,player.y-40,'SLOWED','#b5d590')}}e.combatCool=pattern.cool;e.recoveryTime=e.boss?.65:e.kind==='vampire'?.45:.35;}return}
 let target=player,d=Math.hypot(player.x-e.x,player.y-e.y);for(const ally of activeCompanions()){if(ally.hp<=0)continue;const ad=Math.hypot(ally.x-e.x,ally.y-e.y);if(ad<d){d=ad;target=ally}}
 const homeDistance=Math.hypot(e.x-e.spawnX,e.y-e.spawnY);if(!e.boss&&!e.eventRegion&&!e.storyBoss&&(homeDistance>330||d>270)){e.returning=true;steerActor(e,e.spawnX,e.spawnY,pattern.speed*1.3,dt);if(homeDistance<12){e.returning=false;e.hp=Math.min(e.maxHp,e.hp+dt*3)}return}e.returning=false;
 if(d<pattern.range&&e.combatCool<=0&&clearCombatLine(e.x,e.y,target.x,target.y)){e.windup=pattern.windup;e.windupLength=e.windup;e.swing={x:target.x,y:target.y,radius:pattern.radius};return}
 if(d<250&&d>28){if(pattern.ranged&&d<80){steerActor(e,e.x+(e.x-target.x),e.y+(e.y-target.y),pattern.speed*.7,dt)}else steerActor(e,target.x,target.y,pattern.speed,dt)}
}
function drawCombat(){for(const e of enemies)if(e.alive&&e.swing&&e.windup>0){ctx.fillStyle='#e54e423d';ctx.strokeStyle='#ffb064';ctx.lineWidth=3;ctx.beginPath();ctx.arc(e.swing.x,e.swing.y,e.swing.radius,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.fillStyle='#ffdc8a';ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.fillText('DODGE!',e.x,e.y-(e.boss?86:64))}if(dodgeGuard>0){ctx.strokeStyle='#9addff';ctx.lineWidth=3;ctx.beginPath();ctx.arc(player.x,player.y,25,0,Math.PI*2);ctx.stroke()}for(const fx of combatEffects){ctx.save();ctx.globalAlpha=Math.min(1,fx.life*3);if(fx.asset){const p=1-fx.life/fx.duration,x=fx.endX===null?fx.x:fx.x+(fx.endX-fx.x)*p,y=fx.endY===null?fx.y:fx.y+(fx.endY-fx.y)*p;drawBattleAsset(fx.asset,x,y,fx.scale,p)}else if(fx.text){ctx.font='bold 18px system-ui';ctx.textAlign='center';ctx.fillStyle=fx.color;ctx.fillText(fx.text,fx.x,fx.y-(.8-fx.life)*35)}else{ctx.strokeStyle=fx.color;ctx.lineWidth=4;ctx.beginPath();ctx.arc(fx.x,fx.y,fx.radius,0,Math.PI*2);ctx.stroke()}ctx.restore()}ctx.textAlign='start'}

function attack(){if(!combatReady()||player.cool>0)return;const def=classDefs[player.class],target=nearestCombatEnemy(def.range);if(!target)return;player.cool=playerAttackCooldown();player.attack=.32;playSfx('attack');if(target){lockedEnemy=target;const dx=target.x-player.x,dy=target.y-player.y,d=Math.hypot(dx,dy)||1;player.faceX=dx/d;player.faceY=dy/d;if(player.class==='mage')battleVfx('Fire_Ball',player.x,player.y-20,55,target.x,target.y-15);else battleVfx('Wind',player.x+player.faceX*20,player.y-18,65);strikeEnemy(target,playerAttackPower())}ui()}
let renderErrorShown=false;function renderScene(){try{draw()}catch(error){console.error('Map rendering error:',error);if(!renderErrorShown){renderErrorShown=true;ctx.save();ctx.fillStyle='#101613';ctx.fillRect(20,H/2-35,W-40,70);ctx.fillStyle='#ffe08a';ctx.font='bold 16px system-ui';ctx.textAlign='center';ctx.fillText('Map render error · '+String(error.message||error).slice(0,72),W/2,H/2+5);ctx.textAlign='start';ctx.restore()}}}
function frame(now){if(switchingCharacter){requestAnimationFrame(frame);return}const dt=Math.min(.04,(now-last)/1000);last=now;if(document.hidden){requestAnimationFrame(frame);return}animationClock+=dt;drawVampirePortrait(animationClock);footstepClock=Math.max(0,footstepClock-dt);saveClock+=dt;if(saveClock>=2){saveClock=0;saveGame()}if(toastTimer>0&&(toastTimer-=dt)<=0)document.getElementById('toast').classList.remove('show');
if((window.regionalPanelOpen&&window.regionalPanelOpen())||window.jarvisPaused||titleMenuActive||!hasStarted||!document.getElementById('optionsMenu').hidden||!document.getElementById('adventureScreen').hidden||document.getElementById('gameView').hidden||!travelScreen.hidden||!inventoryScreen.hidden||!characterScreen.hidden||!skillsScreen.hidden||!shopScreen.hidden||!partyScreen.hidden||!storageScreen.hidden||!questScreen.hidden||!saveFilesScreen.hidden){if(!document.getElementById('gameView').hidden)renderScene();requestAnimationFrame(frame);return}
player.cool=Math.max(0,player.cool-dt);player.attack=Math.max(0,player.attack-dt);tickVampire(dt);politicsTick(dt);updateNpcRoutines(dt);workforceTick(dt);tickCombat(dt);if(!combatReady()){renderScene();requestAnimationFrame(frame);return}tickXpBoost(dt);tickTownStock(dt);const tutorialStartX=player.x,tutorialStartY=player.y;let [dx,dy]=movementAxes();if(dx||dy)tapTarget=null;const waypoint=nextWalkingTarget();if(waypoint&&!dx&&!dy){const tx=waypoint.x-player.x,ty=waypoint.y-player.y,td=Math.hypot(tx,ty);dx=tx/td;dy=ty/td}player.walking=!!(dx||dy);if(player.walking&&footstepClock<=0){playSfx('step');footstepClock=.34}if(dx||dy){const n=Math.hypot(dx,dy);dx/=n;dy/=n;player.faceX=dx;player.faceY=dy;const castMovement=player.class==='mage'&&player.attack>0?.6:1,bounds=worldBounds(),nx=clamp(player.x+dx*Math.min(player.speed*castMovement*(slowTimer>0?.65:1)*dt,waypoint?Math.hypot(waypoint.x-player.x,waypoint.y-player.y):Infinity),bounds.minX,bounds.maxX),ny=clamp(player.y+dy*Math.min(player.speed*castMovement*(slowTimer>0?.65:1)*dt,waypoint?Math.hypot(waypoint.x-player.x,waypoint.y-player.y):Infinity),bounds.minY,bounds.maxY);if(!overlaps(nx,player.y,player.r))player.x=nx;else if(tapTarget)tapTarget=null;if(!overlaps(player.x,ny,player.r))player.y=ny;else if(tapTarget)tapTarget=null}const tutorial=tutorialState();if(tutorial.active&&!tutorial.steps.move){tutorial.distance+=Math.hypot(player.x-tutorialStartX,player.y-tutorialStartY);if(tutorial.distance>=80)tutorialMark('move')}updateCamera();
const walkExit=mapConnections[mapId].exits.find(e=>e.autoWalk&&Math.hypot(player.x-e.x,player.y-e.y)<e.radius);if(walkExit){takeMapExit(walkExit);renderScene();requestAnimationFrame(frame);return;}
const bounds=worldBounds(),edgeSide=edgeSideAt(player.x,player.y,bounds),edgeExit=edgeSide&&mapConnections[mapId].exits.find(item=>item.trigger==='edge'&&item.side===edgeSide);if(edgeExit)takeMapExit(edgeExit,true);if(!edgeSideAt(player.x,player.y,{minX:bounds.minX+75,maxX:bounds.maxX-75,minY:bounds.minY+75,maxY:bounds.maxY-75}))gateBlocked=false;
if(mapId==='emberdeep'){for(const t of traps){if(t.armed&&Math.hypot(player.x-t.x,player.y-t.y)<19){t.armed=false;player.hp=Math.max(1,player.hp-12);say('Ash rune snaps · -12 vitality. Use INTERACT near a rune to disarm it.');ui();saveGame()}}}
tickRoamingElite();updateCompanions(dt);for(const e of enemies){if(activeMap.town)break;if(!e.alive){if((!window.regionalSpawnSafe||window.regionalSpawnSafe(e))&&!e.roamingElite&&activeMap.respawnMs&&!e.boss&&e.respawnAt&&Date.now()>=e.respawnAt){e.alive=true;e.windup=0;e.swing=null;e.stun=0;e.combatCool=.5;e.hp=e.maxHp||3;e.x=e.spawnX;e.y=e.spawnY;e.respawnAt=0;if(mapId!=='emberdeep')e.lootClaimed=false;say((e.name||'A monster')+' has returned.');saveGame()}else continue}updateEnemyCombat(e,dt)}
renderScene();requestAnimationFrame(frame)}
window.addEventListener('pagehide',()=>{if(!switchingCharacter)saveGame()});
document.getElementById('forumShopButton').addEventListener('click',()=>{if(window.ThornhavenDevice?.openForumShop)window.ThornhavenDevice.openForumShop();else window.open('https://thornhaven-community.blushbeech32.chatgpt.site/shop','_blank','noopener,noreferrer')});
document.getElementById('premiumShopButton').addEventListener('click',openPremiumShop);document.getElementById('premiumScreen').addEventListener('click',event=>{if(event.target.closest('[data-close-premium]')){closePanel('premiumScreen');return;}if(event.target.closest('[data-clear-premium]')){clearPremiumPreview();return;}const tab=event.target.closest('[data-premium-category]');if(tab){premiumCategory=tab.dataset.premiumCategory;renderPremiumShop();return;}const item=event.target.closest('[data-preview-product]');if(item)previewPremiumProduct(item.dataset.previewProduct);});
const optionsToggle=document.getElementById('optionsToggle'),optionsMenu=document.getElementById('optionsMenu');
const card=optionsMenu.querySelector('.optionsCard');
const settings=document.createElement('details');settings.id='gameSettings';settings.innerHTML='<summary>Settings · screen, sound & controls</summary>';
const firstSetting=card.querySelector('.optionsLabel');let settingNode=firstSetting;while(settingNode&&settingNode.id!=='danTestControls'&&!settingNode.classList.contains('optionsDone')){const next=settingNode.nextElementSibling;settings.appendChild(settingNode);settingNode=next;}card.insertBefore(settings,document.getElementById('quickMenuLinks'));
const audioLabel=document.createElement('label');audioLabel.className='optionsLabel';audioLabel.htmlFor='soundVolume';audioLabel.innerHTML='Effects volume <output id="soundVolumeValue"></output>';
const volume=document.createElement('input');volume.id='soundVolume';volume.type='range';volume.min='0';volume.max='100';volume.step='5';volume.value=String(Math.round(soundVolume*100));
const showVolume=()=>{document.getElementById('soundVolumeValue').textContent=volume.value+'%'};volume.addEventListener('input',()=>{soundVolume=Number(volume.value)/100;try{localStorage.setItem('thornhaven_sound_volume',String(soundVolume))}catch{}showVolume()});volume.addEventListener('change',()=>playSfx('menu'));const soundButton=document.getElementById('soundToggle');soundButton.after(audioLabel,volume);showVolume();
const pauseNote=document.createElement('p');pauseNote.className='menuPauseNote';pauseNote.textContent='Game paused · close menu to continue';card.querySelector('.optionsTitle').after(pauseNote);
const vampireBadge=document.createElement('div');vampireBadge.id='vampireStatus';vampireBadge.style.cssText='font:10px system-ui;color:#eab4c3;line-height:1.4';document.querySelector('.hud .stats').appendChild(vampireBadge);refreshVampireHud();
const xpBoostStatus=document.createElement('div');xpBoostStatus.id='xpBoostStatus';xpBoostStatus.style.font='10px system-ui';document.querySelector('.hud .stats').appendChild(xpBoostStatus);refreshXpBoost();
const barterShopButton=document.createElement('button');barterShopButton.type='button';barterShopButton.textContent='Town barter';barterShopButton.dataset.shopAction='barter';document.querySelector('#shopScreen .screenTabs').appendChild(barterShopButton);
const quickMenuLinks=document.getElementById('quickMenuLinks');
const tutorialHint=document.createElement('button');tutorialHint.id='tutorialHint';tutorialHint.type='button';tutorialHint.className='journalButton';tutorialHint.addEventListener('click',openTutorial);document.getElementById('gameView').appendChild(tutorialHint);refreshTutorialHint();
document.getElementById('worldButton').addEventListener('click',()=>tutorialMark('map'));

for(const [id,label] of [['worldButton','World Map'],['journalButton','Journal'],['inventoryButton','Inventory'],['characterButton','Character']]){const button=document.getElementById(id);button.textContent=label;quickMenuLinks.appendChild(button)}
for(const [label,action] of [['Bestiary',()=>openBestiary()],['Mage study',()=>openMageStudy()],['Town barter',()=>openTownBarter()],['Tutorial',()=>openTutorial()],['Pets',()=>openPartyScreen()],['Skills',()=>openSkillsScreen()],['Next goal',()=>objectiveAction()],['Adventures',()=>openContinuingAdventure()],['Your story',()=>openClassMystery()],['Night Visitor',()=>openVampireStory()],['Co-op / Clans',()=>openMultiplayerPreview()]]){const button=document.createElement('button');button.type='button';button.textContent=label;button.addEventListener('click',action);quickMenuLinks.appendChild(button)}

// Keep navigation together; retain existing handlers on each button.
const menuCore=['Character','Inventory','Journal','World Map','Pets','Skills'];
const menuButtons=[...quickMenuLinks.querySelectorAll('button')];
for(const label of menuCore){const button=menuButtons.find(b=>b.textContent===label);if(button){button.classList.add('menuCore');quickMenuLinks.appendChild(button);}}
for(const button of menuButtons)if(!menuCore.includes(button.textContent))quickMenuLinks.appendChild(button);
const menuSection=document.createElement('div');menuSection.className='menuSectionHeading';menuSection.textContent='Explore & progress';quickMenuLinks.insertBefore(menuSection,quickMenuLinks.children[6]);
const extraMenu=document.createElement('details');extraMenu.id='moreAdventureOptions';extraMenu.innerHTML='<summary>Settlement, journal & saves</summary>';
for(const id of ['frontierChapterButton','settlementButton','storyChronicleButton','fieldGuideButton','premiumShopButton','saveFilesButton','closeGameButton','petSanctuaryButton']){const button=document.getElementById(id);if(button)extraMenu.appendChild(button);}
quickMenuLinks.after(extraMenu);
card.querySelector('.optionsTitle').textContent='THORNHAVEN · MENU';
document.getElementById('optionsDone').textContent='Return to adventure';
new MutationObserver(()=>refreshPanelState()).observe(optionsMenu,{attributes:true,attributeFilter:['hidden']});
optionsToggle.addEventListener('click',()=>{optionsMenu.hidden=!optionsMenu.hidden;if(!optionsMenu.hidden){stopWorldTouch();clearPadTouches();keys.clear();tapTarget=null;attackHeld=false;}optionsToggle.setAttribute('aria-expanded',String(!optionsMenu.hidden));refreshPanelState()});document.getElementById('soundToggle').addEventListener('click',toggleSound);updateSoundButton();
const orientationModes=['landscape','portrait','auto'];
let orientationPreference='landscape';
try{orientationPreference=window.ThornhavenDevice?window.ThornhavenDevice.getOrientationPreference():localStorage.getItem('thornhaven_orientation')||'landscape';}catch{}
if(!orientationModes.includes(orientationPreference))orientationPreference='landscape';
function refreshOrientation(){document.querySelectorAll('[data-orientation]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.orientation===orientationPreference)));}
async function setOrientationPreference(mode){
 if(!orientationModes.includes(mode))return;
 orientationPreference=mode;
 try{localStorage.setItem('thornhaven_orientation',mode)}catch{}
 stopWorldTouch();clearPadTouches();keys.clear();attackHeld=false;
 refreshOrientation();
 try{
  if(window.ThornhavenDevice)window.ThornhavenDevice.setOrientationPreference(mode);
  else if(mode==='auto')screen.orientation?.unlock();
  else{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();await screen.orientation.lock(mode);}
 }catch{say('Screen preference saved. Rotate your device if your browser cannot lock orientation.');}
}
document.querySelectorAll('[data-orientation]').forEach(button=>button.addEventListener('click',()=>setOrientationPreference(button.dataset.orientation)));
refreshOrientation();
const fullscreenToggle=document.getElementById('fullscreenToggle'),gameShell=document.querySelector('.shell');
function nativeFullscreenAvailable(){return !!(window.ThornhavenDevice && typeof window.ThornhavenDevice.getFullscreenPreference==='function')}
function refreshFullscreenButton(){const active=nativeFullscreenAvailable()?window.ThornhavenDevice.getFullscreenPreference():(document.fullscreenElement||gameShell.classList.contains('appFullscreen'));fullscreenToggle.textContent=active?'EXIT FULL SCREEN':'FULL SCREEN'}
fullscreenToggle.addEventListener('click',async()=>{try{if(nativeFullscreenAvailable()){window.ThornhavenDevice.setFullscreenPreference(!window.ThornhavenDevice.getFullscreenPreference());optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false');refreshFullscreenButton();return;}if(document.fullscreenElement)await document.exitFullscreen();else if(gameShell.classList.contains('appFullscreen'))gameShell.classList.remove('appFullscreen');else if(gameShell.requestFullscreen)await gameShell.requestFullscreen();else gameShell.classList.add('appFullscreen');optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false');refreshFullscreenButton()}catch{gameShell.classList.add('appFullscreen');refreshFullscreenButton();optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false')}});
document.addEventListener('fullscreenchange',refreshFullscreenButton);refreshFullscreenButton();
document.getElementById('earnedTitleList').addEventListener('click',e=>{const b=e.target.closest('[data-earned-title]');if(b)equipEarnedTitle(b.dataset.earnedTitle)});document.getElementById('restorePurchasesButton').addEventListener('click',()=>{document.getElementById('premiumSummary').textContent='Purchases are not active in this version. No payment or purchase restoration has taken place.'});
document.getElementById('frontierChapterButton').addEventListener('click',openFrontierChapter);
document.getElementById('settlementButton').addEventListener('click',openSettlementMap);
document.getElementById('storyChronicleButton').addEventListener('click',()=>{optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false');openCampaignChronicle()});
document.getElementById('optionsDone').addEventListener('click',()=>{optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false')});document.getElementById('saveFilesButton').addEventListener('click',()=>openSaveFiles(true));document.getElementById('closeGameButton').addEventListener('click',closeGameToSaveMenu);document.getElementById('setupSaveFilesButton').addEventListener('click',()=>openSaveFiles(false));
document.querySelectorAll('[data-side-choice]').forEach(button=>button.addEventListener('click',()=>{setControlSide(button.dataset.sideChoice);optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false')}));
document.addEventListener('pointerdown',event=>{if(!optionsMenu.hidden&&!optionsMenu.contains(event.target)&&event.target!==optionsToggle){optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false')}});
// Suppress native held-touch gestures only on live game controls.
// Pointer events remain responsible for movement and multi-touch capture.
for(const surface of document.querySelectorAll('.controls,.combatActions,#dodgeButton,#world')){
 surface.addEventListener('contextmenu',event=>event.preventDefault());
 surface.addEventListener('dragstart',event=>event.preventDefault());
 if('PointerEvent' in window){
  surface.addEventListener('touchstart',event=>{if(event.cancelable)event.preventDefault()},{passive:false});
  surface.addEventListener('touchmove',event=>{if(event.cancelable)event.preventDefault()},{passive:false});
 }
}
const movementDirections={ArrowUp:[0,-1],ArrowDown:[0,1],ArrowLeft:[-1,0],ArrowRight:[1,0],DiagonalNW:[-1,-1],DiagonalNE:[1,-1],DiagonalSW:[-1,1],DiagonalSE:[1,1]};
function movementAxes(){let dx=0,dy=0;for(const key of keys){const d=movementDirections[key.startsWith('Touch:')?key.slice(6):key];if(d){dx+=d[0];dy+=d[1]}}return [Math.sign(dx),Math.sign(dy)]}
const tapStep=key=>{const direction=movementDirections[key];if(!direction)return;const bounds=worldBounds(),length=Math.hypot(...direction);tapTarget={x:clamp(player.x+direction[0]/length*48,bounds.minX,bounds.maxX),y:clamp(player.y+direction[1]/length*48,bounds.minY,bounds.maxY)}};
const movementPad=document.querySelector('.controls'),movementTouches=new Map();
const padSectors=['ArrowRight','DiagonalSE','ArrowDown','DiagonalSW','ArrowLeft','DiagonalNW','ArrowUp','DiagonalNE'];
function refreshHeldDirections(){
 if(!movementTouches.size){movementPad.style.setProperty('--stick-x','0px');movementPad.style.setProperty('--stick-y','0px')}
 for(const key of [...keys])if(key.startsWith('Touch:'))keys.delete(key);
 for(const touch of movementTouches.values())if(touch.key)keys.add('Touch:'+touch.key);
 for(const button of movementPad.querySelectorAll('[data-key]'))button.classList.toggle('directionHeld',[...movementTouches.values()].some(t=>t.key===button.dataset.key));
}
function startPadTouch(id,key,x,y){if(movementTouches.size)return;movementTouches.set(id,{key,x,y,started:performance.now(),dragged:false,sector:-1});tapTarget=null;slidePadTouch(id,x,y)}
function slidePadTouch(id,x,y){
 const touch=movementTouches.get(id);if(!touch)return;

 touch.dragged=true;tapTarget=null;
 const rect=movementPad.getBoundingClientRect(),dx=x-(rect.left+rect.width/2),dy=y-(rect.top+rect.height/2);
 const radius=Math.min(rect.width,rect.height)*.30,length=Math.hypot(dx,dy),scale=length?Math.min(1,radius/length):0;movementPad.style.setProperty('--stick-x',dx*scale+'px');movementPad.style.setProperty('--stick-y',dy*scale+'px');
 if(Math.hypot(dx,dy)<Math.min(rect.width,rect.height)*.10){touch.key=null;touch.sector=-1;refreshHeldDirections();return}
 const angle=Math.atan2(dy,dx),sector=(Math.round(angle/(Math.PI/4))+8)%8;
 // Keep a small margin around sector boundaries so finger jitter does not switch directions.
 if(touch.sector>=0&&sector!==touch.sector){const previous=touch.sector*Math.PI/4,delta=Math.atan2(Math.sin(angle-previous),Math.cos(angle-previous));if(Math.abs(delta)<Math.PI/8+.08)return}
 touch.sector=sector;touch.key=padSectors[sector];refreshHeldDirections();
}
function endPadTouch(id,tap=false){const touch=movementTouches.get(id);if(!touch)return;movementTouches.delete(id);refreshHeldDirections();tapTarget=null}
function clearPadTouches(){movementTouches.clear();refreshHeldDirections()}
movementPad.addEventListener('pointerdown',event=>{
 if(!combatReady()||movementTouches.size||(event.pointerType==='mouse'&&event.button!==0))return;
 event.preventDefault();startPadTouch(event.pointerId,null,event.clientX,event.clientY);
 try{movementPad.setPointerCapture(event.pointerId)}catch{}
});
movementPad.addEventListener('pointermove',event=>{if(movementTouches.has(event.pointerId)){event.preventDefault();slidePadTouch(event.pointerId,event.clientX,event.clientY)}});
movementPad.addEventListener('pointerup',event=>endPadTouch(event.pointerId,true));
for(const type of ['pointercancel','lostpointercapture'])movementPad.addEventListener(type,event=>endPadTouch(event.pointerId));
window.addEventListener('pointerup',event=>endPadTouch(event.pointerId));window.addEventListener('pointercancel',event=>endPadTouch(event.pointerId));
window.addEventListener('blur',clearPadTouches);document.addEventListener('visibilitychange',()=>{if(document.hidden)clearPadTouches()});
window.addEventListener('keydown',e=>{if(!combatReady()||/INPUT|TEXTAREA/.test(e.target.tagName)||e.target.isContentEditable)return;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','w','a','s','d'].includes(e.key)){e.preventDefault();keys.add(({w:'ArrowUp',a:'ArrowLeft',s:'ArrowDown',d:'ArrowRight'})[e.key]||e.key)}});window.addEventListener('keyup',e=>{keys.delete(({w:'ArrowUp',a:'ArrowLeft',s:'ArrowDown',d:'ArrowRight'})[e.key]||e.key)});
for(const [id,action] of [['skillButton',useCombatSkill],['dodgeButton',dodge]]){const b=document.getElementById(id);b.addEventListener('pointerdown',e=>{e.preventDefault();action()});b.addEventListener('click',e=>{if(e.detail===0)action()})}window.addEventListener('keydown',e=>{if(!combatReady()||e.repeat||/INPUT|TEXTAREA/.test(e.target.tagName))return;if(e.code==='Space'){e.preventDefault();attackHeld=true;contextAction()}if(e.code==='KeyQ'){e.preventDefault();useCombatSkill()}if(e.code==='ShiftLeft'||e.code==='ShiftRight'){e.preventDefault();dodge()}});
const actionButton=document.getElementById('attack');actionButton.addEventListener('pointerdown',e=>{e.preventDefault();attackHeld=!!combatActionTarget();try{actionButton.setPointerCapture(e.pointerId)}catch{}contextAction()});for(const event of ['pointerup','pointercancel','lostpointercapture'])actionButton.addEventListener(event,()=>attackHeld=false);window.addEventListener('pointerup',()=>attackHeld=false);window.addEventListener('blur',()=>{attackHeld=false;keys.clear()});document.addEventListener('visibilitychange',()=>{if(document.hidden){attackHeld=false;keys.clear();saveGame()}});document.getElementById('attack').addEventListener('click',e=>{if(e.detail===0)contextAction()});

window.addEventListener('keyup',e=>{if(e.code==='Space')attackHeld=false});
// v1.81: one persistent selected quest per character, with live guidance.
function trackedQuestId(){return townQuestState._tracking?.id||null}
function questGuide(q){
 if(q.id==='camp_caller')return campGuide();
 if(q.id==='camp_patrol')return campPatrolGuide();
 if(q.id==='briar_hollow')return briarGuide();
 if(q.id==='night_visitor')return vampireGuide();
 if(npcStoryDefs[q.id])return npcStoryGuide(q.id);
 if(q.id.startsWith('frontier_'))return frontierQuestGuide(q.id);
 let destination=null,detail=q.desc,progress=q.active?'In progress':'Find the quest giver',ready=false;
 const st=townQuestState[q.id]||{},townId=name=>Object.keys(maps).find(id=>maps[id].town&&maps[id].name.toLowerCase().includes(name.toLowerCase()));
 if(q.id==='slayer_intro'){destination=activeMap.town?mapId:classOrigins[player.class].town;detail='Visit Warden Rook at the Slayers Hall beside the tavern in any town.';progress='Visit the hall';}
  else if(q.id.startsWith('slayer_')){const huntId=q.id.slice(7),d=slayerContracts[huntId],h=slayerHunt(huntId);if(d&&h?.accepted){ready=h.kills>=h.target;destination=ready?(activeMap.town?mapId:classOrigins[player.class].town):d.area;detail=ready?'Return to Warden Rook at any town’s Slayers Hall to claim '+slayerRewardText(h)+'.':'Defeat '+(h.target-h.kills)+' more '+d.monster+' in '+maps[d.area].name+'. '+d.hint;progress=Math.min(h.kills,h.target)+'/'+h.target+' defeated';}}
  else if(q.id==='wayfarer_compass'){const state=townQuestState.wayfarer_compass||{},seals=state.seals||[],next=wayfarerTrials.find((t,i)=>!seals.includes(i));destination=!state.accepted?'ashvale':next?next.area:'northridge';detail=!state.accepted?'Read THE LOST COMPASS inscription in Ashvale to begin.':next?'Awaken the '+next.name+' trial in '+maps[next.area].name+', defeat all three guardians, then solve its runes. Read the altar for the order.':'Open the Compass Vault on the east side of North Ridge. Defeat its three guardians and interact again to claim the relic.';progress='Trial seals '+seals.length+'/3';if(next&&state.started?.includes(wayfarerTrials.indexOf(next)))progress+=' · Guardians remaining '+maps[next.area].enemies.filter(e=>e.wayfarerTrial===wayfarerTrials.indexOf(next)&&e.alive).length;}
 else if(townQuestDefs[q.id]){const d=townQuestDefs[q.id],giverMap=Object.keys(maps).find(id=>maps[id].npcs?.some(n=>n.questId===q.id))||townId(d.town),giverName=maps[giverMap]?.npcs?.find(n=>n.questId===q.id)?.name||d.giver,giverPlace=maps[giverMap]?.name||d.town;ready=!!st.accepted&&(st.kills||0)>=d.target&&(!d.drop||bagCount(d.drop)>=d.dropTarget);destination=!st.accepted||ready?giverMap:d.area;detail=!st.accepted?(d.requires&&!townQuestState[d.requires]?.claimed?'Finish '+townQuestDefs[d.requires].title+' first. ':'')+'Speak to '+giverName+' in '+giverPlace+'.':ready?'Return to '+giverName+' in '+giverPlace+' to claim your reward.':d.desc;progress=st.accepted?'Kills '+Math.min(st.kills||0,d.target)+'/'+d.target+(d.drop?' · '+itemDefs[d.drop].name+' '+Math.min(bagCount(d.drop),d.dropTarget)+'/'+d.dropTarget:''):'Not accepted';}
 else if(classGearQuests[q.id]){const d=classGearQuests[q.id],n=d.type==='waystones'?(st.waystones||[]).length:st.progress||0;ready=!!st.accepted&&n>=d.target;destination=!st.accepted||ready?d.town:d.area||d.regions.find(id=>!(st.waystones||[]).includes(id));detail=!st.accepted?'Visit the '+classDefs[d.hero].title+' armory in '+maps[d.town].name+'. Complete earlier equipment quests first.':ready?'Return to the '+maps[d.town].name+' armory for your reward.':classGearQuestDetail(d);progress=Math.min(n,d.target)+'/'+d.target+(ready?' · Ready to turn in':'');}
 else if(q.id.startsWith('regional_')){const id=q.id.slice(9),d=regionalAdventures[id];destination=id;const n=d.type==='hunt'?maps[id].enemies.filter(e=>e.eventRegion===id&&e.alive).length:d.type==='supply'?Math.min(1,bagCount('field_ration')):d.type==='sequence'?st.progress||0:(st.found||[]).length;ready=!!st.accepted&&regionalReady(id);detail=!st.accepted?'Interact with '+d.title+' in '+maps[id].name+' to begin.':ready?'Return to the '+d.title+' marker and interact to claim your reward.':d.text;progress=!st.accepted?'Not started':d.type==='hunt'?'Guards remaining '+n:d.type==='supply'?'Field Ration '+n+'/1':'Progress '+n+'/3';}
 else if(q.id==='main_hunt'){destination='whisperwood';detail='Defeat three Ash Slimes in Whisperwood Trail. Reward is automatic.';progress=Math.min(defeated,3)+'/3 defeated';}
 else if(q.id==='main_seals'){destination=Object.keys(townRelicState).find(id=>!townRelicState[id]);detail='Complete both town quests in each of Ashvale, Sunmere, Brackenford, and Stonewatch.';progress='Town seals '+Object.values(townRelicState).filter(Boolean).length+'/4';}
 else if(q.id==='main_rune'){destination='mosslight';detail=hasFourfoldKey?'At Mosslight Shrine: West → North → East, then open the chest.':'Earn the Fourfold Keystone first by finishing all four town stories.';progress=hasFourfoldKey?'Shrine unlocked':'Shrine locked';}
 else if(q.id==='main_maze'){destination='shrine_rootmaze';detail='Touch North → East → West, then open the chest.';progress=hasSigil?'Floor II':'Earn the Ember Rune first';}
 else if(q.id==='main_heart'){destination='shrine_heart';detail='Touch East → West → South, defeat the guardian, then open the shrine heart.';progress=maps.shrine_rootmaze.chest.open?'Floor III':'Complete Floor II first';}
 else if(q.id==='main_vault'){destination='emberdeep';detail='Defeat the Cinder Warden and open the treasure coffer.';progress=hasSigil?'Enter the Ashvault':'Earn the Ember Rune first';}
 else if(q.id.startsWith('story_')){const id=q.id.slice(6),d=storyDungeons[id];destination=d.parent;detail=storyPortalLock(id)||('Enter '+d.name+' from '+maps[d.parent].name+'. '+d.hint);progress='Wards '+storyWards(id)+'/'+maps[id].worldObjects.filter(o=>o.id.startsWith('story_ward_')).length;}
 else if(q.id.startsWith('epilogue_')){const d=companionEpilogues[q.id.slice(9)];destination=d.town;detail='Recruit this companion, finish both town chapters, then visit the epilogue marker on the east side of '+maps[d.town].name+'.';}
 else if(q.id==='world_watchtower'){destination='northridge';ready=(st.progress||0)>=3;detail=ready?'Open the watchtower cache.':'Read the tablet, then light East → West → North.';progress='Beacons '+(st.progress||0)+'/3';}
 else if(q.id==='world_rescue'){destination='meadowroad';const left=maps.meadowroad.enemies.filter(e=>e.worldBandit&&e.alive).length;detail=left?'Defeat the camp guards, then interact at the prisoner cage.':'Interact at the prisoner cage to free the traveler.';progress='Guards remaining '+left;}
 else if(q.id==='crossroads_medicine'){destination='coastroad';detail='Bring a Small Healing Potion to the wounded traveler and choose who receives it.';progress='Potion '+Math.min(1,bagCount('potion_25'))+'/1';}
 else if(q.id==='main_caches'){destination=hiddenTrailCaches.find(c=>!townQuestState[c.id]?.claimed)?.area;detail='Search the edges of Westwood, Coast Road, and Southwood for hidden caches.';progress='Caches '+hiddenTrailCaches.filter(c=>townQuestState[c.id]?.claimed).length+'/3';}
 return {destination:maps[destination]?destination:null,detail,progress,ready};
}
function questEscape(value){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function refreshMainQuestHud(){if(trackedQuestId())return;const q=journalActiveRows().find(q=>journalKind(q.id)==='main');if(!q)return;const g=questGuide(q);document.getElementById('questDetails').textContent=g.detail;document.getElementById('progress').textContent=g.progress+(g.destination?' · '+maps[g.destination].name:'');if(q.id==='main_hunt')refreshOpeningGuide();document.getElementById('questTitle').textContent=journalLabel(q.id)+' · '+q.title;}
function refreshTrackedQuest(){
 const id=trackedQuestId();if(!id)return;
 const q=questCatalog().find(q=>q.id===id);
 if(!q||q.done||journalPaused(q.id)){delete townQuestState._tracking;ui();if(q?.done)say(q.title+' complete · choose another quest in QUEST LOG.');return;}
 const g=questGuide(q);document.getElementById('questTitle').textContent=journalLabel(q.id)+' · '+q.title;
 document.getElementById('questDetails').textContent=g.detail;
 document.getElementById('progress').textContent=(g.ready?'Ready for reward · ':g.progress+' · ')+(g.destination?maps[g.destination].name:'Explore Ashvale');
}
function selectTrackedQuest(id){const q=questCatalog().find(q=>q.id===id&&!q.done);if(!q||!journalActiveRows().some(row=>row.id===id))return;if(trackedQuestId()===id)delete townQuestState._tracking;else townQuestState._tracking={id};ui();renderQuests();if(trackedQuestId()){closePanel('questScreen');say('Tracking '+q.title);}}
function markQuestDestination(id=trackedQuestId()){
 const q=questCatalog().find(q=>q.id===id&&!q.done);if(!q)return;const g=questGuide(q);if(!g.destination)return;
 document.getElementById('travelCurrent').textContent='Quest destination: '+maps[g.destination].name+' · '+q.title;
 const atlasDestination=['memory_valley','frontier_quarry'].includes(g.destination)?'frontier_outpost':g.destination;if(atlasDestination!==g.destination)document.getElementById('travelCurrent').textContent+=' · Enter Hearthstead in the southeast corner of the world'+(g.destination==='memory_valley'?', then Hearthstead’s east road.':'.');
 for(const el of document.querySelectorAll('[data-travel-to]'))if(el.dataset.travelTo===atlasDestination){el.classList.add('questDestination');el.setAttribute('aria-label','Quest destination: '+maps[g.destination].name);requestAnimationFrame(()=>{const pane=document.getElementById('atlasScroller');if(pane&&el.classList.contains('atlasNode')){pane.scrollLeft=Math.max(0,el.offsetLeft-pane.clientWidth/2);pane.scrollTop=Math.max(0,el.offsetTop-pane.clientHeight/2);}});}
}
document.getElementById('questList').addEventListener('click',event=>{const track=event.target.closest('[data-track-quest]');if(track){selectTrackedQuest(track.dataset.trackQuest);return}const map=event.target.closest('[data-quest-map]');if(map){openTravelScreen();markQuestDestination(map.dataset.questMap);}});
setInterval(()=>{if(!hasStarted)return;if(trackedQuestId())refreshTrackedQuest();else refreshMainQuestHud();if(!questScreen.hidden)renderQuests();},750);
document.getElementById('fieldGuideButton').addEventListener('click',openFieldGuide);
function addDanLevels(count){if(!danTesting()||![1,10].includes(count))return false;player.level+=count;syncHeroStats();normalizePets();scaleEnemiesForRegion();ui();saveGame();document.getElementById('danCodeStatus').textContent='Level '+player.level+' · no level cap. Monsters scale with you.';return true;}
function refillDan(){if(!danTesting())return;applyDanTestProfile();ui();saveGame();document.getElementById('danCodeStatus').textContent='Level 100 is a starting point, not a cap. Use +1 or +10 to test higher levels; combat also earns XP.';}
document.getElementById('danRefill').addEventListener('click',refillDan);document.getElementById('danLevelOne').addEventListener('click',()=>addDanLevels(1));document.getElementById('danLevelTen').addEventListener('click',()=>addDanLevels(10));


document.getElementById('inventoryButton').addEventListener('click',openInventory);document.getElementById('characterButton').addEventListener('click',openCharacterScreen);const journalButton=document.getElementById('journalButton');document.getElementById('worldButton').addEventListener('click',openTravelScreen);document.getElementById('travelDestinations').addEventListener('click',e=>{const b=e.target.closest('[data-travel-to]');if(b&&!b.disabled){if(b.closest('.atlasOverview')){sizeAtlas(false,b.dataset.travelTo);const info=document.getElementById('atlasSelection');if(info)info.textContent=maps[b.dataset.travelTo].name+' · Select again for travel details.';}else travelTo(b.dataset.travelTo)}});travelScreen.addEventListener('click',e=>{const b=e.target.closest('[data-close-screen]');if(b)closePanel('travelScreen')});journalButton.addEventListener('click',openQuestJournal);
function handleWorldTap(clientX,clientY){
 if(!combatReady())return;
 const rect=c.getBoundingClientRect(),{x,y}=screenToMap((clientX-rect.left)/rect.width*viewW,(clientY-rect.top)/rect.height*viewH),bounds=worldBounds();
 if(Math.hypot(x-player.x,y-player.y)<24){tapTarget=null;return;}
 tapTarget={x:clamp(x,bounds.minX,bounds.maxX),y:clamp(y,bounds.minY,bounds.maxY)};
}
let proximityMap=null,proximitySeen=new Set(),proximityStill=0;
function proximityCandidates(){
 const rows=[];const add=(o,key,range,act)=>{if(o)rows.push({o,key,range,act,d:Math.hypot(player.x-o.x,player.y-o.y)})};
 for(const n of npcs)add(n,'npc:'+n.id+':'+n.name,60,()=>openNpcConversation(n));
 for(const o of (activeMap.worldObjects||[]))add(o,'object:'+o.id,60,()=>{const person=npcWorldPerson(o);if(person)openNpcConversation(person);else openAdventureDialog(o.name||'Nearby object','Interact with this object?',[{label:'Interact',action:()=>worldObjectInteract(o)}])});
 for(const n of activeMap.gatherNodes||[])add(n,'gather:'+n.x+':'+n.y,52,()=>gatherNode(n));
 for(const t of traps||[])if(t.armed)add(t,'trap:'+t.x+':'+t.y,55,()=>disarmTrap(t));
 for(const r of runes)add(r,'rune:'+r.x+':'+r.y,54,()=>activateRune(r));
 if(activeMap.interior)for(const [x,y,id] of [[190,210,'front_chest'],[825,215,'side_chest']])add({x,y},'storage:'+id,58,()=>openStorage(activeMap.homeId,id));
 if(chest&&!chest.open)add(chest,'chest',60,()=>openChest());
 if(treasure&&!treasure.opened)add(treasure,'treasure',64,()=>interact());
 for(const e of mapConnections[mapId].exits.filter(e=>e.trigger==='interact'))add(e,'exit:'+e.x+':'+e.y,e.radius,()=>openAdventureDialog('Travel','Leave this area?',[{label:'Travel',action:()=>takeMapExit(e)}]));
 return rows;
}
function tickProximity(dt){
 // Only combat is automatic. Conversations, resources and objects require INTERACT.
 if(!combatReady())return;
 const enemy=enemies.filter(e=>e.alive&&Math.hypot(e.x-player.x,e.y-player.y)<=classDefs[player.class].range&&clearCombatLine(player.x,player.y,e.x,e.y)).sort((a,b)=>Math.hypot(a.x-player.x,a.y-player.y)-Math.hypot(b.x-player.x,b.y-player.y))[0];
 if(enemy){lockedEnemy=enemy;attack();}
}
const zoomPointers=new Map();let pinchStartDistance=0,pinchStartZoom=1,pinchUsed=false;
const MOVEMENT_PREF='thornhaven_movement_mode_v2';
function setMovementMode(mode){
 const value=mode==='arrows'?'arrows':'touch';
 stopWorldTouch();clearPadTouches();keys.clear();
 document.body.dataset.movementMode=value;
 document.querySelectorAll('[data-movement-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.movementChoice===value)));
 try{localStorage.setItem(MOVEMENT_PREF,value)}catch{}
}

let touchSteerClock=0;
function stopWorldTouch(){zoomPointers.clear();tapTarget=null;touchSteerClock=0;}
function tickTouchSteering(dt){
 touchSteerClock-=dt;
 if(!combatReady()||zoomPointers.size!==1||pinchUsed||touchSteerClock>0)return;
 const p=zoomPointers.values().next().value;
 if(!p.steering && performance.now()-p.started<220)return;
 p.steering=true;touchSteerClock=.08;handleWorldTap(p.x,p.y);
}
function pinchDistance(){const p=[...zoomPointers.values()];return p.length>=2?Math.hypot(p[0].x-p[1].x,p[0].y-p[1].y):0}
c.addEventListener('pointerdown',event=>{
 if(!combatReady()||(event.pointerType==='mouse'&&event.button!==0))return;
 event.preventDefault();if(zoomPointers.size===0){pinchUsed=false;tapTarget=null;}
 zoomPointers.set(event.pointerId,{x:event.clientX,y:event.clientY,startX:event.clientX,startY:event.clientY,started:performance.now(),steering:false});
 try{c.setPointerCapture(event.pointerId)}catch{}
 if(zoomPointers.size===1)handleWorldTap(event.clientX,event.clientY);
 if(zoomPointers.size===2){pinchStartDistance=pinchDistance();pinchStartZoom=cameraZoom;pinchUsed=true;tapTarget=null}
});
c.addEventListener('pointermove',event=>{const p=zoomPointers.get(event.pointerId);if(!p)return;
 if(event.pointerType==='mouse'&&event.buttons===0){stopWorldTouch();return}
 event.preventDefault();p.x=event.clientX;p.y=event.clientY;
 if(Math.hypot(p.x-p.startX,p.y-p.startY)>10)p.steering=true;
 if(zoomPointers.size===1&&!pinchUsed&&p.steering)handleWorldTap(p.x,p.y);
 if(zoomPointers.size===2&&pinchStartDistance>0)setCameraZoom(pinchStartZoom*pinchDistance()/pinchStartDistance)
});
function releaseZoomPointer(event,tap=false){const p=zoomPointers.get(event.pointerId);if(!p)return;
 zoomPointers.delete(event.pointerId);
 const shortTap=tap&&!pinchUsed&&!p.steering&&performance.now()-p.started<220;
 if(!shortTap)tapTarget=null;
 if(!zoomPointers.size)touchSteerClock=0;
}
window.addEventListener('pointerup',event=>releaseZoomPointer(event,true),true);
for(const type of ['pointercancel','lostpointercapture'])window.addEventListener(type,event=>releaseZoomPointer(event),true);
// Android can deliver a native touch cancellation without a matching pointer release.
window.addEventListener('touchend',event=>{if(!event.touches.length&&zoomPointers.size)stopWorldTouch()},{passive:true});
window.addEventListener('touchcancel',stopWorldTouch,{passive:true});
window.addEventListener('resize',stopWorldTouch);window.addEventListener('blur',stopWorldTouch);document.addEventListener('visibilitychange',()=>{if(document.hidden)stopWorldTouch()});
for(const [id,change] of [['zoomOut',-.15],['zoomIn',.15],['zoomReset',null]])document.getElementById(id).addEventListener('click',()=>setCameraZoom(change===null?1:cameraZoom+change));
document.querySelector('.zoomControls').addEventListener('contextmenu',event=>event.preventDefault());
c.addEventListener('wheel',event=>{event.preventDefault();setCameraZoom(cameraZoom*(event.deltaY<0?1.1:1/1.1))},{passive:false});setCameraZoom(cameraZoom);
if(!('PointerEvent' in window)){c.addEventListener('touchstart',e=>{if(!combatReady())return;e.preventDefault();if(!zoomPointers.size)pinchUsed=false;for(const t of e.changedTouches)zoomPointers.set(t.identifier,{x:t.clientX,y:t.clientY,startX:t.clientX,startY:t.clientY,started:performance.now(),steering:false});if(zoomPointers.size===1){const p=zoomPointers.values().next().value;handleWorldTap(p.x,p.y)}else{pinchUsed=true;tapTarget=null;pinchStartDistance=pinchDistance();pinchStartZoom=cameraZoom}},{passive:false});c.addEventListener('touchmove',e=>{e.preventDefault();for(const t of e.changedTouches){const p=zoomPointers.get(t.identifier);if(p){p.x=t.clientX;p.y=t.clientY;if(Math.hypot(p.x-p.startX,p.y-p.startY)>10)p.steering=true}}if(zoomPointers.size===1&&!pinchUsed){const p=zoomPointers.values().next().value;handleWorldTap(p.x,p.y)}else if(zoomPointers.size===2&&pinchStartDistance>0)setCameraZoom(pinchStartZoom*pinchDistance()/pinchStartDistance)},{passive:false});for(const type of ['touchend','touchcancel'])c.addEventListener(type,e=>{for(const t of e.changedTouches)releaseZoomPointer({pointerId:t.identifier},type==='touchend')});movementPad.addEventListener('touchstart',event=>{if(!combatReady())return;event.preventDefault();for(const touch of event.changedTouches)startPadTouch(touch.identifier,null,touch.clientX,touch.clientY)},{passive:false});movementPad.addEventListener('touchmove',event=>{event.preventDefault();for(const touch of event.changedTouches)slidePadTouch(touch.identifier,touch.clientX,touch.clientY)},{passive:false});movementPad.addEventListener('touchend',event=>{for(const touch of event.changedTouches)endPadTouch(touch.identifier,true)});movementPad.addEventListener('touchcancel',event=>{for(const touch of event.changedTouches)endPadTouch(touch.identifier)});const touchAction=(id,action)=>document.getElementById(id).addEventListener('touchstart',e=>{e.preventDefault();action()},{passive:false});touchAction('attack',contextAction);}
let savedMovementMode='arrows';try{savedMovementMode=localStorage.getItem(MOVEMENT_PREF)||'arrows'}catch{}setMovementMode(savedMovementMode);
document.querySelectorAll('[data-movement-choice]').forEach(b=>b.addEventListener('click',()=>{setMovementMode(b.dataset.movementChoice);optionsMenu.hidden=true;optionsToggle.setAttribute('aria-expanded','false');refreshPanelState();}));
window.addEventListener('resize',()=>{stopWorldTouch();clearPadTouches();keys.clear();attackHeld=false;});
document.querySelectorAll('input[name="heroGender"]').forEach(el=>el.addEventListener('change',()=>{if(el.checked)setCreationGender(el.value)}));
document.querySelectorAll('input[name="heroClass"]').forEach(el=>el.addEventListener('change',()=>{if(el.checked)selectedClass=el.value}));
const characterNameInput=document.getElementById('characterName');
function isReservedCharacterName(name){return false}
function validateCharacterName(){const reserved=isReservedCharacterName(characterNameInput.value);characterNameInput.setCustomValidity(reserved?'This name is reserved. Please choose another character name.':'');return !reserved}
characterNameInput.addEventListener('input',validateCharacterName);
document.getElementById('characterForm').addEventListener('submit',e=>{e.preventDefault();if(!validateCharacterName()){characterNameInput.reportValidity();return}const chosenName=characterNameInput.value.trim();player.name=chosenName||'Hero';player.gender=selectedGender;applyClass(selectedClass);townQuestState._camp={stage:0,claimed:false};townQuestState._tracking={id:'camp_caller'};setMap('wayfarers_camp',480,420,false);hasStarted=true;document.getElementById('characterSetup').hidden=true;document.getElementById('gameView').hidden=false;document.getElementById('controlRow').hidden=false;ui();saveGame();say('Welcome, '+player.name+'. Your First Hunt awaits in Whisperwood. Open MAPS to find your route. HOW TO PLAY explains the controls.');say('Wayfarer’s Camp · inspect the dying fire. Your Journal records each discovery.');});
if(!Array.isArray(player.inventory))player.inventory=[];if(!player.weapon)player.weapon=null;if(!player.armor)player.armor=null;if(!classDefs[player.class])player.class='warrior';if(!player.name)player.name='Hero';for(const slot of GEAR_SLOTS)if(player[slot]&&!canUseItem(player[slot]))player[slot]=null;else if(!player[slot])player[slot]=null;
document.getElementById('characterSetup').hidden=hasStarted;document.getElementById('gameView').hidden=!hasStarted;document.getElementById('controlRow').hidden=!hasStarted;
const oldFrame=frame;frame=function(now){if(keys.has('tap')){const bounds=worldBounds();player.x=clamp(player.x+player.faceX*player.speed/60,bounds.minX,bounds.maxX);player.y=clamp(player.y+player.faceY*player.speed/60,bounds.minY,bounds.maxY);updateCamera()}oldFrame(now)};
document.getElementById('adventureScreen').addEventListener('click',e=>{const close=e.target.closest('[data-close-screen]');if(close){closePanel('adventureScreen');return}const button=e.target.closest('[data-adventure-choice]');if(!button)return;const choice=adventureChoices[Number(button.dataset.adventureChoice)];if(!choice||choice.disabled)return;closePanel('adventureScreen');if(choice)choice.action()});
document.getElementById('buildChoices').addEventListener('click',e=>{const button=e.target.closest('[data-build-choice]');if(button)chooseBuild(button.dataset.buildChoice)});
for(const [id,m] of Object.entries(maps)){
 for(const o of m.worldObjects||[])if(o.id.startsWith('regional_')){Object.assign(o,safeMapPosition(id,o.x,o.y,18));}
 const occupied=[];for(const n of m.npcs){Object.assign(n,safeMapPosition(id,n.x,n.y,14,occupied));occupied.push(n)}
 for(const e of m.enemies){Object.assign(e,safeMapPosition(id,e.x,e.y,14));const spawn=safeMapPosition(id,e.spawnX??e.x,e.spawnY??e.y,14);e.spawnX=spawn.x;e.spawnY=spawn.y;}
}
Object.assign(player,safeMapPosition(mapId,player.x,player.y,player.r));snapCompanionsToPlayer();updateCamera();
function refreshClassPortraits(){for(const pick of document.querySelectorAll('.classPick')){const hero=pick.querySelector('input').value,card=pick.querySelector('.classCard'),appearance=classAppearance({class:hero,gender:selectedGender}),atlas=appearance.atlas,f=appearance.frames[0];if(!atlas.complete||!atlas.naturalWidth)continue;let portrait=card.querySelector('.classPortrait');if(!portrait){portrait=document.createElement('span');portrait.className='classPortrait';portrait.setAttribute('aria-hidden','true');card.appendChild(portrait)}portrait.setAttribute('aria-label',(selectedGender==='female'?'Female ':'Male ')+classDefs[hero].title);portrait.style.width=Math.round(48*f[2]/f[3])+'px';portrait.style.backgroundImage='url('+atlas.src+')';portrait.style.backgroundSize=(atlas.naturalWidth/f[2]*100)+'% '+(atlas.naturalHeight/f[3]*100)+'%';portrait.style.backgroundPosition=(f[0]/(atlas.naturalWidth-f[2])*100)+'% '+(f[1]/(atlas.naturalHeight-f[3])*100)+'%';}}classSpriteAtlas.onload=refreshClassPortraits;counterpartSpriteAtlas.onload=refreshClassPortraits;refreshClassPortraits();
const originalUiForDan=ui;ui=function(){originalUiForDan();const testing=danTesting();document.getElementById('danTestControls').hidden=!testing;if(testing){document.getElementById('danTestClass').value=player.class;document.getElementById('danTestGender').value=player.gender}};document.getElementById('danTestClass').addEventListener('change',event=>{
 if(!danTesting())return;applyClass(event.target.value);skillCooldown=0;player.cool=0;attackHeld=false;lockedEnemy=null;ui();saveGame()});document.getElementById('danTestGender').addEventListener('change',event=>{
 if(!danTesting())return;player.gender=normalizedHeroGender(event.target.value,player.class);ui();saveGame()});installPetUI();const uiBeforePets=ui;ui=function(){ensureStarterPet();uiBeforePets();const p=companions.find(p=>p.active&&p.hp>0),button=document.getElementById('petStatusButton');if(button){const key=p?p.id+':'+p.level:'none';if(button.dataset.petDisplay!==key){button.dataset.petDisplay=key;button.innerHTML=p?'<img src="assets/pets/'+petArtwork[p.id]+'-v2.webp" alt="" style="width:26px;height:26px;object-fit:contain;vertical-align:middle"> '+p.name+' · Lv '+p.level:'PETS';}}};ui();if(hasStarted&&!done)say('Welcome back, '+player.name+'. Your story continues in '+activeMap.name+'.');requestAnimationFrame(frame);
installFocusedJournal();installNpcConversations();
// Main menu keeps all existing save-slot identities and pauses the world until entry.
function titleSavedSlot(){
 const valid=id=>{const row=saveSlots[id],state=row&&(row.state||row);return !!(state?.player?.name&&classDefs[state.player.class]);};
 if(valid(activeSlotId))return activeSlotId;
 return SAVE_SLOT_IDS.filter(valid).sort((a,b)=>(saveSlots[b].updated||0)-(saveSlots[a].updated||0))[0]||null;
}
function showTitleMenu(){document.getElementById('summonsScreen').hidden=true;
 if(!titleMenuActive)saveGame();
 titleMenuActive=true;preparePanel('titleMenu');stopWorldTouch();clearPadTouches();keys.clear();tapTarget=null;attackHeld=false;
 document.getElementById('characterSetup').hidden=true;document.getElementById('gameView').hidden=true;document.getElementById('controlRow').hidden=true;
 document.body.classList.add('title-menu');document.getElementById('titleMenu').hidden=false;
 const id=titleSavedSlot(),record=id&&saveSlots[id],state=record&&(record.state||record);
 document.getElementById('titleContinue').disabled=!id;
 document.getElementById('titleSaveInfo').textContent=id?state.player.name+' · '+classDefs[state.player.class].title+' · Level '+state.player.level+' · '+(maps[state.mapId]?.name||'Ashvale Reach'):'Your story begins here. Start a new game to create your hero.';
 document.getElementById('optionsDone').textContent='Back to main menu';
 drawThemedWorldMap(document.getElementById('titleMap'));refreshPanelState();
}
function leaveTitleMenu(){titleMenuActive=false;document.body.classList.remove('title-menu');document.getElementById('titleMenu').hidden=true;document.getElementById('optionsDone').textContent='Return to adventure';}
const selectSlotBeforeTitle=selectSaveSlot;
selectSaveSlot=function(id){if(!SAVE_SLOT_IDS.includes(id)||switchingCharacter)return;leaveTitleMenu();selectSlotBeforeTitle(id);if(!hasStarted){document.getElementById('characterSetup').hidden=true;document.getElementById('summonsScreen').hidden=false;}};
const closePanelBeforeTitle=closePanel;
closePanel=function(id){closePanelBeforeTitle(id);if(titleMenuActive)showTitleMenu();};
closeGameToSaveMenu=function(){showTitleMenu();};
document.getElementById('closeGameButton').textContent='Main menu · save & return';
document.getElementById('titleContinue').addEventListener('click',()=>{const id=titleSavedSlot();if(id)selectSaveSlot(id);});
document.getElementById('titleNew').addEventListener('click',()=>{
 const empty=SAVE_SLOT_IDS.find(id=>!saveSlots[id]);
 if(empty){selectSaveSlot(empty);return;}
 document.getElementById('titleSaveInfo').textContent='All four character slots are occupied. Open Characters to manage them; no progress has been replaced.';
});
document.getElementById('titleCharacters').addEventListener('click',()=>{document.getElementById('titleMenu').hidden=true;openSaveFiles(true);});
document.getElementById('titleSettings').addEventListener('click',()=>{document.getElementById('titleMenu').hidden=true;optionsMenu.hidden=false;document.getElementById('gameSettings').open=true;optionsToggle.setAttribute('aria-expanded','true');refreshPanelState();});
document.getElementById('optionsDone').addEventListener('click',()=>{if(titleMenuActive)showTitleMenu();});
new MutationObserver(()=>{if(titleMenuActive&&optionsMenu.hidden&&saveFilesScreen.hidden&&document.getElementById('titleMenu').hidden)showTitleMenu();}).observe(optionsMenu,{attributes:true,attributeFilter:['hidden']});
const creationBack=document.createElement('button');creationBack.id='creationBack';creationBack.type='button';creationBack.textContent='Back to main menu';creationBack.addEventListener('click',showTitleMenu);document.getElementById('characterSetup').prepend(creationBack);

function installSimpleOptions(){
 const menu=document.getElementById('optionsMenu'),card=menu.querySelector('.optionsCard'),quick=document.getElementById('quickMenuLinks'),settings=document.getElementById('gameSettings');
 const groups={world:document.createElement('div'),help:document.createElement('div'),character:document.createElement('div')};
 for(const [key,group] of Object.entries(groups)){group.id='menuPage_'+key;group.className='cleanMenuPage';group.hidden=true;card.appendChild(group);}
 const coreIds=['characterButton','inventoryButton','journalButton','worldButton'];
 for(const button of [...quick.querySelectorAll('button')]){
  if(coreIds.includes(button.id)||['Pets','Skills'].includes(button.textContent.trim()))continue;
  groups[['Bestiary','Tutorial','Co-op / Clans'].includes(button.textContent.trim())?'help':'world'].appendChild(button);
 }
 quick.querySelector('.menuSectionHeading')?.remove();
 const plainLabels={'Next goal':'Current objective','Adventures':'Activity board','Your story':'Class story','Night Visitor':'Vampire story','Mage study':'Mage research','Tutorial':'Guided tutorial','Co-op / Clans':'Multiplayer (planned)'};
 for(const group of Object.values(groups))for(const b of group.querySelectorAll('button'))if(plainLabels[b.textContent.trim()])b.textContent=plainLabels[b.textContent.trim()];
 for(const [id,group,label] of [['frontierChapterButton','world','Settlement quests'],['settlementButton','world','Your settlement'],['storyChronicleButton','world','Story history'],['fieldGuideButton','help','How to play'],['premiumShopButton','help','Shop previews'],['saveFilesButton','help','Saved characters'],['closeGameButton','help','Save & main menu']]){const b=document.getElementById(id);if(b){b.textContent=label;groups[group].appendChild(b);}}
 // The main Pets button already opens the same sanctuary.
 document.getElementById('petSanctuaryButton')?.remove();document.getElementById('moreAdventureOptions')?.remove();
 const testing=document.getElementById('danTestControls');if(testing)groups.help.appendChild(testing);
 for(const child of [...card.children])if(child.tagName==='P'&&!child.classList.contains('menuPauseNote'))child.remove();
 const hints={Character:'Stats and equipment',Inventory:'Items and supplies',Journal:'Quests and objectives','World Map':'Places and directions',Pets:'Manage your companion',Skills:'Abilities and professions'};
 for(const b of quick.querySelectorAll('button')){const hint=document.createElement('span');hint.className='menuHint';hint.textContent=hints[b.textContent.trim()]||'';b.appendChild(hint);}
 const back=document.createElement('button');back.id='menuBack';back.type='button';back.textContent='‹ Back to menu';back.addEventListener('click',()=>showOptionsPage('main'));card.insertBefore(back,settings);
 const categories=document.createElement('div');categories.id='menuCategories';
 for(const [page,label,hint] of [['world','World & story','Settlement, adventures and story'],['settings','Settings','Sound and movement controls'],['help','Help & saves','Instructions and saved characters']]){const b=document.createElement('button');b.type='button';b.textContent=label;const note=document.createElement('span');note.className='menuHint';note.textContent=hint;b.appendChild(note);b.addEventListener('click',()=>showOptionsPage(page));categories.appendChild(b);}
 quick.after(categories);
 // Split settings into three short, collapsible sections, preserving the controls.
 const settingNodes=[...settings.children].filter(n=>n.tagName!=='SUMMARY');
 const section=(id,label)=>{const d=document.createElement('details');d.id=id;d.className='settingSection';const h=document.createElement('summary');h.textContent=label;d.appendChild(h);settings.appendChild(d);return d;};
 const screenSection=section('screenSettings','Display'),controlsSection=section('controlSettings','Movement & controls'),audioSection=section('audioSettings','Sound');
 let destination=screenSection;
 for(const node of settingNodes){if(node.classList.contains('optionsLabel')){if(node.textContent.trim()==='Movement')destination=controlsSection;if(node.textContent.includes('Effects volume'))destination=audioSection;}if(node.id==='fullscreenToggle')destination=screenSection;if(node.id==='soundToggle')destination=audioSection;destination.appendChild(node);}
 card.appendChild(document.getElementById('optionsDone'));
 const mainButton=document.getElementById('closeGameButton');mainButton.textContent='Back to main screen';mainButton.classList.add('optionsDone');card.appendChild(mainButton);
 menu.querySelector('.menuPauseNote').textContent='Paused · your adventure will wait.';
 optionsToggle.addEventListener('click',()=>{if(!menu.hidden)showOptionsPage('main');});
 document.getElementById('titleSettings').addEventListener('click',()=>showOptionsPage('settings'));
 document.getElementById('titleDisplay').addEventListener('click',()=>{document.getElementById('titleMenu').hidden=true;optionsMenu.hidden=false;optionsToggle.setAttribute('aria-expanded','true');showOptionsPage('display');refreshPanelState();});
 showOptionsPage('main');
}
function showOptionsPage(page){
 if(page==='display'&&!titleMenuActive)page='settings';
 const isMain=page==='main';
 document.getElementById('closeGameButton').hidden=titleMenuActive;
 document.getElementById('quickMenuLinks').hidden=!isMain;document.getElementById('menuCategories').hidden=!isMain;
 document.getElementById('menuBack').hidden=isMain||titleMenuActive||page==='character';
 document.getElementById('optionsMenu').dataset.page=page;
 document.getElementById('heroMenuButton').setAttribute('aria-expanded',String(page==='character'&&!optionsMenu.hidden));
 document.getElementById('closeGameButton').hidden=titleMenuActive||page==='character';
 const portraitHint=document.getElementById('portraitMenuHint');if(portraitHint)portraitHint.hidden=!isMain;
 for(const key of ['world','help','character'])document.getElementById('menuPage_'+key).hidden=page!==key;
 const settings=document.getElementById('gameSettings');const isSettings=page==='settings'||page==='display';settings.hidden=!isSettings;settings.open=isSettings;
 document.getElementById('screenSettings').hidden=page!=='display';document.getElementById('screenSettings').open=page==='display';
 for(const id of ['controlSettings','audioSettings'])document.getElementById(id).hidden=page!=='settings';
 if(page==='settings')for(const id of ['screenSettings','controlSettings','audioSettings'])document.getElementById(id).open=false;
 document.querySelector('#optionsMenu .optionsTitle').textContent=({character:'Character',main:'Game menu',world:'World & story',settings:'Settings',display:'Display',help:'Help & saves'})[page]||'Game menu';
 document.getElementById('optionsMenu').scrollTop=0;
}
installSimpleOptions();

function installPortraitMenu(){
 const page=document.getElementById('menuPage_character');
 const summary=document.createElement('p');summary.id='characterMenuSummary';page.appendChild(summary);
 for(const id of ['characterButton','inventoryButton','journalButton'])page.appendChild(document.getElementById(id));
 document.getElementById('characterButton').firstChild.textContent='Stats & equipment';
 for(const b of [...document.querySelectorAll('#quickMenuLinks button, #menuPage_world button')]){
  const label=b.firstChild.textContent.trim();
  if(['Pets','Skills','Mage research','Class story','Vampire story','Story history'].includes(label))page.appendChild(b);
 }
 const testing=document.getElementById('danTestControls');if(testing)page.appendChild(testing);
 const hint=document.createElement('p');hint.id='portraitMenuHint';hint.textContent='Tap your hero portrait for equipment, inventory, skills, pets and your journal.';document.getElementById('quickMenuLinks').after(hint);
 const portrait=document.getElementById('heroMenuButton');
 portrait.addEventListener('pointerdown',e=>e.stopPropagation());
 portrait.addEventListener('click',e=>{e.stopPropagation();openPortraitMenu();});
 new MutationObserver(()=>{portrait.setAttribute('aria-expanded',String(!optionsMenu.hidden&&optionsMenu.dataset.page==='character'));}).observe(optionsMenu,{attributes:true,attributeFilter:['hidden']});
}
function openPortraitMenu(){
 if(!hasStarted||titleMenuActive)return;
 preparePanel('optionsMenu');
 const summary=document.getElementById('characterMenuSummary');
 summary.textContent=player.name+' · '+classDefs[player.class].title+' · Level '+player.level+' · Vitality '+player.hp+' / '+player.max;
 optionsMenu.hidden=false;optionsToggle.setAttribute('aria-expanded','true');
 showOptionsPage('character');refreshPanelState();
 document.getElementById('characterButton').focus({preventScroll:true});
}
installPortraitMenu();
function campState(){return townQuestState._camp||{stage:3,claimed:true,legacy:true};}
function campGuide(){const s=campState();return {destination:s.claimed?'briarhollow':'wayfarers_camp',detail:s.claimed?'The caller left a trail toward Briar Hollow. Their identity remains unknown.':s.stage===0?'Inspect the dying campfire.':s.stage===1?'Read the sealed message beside the western tent.':'Examine the footprints inside Wayfarer’s Camp, beside the southern exit.',progress:s.claimed?'Chapter complete':s.stage+'/3 discoveries',ready:false};}
function campQuestEntries(){const s=campState();if(s.legacy)return [];return [{id:'camp_caller',title:'The Unknown Caller',desc:s.claimed?'I followed an unsigned summons to Wayfarer’s Camp. The stranger had left, but their message pointed toward Briar Hollow.':s.stage===0?'An unsigned letter called me here. I found an empty campsite and a dying fire.':s.stage===1?'Someone left this fire recently. A sealed message waits beside the tent.':'The message asks me to find what happened to Briar Hollow. Examine the footprints inside Wayfarer’s Camp, just south of the campfire and before the southern exit.',reward:'20 crowns · 25 XP · a new lead',done:!!s.claimed,active:!s.claimed},...(s.claimed?[{id:'camp_patrol',title:'Keep the Roads Open',desc:'The road wardens need help protecting travelers. Each completed patrol pays once; another can be accepted at camp.',reward:'20 crowns · 20 XP per patrol',done:false,active:!!townQuestState._campPatrol?.accepted}]:[])];}
function campNote(id,title,text){const s=townQuestState._camp;if(!s)return;s.notes=s.notes||[];if(!s.notes.some(n=>n.id===id))s.notes.push({id,title,text});}
function campCommit(){saveGame();ui();}
function campInteract(o){if(!o.id.startsWith('camp_'))return false;if(o.id==='camp_return'){setMap('wayfarers_camp',480,440);return true;}if(o.id==='camp_board'){openCampBoard();return true;}const s=townQuestState._camp;if(!s){say('An old campsite beside the road.');return true;}
 if(o.id==='camp_fire'){if(s.stage===0){s.stage=1;campNote('embers','Warm embers','The fire was tended recently. Two cups stand beside it, but only one has been used. Someone expected me.');campCommit();}openAdventureDialog('Warm embers','The last flames stir beneath the ash. Two cups wait beside the fire. Whoever called you here has only just left.\n\nA folded message rests on the crate by the western tent.',[{label:'Record the clue',action:()=>{}}]);return true;}
 if(o.id==='camp_letter'){if(s.stage<1){say('Inspect the dying campfire first.');return true;}if(s.stage===1){s.stage=2;campNote('message','The second message','“I could not wait. Briar Hollow has fallen silent. Follow the road into Ashvale, then travel north. Learn what happened there. Trust what you discover, not what you are told.”');campCommit();}openAdventureDialog('The second message','“I could not wait. Briar Hollow has fallen silent. Follow the road into Ashvale, then travel north. Learn what happened there. Trust what you discover, not what you are told.”\n\nAgain, no signature. Only a crescent pressed into the wax.',[{label:'Keep the letter in my journal',action:()=>{}}]);return true;}
 if(o.id==='camp_tracks'){if(s.stage<2){say('Read the sealed message by the tent before following the tracks.');return true;}if(!s.claimed){s.stage=3;s.claimed=true;player.coins+=20;grantXp(25);campNote('tracks','A road into darkness','One set of footprints left camp toward Ashvale. The crescent seal may be a clue to the caller’s identity. Briar Hollow is my next lead.');townQuestState._tracking={id:'briar_hollow'};campCommit();}openAdventureDialog('The Unknown Caller · Chapter complete','The footprints lead toward Ashvale. Beyond its northern road lies Briar Hollow.\n\nYou have found your first lead, but not the person who summoned you.\n\nThe camp’s road warden board now offers repeatable patrols.',[{label:'Follow the south road to Ashvale',action:()=>setMap('ashvale',300,450)},{label:'Stay and explore camp',action:()=>{}}]);return true;}return true;}
function campPatrolGuide(){const s=townQuestState._campPatrol||{};return {destination:s.kills>=3?'wayfarers_camp':'whisperwood',detail:!s.accepted?'Accept a patrol at the camp’s road warden board.':s.kills>=3?'Return to the camp board to collect your patrol reward.':'Defeat three creatures in Whisperwood to protect the road.',progress:(s.kills||0)+'/3 · Patrols completed: '+(s.completed||0),ready:s.kills>=3};}
function openCampBoard(){if(!campState().claimed){say('Follow the caller’s clues first.');return;}const s=townQuestState._campPatrol||(townQuestState._campPatrol={completed:0,kills:0,accepted:false});openAdventureDialog('Road Warden Board',campPatrolGuide().detail+'\n\nCompleted patrols: '+s.completed+'\nReward: 20 crowns and 20 XP. A new patrol becomes available after each return.',[{label:!s.accepted?'Accept road patrol':s.kills>=3?'Collect patrol reward':'Track patrol',action:()=>{if(!s.accepted){if(!journalCanAccept('camp_patrol'))return;s.accepted=true;s.kills=0;townQuestState._tracking={id:'camp_patrol'};}else if(s.kills>=3){s.completed++;s.accepted=false;s.kills=0;player.coins+=20;grantXp(20);campNote('patrol_'+s.completed,'Road patrol '+s.completed,'I cleared the Whisperwood road and returned safely. Travelers can pass for another night.');}else townQuestState._tracking={id:'camp_patrol'};campCommit();}},{label:'Leave the board',action:()=>{}}]);}
const campKillBefore=recordQuestKill;recordQuestKill=function(area,e){campKillBefore(area,e);const s=townQuestState._campPatrol;if(area==='whisperwood'&&s?.accepted&&!journalPaused('camp_patrol')&&s.kills<3){s.kills++;campCommit();}};
function renderCampNotes(){const notes=campState().notes||[];document.getElementById('questList').innerHTML='<nav class="journalTabs">'+[['active','Current'],['paused','Paused'],['history','Completed'],['notes','Story notes']].map(([id,label])=>'<button data-journal-tab="'+id+'" aria-pressed="'+(id==='notes')+'">'+label+'</button>').join('')+'</nav>'+(notes.length?notes.map(n=>'<article class="questEntry"><h3>'+questEscape(n.title)+'</h3><p>'+questEscape(n.text)+'</p></article>').join(''):'<p class="journalEmpty">Letters and discoveries will be recorded here as you find them.</p>');document.getElementById('questList')._questMarkup=null;}
document.getElementById('summonsContinue').addEventListener('click',()=>{document.getElementById('summonsScreen').hidden=true;document.getElementById('characterSetup').hidden=false;document.getElementById('characterSetup').scrollTop=0;});
document.querySelector('#questScreen .screenHead h2').textContent='Journal';document.querySelector('#questScreen .screenHead p').textContent='Your journey, one discovery at a time.';
function drawCampPath(x,y,label){ctx.save();paintSurface('dirt',x-34,y-30,68,60);ctx.strokeStyle='#f5dc9c';ctx.lineWidth=3;ctx.strokeRect(x-32,y-28,64,56);ctx.fillStyle='#f5dc9c';ctx.font='bold 22px system-ui';ctx.textAlign='center';ctx.fillText('↓',x,y+8);ctx.restore();drawLocationLabel(x,y-48,label);drawLocationLabel(x,y+46,'WALK ONTO PATH');}
function drawWayfarerCamp(){if(mapId==='ashvale'){drawCampPath(300,500,'TO WAYFARER’S CAMP');return;}if(mapId!=='wayfarers_camp')return;drawCampPath(480,550,'TO ASHVALE');ctx.save();paintSurface('dirt',270,220,450,180);paintArt('tent',210,130,150,120);paintArt('tent',610,130,150,120);standArt('crate',335,265,40);standArt('barrel',710,280,38);ctx.fillStyle='#daca9c';ctx.fillRect(326,238,19,13);ctx.fillStyle='#873c32';ctx.fillRect(333,242,5,5);ctx.fillStyle='#362d24';ctx.fillRect(690,300,8,68);ctx.fillRect(665,290,62,35);ctx.fillStyle='#d8c18e';ctx.fillRect(672,296,46,21);
 for(let i=0;i<10;i++){const a=i*Math.PI/5;ctx.fillStyle=i%2?'#777568':'#555a50';ctx.beginPath();ctx.ellipse(480+Math.cos(a)*30,310+Math.sin(a)*16,7,5,a,0,Math.PI*2);ctx.fill();}
 ctx.strokeStyle='#4e3424';ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(463,314);ctx.lineTo(495,304);ctx.moveTo(467,302);ctx.lineTo(493,315);ctx.stroke();
 for(let i=0;i<6;i++){const flick=Math.sin(animationClock*(7+i)+i)*4;ctx.fillStyle=i%2?'#ffc468':'#ee753c';ctx.beginPath();ctx.moveTo(468+i*4,309);ctx.quadraticCurveTo(465+i*5+flick,285,474+i*3+flick,273+flick);ctx.quadraticCurveTo(493,296,490-i*2,309);ctx.fill();}
 for(let i=0;i<8;i++){const phase=(animationClock*.25+i/8)%1;ctx.globalAlpha=(1-phase)*.18;ctx.fillStyle='#b6b4a2';ctx.beginPath();ctx.arc(480+Math.sin(phase*8+i)*12,280-phase*95,5+phase*12,0,Math.PI*2);ctx.fill();}ctx.globalAlpha=1;
 for(let i=0;i<45;i++){const x=100+(i*139)%760,y=100+(i*83)%400;if(Math.abs(x-480)<90||y>230&&y<390)continue;ctx.strokeStyle=i%2?'#819568':'#526e47';ctx.lineWidth=2;const sway=Math.sin(animationClock*1.7+i)*3;ctx.beginPath();ctx.moveTo(x,y);ctx.quadraticCurveTo(x-3,y-5,x+sway,y-11);ctx.stroke();}
 for(let i=0;i<5;i++){ctx.fillStyle='#655841';ctx.beginPath();ctx.ellipse(475+i%2*10,455+i*11,3,5,.3,0,Math.PI*2);ctx.fill();}
 if((townQuestState._campPatrol?.completed||0)>0){standArt('crate',655,400,40);standArt('barrel',705,405,36);drawLocationLabel(680,445,'ROAD SUPPLIES RESTORED');}drawLocationLabel(480,220,'WAYFARER’S CAMP');for(const o of activeMap.worldObjects){if(Math.hypot(player.x-o.x,player.y-o.y)<110)drawLocationLabel(o.x,o.y-43,o.label);}ctx.restore();}
const campDamageBefore=damageEnemy;damageEnemy=function(e,damage,stun=0,owner=player){const alive=e.alive;campDamageBefore(e,damage,stun,owner);if(alive){e.campImpactAngle=Math.atan2(e.y-owner.y,e.x-owner.x);e.campImpactColor=({mage:'#92cfff',cleric:'#ffe3a1',rogue:'#bce5ac',warrior:'#ffc68c'})[owner.class]||'#ffc68c';}};
const campMonsterBefore=drawDetailedMonster;drawDetailedMonster=function(e,dead=false){ctx.save();if(!dead&&e.hitTime>0){const recoil=Math.sin(Math.PI*Math.min(1,e.hitTime/.2))*4;ctx.translate(Math.cos(e.campImpactAngle||0)*recoil,Math.sin(e.campImpactAngle||0)*recoil);}const result=campMonsterBefore(e,dead);ctx.restore();if(!dead&&e.hitTime>0){ctx.save();ctx.strokeStyle=e.campImpactColor||'#ffe1aa';ctx.globalAlpha=Math.min(1,e.hitTime*5);ctx.lineWidth=2;for(let i=0;i<5;i++){const a=i*Math.PI*2/5+(e.campImpactAngle||0),r=10+(1-e.hitTime/.2)*20;ctx.beginPath();ctx.moveTo(e.x+Math.cos(a)*r,e.y-20+Math.sin(a)*r);ctx.lineTo(e.x+Math.cos(a)*(r+5),e.y-20+Math.sin(a)*(r+5));ctx.stroke();}ctx.restore();}return result;};
function drawCampLighting(){if(mapId!=='wayfarers_camp')return;ctx.save();ctx.fillStyle='#07141044';ctx.fillRect(0,0,960,600);const r=150+Math.sin(animationClock*6)*6,g=ctx.createRadialGradient(480,300,12,480,300,r);g.addColorStop(0,'#ffbd583d');g.addColorStop(1,'#ffb34a00');ctx.fillStyle=g;ctx.fillRect(300,120,360,360);for(let i=0;i<12;i++){const x=140+(i*73)%690+Math.sin(animationClock*.7+i)*18,y=130+(i*43)%300+Math.cos(animationClock*.6+i)*12;ctx.globalAlpha=.25+.45*(1+Math.sin(animationClock*2+i))/2;ctx.fillStyle='#e3e9a0';ctx.fillRect(x,y,2,2);}ctx.restore();}
// Inspectable state only on the local browser test host, never in the APK.
if(location.hostname==='127.0.0.1')window.campQA={get state(){return {mapId,hasStarted,camp:campState(),patrol:townQuestState._campPatrol,player,quests:journalActiveRows()};},interact:campInteract,setMap,saveGame,recordQuestKill,openQuestJournal,renderQuests,notes:()=>{journalTab='notes';renderQuests();}};


// Human companions are saved separately from legacy pet ids, within each character's quest state.
const humanStories={
 dalen:{area:'whisperwood',role:'Fighter',clue:'My summons bore the seal of a watch captain who vanished years ago.'},
 sylvi:{area:'redfen',role:'Rogue',clue:'The route on my summons avoids every royal checkpoint. Our caller knows the patrols.'},
 corin:{area:'highmoor',role:'Healer',clue:'The prayer on my summons belongs to an order erased from the records.'},
 eryn:{area:'frostmarch',role:'Mage',clue:'The ink on my summons glows with the same magic that broke the beacon.'}
};
function humanParty(){return townQuestState._humanParty||(townQuestState._humanParty={active:null,roster:{}});}
function humanCompanion(){const s=humanParty(),c=s.roster[s.active];return c&&c.hp>0?c:null;}
function humanQuestOwner(id){return Object.keys(humanStories).find(k=>companionEpilogues[k].quests.includes(id)||id==='epilogue_'+k);}
function humanQuestReady(id){const owner=humanQuestOwner(id);return !owner||humanCompanion()?.id===owner;}
function makeHuman(id){const d=companionDefs[id],level=Math.max(1,player.level),max=classDefs[d.class].hp+(level-1)*5;return {id,name:d.name,class:d.class,gender:d.gender,human:true,level,max,hp:max,active:true,x:player.x,y:player.y,faceX:0,faceY:1,cool:0,skillCool:0};}
function selectHuman(id){if(mapId!=='wayfarers_camp')return say('Return to Wayfarer’s Camp to change companions.');const s=humanParty();if(id&&!s.roster[id])return;for(const c of Object.values(s.roster))c.active=false;s.active=id||null;if(id){const c=s.roster[id];c.active=true;c.hp=c.max;}snapCompanionsToPlayer();saveGame();ui();openHumanRoster();}
function recruitHuman(id){if(mapId!=='wayfarers_camp'||!humanStories[id])return;const s=humanParty();if(s.roster[id])return;const key='recruit_'+id;if(!journalCanAccept(key))return;townQuestState[key]={accepted:true,kills:0,claimed:false};s.roster[id]=makeHuman(id);selectHuman(id);}
function openHumanRoster(){const s=humanParty(),atCamp=mapId==='wayfarers_camp';openAdventureDialog('Companions', 'One companion may travel with you alongside your pet. Swap or recover at Wayfarer’s Camp. Each companion carries a different clue to the unknown caller.\n\nActive: '+(s.roster[s.active]?.name||'None')+(atCamp?'':'\nReturn to camp to change your party.'),Object.keys(humanStories).map(id=>({label:companionDefs[id].name+' · '+humanStories[id].role+(s.active===id?' · ACTIVE':s.roster[id]?' · At camp':' · Answer the summons'),action:()=>openHumanStory(id)})));}
function openHumanStory(id){const s=humanParty(),c=s.roster[id],r=townQuestState['recruit_'+id],d=humanStories[id],q=companionEpilogues[id],atCamp=mapId==='wayfarers_camp';const choices=[];if(!c)choices.push({label:'Accept: A Shared Summons',disabled:!atCamp,action:()=>recruitHuman(id)});else {choices.push({label:s.active===id?'Leave at camp':'Travel together',disabled:!atCamp,action:()=>selectHuman(s.active===id?null:id)});if(r&&!r.claimed&&r.kills>=2)choices.push({label:'Complete the summons · establish your bond',disabled:!atCamp||s.active!==id,action:()=>{if(mapId!=='wayfarers_camp'||humanCompanion()?.id!==id||r.claimed||journalPaused('recruit_'+id))return;r.claimed=true;campNote('companion_'+id,c.name,d.clue);player.coins+=10;grantXp(15);saveGame();ui();openHumanStory(id);}});if(r?.claimed)for(const key of q.quests){const def=townQuestDefs[key];choices.push({label:(townQuestState[key]?.claimed?'✓ ':townQuestState[key]?'Continue: ':'Begin: ')+def.title,disabled:!!townQuestState[key]?.claimed||humanCompanion()?.id!==id,action:()=>{interactQuest({questId:key});openHumanStory(id);}});}}
choices.push({label:'Back to companions',action:openHumanRoster});openAdventureDialog(companionDefs[id].name,d.clue+'\n\n'+(!c?'I received a summons too. Meet me at camp. Travel with me and defeat two enemies in '+maps[d.area].name+' to earn my trust.':!r?.claimed?'A Shared Summons: '+(r?.kills||0)+'/2 enemies defeated together in '+maps[d.area].name+'. Return to camp together to seal your bond.':q.quests.map(key=>townQuestDefs[key].title+': '+(townQuestState[key]?.claimed?'Complete':townQuestState[key]?.accepted?'In progress':'Not started')).join('\n'))+'\n\nYour companion must be active for their personal quests. Progress stays saved when you switch.',choices);}
const petsActiveBeforeHumans=activeCompanions;
activeCompanions=function(){const c=humanCompanion();return [...petsActiveBeforeHumans(),...(c?[c]:[])];};
const humanAttackBefore=companionAttackPower;
companionAttackPower=function(c){return c.human?Math.max(1,2+Math.floor(c.level*.7)+companionStoryAttack(c)):humanAttackBefore(c);};
const humanSkillBefore=useCompanionSkill;
useCompanionSkill=function(c,dt){if(!c.human)return humanSkillBefore(c,dt);c.skillCool=Math.max(0,(c.skillCool||0)-dt);if(c.skillCool||activeMap.town||c.hp<=0)return;let hit=false;if(c.class==='cleric'){for(const a of [player,...activeCompanions()])if(a.hp>0&&a.hp<a.max*.8&&Math.hypot(a.x-c.x,a.y-c.y)<180){const n=Math.min(a.max-a.hp,6+c.level);a.hp+=n;combatText(a.x,a.y-28,'+'+n,'#bcebc4');hit=true;}}else {const t=enemies.find(e=>e.alive&&Math.hypot(e.x-c.x,e.y-c.y)<(c.class==='mage'?210:90)&&clearCombatLine(c.x,c.y,e.x,e.y));if(t){damageEnemy(t,Math.round(companionAttackPower(c)*(c.class==='rogue'?2:1.5)),c.class==='warrior'?.5:0,c);hit=true;c.attack=.32;}}if(hit)c.skillCool=7;};
const humanUpdateBefore=updateCompanions;
updateCompanions=function(dt){const c=humanCompanion();if(c&&c.level!==player.level){const ratio=c.hp/c.max;c.level=player.level;c.max=classDefs[c.class].hp+(c.level-1)*5;c.hp=Math.max(1,Math.round(c.max*ratio));}humanUpdateBefore(dt);};
const humanInteractBefore=interactQuest;
interactQuest=function(n){const id=humanQuestOwner(n.questId);if(id&&!townQuestState[n.questId]?.claimed&&(!humanQuestReady(n.questId)||!townQuestState['recruit_'+id]?.claimed)){say('Travel with '+companionDefs[id].name+' and complete A Shared Summons first. Manage companions at Wayfarer’s Camp.');return true;}return humanInteractBefore(n);};
const humanKillBefore=recordQuestKill;
recordQuestKill=function(area,e){humanKillBefore(area,e);const c=humanCompanion();if(!c)return;const key='recruit_'+c.id,r=townQuestState[key];if(r?.accepted&&!r.claimed&&!journalPaused(key)&&area===humanStories[c.id].area){r.kills=Math.min(2,r.kills+1);if(r.kills===2)say(c.name+': We fought well together. Let us return to camp.');saveGame();}};
const humanCatalogBefore=questCatalog;
questCatalog=function(){return [...humanCatalogBefore(),...Object.keys(humanStories).map(id=>{const s=townQuestState['recruit_'+id];return {id:'recruit_'+id,title:companionDefs[id].name+' · A Shared Summons',desc:'Defeat two enemies together in '+maps[humanStories[id].area].name+', then speak at Wayfarer’s Camp.',reward:'Companion bond · 10 crowns · 15 XP',active:!!s?.accepted&&!s.claimed,done:!!s?.claimed};})];};
const humanKindBefore=journalKind;journalKind=function(id){return id.startsWith('recruit_')?'personal':humanKindBefore(id);};
const humanGuideBefore=questGuide;questGuide=function(q){if(q.id.startsWith('recruit_')){const id=q.id.slice(8),r=townQuestState[q.id]||{};return {destination:r.kills>=2?'wayfarers_camp':humanStories[id].area,detail:q.desc+' Active companion required: '+companionDefs[id].name,progress:(r.kills||0)+'/2 defeated together'};}const g=humanGuideBefore(q),owner=humanQuestOwner(q.id);if(owner&&!humanQuestReady(q.id))g.detail='Bring '+companionDefs[owner].name+' from Wayfarer’s Camp. '+g.detail;return g;};
interactCompanion=function(n){if(!humanStories[n.companionId])return false;openHumanStory(n.companionId);return true;};
const humanServiceBefore=npcServiceLabel;npcServiceLabel=function(n){return n.role==='companion'?'Discuss joining and personal quests':humanServiceBefore(n);};
const humanCampBefore=openCampBoard;openCampBoard=function(){openAdventureDialog('Wayfarer’s Camp','Your companions gather here between journeys.',[{label:'Companions · recruit, swap and talk',action:openHumanRoster},{label:'Road Warden patrols',action:humanCampBefore}]);};
const humanCampDrawBefore=drawWayfarerCamp;drawWayfarerCamp=function(){humanCampDrawBefore();if(mapId!=='wayfarers_camp')return;Object.keys(humanStories).forEach((id,i)=>{if(humanParty().active===id)return;const c={...companionDefs[id],x:300+i*115,y:390,faceY:1};drawClassHero(c,1.45);drawLocationLabel(c.x,c.y+32,c.name.split(' ')[0]);});};
const humanButton=document.createElement('button');humanButton.id='humanCompanionsButton';humanButton.type='button';humanButton.textContent='Companions';humanButton.addEventListener('click',openHumanRoster);document.getElementById('menuPage_character').appendChild(humanButton);
if(location.hostname==='127.0.0.1')window.humanQA={humanParty,humanCompanion,recruitHuman,selectHuman,openHumanRoster,openHumanStory,makeHuman};

// PLAY_PURCHASE_UI_START
let playStore={products:{},owned:[],deliveries:[],message:'Google Play purchases require the Android Play release.'},playStoreRaw='';
function purchaseOwned(id){const owned=[...playStore.owned,...(danTesting()?Object.keys(townQuestState._testPremium||{}):[])];return owned.includes(id)||owned.some(key=>premiumProduct(key)?.contains?.includes(id))}
function grantTestPremium(id){
 if(!danTesting()||!hasStarted||titleMenuActive||switchingCharacter)return;
 const p=premiumProduct(id);if(!p)return;const next=snapshotGameState(),q=next.townQuestState;
 if(p.category==='levels')next.player.level+=p.levels;
 else if(['xp','builder'].includes(p.category)){const credits=q._purchaseCredits||(q._purchaseCredits={});credits[p.category]=(credits[p.category]||0)+1;}
 else (q._testPremium||(q._testPremium={}))[id]=true;
 try{purchaseCommit(next);renderPremiumShop()}catch{document.getElementById('premiumSummary').textContent='Test item was not saved. Free device storage and retry.';}
}
function purchaseCommit(next){
 const slot={id:activeSlotId,name:next.player.name,class:next.player.class,level:next.player.level,updated:Date.now(),state:next};
 const slots={...saveSlots,[activeSlotId]:slot};
 // The slot store is authoritative on reload. One atomic write includes reward AND ledger.
 localStorage.setItem(SAVE_SLOTS_KEY,JSON.stringify(slots));
 saveSlots=slots;townQuestState=next.townQuestState;player.level=next.player.level;
 syncHeroStats();normalizePets();scaleEnemiesForRegion();
 // Compatibility cache failure must not roll back a committed purchase.
 try{localStorage.setItem(SAVE_KEY,JSON.stringify(next));localStorage.setItem(ACTIVE_SLOT_KEY,activeSlotId)}catch{}
}
function ensurePurchaseProfile(){
 if(!/^[a-f0-9]{64}$/.test(townQuestState._purchaseProfile||'')){
  const bytes=crypto.getRandomValues(new Uint8Array(32)),next=snapshotGameState();
  next.townQuestState._purchaseProfile=Array.from(bytes,b=>b.toString(16).padStart(2,'0')).join('');purchaseCommit(next);
 }
 return townQuestState._purchaseProfile;
}
function pollPlayStore(){
 if(!window.ThornhavenPlayPurchases)return;
 try{
  const raw=window.ThornhavenPlayPurchases.state();playStore={products:{},owned:[],deliveries:[],...JSON.parse(raw)};
  if(hasStarted&&!titleMenuActive&&!switchingCharacter){
   for(const receipt of playStore.deliveries){
    const product=premiumProduct(receipt.product);if(!product)continue;
    if(product.productType==='consumable'&&receipt.profile!==townQuestState._purchaseProfile)continue;
    try{
     const next=window.ThornhavenPurchaseDelivery.reward(snapshotGameState(),receipt,PREMIUM_PRODUCTS);
     purchaseCommit(next);window.ThornhavenPlayPurchases.delivered(receipt.id);
    }catch{playStore.message='Purchase is waiting for delivery. Free device storage and use Restore purchases. No purchase will be confirmed until it is saved.';}
   }
  }
  if(raw!==playStoreRaw&&!document.getElementById('premiumScreen').hidden)renderPremiumShop();playStoreRaw=raw;
 }catch{playStore.message='Could not read Google Play purchase status.';}
}
function buyPlayProduct(id){
 if(danTesting()||!hasStarted||titleMenuActive||switchingCharacter||!playStore.products[id]||playStore.busy)return;
 try{window.ThornhavenPlayPurchases.buy(id,ensurePurchaseProfile());}catch{document.getElementById('premiumSummary').textContent='Could not save this character for checkout. Free device storage and retry.';}
}
function equipPurchasedStyle(id){
 if(!purchaseOwned(id))return;const p=premiumProduct(id),next=snapshotGameState(),styles=next.townQuestState._equippedPaid||(next.townQuestState._equippedPaid={});
 for(const item of p.contains||[id]){const d=premiumProduct(item);if(d.category==='title')delete next.townQuestState._earnedTitle;if(styles[d.category]===item)delete styles[d.category];else styles[d.category]=item;}
 try{purchaseCommit(next);premiumTrial={};premiumTrialUntil=0;renderPremiumShop()}catch{document.getElementById('premiumSummary').textContent='Could not save your selection.';}
}
function activatePurchasedBoost(kind){
 const credits=townQuestState._purchaseCredits||{};if(!['xp','builder'].includes(kind)||!(credits[kind]>0))return;
 if(kind==='xp'&&xpBoostSeconds()>0||kind==='builder'&&(builderBoostSeconds()>0||!frontierState().complete||!workforceState().hires.builder||workerGate('builder'))){document.getElementById('premiumSummary').textContent='This boost cannot start yet. Your purchased credit is saved.';return;}
 const next=snapshotGameState();next.townQuestState._purchaseCredits[kind]--;next.townQuestState[kind==='xp'?'_xpBoost':'_builderBoost']={seconds:900};
 try{purchaseCommit(next);refreshXpBoost();renderPremiumShop()}catch{document.getElementById('premiumSummary').textContent='Could not save boost activation. Your credit has not been spent.';}
}
const previewStyleSelection=styleSelection;
styleSelection=function(){const out={};for(const [slot,id] of Object.entries(townQuestState._equippedPaid||{}))if(purchaseOwned(id)&&premiumProduct(id)?.category===slot)out[slot]=id;return {...out,...previewStyleSelection()}};
const previewShopRender=renderPremiumShop;
renderPremiumShop=function(){
 previewShopRender();
 const note=document.querySelector('.premiumPreviewNotice');note.textContent='Google Play purchases • Cosmetics can be restored. Levels and boost credits belong to the selected character and are saved on this device; deleting its save or uninstalling loses consumable progress. Boost credits start only when you activate them. Cosmetic previews remain free.';
 document.getElementById('premiumSummary').textContent=danTesting()?'DEVELOPER TEST CHARACTER · Test grants cost nothing, stay with this character and are not Google Play purchases. Real checkout is disabled.':playStore.message;
 const escape=value=>String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 for(const button of document.querySelectorAll('[data-preview-product]')){
  const id=button.dataset.previewProduct,p=premiumProduct(id),card=button.closest('.premiumCardInfo'),details=playStore.products[id],owned=purchaseOwned(id);
  card.querySelector('.premiumPrice').textContent=owned?'Owned':details?details.price:'Not currently available on Google Play';
  const buy=document.createElement('button');buy.type='button';buy.textContent=owned?'Equip / remove':details?'Buy · '+details.price:'Unavailable';buy.disabled=!owned&&(!details||playStore.busy||danTesting());buy.onclick=()=>owned?equipPurchasedStyle(id):buyPlayProduct(id);card.appendChild(buy);
  if(danTesting()){const test=document.createElement('button');test.type='button';test.textContent='Test grant · no payment';test.onclick=()=>grantTestPremium(id);card.appendChild(test);}
  if(['xp','builder'].includes(p.category)){
   const count=townQuestState._purchaseCredits?.[p.category]||0;
   if(count){const activate=document.createElement('button');activate.type='button';activate.textContent='Activate saved boost · '+count+' available';activate.onclick=()=>activatePurchasedBoost(p.category);card.appendChild(activate);}
  }
 }
};
// Remove the obsolete no-op restore listener and the unapproved external-payment path.
const oldRestore=document.getElementById('restorePurchasesButton'),restore=oldRestore.cloneNode(true);oldRestore.replaceWith(restore);
restore.onclick=()=>{window.ThornhavenPlayPurchases?.restore();pollPlayStore();renderPremiumShop()};
document.getElementById('forumShopButton').hidden=true;
setInterval(pollPlayStore,1000);pollPlayStore();
const privacyButton=document.createElement('button');privacyButton.type='button';privacyButton.textContent='Privacy policy';privacyButton.onclick=()=>{if(window.ThornhavenDevice?.openPrivacyPolicy)window.ThornhavenDevice.openPrivacyPolicy();else window.open('https://thornhaven-community.blushbeech32.chatgpt.site/privacy','_blank','noopener,noreferrer')};document.querySelector('.optionsCard').appendChild(privacyButton);
// PLAY_PURCHASE_UI_END

showTitleMenu();

document.getElementById('assetLoading')?.remove();
// End shared game initialization.
</script>
<script>
(()=>{
const b=document.createElement('button');b.textContent='Ask Jarvis';b.id='jarvisButton';b.style.cssText='position:fixed;right:12px;top:88px;z-index:100;min-height:44px';b.hidden=true;document.body.append(b);
const panel=document.createElement('dialog');panel.id='jarvisPanel';panel.style.cssText='width:min(560px,92vw);max-height:85dvh;overflow:auto;background:#18221d;color:#f3ecd9;border:2px solid #b49a61;border-radius:12px;padding:18px';panel.innerHTML='<h2>Jarvis · Playtest help</h2><p>Game paused. Messages include your map, position, character class, level and tracked quest. This chat is separate from ChatGPT.</p><p id="jarvisStatus" role="status">Live chat is not connected yet.</p><div id="jarvisLog" role="log" aria-live="polite" style="white-space:pre-wrap;max-height:30vh;overflow:auto"></div><form id="jarvisForm"><label>Message<textarea id="jarvisMessage" maxlength="2000" rows="3" style="width:100%;user-select:text" required></textarea></label><button id="jarvisSend">Send</button></form><button id="jarvisBug" type="button">Report a bug</button><button id="jarvisCopy" type="button">Copy report</button><textarea id="jarvisReport" aria-label="Bug report to copy" readonly hidden style="width:100%;height:140px;user-select:text"></textarea><details><summary>Testing connection</summary><label>Server URL<input id="jarvisUrl" type="url" placeholder="https://your-server.example" style="width:100%"></label><label>Tester access token<input id="jarvisToken" type="password" autocomplete="off" style="width:100%"></label><p>Use a tester token, never an OpenAI API key. Connection details last only for this session.</p></details><button id="jarvisClose" type="button">Back to game</button>';
document.body.append(panel);const el=id=>document.getElementById(id);let history=[],busy=false;const status=t=>el('jarvisStatus').textContent=t;const context=()=>({build:'1.0.49',map:mapId,mapName:activeMap.name,position:{x:Math.round(player.x),y:Math.round(player.y)},class:player.class,level:player.level,trackedQuest:townQuestState._tracking?.id||null,camp:townQuestState._camp?{stage:townQuestState._camp.stage,claimed:!!townQuestState._camp.claimed}:null});
const oldUi=ui;ui=function(){oldUi();b.hidden=!hasStarted||titleMenuActive||!danTesting()};
b.onclick=()=>{if(!danTesting())return;stopWorldTouch();clearPadTouches();keys.clear();tapTarget=null;attackHeld=false;window.jarvisPaused=true;panel.showModal();el('jarvisMessage').focus()};panel.addEventListener('close',()=>{window.jarvisPaused=false;keys.clear();clearPadTouches()});el('jarvisClose').onclick=()=>panel.close();
el('jarvisBug').onclick=()=>{el('jarvisReport').hidden=false;el('jarvisReport').value=JSON.stringify({type:'Thornhaven bug report',time:new Date().toISOString(),description:el('jarvisMessage').value,context:context()},null,2);status('Report prepared locally. Copy it and paste it into our ChatGPT conversation. Nothing has been submitted.');};
el('jarvisCopy').onclick=async()=>{if(!el('jarvisReport').value)el('jarvisBug').click();try{await navigator.clipboard.writeText(el('jarvisReport').value);status('Report copied. Paste it into ChatGPT.')}catch{el('jarvisReport').focus();el('jarvisReport').select();status('Select and copy the report below.')}};
function append(who,text){const p=document.createElement('p');p.textContent=who+': '+text;el('jarvisLog').append(p);p.scrollIntoView({block:'nearest'});}
el('jarvisForm').onsubmit=async e=>{e.preventDefault();if(busy||!danTesting())return;const message=el('jarvisMessage').value.trim();if(!message)return;let url;try{url=new URL(el('jarvisUrl').value);if(url.protocol!=='https:'||url.username||url.password)throw Error()}catch{status('Live chat needs a secure server connection. Bug reports work offline.');return;}const token=el('jarvisToken').value.trim();if(!token||token.startsWith('sk-')){status('Enter the tester access token, not an OpenAI API key.');return;}busy=true;el('jarvisSend').disabled=true;status('Contacting Jarvis…');try{const response=await fetch(url.origin+'/chat',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify({message,context:context(),history:history.slice(-8)}),signal:AbortSignal.timeout(30000)});if(!response.ok)throw Error(response.status===401?'Tester token rejected.':response.status===429?'Request limit reached. Try again later.':'Chat unavailable. Try again later.');const data=await response.json();if(typeof data.reply!=='string'||!data.reply)throw Error('No reply received.');append('You',message);append('Jarvis',data.reply);history.push({role:'user',content:message},{role:'assistant',content:data.reply});history=history.slice(-8);el('jarvisMessage').value='';status('Connected.')}catch(error){status(error.name==='TimeoutError'?'Connection timed out. Your message is still here.':error.message||'Connection failed.')}finally{busy=false;el('jarvisSend').disabled=false;}};
ui();
})();

</script>
<script src="playtest-update.js"></script>
<script src="town-progress.js"></script>
<script src="playtest-editor.js"></script>
<script src="regional-playtest.js"></script>
</body>
</html>
